# Based on github's .gitignore templates
# https://github.com/github/gitignore/tree/main

# System-specific files
.bashrc

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv*

# Outputs
*.ini
*.png
*.mp4
output*
train_results*

# Undo h5 and .vscode files in this subdirectory
!*.h5
!.vscode
