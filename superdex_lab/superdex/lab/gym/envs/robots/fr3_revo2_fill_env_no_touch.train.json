{
  "description": "Training recipe for the no_touch ablation of the hold-while-filling task; same settings as the base recipe, so the runs compare.",
  "normalize_observations": true,
  "stop_criteria": {
    "num_env_steps_sampled_lifetime": 20000000
  },
  "ppo": {
    "env_runners": {
      "batch_mode": "truncate_episodes"
    },
    "training": {
      "clip_param": 0.2,
      "gamma": 0.99,
      "grad_clip": 0.5,
      "lambda_": 0.95,
      "lr": 0.0003,
      "minibatch_size": 1024,
      "num_epochs": 10,
      "train_batch_size": 8192,
      "vf_loss_coeff": 0.5
    }
  }
}
