{
  "description": "Training recipe for holding a paper cup while it fills (FR3 + Revo2, fingertip tactile sensing). PPO is the recommended workflow.",
  "normalize_observations": true,
  "stop_criteria": {
    "num_env_steps_sampled_lifetime": 20000000
  },
  "ppo": {
    "env_runners": {
      "batch_mode": "truncate_episodes"
    },
    "train_batch_size_per_runner": 1024,
    "training": {
      "clip_param": 0.2,
      "gamma": 0.99,
      "grad_clip": 0.5,
      "lambda_": 0.95,
      "lr": 0.0003,
      "minibatch_size": 1024,
      "num_epochs": 10,
      "vf_loss_coeff": 0.5
    }
  }
}
