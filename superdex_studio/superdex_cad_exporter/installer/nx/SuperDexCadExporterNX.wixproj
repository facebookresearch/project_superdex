<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>SuperDexCadExporterNXSetup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>..\output\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <CommitVersion Condition="'$(CommitVersion)' == ''">unknown</CommitVersion>
    <ExporterBinDir Condition="'$(ExporterBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\bin\Release</ExporterBinDir>
    <NXSourceDir>$(MSBuildThisFileDirectory)..\..\src\CAD\NX</NXSourceDir>
    <DefineConstants>BinDir=$(ExporterBinDir);NXSourceDir=$(NXSourceDir);CommitVersion=$(CommitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="EnsureExporterBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ExporterBinDir)\NXRobotExporter.dll') Or !Exists('$(ExporterBinDir)\NXLayout\startup\NXRobotExporter.dll')"
           Text="NXRobotExporter.dll or its staged NXLayout not found in $(ExporterBinDir). Build NXRobotExporter (Release) before building the installer." />
  </Target>

</Project>
