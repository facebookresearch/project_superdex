<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>SuperDexCadExporterSetup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>output\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <CommitVersion Condition="'$(CommitVersion)' == ''">unknown</CommitVersion>
    <ExporterBinDir Condition="'$(ExporterBinDir)' == ''">$(MSBuildThisFileDirectory)..\bin\x64\Release</ExporterBinDir>
    <DefineConstants>BinDir=$(ExporterBinDir);CommitVersion=$(CommitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="EnsureExporterBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ExporterBinDir)\SuperDexCADExporter.dll')"
           Text="$(ExporterBinDir)\SuperDexCADExporter.dll not found. Build SolidWorksRobotExporter (Release|x64) before building the installer." />
  </Target>

</Project>
