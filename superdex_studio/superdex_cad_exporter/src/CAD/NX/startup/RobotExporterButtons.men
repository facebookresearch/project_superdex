VERSION 120

EDIT UG_GATEWAY_MAIN_MENUBAR

TOP_MENU

CASCADE_BUTTON ROBOT_EXPORTER_MENU
LABEL Robot Exporter

END_OF_TOP_MENU

MENU ROBOT_EXPORTER_MENU

BUTTON ROBOT_EXPORTER_MENU_CREATE_BUTTON
LABEL New Robot Configuration
BITMAP ${UGII_USER_DIR}\application\icons\new_128px.bmp
ACTIONS ROBOT_EXPORTER__CreateNewRobot

BUTTON ROBOT_EXPORTER_MENU_EDIT_BUTTON
LABEL Edit and Export Robot Configuration
BITMAP ${UGII_USER_DIR}\application\icons\export_128px.bmp
ACTIONS ROBOT_EXPORTER__EditRobot

BUTTON ROBOT_EXPORTER_MENU_BACKUP_BUTTON
LABEL Back-up configuration
BITMAP ${UGII_USER_DIR}\application\icons\backup_128px.bmp
ACTIONS ROBOT_EXPORTER__BackupRobot

BUTTON ROBOT_EXPORTER_MENU_IMPORT_BUTTON
LABEL Import configuration
BITMAP ${UGII_USER_DIR}\application\icons\import_128px.bmp
ACTIONS ROBOT_EXPORTER__ImportRobot

BUTTON ROBOT_EXPORTER_MENU_IMPORT_URDF_BUTTON
LABEL Import from URDF file
BITMAP ${UGII_USER_DIR}\application\icons\import_128px.bmp
ACTIONS ROBOT_EXPORTER__ImportURDF

BUTTON ROBOT_EXPORTER_MENU_DUPLICATE_BUTTON
LABEL Duplicate configuration
BITMAP ${UGII_USER_DIR}\application\icons\duplicate_128px.bmp
ACTIONS ROBOT_EXPORTER__DuplicateRobot

BUTTON ROBOT_EXPORTER_MENU_LAUNCH_GUID_SANITIZER_BUTTON
LABEL GUID sanitizer
BITMAP ${UGII_USER_DIR}\application\icons\guid_128px.bmp
ACTIONS ROBOT_EXPORTER__LaunchGuidSanitizer

BUTTON ROBOT_EXPORTER_MENU_LAUNCH_GUID_DEBUGGER_BUTTON
LABEL GUID Debugger
BITMAP ${UGII_USER_DIR}\application\icons\guid_128px.bmp
ACTIONS ROBOT_EXPORTER__LaunchGuidDebugger

BUTTON ROBOT_EXPORTER_MENU_LAUNCH_SUPERDEX_MESH_EXPORTER_BUTTON
LABEL SuperDex Mesh Exporter
BITMAP ${UGII_USER_DIR}\application\icons\export_128px.bmp
ACTIONS ROBOT_EXPORTER__LaunchSuperDexMeshExporter

END_OF_MENU
