    <None Include="packages.config" />
    <!-- Out-of-process mesher. Not checked in; build it with scripts\refresh_mesh_cli_buck.bat
         (or refresh_mesh_cli_cmake.bat). -->
    <None Include="Meshing\superdex_mesh_cli.exe">
      <!-- Link flattens it to the output root; MeshCliRunner looks for the helper next to the
           assembly, not in a Meta subfolder. -->
      <Link>superdex_mesh_cli.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="EnsureMeshCliHelper" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ProjectDir)Meshing\superdex_mesh_cli.exe')" Text="superdex_mesh_cli.exe is missing from src\Meshing. Please build it first." />
  </Target>
  <PropertyGroup>
    <PostBuildEvent>
if exist "%25UGII_BASE_DIR%25\ugopen\NXOpenAuxillaryActions.bat" call "%25UGII_BASE_DIR%25\ugopen\NXOpenAuxillaryActions.bat" DotNet $(TargetDir) $(TargetFileName) $(ProjectDir) $(ProjectName)

REM Create NX custom directories if they don't exist
if not exist "C:\NXCustom\startup" mkdir "C:\NXCustom\startup"
if not exist "C:\NXCustom\application" mkdir "C:\NXCustom\application"

REM Copy DLLs and related files to startup directory
xcopy /Y "$(TargetDir)*.*" "C:\NXCustom\startup\"

REM Copy application files (dlx, xml, etc.)
xcopy /Y "$(ProjectDir)CAD\NX\application\*.*" "C:\NXCustom\application\"
xcopy /Y "$(ProjectDir)CAD\NX\application\icons\*.*" "C:\NXCustom\application\icons\"

REM Copy startup files
xcopy /Y "$(ProjectDir)CAD\NX\startup\*.*" "C:\NXCustom\startup\"
</PostBuildEvent>
  </PropertyGroup>
