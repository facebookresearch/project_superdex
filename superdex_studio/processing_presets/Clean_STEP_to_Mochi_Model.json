{
  "description": "Used for processing clean, often single-body, CAD models with relatively simple geometry (e.g. no bolt holes, closed volumes, no small features).",
  "modifiers": [
    {
      "collapsed": true,
      "enabled": true,
      "method": "From Model Viewer",
      "modifier": "Source from CAD Model",
      "properties": {
        "allowPartialFailure": true,
        "angularDeflection": 0.25,
        "backend": "CadMesher",
        "bodySelection": 0,
        "edgeSampling": "Uniform",
        "linearDeflection": 0.050000000000000003,
        "targetEdgeLength": 0,
        "targetEdgeLengthFraction": 0.02
      }
    },
    {
      "collapsed": true,
      "enabled": true,
      "method": "Make Manifold",
      "modifier": "Refine Mesh",
      "properties": {
        "thenMakeWatertight": true
      }
    },
    {
      "collapsed": true,
      "enabled": true,
      "method": "Tangential Relaxation (Smoothing)",
      "modifier": "Refine Mesh",
      "properties": {
        "angleSmoothingIterations": 0,
        "tangentialRelaxationIterations": 3
      }
    },
    {
      "collapsed": false,
      "enabled": true,
      "method": "SDF",
      "modifier": "Export Mochi Model",
      "properties": {
        "sdf": {
          "boundaryPaddingDist": 0.0050000003539025784,
          "minGridResolution": [
            6,
            6,
            6
          ],
          "resolutionDelta": [
            1,
            1,
            1
          ],
          "resolutionMode": "MeanEdge"
        }
      }
    }
  ],
  "version": 1
}
