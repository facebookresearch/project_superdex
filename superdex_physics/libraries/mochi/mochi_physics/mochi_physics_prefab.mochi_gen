namespace prefab;

## Prefab Types

// @brief Parameters that are global to the @ref Scene in which this prefab
// will be instantiated.
//
// @note If prefabs are nested, then only the top-level prefab will use these
// parameters.
struct prefab::SceneParams [no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Human-readable description of the scene.
  String description;

  // @brief Optional gravity vector [m/s^2] in world frame.
  //
  // @details @ref AddToScene replaces the scene's gravity only when this value is
  // provided by the top-level prefab and @ref PrefabParams::applySceneSettings is true.
  // Otherwise, the existing scene gravity is preserved.
  Optional<Real3> gravity [units(m/s^2)];

  // @brief Optional solver parameters.
  //
  // @details @ref AddToScene replaces the scene's complete solver parameters only when this value
  // is provided by the top-level prefab and @ref PrefabParams::applySceneSettings is true. In all
  // other cases, the existing scene solver parameters are preserved. When replacement occurs,
  // fields omitted from the solver object use their default values, e.g. `"solver": {}` resets all
  // solver parameters to their defaults.
  Optional<SolverParams> solver;
}

// @brief Prefab parameters for a rigid actor.
//
// @details Extends @ref RigidActorParams. The inherited @ref RigidActorParams::worldFromLocal
// is replaced by the prefab-relative @ref rotation and @ref translation fields, and the
// inherited @ref RigidActorParams::shape (a runtime @ref ShapeHandle) is replaced by
// @ref shapeFile (a path serialized to JSON. The shape is loaded at instantiation time).
//
// @note The inherited @ref RigidActorParams::name field need not be unique, but a name
// shared by more than one actor cannot be referenced by a constraint, pose controller, or
// contact filter.
struct prefab::RigidActorPrefab(RigidActorParams) [no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Path to a model file that will be loaded and referenced via @ref ShapeHandle.
  String shapeFile;

  // @brief Scale [x, y, z] to bake into the shape file.
  //
  // @note All components must be non-zero and finite. Negative scale mirrors the shape.
  // @note Some shape data cannot bake arbitrary non-uniform scale. Unsupported scale values are
  // rejected when the shape is loaded.
  // @note Precomputed grid SDF data is preserved only when @ref scale is uniform by absolute
  // value. Non-uniform scale by absolute value discards the precomputed SDF. If an SDF collider
  // is used, SuperDex Physics regenerates the SDF from the transformed mesh at runtime, which
  // may be expensive.
  Real3 scale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to bake into the shape file.
  Quaternion shapeRotation;

  // @brief Translation [x, y, z] to bake into the shape file.
  Real3 shapeTranslation [units(m)];

  // @brief Actor rotation quaternion [x, y, z, w] relative to the prefab's local frame
  // (i.e., the prefab-from-local rotation). Composes with @ref PrefabParams::rotation
  // to produce the final world-from-local rotation.
  //
  // @note Must be finite and non-zero.
  Quaternion rotation;

  // @brief Actor translation [x, y, z] relative to the prefab's local frame
  // (i.e., the prefab-from-local translation). Composes with @ref PrefabParams::scale,
  // @ref PrefabParams::rotation, and @ref PrefabParams::translation to produce the final
  // world-from-local translation.
  //
  // @note Must be finite.
  Real3 translation [units(m)];

  // @brief Optional path to a render model file (e.g. .glb) for visualization.
  //
  // @note SuperDex Physics does not use this field for simulation. It provides additional
  // metadata for visualization in supported tools. Ignored if empty.
  DynamicString renderModelFile;

  // @brief Scale [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelScale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Quaternion renderModelRotation;

  // @brief Translation [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelTranslation [units(m)];
}

// @brief Prefab parameters for a soft actor.
//
// @details Extends @ref SoftActorParams. The inherited @ref SoftActorParams::worldFromLocal
// is replaced by the prefab-relative @ref rotation and @ref translation fields, and the
// inherited @ref SoftActorParams::shape (a runtime @ref ShapeHandle) is replaced by
// @ref shapeFile (a path serialized to JSON. The shape is loaded at instantiation time).
//
// @note When used as a standalone soft actor prefab, the inherited @ref SoftActorParams::name
// field need not be unique, but a name shared by more than one actor cannot be referenced by a
// constraint, pose controller, or contact filter.
struct prefab::SoftActorPrefab(SoftActorParams) [no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Path to a model file that will be loaded and referenced via @ref ShapeHandle.
  String shapeFile;

  // @brief [Experimental] Collision detection geometry.
  //
  // @warning This is an experimental feature. It may be changed or removed in the future. Use at
  // your own risk.
  //
  // @note Determines how OTHER actors detect contact with this actor. It does not affect how this
  // actor detects contact with other actors.
  ColliderType colliderType = None;

  // @brief [Experimental] Parameters used to construct a grid-based Signed Distance Field (SDF)
  // if the shape doesn't already have one.
  //
  // @warning This is an experimental feature. It may be changed or removed in the future. Use at
  // your own risk.
  //
  // @note Ignored if @ref colliderType is not @ref ColliderType::Sdf.
  // @note Ignored if the shape already has a grid-based SDF.
  GridSdfParams sdf;

  // @brief [Experimental] Optional path to a deep flow shape handle for collision detection.
  //
  // @warning This is an experimental feature. It may be changed or removed in the future. Use at
  // your own risk.
  String flowFile;

  // @brief [Experimental] Optional deep flow shape handle loaded from @ref flowFile.
  //
  // @warning This is an experimental feature. It may be changed or removed in the future. Use at
  // your own risk.
  ShapeHandle flow;

  // @brief [Experimental] Enable automatic recentering of the local coordinate system.
  //
  // @warning This is an experimental feature. It may be changed or removed in the future. Use at
  // your own risk.
  //
  // @note Recentering updates the root transform as the actor moves, keeping local-space
  // displacements small. This improves numerical stability for actors that move far from their
  // initial position.
  // @note Ignored for nested soft actors in soft-skinned actors, which do not support recentering.
  bool useRecentering = true;

  // @brief Scale [x, y, z] to bake into the shape file.
  //
  // @note All components must be strictly positive and finite. Negative scale (mirroring) is not
  // supported and rejected at @ref AddToScene.
  // @note If @ref flowFile is set, @ref scale must be (1, 1, 1).
  // @note Non-uniform scale is supported only for shape data that supports arbitrary per-axis bake
  // scale. Unsupported scale values are rejected when the shape is loaded.
  Real3 scale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to bake into the shape file.
  Quaternion shapeRotation;

  // @brief Translation [x, y, z] to bake into the shape file.
  Real3 shapeTranslation [units(m)];

  // @brief Actor rotation quaternion [x, y, z, w] relative to the prefab's local frame
  // (i.e., the prefab-from-local rotation). Composes with @ref PrefabParams::rotation
  // to produce the final world-from-local rotation.
  //
  // @note Must be finite and non-zero when used in @ref ActorLists::soft.
  // @note Ignored when used in @ref SoftSkinnedActorPrefab::softParams.
  Quaternion rotation;

  // @brief Actor translation [x, y, z] relative to the prefab's local frame
  // (i.e., the prefab-from-local translation). Composes with @ref PrefabParams::scale,
  // @ref PrefabParams::rotation, and @ref PrefabParams::translation to produce the final
  // world-from-local translation.
  //
  // @note Must be finite when used in @ref ActorLists::soft.
  // @note Ignored when used in @ref SoftSkinnedActorPrefab::softParams.
  Real3 translation [units(m)];

  // @brief Optional path to a render model file (e.g. .glb) for visualization.
  //
  // @note SuperDex Physics does not use this field for simulation. It provides additional
  // metadata for visualization in supported tools. Ignored if empty.
  DynamicString renderModelFile;

  // @brief Scale [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelScale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Quaternion renderModelRotation;

  // @brief Translation [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelTranslation [units(m)];
}

// @brief Joint parameters for an articulated actor prefab.
struct prefab::ArticulatedJointPrefab(ArticulatedJointParams) [equality, no_reflection] {}

// @brief Link parameters for an articulated actor prefab.
//
// @details Extends @ref ArticulatedLinkParams. The inherited @ref ArticulatedLinkParams::shape
// (a runtime @ref ShapeHandle) is replaced by @ref shapeFile (a path serialized to JSON.
// The shape is loaded at instantiation time). Inherited link local-name requirements apply: names
// must not contain forward slash, backslash, or embedded NUL characters, and must be unique within
// the parent articulated actor's nested actor namespace after default-name assignment.
struct prefab::ArticulatedLinkPrefab(ArticulatedLinkParams) [equality, no_reflection] {
  // @brief Path to a simulation model file defining the geometry of the rigid link actor.
  //
  // @note Leave empty for dummy links.
  DynamicString shapeFile;

  // @brief Scale [x, y, z] to bake into the shape file.
  //
  // @note Ignored if @ref shapeFile is empty.
  // @note All components must be non-zero and finite. Negative scale mirrors the link shape.
  // @note Non-uniform scale is supported only for shape data that supports arbitrary per-axis bake
  // scale. Unsupported scale values are rejected when the shape is loaded.
  // @note If @ref ArticulatedLinkParams::mass, @ref ArticulatedLinkParams::centerOfMass, or @ref
  // ArticulatedLinkParams::momentOfInertia are set explicitly, they are transformed consistently
  // with the final per-axis scale applied to the link at @ref AddToScene. If they are left unset,
  // they are computed from the scaled shape.
  Real3 shapeScale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to bake into the shape file.
  //
  // @note Ignored if @ref shapeFile is empty.
  Quaternion shapeRotation;

  // @brief Translation [x, y, z] to bake into the shape file.
  //
  // @note Ignored if @ref shapeFile is empty.
  Real3 shapeTranslation [units(m)];

  // @brief Optional path to a render model file (e.g. .glb) for visualization.
  //
  // @note SuperDex Physics does not use this field for simulation. It provides additional
  // metadata for visualization in supported tools. Ignored if empty.
  DynamicString renderModelFile;

  // @brief Scale [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelScale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Quaternion renderModelRotation;

  // @brief Translation [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelTranslation [units(m)];
}

// @brief Skin parameters for an articulated actor prefab.
//
// @details Extends @ref ArticulatedSkinParams. The inherited @ref ArticulatedSkinParams::shape
// (a runtime @ref ShapeHandle) is replaced by @ref shapeFile (a path serialized to JSON.
// The shape is loaded at instantiation time).
struct prefab::ArticulatedSkinPrefab(ArticulatedSkinParams) [equality, no_reflection] {
  // @brief Path to the model file containing a skinned mesh.
  DynamicString shapeFile;

  // @brief Optional path to a render model file (e.g. .glb) for visualization.
  //
  // @note SuperDex Physics does not use this field for simulation. It provides additional
  // metadata for visualization in supported tools. Ignored if empty.
  DynamicString renderModelFile;

  // @brief Scale [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelScale = kReal3Ones;

  // @brief Rotation quaternion [x, y, z, w] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Quaternion renderModelRotation;

  // @brief Translation [x, y, z] to apply to the render model.
  //
  // @note Ignored if @ref renderModelFile is empty.
  Real3 renderModelTranslation [units(m)];
}

// @brief Prefab parameters for an articulated actor.
struct prefab::ArticulatedActorPrefab [equality, no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Optional actor name. Uniqueness is not enforced.
  //
  // @note Nested actor runtime paths use the effective actor name as the parent path, where the
  // effective actor name is this actor name combined with any enclosing @ref PrefabParams::name or
  // @ref PrefabReference::name path. If the effective actor name is empty, runtime nested actor
  // paths use "unnamed_articulation" as the parent path. Prefab actor-reference fields such as
  // contact filters and constraints are authored relative to their containing prefab, and enclosing
  // prefab-reference names are prepended during instantiation. They do not resolve through the
  // "unnamed_articulation" fallback. Use a non-empty actor name or enclosing prefab name when
  // prefab references need to target nested actors.
  // @note A name shared by more than one actor cannot be referenced by a constraint, pose
  // controller, or contact filter (see @ref PoseControllerPrefab).
  DynamicString name;

  // @brief Uniform scale baked into all link and skin shapes when the prefab is instantiated.
  //
  // @note Must be strictly positive and finite. Negative or zero scale is invalid and rejected
  // at @ref AddToScene.
  // @note This scale is not applied to @ref rotation and @ref translation. It scales each link's
  // baked shape by multiplying both @ref ArticulatedLinkPrefab::shapeScale and @ref
  // ArticulatedLinkPrefab::shapeTranslation. It also uniformly scales the skin shape.
  real scale = 1;

  // @brief Actor rotation quaternion [x, y, z, w] relative to the prefab's local frame
  // (i.e., the prefab-from-root rotation). Composes with @ref PrefabParams::rotation
  // to produce the final world-from-root rotation.
  //
  // @note Must be finite and non-zero.
  Quaternion rotation;

  // @brief Actor translation [x, y, z] relative to the prefab's local frame
  // (i.e., the prefab-from-root translation). Composes with @ref PrefabParams::scale,
  // @ref PrefabParams::rotation, and @ref PrefabParams::translation to produce the final
  // world-from-root translation.
  //
  // @note Must be finite.
  Real3 translation [units(m)];

  // @brief Cycle joints creating closed kinematic loops. Empty if no cycles exist.
  DynamicArray<ArticulatedCycleJointParams> cycles;

  // @brief Joint parameters (one per joint).
  DynamicArray<prefab::ArticulatedJointPrefab> joints;

  // @brief Link parameters (one per link).
  DynamicArray<prefab::ArticulatedLinkPrefab> links;

  // @brief Optional skinned mesh parameters.
  Optional<prefab::ArticulatedSkinPrefab> skin;

  // @brief Optional initial velocity per DoF.
  //
  // @note Units depend on joint type: [rad/s] for revolute and spherical, [m/s] for prismatic.
  Optional<DynamicArray<real>> jointVelocities;
}

// @brief Prefab parameters for a soft-skinned actor.
//
// @details A soft-skinned actor consists of an articulated skeleton with one
// or more attached soft bodies.
struct prefab::SoftSkinnedActorPrefab [no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Articulated actor parameters for the skeleton.
  prefab::ArticulatedActorPrefab skeletonParams;

  // @brief Parameters for each nested soft actor.
  //
  // @note The @ref SoftActorPrefab::rotation and @ref SoftActorPrefab::translation fields for each
  // nested soft actor are ignored. Nested soft actor transforms are determined by the skeleton's
  // link attachments (see @ref softAttachLinks).
  // @note Each nested soft actor's @ref SoftActorPrefab::scale must be uniform (three equal,
  // strictly positive, finite values). Non-uniform soft shape scale is not supported for
  // soft-skinned prefabs.
  // @note If a nested soft actor's @ref SoftActorPrefab::flowFile is set, that entry's @ref
  // SoftActorPrefab::scale must be (1, 1, 1).
  // @note Each entry's inherited name field is a nested soft local name. Explicit non-empty
  // names must be unique across skeleton link local names and other nested soft local names, and
  // must not contain forward slash, backslash, or embedded NUL characters.
  // @note Empty names are assigned deterministically after reserving all skeleton link names and
  // all explicit nested soft names: an empty entry at index `i` uses `soft_i` if available;
  // otherwise it uses the first available `soft_N` found by scanning upward from `N = 0`.
  DynamicArray<prefab::SoftActorPrefab> softParams;

  // @brief Local link names to attach each nested soft actor to. Empty or one entry per @ref
  // softParams element.
  //
  // @note If provided, each entry must be non-empty and must match a skeleton link local
  // name.
  DynamicArray<String> softAttachLinks;

  // @brief Whether links can collide with each other.
  bool enableCollidingLinks = false;

  // @brief Whether gravity is applied.
  bool hasGravity = false;

  // @brief Whether inertia is applied.
  bool hasInertia = false;

  // @brief Whether soft material stress is applied.
  bool hasStress = false;
}

// @brief Lists of actors grouped by type.
struct prefab::ActorLists [no_reflection] {
  // @brief Optional serialized comment.
  Optional<String> comment;

  // @brief Articulated actors.
  DynamicArray<prefab::ArticulatedActorPrefab> articulated;

  // @brief Rigid actors.
  DynamicArray<prefab::RigidActorPrefab> rigid;

  // @brief Soft actors.
  DynamicArray<prefab::SoftActorPrefab> soft;

  // @brief Soft-skinned actors.
  DynamicArray<prefab::SoftSkinnedActorPrefab> softSkinned;
}

// @brief Prefab parameters for a @ref RigidSphericalJointConstraintParams.
//
// @note Actor name fields use the same naming convention as @ref PoseControllerPrefab.
// "myActor" refers to an actor in this prefab. "myPrefab/myActor" refers to an actor
// in a nested prefab.
// @note A referenced actor name must identify exactly one existing actor. Actor names need not be
// unique, but referencing a name shared by more than one actor, or a name that matches no actor,
// is invalid and rejected at @ref AddToScene.
struct prefab::RigidSphericalJointConstraintPrefab(RigidSphericalJointConstraintParams) [no_reflection] {
  // @brief Name or hierarchy path identifying rigid actor A.
  String actorNameA;

  // @brief Name or hierarchy path identifying rigid actor B.
  String actorNameB;
}

