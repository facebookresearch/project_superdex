///
/// @note Only applicable to articulated actors. Sets error otherwise.
/// @note This information never changes throughout the actor's lifetime.
///
/// @see @ref mochi::ArticulatedShapeInfo "ArticulatedShapeInfo", @ref mochi::Context::GetArticulatedShapeInfo "Context::GetArticulatedShapeInfo"
///

/// @fn Span<Constraint* const> mochi::Actor::GetArticulatedJointLimitConstraints(Error& error) const
///
/// @brief Get the joint-limit constraints of the articulated actor.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of pointers to joint limit constraints.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::GetArticulatedDofLimits "GetArticulatedDofLimits"
///

/// @fn Span<ArticulatedJointFrictionParams const> mochi::Actor::GetArticulatedJointFrictionParams(Error& error) const
///
/// @brief Get the per-joint friction parameters of the articulated actor.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of friction parameters, one per joint.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::SetArticulatedJointFrictionParams "SetArticulatedJointFrictionParams", @ref mochi::ArticulatedJointFrictionParams "ArticulatedJointFrictionParams"
///

/// @fn void mochi::Actor::SetArticulatedJointFrictionParams(Span<ArticulatedJointFrictionParams const> friction, Error& error)
///
/// @brief Set the per-joint friction parameters of the articulated actor.
///
/// @param[in] friction Friction parameters, one per joint. Must be of size equal to the number of joints (matching @ref mochi::Actor::GetArticulatedJointFrictionParams "GetArticulatedJointFrictionParams"); all values must be finite and non-negative.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::GetArticulatedJointFrictionParams "GetArticulatedJointFrictionParams", @ref mochi::ArticulatedJointFrictionParams "ArticulatedJointFrictionParams"
///

/// @fn Span<real const> mochi::Actor::GetArticulatedJointInertiaParams(Error& error) const
///
/// @brief Get the per-joint inertia coefficients of the articulated actor.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of inertia coefficients, one per joint.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::SetArticulatedJointInertiaParams "SetArticulatedJointInertiaParams"
///

/// @fn void mochi::Actor::SetArticulatedJointInertiaParams(Span<real const> inertia, Error& error)
///
/// @brief Set the per-joint inertia coefficients of the articulated actor.
///
/// @param[in] inertia Inertia coefficients, one per joint. Must be of size equal to the number of joints (matching @ref mochi::Actor::GetArticulatedJointInertiaParams "GetArticulatedJointInertiaParams"); all values must be finite and non-negative.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::GetArticulatedJointInertiaParams "GetArticulatedJointInertiaParams"
///

/// @fn void mochi::Actor::GetArticulatedDofLimits(Span<Real2> outDofLimits, Error& error) const
///
/// @brief Get the limit values on all DoFs of the articulated actor.
///
/// @param[out] outDofLimits Output span for DoF limits. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Each element contains [min, max] limits for the corresponding DoF: [m] for translational DoFs and [rad] for rotational DoFs.
/// @note Unconstrained DoFs have limits of ±infinity.
///
/// @see @ref mochi::Actor::GetArticulatedJointLimitConstraints "GetArticulatedJointLimitConstraints"
///

/// @fn void mochi::Actor::GetArticulatedPose(Span<real> outPose, Error& error) const
///
/// @brief Get the pose of an articulated actor expressed as joint DoFs.
///
/// @param[out] outPose Output span for pose as joint DoFs: position [m] for translational DoFs and angle [rad] for rotational DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::SetArticulatedPoseFromJoints "SetArticulatedPoseFromJoints"
///

/// @fn void mochi::Actor::GetArticulatedLinkTransforms(Span<TransformRT> outWorldFromLinks, Error& error) const
///
/// @brief Get the pose of an articulated actor expressed as world-from-local link transforms.
///
/// @param[out] outWorldFromLinks Output span for pose as world-from-local links transforms. Must be of size equal to the number of links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::SetArticulatedPoseFromLinks "SetArticulatedPoseFromLinks", @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose"
///

/// @fn void mochi::Actor::GetArticulatedJointVelocities(Span<real> outVelocities, Error& error) const
///
/// @brief Get time derivatives of the articulated actor DoFs.
///
/// @param[out] outVelocities Output span for DoF velocities: [m/s] for translational DoFs and [rad/s] for rotational DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::SetArticulatedJointVelocities "SetArticulatedJointVelocities"
///

/// @fn void mochi::Actor::SetArticulatedPoseFromLinks(Span<TransformRT const> worldFromLinks, Error& error)
///
/// @brief Set the pose of an articulated actor from the world-from-local link transforms.
///
/// @param[in] worldFromLinks World-from-local link transforms. Must be of size equal to the number of links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Transforms are automatically projected onto valid joint space.
/// @note If the actor has a pose controller, its target pose is reset to the provided transforms and its target velocity is set to zero. Call @ref mochi::Actor::SetArticulatedTargetVelocity "SetArticulatedTargetVelocity" afterward to use a non-zero target velocity.
/// @note Does not affect the actor's velocities.
/// @note Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler in the first time step after this method is called.
///
/// @warning Round-trip error: @ref mochi::Actor::SetArticulatedPoseFromLinks "SetArticulatedPoseFromLinks" followed by @ref mochi::Actor::GetArticulatedLinkTransforms "GetArticulatedLinkTransforms" may not return identical values due to internal representation differences.
///
/// @see @ref mochi::Actor::GetArticulatedLinkTransforms "GetArticulatedLinkTransforms", @ref mochi::Actor::SetArticulatedPoseFromJoints "SetArticulatedPoseFromJoints"
///

/// @fn void mochi::Actor::SetArticulatedPoseFromJoints(Span<real const> pose, Error& error)
///
/// @brief Set the pose of an articulated actor from joint DoFs.
///
/// @param[in] pose Joint DoF values to set. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note If the actor has a pose controller, its target pose is reset to the provided pose and its target velocity is set to zero. Call @ref mochi::Actor::SetArticulatedTargetVelocity "SetArticulatedTargetVelocity" afterward to use a non-zero target velocity.
/// @note Does not affect the actor's velocities.
/// @note Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler in the first time step after this method is called.
///
/// @warning Round-trip error: @ref mochi::Actor::SetArticulatedPoseFromJoints "SetArticulatedPoseFromJoints" followed by @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose" may not return identical values due to internal representation differences.
///
/// @see @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose", @ref mochi::Actor::SetArticulatedPoseFromLinks "SetArticulatedPoseFromLinks"
///

/// @fn void mochi::Actor::SetArticulatedJointVelocities(Span<real const> velocities, Error& error)
///
/// @brief Set time derivatives of the articulated actor DoFs.
///
/// @param[in] velocities Joint DoF velocities to set. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note If the actor has a pose controller, target velocity is also set to the provided velocities.
/// @note Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler in the first time step after this method is called.
///
/// @see @ref mochi::Actor::GetArticulatedJointVelocities "GetArticulatedJointVelocities"
///

/// @fn void mochi::Actor::AddArticulatedDeltaToPose(Span<real const> pose, Span<real const> deltaDofs, Span<real> outPose, Error& error) const
///
/// @brief Add a pose delta to a pose using joint-aware composition.
///
/// @param[in] pose Base pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in] deltaDofs Pose delta to add. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[out] outPose Output pose after adding deltaDofs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Deltas cannot be simply added to poses. This function uses joint information to correctly add the delta.
/// @note Useful for adding time-stepped velocity to a reference pose.
/// @note For 3D rotations, delta values are interpreted as Lie-algebra rotation-vector increments.
/// @note For 3D rotations, angular velocity is not directly the time derivative of the rotation vector representation.
///
/// @see @ref mochi::Actor::ComputeArticulatedPoseDelta "ComputeArticulatedPoseDelta", @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose", @ref mochi::Actor::GetArticulatedPoseDistance "GetArticulatedPoseDistance"
///

/// @fn void mochi::Actor::ComputeArticulatedPoseDelta(Span<real const> poseBase, Span<real const> poseTarget, Span<real> outDeltaDofs, Error& error) const
///
/// @brief Compute the pose delta from a base pose to a target pose.
///
/// @param[in] poseBase Base pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in] poseTarget Target pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[out] outDeltaDofs Pose delta. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Deltas cannot be simply subtracted between poses. This function uses joint information to correctly subtract the delta.
///
/// @see @ref mochi::Actor::AddArticulatedDeltaToPose "AddArticulatedDeltaToPose", @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose", @ref mochi::Actor::GetArticulatedPoseDistance "GetArticulatedPoseDistance"
///

/// @fn void mochi::Actor::GetArticulatedPoseDistance(Span<real const> poseA, Span<real const> poseB, Span<real> outTransDistances, Span<real> outRotDistances, Error& error) const
///
/// @brief Compute per-joint distances between two poses.
///
/// @param[in] poseA First pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in] poseB Second pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[out] outTransDistances Translation distances [m] for each joint. Must be of size equal to the number of joints.
/// @param[out] outRotDistances Rotation distances [rad] for each joint. Must be of size equal to the number of joints.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Uses joint-specific distance metrics (Euclidean for translation, angle for rotation).
///
/// @see @ref mochi::Actor::GetArticulatedPose "GetArticulatedPose", @ref mochi::Actor::AddArticulatedDeltaToPose "AddArticulatedDeltaToPose", @ref mochi::Actor::ComputeArticulatedPoseDelta "ComputeArticulatedPoseDelta"
///

/// @fn bool mochi::Actor::HasArticulatedPoseController(Error& error) const
///
/// @brief Check if the articulated actor has a pose controller.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return True if a pose controller exists, false otherwise.
///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::AddArticulatedPoseController "AddArticulatedPoseController", @ref mochi::Actor::RemoveArticulatedPoseController "RemoveArticulatedPoseController"
///

/// @fn void mochi::Actor::AddArticulatedPoseController(PoseControllerParams const& params, Error& error)
///
/// @brief Add a pose controller to an articulated actor.
///
/// @param[in] params Parameters defining the pose controller.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Only one pose controller is allowed per actor. Adding a second controller raises an error.
/// @note The initial target pose and target velocity are set to the actor's current pose and velocity.
/// @note Empty tracking arrays are allowed. Default zero-gain parameters are used for any empty array.
///
/// @see @ref mochi::Actor::RemoveArticulatedPoseController "RemoveArticulatedPoseController", @ref mochi::Actor::HasArticulatedPoseController "HasArticulatedPoseController"
///

/// @fn void mochi::Actor::RemoveArticulatedPoseController(Error& error)
///
/// @brief Remove the pose controller.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors.
/// @note Returns an error if no pose controller exists.
///
/// @see @ref mochi::Actor::AddArticulatedPoseController "AddArticulatedPoseController", @ref mochi::Actor::HasArticulatedPoseController "HasArticulatedPoseController"
///

/// @fn void mochi::Actor::SetArticulatedTargetLinkTransforms(Span<TransformRT const> worldFromTargets, Error& error)
///
/// @brief Set the target pose for the controller expressed as link transforms.
///
/// @param[in] worldFromTargets Target world-from-link transforms to set. Must be of size equal to the number of links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only supported for articulated actors with a pose controller.
/// @note Also affects target velocity, which depends on how the target changes between simulation steps.
///
/// @see @ref mochi::Actor::ResetArticulatedTargetLinkTransforms "ResetArticulatedTargetLinkTransforms", @ref mochi::Actor::SetArticulatedTargetPose "SetArticulatedTargetPose"
///

/// @fn void mochi::Actor::SetArticulatedTargetPose(Span<real const> pose, Error& error)
///
/// @brief Set the target pose for the controller expressed as joint DoFs.
///
/// @param[in] pose Target pose as joint DoFs to set. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Also affects target velocity, which depends on how the target changes between simulation steps.
///
/// @see @ref mochi::Actor::ResetArticulatedTargetPose "ResetArticulatedTargetPose", @ref mochi::Actor::SetArticulatedTargetLinkTransforms "SetArticulatedTargetLinkTransforms", @ref mochi::Actor::GetArticulatedTargetPose "GetArticulatedTargetPose", @ref mochi::Actor::GetArticulatedTargetLinkTransforms "GetArticulatedTargetLinkTransforms", @ref mochi::Actor::SetArticulatedTargetVelocity "SetArticulatedTargetVelocity"
///

/// @fn void mochi::Actor::ResetArticulatedTargetLinkTransforms(Span<TransformRT const> worldFromTargets, Error& error)
///
/// @brief Reset the target pose of the controller expressed as link transforms.
///
/// @param[in] worldFromTargets Target world-from-link transforms to reset to. Must be finite and of size equal to the number of links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Sets the target to the provided transforms and the target velocity to zero, so no velocity kick is introduced.
/// @note To use a non-zero target velocity, call @ref mochi::Actor::SetArticulatedTargetVelocity "SetArticulatedTargetVelocity" after this function.
///
/// @see @ref mochi::Actor::SetArticulatedTargetLinkTransforms "SetArticulatedTargetLinkTransforms", @ref mochi::Actor::ResetArticulatedTargetPose "ResetArticulatedTargetPose"
///

/// @fn void mochi::Actor::ResetArticulatedTargetPose(Span<real const> pose, Error& error)
///
/// @brief Reset the target pose of the controller expressed as joint DoFs.
///
/// @param[in] pose Target pose as joint DoFs to reset to. Must be finite and of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Sets the target to the provided pose and the target velocity to zero, so no velocity kick is introduced.
/// @note To use a non-zero target velocity, call @ref mochi::Actor::SetArticulatedTargetVelocity "SetArticulatedTargetVelocity" after this function.
///
/// @see @ref mochi::Actor::SetArticulatedTargetPose "SetArticulatedTargetPose", @ref mochi::Actor::ResetArticulatedTargetLinkTransforms "ResetArticulatedTargetLinkTransforms"
///

/// @fn void mochi::Actor::SetArticulatedTargetVelocity(Span<real const> velocity, Error& error)
///
/// @brief Set the target velocity of the controller expressed as joint velocities for the next simulation step.
///
/// @param[in] velocity Target DoF velocities to set. [m/s] for translational DoFs and [rad/s] for rotational DoFs. Must be finite and of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Does not change target pose.
/// @note The velocity override is applied once at the start of the next simulation step to compute damping, then cleared automatically. To maintain a constant target velocity, call this function before each step.
/// @note @ref mochi::Actor::ResetArticulatedTargetPose "ResetArticulatedTargetPose" and @ref mochi::Actor::ResetArticulatedTargetLinkTransforms "ResetArticulatedTargetLinkTransforms" overwrite any pending target velocity with zero. Call this function after reset to use a non-zero target velocity.
///
/// @see @ref mochi::Actor::SetArticulatedTargetPose "SetArticulatedTargetPose", @ref mochi::Actor::ResetArticulatedTargetPose "ResetArticulatedTargetPose"
///

/// @fn Span<PoseConstraintInfo const> mochi::Actor::GetArticulatedPoseConstraints(Error& error) const
///
/// @brief Get the pose controller's constraints.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of pose constraint information.
///
/// @note Only applicable to articulated actors with a pose controller.
///
/// @see @ref mochi::PoseConstraintInfo "PoseConstraintInfo", @ref mochi::Actor::GetArticulatedPoseControllerParams "GetArticulatedPoseControllerParams", @ref mochi::Actor::SetArticulatedPoseControllerParams "SetArticulatedPoseControllerParams"
///

/// @fn void mochi::Actor::GetArticulatedPoseControllerParams(PoseControllerParams& outParams, Error& error) const
///
/// @brief Get the pose controller's tracking parameters.
///
/// @param[in,out] outParams Output tracking parameters grouped by constraint type (@ref mochi::PoseControllerParams::linkPosTracking "PoseControllerParams::linkPosTracking", @ref mochi::PoseControllerParams::linkRotTracking "PoseControllerParams::linkRotTracking", @ref mochi::PoseControllerParams::jointTracking "PoseControllerParams::jointTracking"). All three arrays are link-indexed and must be pre-sized to numLinks; they are not resized. Entries in @ref mochi::PoseControllerParams::jointTracking "PoseControllerParams::jointTracking" for links without a controllable joint are reported as zero gains.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
///
/// @see @ref mochi::Actor::GetArticulatedPoseConstraints "GetArticulatedPoseConstraints", @ref mochi::Actor::SetArticulatedPoseControllerParams "SetArticulatedPoseControllerParams"
///

/// @fn void mochi::Actor::SetArticulatedPoseControllerParams(PoseControllerParams const& params, Error& error)
///
/// @brief Set the pose controller's tracking parameters.
///
/// @param[in] params Tracking parameters grouped by constraint type. Each array must be empty, size 1 (broadcast to all links), or size numLinks (per-link). An empty array will broadcast using a default-constructed PoseTrackingParams (zero gains) to all links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Setting zero stiffness and damping disables the constraint but does not destroy it.
///
/// @see @ref mochi::Actor::GetArticulatedPoseControllerParams "GetArticulatedPoseControllerParams", @ref mochi::Actor::GetArticulatedPoseConstraints "GetArticulatedPoseConstraints"
///

/// @fn void mochi::Actor::GetArticulatedTargetPose(Span<real> outPose, Error& error) const
///
/// @brief Get the last target pose set to the pose controller.
///
/// @param[out] outPose Output span for the target pose as joint DoFs. Must be of size @ref mochi::Actor::GetNumDofs "GetNumDofs".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
///
/// @see @ref mochi::Actor::SetArticulatedTargetPose "SetArticulatedTargetPose", @ref mochi::Actor::SetArticulatedTargetLinkTransforms "SetArticulatedTargetLinkTransforms", @ref mochi::Actor::GetArticulatedTargetLinkTransforms "GetArticulatedTargetLinkTransforms"
///

/// @fn void mochi::Actor::GetArticulatedTargetLinkTransforms(Span<TransformRT> outWorldFromTargets, Error& error) const
///
/// @brief Get the last target pose set to the pose controller, expressed as link transforms.
///
/// @param[out] outWorldFromTargets Output span for the target world-from-link transforms. Must be of size equal to the number of links.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to articulated actors with a pose controller.
///
/// @see @ref mochi::Actor::SetArticulatedTargetPose "SetArticulatedTargetPose", @ref mochi::Actor::SetArticulatedTargetLinkTransforms "SetArticulatedTargetLinkTransforms", @ref mochi::Actor::GetArticulatedTargetPose "GetArticulatedTargetPose"
///

/// @fn Span<real const> mochi::Actor::GetArticulatedControllerForce(Error& error) const
///
/// @brief Get the generalized forces applied by the pose controller on each joint DoF.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Flattened generalized-force vector for each joint DoF. Size equals @ref mochi::Actor::GetNumDofs "GetNumDofs". Units are [N] for translational DoFs and [N·m] for rotational DoFs.
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Requires registering @ref mochi::QueryType::ArticulatedControllerForce "QueryType::ArticulatedControllerForce" before the simulation step. Results are available after the simulation step completes.
/// @note Requires the actor to support @ref mochi::QueryType::ArticulatedControllerForce "QueryType::ArticulatedControllerForce".
/// @note Equivalent to using @ref mochi::QueryType::ConstraintForce "QueryType::ConstraintForce" on each of the pose controller's constraints and projecting the constraint forces through the link Jacobians to joint DoF space (i.e., Σ Jᵢᵀ · fᵢ for each pose constraint i).
/// @note If the solver diverged in the last simulation step, the returned generalized forces may be stale.
///
/// @see @ref mochi::Actor::RegisterQuery "RegisterQuery", @ref mochi::QueryType::ArticulatedControllerForce "QueryType::ArticulatedControllerForce"
///

/// @fn bool mochi::Actor::IsNestedLinkActor() const
///
/// @brief Check if the actor is a rigid link within an articulated actor.
///
/// @return True if the actor is a nested link actor, false otherwise.
///
/// @see @ref mochi::Actor::GetNestedLinkActors "GetNestedLinkActors", @ref mochi::Actor::GetArticulatedActor "GetArticulatedActor"
///

/// @fn bool mochi::Actor::IsNestedSoftActor() const
///
/// @brief Check if the actor is a soft actor nested within a soft skinned articulated actor.
///
/// @return True if the actor is a nested soft actor, false otherwise.
///
/// @see @ref mochi::Actor::GetNestedSoftActors "GetNestedSoftActors", @ref mochi::Actor::GetArticulatedActor "GetArticulatedActor"
///

/// @fn ActorHandle mochi::Actor::GetArticulatedActor(Error& error) const
///
/// @brief Get the owning articulated actor.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Handle to the owning articulated actor.
///
/// @note Only applicable to nested link or nested soft actors within articulated actors.
///
/// @see @ref mochi::Actor::IsNestedLinkActor "IsNestedLinkActor", @ref mochi::Actor::GetNestedLinkActors "GetNestedLinkActors", @ref mochi::Actor::IsNestedSoftActor "IsNestedSoftActor", @ref mochi::Actor::GetNestedSoftActors "GetNestedSoftActors"
///

/// @fn Span<real const> mochi::Actor::GetArticulatedJacobian(Error& error) const
///
/// @brief Get the Jacobian with respect to the articulated DoFs in world frame.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Jacobian matrix in row-major order with shape [6, numArticulatedDoFs], where 6 is the number of rigid DoFs of the link (3 translation + 3 rotation) and numArticulatedDoFs is @ref mochi::Actor::GetNumDofs "GetNumDofs" of the owning articulated actor.
///
/// @note Only applicable to nested link actors within articulated actors.
/// @note To get the Jacobian in the articulation's root frame, left-multiply the Jacobian by the 6×6 block-diagonal of the root-from-world rotation:
///
/// @code
/// [ R  0 ] · J
/// [ 0  R ]
/// @endcode
///
/// where R is the 3×3 root-from-world rotation matrix (i.e., the transpose of the owning articulated actor's world-from-root rotation).
///
/// @see @ref mochi::Actor::IsNestedLinkActor "IsNestedLinkActor"
///

/// @class mochi::Constraint
///
/// @brief Represents a constraint that restricts the degrees of freedom of one or more actors.
///
/// @details Constraints enforce relationships between actor degrees of freedom (DoFs), such as fixing positions, limiting joint angles, or tracking target poses. They apply forces to maintain desired configurations using spring-damper mechanics controlled by stiffness and damping parameters.
///
/// @note Each constraint belongs to exactly one scene.
/// @note Each constraint acts on the degrees of freedom of one or more actors.
/// @note The type of constraint determines which methods are applicable.
///
/// @warning Concurrent access to a constraint is illegal.
///

/// @fn ConstraintType mochi::Constraint::GetType() const
///
/// @brief Get the type of the constraint.
///
/// @return Type of the constraint.
///
/// @note Some methods are only valid for certain constraint types.
///
/// @see @ref mochi::ConstraintType "ConstraintType"
///

/// @fn ConstraintHandle mochi::Constraint::GetHandle() const
///
/// @brief Get the handle associated with this constraint.
///
/// @return Handle to this constraint.
///
/// @note Handles are safe to store and remain valid throughout the constraint lifespan.
/// @note Call @ref mochi::Scene::GetConstraint "Scene::GetConstraint" to look up the constraint's pointer from the constraint's handle.
///
/// @see @ref mochi::Scene::GetConstraint "Scene::GetConstraint"
///

/// @fn real mochi::Constraint::GetStiffness() const
///
/// @brief Get the constraint's stiffness parameter.
///
/// @return Stiffness value. [N/m] for translation constraints, [N·m/rad] for rotation constraints.
///
/// @note Higher stiffness results in stronger constraint forces/torques.
///
/// @see @ref mochi::Constraint::SetStiffness "SetStiffness", @ref mochi::Constraint::GetDamping "GetDamping", @ref mochi::Constraint::GetSaturation "GetSaturation"
///

/// @fn void mochi::Constraint::SetStiffness(real stiffness, Error& error)
///
/// @brief Set the constraint's stiffness parameter.
///
/// @param[in] stiffness Stiffness value. [N/m] for translation constraints, [N·m/rad] for rotation constraints. Must be non-negative and finite.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Constraint::GetStiffness "GetStiffness", @ref mochi::Constraint::SetDamping "SetDamping", @ref mochi::Constraint::SetSaturation "SetSaturation"
///

/// @fn real mochi::Constraint::GetDamping() const
///
/// @brief Get the constraint's damping parameter.
///
/// @return Damping value. [N·s/m] for translation constraints, [N·m·s/rad] for rotation constraints.
///
/// @see @ref mochi::Constraint::SetDamping "SetDamping", @ref mochi::Constraint::GetStiffness "GetStiffness", @ref mochi::Constraint::GetSaturation "GetSaturation"
///

/// @fn void mochi::Constraint::SetDamping(real damping, Error& error)
///
/// @brief Set the constraint's damping parameter.
///
/// @param[in] damping Damping value. [N·s/m] for translation constraints, [N·m·s/rad] for rotation constraints. Must be non-negative and finite.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Constraint::GetDamping "GetDamping", @ref mochi::Constraint::SetStiffness "SetStiffness", @ref mochi::Constraint::SetSaturation "SetSaturation"
///

/// @fn real mochi::Constraint::GetSaturation() const
///
/// @brief Get the constraint's saturation parameter.
///
/// @return Saturation distance [m] for translation constraints or angle [rad] for rotation constraints, or a negative value if saturation is disabled.
///
/// @note A positive value smoothly limits the magnitude of the elastic (stiffness) contribution to stiffness * saturation. The damping contribution is separate and is not limited by saturation.
///
/// @see @ref mochi::Constraint::SetSaturation "SetSaturation", @ref mochi::Constraint::GetStiffness "GetStiffness", @ref mochi::Constraint::GetDamping "GetDamping"
///

/// @fn void mochi::Constraint::SetSaturation(real saturation, Error& error)
///
/// @brief Set the constraint's saturation parameter.
///
/// @param[in] saturation Saturation distance [m] for translation constraints or angle [rad] for rotation constraints, or any negative value to disable saturation. Must be finite and non-zero.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note A positive value smoothly limits the magnitude of the elastic (stiffness) contribution to stiffness * saturation. The damping contribution is separate and is not limited by saturation.
///
/// @see @ref mochi::Constraint::GetSaturation "GetSaturation", @ref mochi::Constraint::SetStiffness "SetStiffness", @ref mochi::Constraint::SetDamping "SetDamping"
///

/// @fn DynamicArray<real> mochi::Constraint::GetDeviation() const
///
/// @brief Compute the constraint's current deviation from its target, limits, or coupling condition.
///
/// @return Vector of constraint deviation values, one per constraint dimension. Units: [m] for translation constraints or [rad] for rotation constraints. Size equals the number of scalar constraint equations (e.g., 3 for position/rotation pivots and joints, 1 for single-DoF range/target constraints).
///
/// @note For constraints with targets: deviation is the distance/angle error from target.
/// @note For constraints with range limits: deviation indicates how far the current value is from the valid range.
/// @note For coupling constraints without a target or range: deviation is the constraint violation, i.e. how far the coupling is from being satisfied (zero when exactly satisfied).
///

/// @fn Span<real const> mochi::Constraint::GetForce(Error& error) const
///
/// @brief Get the force/torque applied by the constraint.
///
/// @details Values are ordered first by actor (in the order returned by @ref mochi::Constraint::GetActor "GetActor"), then by DoF within each actor (in the order returned by @ref mochi::Constraint::GetDofIndicesForActor "GetDofIndicesForActor"). Each entry has units conjugate to its DoF: [N] for translational DoFs and [N·m] for rotational DoFs (so a single returned vector may mix both, e.g. for @ref mochi::ConstraintType::RigidPivotPosition "ConstraintType::RigidPivotPosition" the 6 entries are 3 force [N] followed by 3 torque [N·m] components on the rigid actor).
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Flattened generalized-force vector. One entry per constrained DoF.
///
/// @note Requires registering @ref mochi::QueryType::ConstraintForce "QueryType::ConstraintForce" before the simulation step. Results are available after the simulation step completes.
/// @note If the solver diverged in the last simulation step, the returned force may be inaccurate.
///
/// @see @ref mochi::Constraint::RegisterQuery "RegisterQuery", @ref mochi::QueryType::ConstraintForce "QueryType::ConstraintForce", @ref mochi::Constraint::GetDofIndicesForActor "GetDofIndicesForActor"
///

/// @fn int mochi::Constraint::GetNumActors() const
///
/// @brief Get the number of actors affected by the constraint.
///
/// @return Number of actors affected by the constraint.
///

/// @fn Actor* mochi::Constraint::GetActor(int actorIndex)
///
/// @brief Get one of the actors affected by this constraint.
///
/// @param[in] actorIndex Actor index in the range [0, @ref mochi::Constraint::GetNumActors "GetNumActors").
/// @return Pointer to the actor.
///
/// @see @ref mochi::Constraint::GetNumActors "GetNumActors"
///

/// @fn Actor const* mochi::Constraint::GetActor(int actorIndex) const
///
/// @brief Get read-only access to one of the actors affected by this constraint.
///
/// @param[in] actorIndex Actor index in the range [0, @ref mochi::Constraint::GetNumActors "GetNumActors").
/// @return Const pointer to the actor.
///
/// @see @ref mochi::Constraint::GetNumActors "GetNumActors"
///

/// @fn Span<int const> mochi::Constraint::GetDofIndicesForActor(int actorIndex) const
///
/// @brief Get the degrees of freedom (DoF) indices affected by this constraint on a specific actor.
///
/// @param[in] actorIndex Actor index in the range [0, @ref mochi::Constraint::GetNumActors "GetNumActors").
/// @return Span of DoF indices for the specified actor.
///
/// @see @ref mochi::Constraint::GetNumActors "GetNumActors", @ref mochi::Constraint::GetActor "GetActor"
///

/// @fn void mochi::Constraint::SetTargetPosition(Real3 const& position, Error& error)
///
/// @brief Set the constraint's target position in world frame.
///
/// @param[in] position Target position [m] in world frame. Must be finite.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to position-target constraints: @ref mochi::ConstraintType::RigidPivotPosition "ConstraintType::RigidPivotPosition", @ref mochi::ConstraintType::DeformableNodePosition "ConstraintType::DeformableNodePosition", and @ref mochi::ConstraintType::RigidPivotToRigidTarget "ConstraintType::RigidPivotToRigidTarget". For @ref mochi::ConstraintType::RigidPivotToRigidTarget "ConstraintType::RigidPivotToRigidTarget", this updates only the translation of the target center-of-mass transform.
/// @note Also affects target velocity, which depends on the difference between current and old target position.
///
/// @see @ref mochi::Constraint::SetTargetRotation "SetTargetRotation", @ref mochi::Constraint::SetTargetDof "SetTargetDof"
///

/// @fn void mochi::Constraint::SetTargetRotation(Quaternion const& rotation, Error& error)
///
/// @brief Set the constraint's target rotation.
///
/// @details The target is interpreted according to the constraint type. For @ref mochi::ConstraintType::RigidPivotRotation "ConstraintType::RigidPivotRotation", it is the target pivot-frame rotation in world coordinates. For @ref mochi::ConstraintType::RigidPivotToRigidTarget "ConstraintType::RigidPivotToRigidTarget", it is the rotation of the target center-of-mass transform in world coordinates. For @ref mochi::ConstraintType::Articulated3dRotationTarget "ConstraintType::Articulated3dRotationTarget", it is the target joint-local rotation. For @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking", it is the target rotation of @ref mochi::JointRotationTrackingConstraintParams::actorB "JointRotationTrackingConstraintParams::actorB" relative to @ref mochi::JointRotationTrackingConstraintParams::actorA "JointRotationTrackingConstraintParams::actorA". For @ref mochi::ConstraintType::RodElementRotationToRigid "ConstraintType::RodElementRotationToRigid", it is the target rotation of the constrained rod element relative to the rigid actor.
///
/// @param[in] rotation Target rotation quaternion [x, y, z, w]. Must be finite and non-zero. Normalized before use.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Also affects target velocity, which depends on the difference between current and old target rotation.
///
/// @see @ref mochi::Constraint::SetTargetPosition "SetTargetPosition", @ref mochi::Constraint::SetTargetDof "SetTargetDof", @ref mochi::Constraint::SetRefRelativeRotation "SetRefRelativeRotation"
///

/// @fn void mochi::Constraint::SetTargetDof(real target, Error& error)
///
/// @brief Set the constraint's target DoF.
///
/// @param[in] target Target DoF value. Units: [m] for translation DoFs, [rad] for rotation DoFs.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to @ref mochi::ConstraintType::ArticulatedSingleDofTarget "ConstraintType::ArticulatedSingleDofTarget".
/// @note Also affects target velocity, which depends on the difference between current and old target DoF.
///
/// @see @ref mochi::Constraint::SetTargetPosition "SetTargetPosition", @ref mochi::Constraint::SetTargetRotation "SetTargetRotation"
///

/// @fn void mochi::Constraint::UpdateOldTarget(Error& error)
///
/// @brief Update the old target to match the current target.
///
/// @details Call this method after changing a target discontinuously, and before stepping the scene, to prevent that change from contributing to damping during the next simulation step.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to constraints with a target.
///

/// @fn void mochi::Constraint::SetRefRelativeRotation(Quaternion const& rotationA, Quaternion const& rotationB, Error& error)
///
/// @brief Set a relative-rotation target from two rotations expressed in a common frame.
///
/// @details Sets the target to inverse(@p rotationA) * @p rotationB.
///
/// @param[in] rotationA First rotation. Represents @ref mochi::JointRotationTrackingConstraintParams::actorA "JointRotationTrackingConstraintParams::actorA" for @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking" and the rigid actor for @ref mochi::ConstraintType::RodElementRotationToRigid "ConstraintType::RodElementRotationToRigid". Must be finite and non-zero. Normalized before use.
/// @param[in] rotationB Second rotation. Represents @ref mochi::JointRotationTrackingConstraintParams::actorB "JointRotationTrackingConstraintParams::actorB" for @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking" and the selected rod element for @ref mochi::ConstraintType::RodElementRotationToRigid "ConstraintType::RodElementRotationToRigid". Must be finite and non-zero. Normalized before use.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Only applicable to @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking" and @ref mochi::ConstraintType::RodElementRotationToRigid "ConstraintType::RodElementRotationToRigid".
/// @note Also affects target velocity, which depends on the difference between current and old target relative rotation.
///
/// @see @ref mochi::Constraint::SetTargetRotation "SetTargetRotation", @ref mochi::Constraint::UpdateOldTarget "UpdateOldTarget"
///

/// @fn Span<real const> mochi::Constraint::GetLimitMinValues(Error& error) const
///
/// @brief Get the constraint's minimum limit values.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of minimum values for each constrained DoF. Units: [m] for translation DoFs, [rad] for rotation DoFs.
///
/// @note Only applicable to range-based constraints (@ref mochi::ConstraintType::ArticulatedSingleDofRange "ConstraintType::ArticulatedSingleDofRange", @ref mochi::ConstraintType::Articulated3dRotationRange "ConstraintType::Articulated3dRotationRange", @ref mochi::ConstraintType::JointRotationRange "ConstraintType::JointRotationRange").
///
/// @see @ref mochi::Constraint::GetLimitMaxValues "GetLimitMaxValues"
///

/// @fn Span<real const> mochi::Constraint::GetLimitMaxValues(Error& error) const
///
/// @brief Get the constraint's maximum limit values.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Span of maximum values for each constrained DoF. Units: [m] for translation DoFs, [rad] for rotation DoFs.
///
/// @note Only applicable to range-based constraints (@ref mochi::ConstraintType::ArticulatedSingleDofRange "ConstraintType::ArticulatedSingleDofRange", @ref mochi::ConstraintType::Articulated3dRotationRange "ConstraintType::Articulated3dRotationRange", @ref mochi::ConstraintType::JointRotationRange "ConstraintType::JointRotationRange").
///
/// @see @ref mochi::Constraint::GetLimitMinValues "GetLimitMinValues"
///

/// @fn QueryHandle mochi::Constraint::RegisterQuery(QueryType type, Error& error)
///
/// @brief Register a query to compute data for this constraint.
///
/// @param[in] type Type of query to register.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return @ref mochi::QueryHandle "QueryHandle" for the registered query.
///
/// @note Queries may add substantial computational overhead. Use only when necessary.
/// @note Data becomes available after the next simulation step (even if the time-step is zero).
/// @note Call @ref mochi::Constraint::CancelQuery "CancelQuery" when the query is not needed again in the future.
/// @note Queries are reference counted internally, so they will be available as long as there is one outstanding @ref mochi::QueryHandle "QueryHandle".
///
/// @see @ref mochi::Constraint::CancelQuery "CancelQuery", @ref mochi::Constraint::IsQuerySupported "IsQuerySupported", @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery"
///

/// @fn void mochi::Constraint::CancelQuery(QueryHandle handle)
///
/// @brief Cancel a previously registered query.
///
/// @param[in] handle @ref mochi::QueryHandle "QueryHandle" from a previous @ref mochi::Constraint::RegisterQuery "RegisterQuery" call.
///
/// @note Cancelling queries may improve memory usage and/or performance if the query is no longer needed.
///
/// @see @ref mochi::Constraint::RegisterQuery "RegisterQuery", @ref mochi::Actor::CancelQuery "Actor::CancelQuery"
///

/// @fn bool mochi::Constraint::IsQuerySupported(QueryType type) const
///
/// @brief Check whether a query type is supported for this constraint.
///
/// @param[in] type Type of query to check.
/// @return True if @ref mochi::Constraint::RegisterQuery "RegisterQuery" would succeed for this query type, false otherwise.
///
/// @see @ref mochi::Constraint::RegisterQuery "RegisterQuery"
///

/// @class mochi::Scene
///
/// @brief Represents a simulation scene.
///
/// @note Each scene manages the simulation of a series of actors.
/// @note Actors from different scenes do not interact with each other.
///
/// @warning Concurrent access to the scene and its actors and constraints is illegal.
///

/// @fn Context* mochi::Scene::GetContext()
///
/// @brief Get the @ref mochi::Context "Context" that owns this scene.
///
/// @return Pointer to the @ref mochi::Context "Context" that owns this scene.
///

/// @fn Context const* mochi::Scene::GetContext() const
///
/// @brief Get read-only access to the @ref mochi::Context "Context" that owns this scene.
///
/// @return Const pointer to the @ref mochi::Context "Context" that owns this scene.
///

/// @fn SceneHandle mochi::Scene::GetHandle() const
///
/// @brief Get the scene handle.
///
/// @return Scene's handle.
///
/// @note Handles are safe to store and remain valid throughout the scene lifespan.
/// @note Call @ref mochi::Context::GetScene "Context::GetScene" to look up the scene's pointer from the scene's handle.
///
/// @see @ref mochi::Context::GetScene "Context::GetScene"
///

/// @fn char const* mochi::Scene::GetName() const
///
/// @brief Get the name of the scene.
///
/// @return Name of the scene.
///

/// @fn Real3 mochi::Scene::GetGravity() const
///
/// @brief Get the gravity vector in world frame.
///
/// @return Gravity vector [m/s^2] in world frame.
///
/// @see @ref mochi::Scene::SetGravity "SetGravity"
///

/// @fn void mochi::Scene::SetGravity(Real3 const& gravity)
///
/// @brief Set the gravity vector in world frame.
///
/// @param[in] gravity Gravity vector [m/s^2] in world frame.
///
/// @see @ref mochi::Scene::GetGravity "GetGravity"
///

/// @fn SolverParams mochi::Scene::GetSolverParams() const
///
/// @brief Get the solver parameters.
///
/// @return Current solver parameters.
///
/// @see @ref mochi::Scene::SetSolverParams "SetSolverParams"
///

/// @fn void mochi::Scene::SetSolverParams(SolverParams const& params, Error& error)
///
/// @brief Set the solver parameters.
///
/// @param[in] params Solver parameters to set.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Scene::GetSolverParams "GetSolverParams", @ref mochi::SolverParams "SolverParams"
///

/// @fn void mochi::Scene::Step(double timeStepSec)
///
/// @brief Advance the simulation of the @ref mochi::Scene "Scene" one step.
///
/// @details SuperDex Physics uses fully-implicit time integration, enabling substantially larger stable time steps than physics engines using explicit or semi-implicit methods, particularly for stiff systems. Fewer steps per simulated second often improve simulation performance and real-time factor.
///
/// @param[in] timeStepSec Time step size [s]. Must be non-negative.
///
/// @note Time steps of 10–25 ms (40–100 physics steps per simulated second) run robustly in most scenes, including complex contact-rich and deformable simulations. This is a practical starting range, not a guarantee. Smaller steps may still be required to resolve fast motion, accurately capture short-duration contact dynamics without excessive numerical dissipation, resolve dynamics associated with small geometric or discretization length scales, or improve nonlinear-solver convergence.
/// @note It is OK to use a different time step each time.
/// @note If the time step is zero, then the state of the simulation will not change, but pre-step and post-step callbacks will still be called, and queries will be updated.
/// @note If the time step is negative or NaN, no step is taken and an error is logged.
///
/// @see @ref mochi::IntegrationMethod "IntegrationMethod"
///

/// @fn double mochi::Scene::GetLastTimeStep() const
///
/// @brief Returns the time step size [s] from the most recent positive call to @ref mochi::Scene::Step "Step".
///
/// @return The time step size [s] from the most recent positive @ref mochi::Scene::Step "Step" call.
///
/// @note In a newly created scene, the return value is unspecified until the first positive @ref mochi::Scene::Step "Step" call.
/// @note @ref mochi::Scene::RestoreState "RestoreState" and @ref mochi::Scene::RestoreStateFromBytes "RestoreStateFromBytes" restore this value from the captured state.
/// @note Calling @ref mochi::Scene::Step "Step" with a zero time step (e.g. to refresh queries without advancing the simulation) does not update this value (i.e. it retains the value from the last positive time step).
///

/// @fn double mochi::Scene::GetTotalSimulationTime() const
///
/// @brief Returns the total simulation time [s] in the scene.
///
/// @return The total simulation time [s].
///
/// @note May not match the real-time that has elapsed.
///

/// @fn SolverStats mochi::Scene::GetSolverStats() const
///
/// @brief Get solver convergence metrics from the last simulation step.
///
/// @return The @ref mochi::SolverStats "SolverStats" from the last simulation step.
///
/// @see @ref mochi::SolverStats "SolverStats", @ref mochi::Actor::GetConvergenceStatus "Actor::GetConvergenceStatus"
///

/// @fn PerformanceStats mochi::Scene::GetPerformanceStats() const
///
/// @brief Get timing and profiling metrics from the last simulation step.
///
/// @return The @ref mochi::PerformanceStats "PerformanceStats" from the last simulation step.
///
/// @see @ref mochi::PerformanceStats "PerformanceStats"
///

/// @fn void mochi::Scene::SetForceSingleIsland(bool forceSingleIsland)
///
/// @brief Enables/disables forcing all actors in the scene to be in a single simulation island.
///
/// @details An island is a group of actors and constraints that are solved together. Islands are managed automatically based on proximity and other factors. Islands can be solved in parallel, which can greatly improve the performance of the scene. However, if you suspect that island partitioning might be causing a problem, then you can use this function to force all actors in the scene to be simulated in a single island.
///
/// @param[in] forceSingleIsland Whether to force all actors to be in a single simulation island.
///
/// @warning Forcing single-island is a debugging feature. It will hurt performance.
///
/// @see @ref mochi::Scene::GetForceSingleIsland "GetForceSingleIsland"
///

/// @fn bool mochi::Scene::GetForceSingleIsland() const
///
/// @brief Get whether all actors are forced to be in a single simulation island.
///
/// @return True if all actors are forced into a single simulation island.
///
/// @see @ref mochi::Scene::SetForceSingleIsland "SetForceSingleIsland"
///

/// @fn StateHandle mochi::Scene::CaptureState(Error& error)
///
/// @brief Capture the simulation state that changes from step to step for later restoration.
///
/// @details Captured state includes actor solution, transforms, and velocities; current and previous constraint/controller targets; and external forces.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return @ref mochi::StateHandle "StateHandle" to be used with @ref mochi::Scene::RestoreState "RestoreState". Call @ref mochi::Scene::ReleaseState "ReleaseState" or @ref mochi::Scene::ReleaseAllStates "ReleaseAllStates" when you're done with it.
///
/// @warning Not supported for scenes with ROM actors.
///
/// @see @ref mochi::Scene::RestoreState "RestoreState", @ref mochi::Scene::ReleaseState "ReleaseState", @ref mochi::Scene::ReleaseAllStates "ReleaseAllStates", @ref mochi::Scene::CaptureStateToFile "CaptureStateToFile", @ref mochi::Scene::CaptureStateToBytes "CaptureStateToBytes"
///

/// @fn void mochi::Scene::RestoreState(StateHandle handle, bool releaseImmediately, Error& error)
///
/// @brief Restore captured simulation state. Optionally release the @ref mochi::StateHandle "StateHandle" at the same time.
///
/// @param[in] handle @ref mochi::StateHandle "StateHandle" from a successful call to @ref mochi::Scene::CaptureState "CaptureState".
/// @param[in] releaseImmediately If true, release the state handle immediately (as if @ref mochi::Scene::ReleaseState "ReleaseState" were called), even if the restore fails.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note The @ref mochi::StateHandle "StateHandle" must have been captured from this @ref mochi::Scene "Scene".
/// @note The scene composition (actors, constraints) must be the same as when the state was captured.
///
/// @warning Does not create or destroy actors or constraints, or restore shapes, materials, or scene parameters. Captured mutable state on existing actors, including static actor transforms, is restored; if topology or persistent configuration changes, simulation results may differ.
/// @warning Restoration is not transactional. If restoration fails, the scene may be partially modified. Restore a known-good checkpoint or recreate the scene before continuing.
///
/// @see @ref mochi::Scene::CaptureState "CaptureState", @ref mochi::Scene::ReleaseState "ReleaseState", @ref mochi::Scene::ReleaseAllStates "ReleaseAllStates", @ref mochi::Scene::RestoreStateFromBytes "RestoreStateFromBytes"
///

/// @fn void mochi::Scene::CaptureStateToBytes(DynamicArray<uint8_t>& outData, Error& error)
///
/// @brief Capture simulation state to a binary byte buffer.
///
/// @details Captures the same simulation state as @ref mochi::Scene::CaptureState "CaptureState", but writes the binary representation to caller-owned memory instead of storing it internally. This is useful for transferring state between processes or caching state outside the scene.
///
/// @param[in,out] outData Output byte buffer. Capture data is appended to the buffer.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note On failure, the output buffer may contain a partial capture. Discard the buffer or truncate it to its original size before reuse.
///
/// @warning Has the same capture restrictions as @ref mochi::Scene::CaptureState "CaptureState", including no support for scenes with ROM actors.
/// @warning The binary representation uses an internal capture format. It is intended only for compatible scenes with the same actors and constraints created in the same order and the same component layouts, using the same SuperDex Physics build. It is not a stable long-term serialization or asset interchange format.
///
/// @see @ref mochi::Scene::RestoreStateFromBytes "RestoreStateFromBytes", @ref mochi::Scene::CaptureState "CaptureState", @ref mochi::Scene::CaptureStateToFile "CaptureStateToFile"
///

/// @fn void mochi::Scene::RestoreStateFromBytes(Span<uint8_t const> data, Error& error)
///
/// @brief Restore simulation state from a binary byte buffer produced by @ref mochi::Scene::CaptureStateToBytes "CaptureStateToBytes".
///
/// @param[in] data State data from a successful call to @ref mochi::Scene::CaptureStateToBytes "CaptureStateToBytes".
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note The byte buffer must have been captured from this or a compatible scene via @ref mochi::Scene::CaptureStateToBytes "CaptureStateToBytes".
/// @note The capture and restore scenes must use the same SuperDex Physics build.
/// @note The restore requirements from @ref mochi::Scene::RestoreState "RestoreState" apply, including scene composition (actors, constraints) being the same as when the state was captured.
///
/// @warning Has the same restore scope and non-transactional failure behavior as @ref mochi::Scene::RestoreState "RestoreState".
///
/// @see @ref mochi::Scene::CaptureStateToBytes "CaptureStateToBytes", @ref mochi::Scene::RestoreState "RestoreState"
///

/// @fn void mochi::Scene::ReleaseState(StateHandle handle)
///
/// @brief Release a @ref mochi::StateHandle "StateHandle" when you are done with it. This frees up memory.
///
/// @param[in] handle @ref mochi::StateHandle "StateHandle" to release.
///
/// @note Redundant calls to ReleaseState will be ignored.
///

/// @fn void mochi::Scene::ReleaseAllStates()
///
/// @brief Release memory for all captured state and invalidate all prior @ref mochi::StateHandle "StateHandle" objects.
///

/// @fn bool mochi::Scene::IsEqualState(StateHandle stateA, StateHandle stateB) const
///
/// @brief Return true if both StateHandles are valid and refer to identical state information (full precision).
///
/// @param[in] stateA First StateHandle to compare
/// @param[in] stateB Second StateHandle to compare
/// @return True if both states are valid and identical.
///

/// @fn void mochi::Scene::CaptureStateToFile(std::string_view filePath, Error& error)
///
/// @brief Captures a snapshot of the state of a @ref mochi::Scene "Scene", similar to @ref mochi::Scene::CaptureState "Scene::CaptureState", then writes the data to a JSON file for manual inspection.
///
/// @param[in] filePath Path of the output file to write/overwrite (case sensitive on some filesystems).
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @warning Not supported for scenes with ROM actors.
///
/// @see @ref mochi::Scene::CaptureState "Scene::CaptureState"
///

/// @fn Actor* mochi::Scene::CreateRigidActor(RigidActorParams const& params, Error& error)
///
/// @brief Create a rigid body actor.
///
/// @param[in] params Parameters defining the rigid actor.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Pointer to the created @ref mochi::Actor "Actor", or nullptr on error.
///
/// @see @ref mochi::RigidActorParams "RigidActorParams", @ref mochi::Scene::DestroyActor "DestroyActor"
///

/// @fn Actor* mochi::Scene::CreateSoftActor(SoftActorParams const& params, Error& error)
///
/// @brief Create a soft deformable actor.
///
/// @param[in] params Parameters defining the soft actor.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Pointer to the created @ref mochi::Actor "Actor", or nullptr on error.
///
/// @see @ref mochi::SoftActorParams "SoftActorParams", @ref mochi::Scene::DestroyActor "DestroyActor"
///

/// @fn Actor* mochi::Scene::CreateArticulatedActor(ArticulatedActorParams const& params, Error& error)
///
/// @brief Create an articulated actor.
///
/// @param[in] params Parameters defining the articulated actor.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Pointer to the created @ref mochi::Actor "Actor", or nullptr on error.
///
/// @note To access nested link actors, use @ref mochi::Actor::GetNestedLinkActors "Actor::GetNestedLinkActors".
///
/// @warning A zero-DOF skeleton (every joint is @ref mochi::ArticulatedJointType::Hard "ArticulatedJointType::Hard") is a static welded structure and cannot carry a skin (@ref mochi::ArticulatedActorParams::skin "ArticulatedActorParams::skin").
///
/// @see @ref mochi::ArticulatedActorParams "ArticulatedActorParams", @ref mochi::Scene::DestroyActor "DestroyActor"
///

/// @fn Actor* mochi::Scene::CreateSoftSkinnedActor(SoftSkinnedActorParams const& params, Error& error)
///
/// @brief Create a soft-skinned actor with an articulated skeleton.
///
/// @param[in] params Parameters defining the soft-skinned actor.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Pointer to the created @ref mochi::Actor "Actor", or nullptr on error.
///
/// @note To access underlying soft actors, use @ref mochi::Actor::GetNestedSoftActors "Actor::GetNestedSoftActors".
/// @note To access underlying rigid link actors, use @ref mochi::Actor::GetNestedLinkActors "Actor::GetNestedLinkActors".
///
/// @warning The skeleton must have at least one non-Hard joint.
///
/// @see @ref mochi::SoftSkinnedActorParams "SoftSkinnedActorParams", @ref mochi::Scene::DestroyActor "DestroyActor"
///

/// @fn void mochi::Scene::DestroyActor(Actor* actor)
///
/// @brief Destroy an actor and remove it from the scene.
///
/// @param[in] actor Pointer to the actor to destroy.
///
/// @note Nested actors cannot be destroyed individually. When you destroy the parent actor (e.g. an articulation), all the nested actors will be destroyed automatically.
/// @note Constraints attached to the actor are automatically destroyed.
/// @note If @p actor is null, this function has no effect.
/// @note After the actor is destroyed, do not use the pointer or its handle.
///
/// @warning The pointer must be null or point to a live actor owned by this scene. Passing a pointer to an actor that has been destroyed is undefined behavior.
///
/// @see @ref mochi::Scene::GetActor "GetActor", @ref mochi::Actor::GetHandle "Actor::GetHandle"
///

/// @fn void mochi::Scene::DestroyActor(ActorHandle actor)
///
/// @brief Destroy an actor and remove it from the scene.
///
/// @param[in] actor Handle of the actor to destroy. If valid, it must be owned by this scene.
///
/// @note Nested actors cannot be destroyed individually. When you destroy the parent actor (e.g. an articulation), all the nested actors will be destroyed automatically.
/// @note Constraints attached to the actor are automatically destroyed.
/// @note An invalid handle or one that does not currently identify an actor in the scene has no effect.
/// @note After the actor is destroyed, do not use its handle.
///
/// @see @ref mochi::Scene::GetActor "GetActor", @ref mochi::Actor::GetHandle "Actor::GetHandle"
///

/// @fn Actor* mochi::Scene::GetActor(ActorHandle actor)
///
/// @brief Get the @ref mochi::Actor "Actor" pointer associated with an @ref mochi::ActorHandle "ActorHandle".
///
/// @param[in] actor Handle of the actor to retrieve. If valid, it must be owned by this scene.
/// @return Pointer to the @ref mochi::Actor "Actor", or nullptr if the handle does not currently identify an actor in this scene.
///
/// @see @ref mochi::Actor "Actor", @ref mochi::ActorHandle "ActorHandle", @ref mochi::Scene::DestroyActor "DestroyActor", @ref mochi::Actor::GetHandle "Actor::GetHandle"
///

/// @fn Actor const* mochi::Scene::GetActor(ActorHandle actor) const
///
/// @brief Get a const pointer to the @ref mochi::Actor "Actor" associated with an @ref mochi::ActorHandle "ActorHandle".
///
/// @param[in] actor Handle of the actor to retrieve. If valid, it must be owned by this scene.
/// @return Const pointer to the @ref mochi::Actor "Actor", or nullptr if the handle does not currently identify an actor in this scene.
///
/// @see @ref mochi::Actor "Actor", @ref mochi::ActorHandle "ActorHandle", @ref mochi::Scene::DestroyActor "DestroyActor", @ref mochi::Actor::GetHandle "Actor::GetHandle"
///

/// @fn int mochi::Scene::GetNumActors() const
///
/// @brief Get the number of actors in the scene, including nested link actors and nested soft actors.
///
/// @return Number of actors in the scene.
///
/// @note To count only top-level actors, iterate with @ref mochi::Scene::ForEachActor "ForEachActor" and skip actors for which @ref mochi::Actor::IsNestedLinkActor "Actor::IsNestedLinkActor" or @ref mochi::Actor::IsNestedSoftActor "Actor::IsNestedSoftActor" returns true.
///

/// @fn void mochi::Scene::GetActors(Span<Actor*> outActors, Error& error)
///
/// @brief Get @ref mochi::Actor "Actor" pointers for all the actors in the scene.
///
/// @param[out] outActors Output span to fill with @ref mochi::Actor "Actor" pointers. Must be of size @ref mochi::Scene::GetNumActors "GetNumActors"().
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Scene::GetNumActors "GetNumActors", @ref mochi::Scene::GetActor "GetActor"
///

/// @fn void mochi::Scene::GetActors(Span<Actor const*> outActors, Error& error) const
///
/// @brief Get const @ref mochi::Actor "Actor" pointers for all the actors in the scene.
///
/// @param[out] outActors Output span to fill with const @ref mochi::Actor "Actor" pointers. Must be of size @ref mochi::Scene::GetNumActors "GetNumActors"().
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Scene::GetNumActors "GetNumActors", @ref mochi::Scene::GetActor "GetActor"
///

/// @fn void mochi::Scene::ForEachActor(std::function<void(Actor*)> const& callback)
///
/// @brief Iterate over all the actors in the scene using a callback. Includes nested link actors and nested soft actors.
///
/// @param[in] callback Function called once for each actor.
///
/// @note To skip nested actors, check @ref mochi::Actor::IsNestedLinkActor "Actor::IsNestedLinkActor" and @ref mochi::Actor::IsNestedSoftActor "Actor::IsNestedSoftActor" inside the callback.
///
/// @warning Destroying other actors or constraints from within the callback is illegal.
///

/// @fn void mochi::Scene::ForEachActor(std::function<void(Actor const*)> const& callback) const
///
/// @brief Iterate over all the actors in the scene using a callback (const version). Includes nested link actors and nested soft actors.
///
/// @param[in] callback Function called once for each actor.
///
/// @note To skip nested actors, check @ref mochi::Actor::IsNestedLinkActor "Actor::IsNestedLinkActor" and @ref mochi::Actor::IsNestedSoftActor "Actor::IsNestedSoftActor" inside the callback.
///
/// @warning Destroying other actors or constraints from within the callback is illegal.
///

