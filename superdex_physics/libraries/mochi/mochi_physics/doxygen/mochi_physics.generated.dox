/// @enum mochi::BoundarySubsamplingStrategy
///
/// @brief Strategy for selecting the active boundary faces when subsampling boundary integrals.
///

/// @var mochi::BoundarySubsamplingStrategy::UniformProbability
///
/// @brief Select boundary faces with uniform probability.
///
/// @note Results in sample density following mesh resolution. Areas with more triangles have more samples.
/// @note Active boundary faces are selected deterministically using uniformly-spaced indices.
///

/// @var mochi::BoundarySubsamplingStrategy::AreaProportional
///
/// @brief Select boundary faces with probability proportional to their area.
///
/// @note Larger faces have higher selection probability.
/// @note Results in more uniform spatial distribution of sample points, independent of mesh resolution.
///

/// @var mochi::BoundarySubsamplingStrategy::Count
///
/// @brief Number of boundary subsampling strategy enum values.
///

/// @enum mochi::ActorBoundaryElementType
///
/// @brief Two-dimensional discretization element types for actor boundary integrals.
///
/// @note PxQy indicates x-th order elements with y quadrature points.
///

/// @var mochi::ActorBoundaryElementType::P1Q1
///
/// @brief Linear elements (P1), Dunavant quadrature with 1 point (Q1).
///

/// @var mochi::ActorBoundaryElementType::P1Q3
///
/// @brief Linear elements (P1), Dunavant quadrature with 3 points (Q3).
///

/// @var mochi::ActorBoundaryElementType::P1Q6
///
/// @brief Linear elements (P1), Dunavant quadrature with 6 points (Q6).
///

/// @var mochi::ActorBoundaryElementType::ExperimentalP1Q7
///
/// @brief [Experimental] Linear elements (P1), Lyness-Jespersen quadrature with 7 points (Q7).
///
/// @warning This is an experimental feature. It may be changed or removed in the future. Use at your own risk.
///

/// @var mochi::ActorBoundaryElementType::ExperimentalP1Q12
///
/// @brief [Experimental] Linear elements (P1), Dunavant quadrature with 12 points (Q12).
///
/// @warning This is an experimental feature. It may be changed or removed in the future. Use at your own risk.
///

/// @var mochi::ActorBoundaryElementType::ExperimentalP1Q16
///
/// @brief [Experimental] Linear elements (P1), Lyness-Jespersen quadrature with 16 points (Q16).
///
/// @warning This is an experimental feature. It may be changed or removed in the future. Use at your own risk.
///

/// @var mochi::ActorBoundaryElementType::Count
///
/// @brief Number of actor boundary element type enum values.
///

/// @var mochi::ActorBoundaryElementType::Default
///
/// @brief Default actor boundary element type.
///

/// @enum mochi::ActorSegmentElementType
///
/// @brief One-dimensional discretization element types for actor segment integrals.
///
/// @note PxQy indicates x-th order elements with y quadrature points.
///

/// @var mochi::ActorSegmentElementType::P1Q1
///
/// @brief Linear elements (P1), Gauss-Legendre quadrature with 1 point (Q1).
///

/// @var mochi::ActorSegmentElementType::P1Q2
///
/// @brief Linear elements (P1), Gauss-Legendre quadrature with 2 points (Q2).
///

/// @var mochi::ActorSegmentElementType::P1Q3
///
/// @brief Linear elements (P1), Gauss-Legendre quadrature with 3 points (Q3).
///

/// @var mochi::ActorSegmentElementType::Count
///
/// @brief Number of actor segment element type enum values.
///

/// @var mochi::ActorSegmentElementType::Default
///
/// @brief Default actor segment element type.
///

/// @enum mochi::ConstraintType
///
/// @brief Type of constraint acting on actors' degrees of freedom.
///
/// @details Each constraint type enforces specific relationships between actor DoFs, such as fixing positions, limiting joint ranges, or maintaining rigid connections. The type determines which constraint methods are applicable and what parameters are required.
///
/// @see @ref mochi::Constraint "Constraint", @ref mochi::Constraint::GetType "Constraint::GetType"
///

/// @var mochi::ConstraintType::None
///
/// @brief Invalid constraint type.
///

/// @var mochi::ConstraintType::ArticulatedSingleDofRange
///
/// @brief Range constraint on a single articulated DoF. Limits the DoF value to [min, max].
///
/// @see @ref mochi::Scene::CreateArticulatedSingleDofRangeConstraint "Scene::CreateArticulatedSingleDofRangeConstraint", @ref mochi::ArticulatedSingleDofRangeConstraintParams "ArticulatedSingleDofRangeConstraintParams"
///

/// @var mochi::ConstraintType::Articulated3dRotationRange
///
/// @brief Range constraint on the DoFs of an articulated 3D rotation. Limits DoF values to [min, max].
///
/// @see @ref mochi::Scene::CreateArticulated3dRotationRangeConstraint "Scene::CreateArticulated3dRotationRangeConstraint", @ref mochi::Articulated3dRotationRangeConstraintParams "Articulated3dRotationRangeConstraintParams"
///

/// @var mochi::ConstraintType::ArticulatedSingleDofTarget
///
/// @brief Target constraint on a single articulated DoF. Drives the DoF toward a target value.
///
/// @see @ref mochi::Scene::CreateArticulatedSingleDofTargetConstraint "Scene::CreateArticulatedSingleDofTargetConstraint", @ref mochi::ArticulatedSingleDofTargetConstraintParams "ArticulatedSingleDofTargetConstraintParams"
///

/// @var mochi::ConstraintType::Articulated3dRotationTarget
///
/// @brief Target constraint on the DoFs of an articulated 3D rotation. Drives rotation DoFs toward target values.
///
/// @see @ref mochi::Scene::CreateArticulated3dRotationTargetConstraint "Scene::CreateArticulated3dRotationTargetConstraint", @ref mochi::Articulated3dRotationTargetConstraintParams "Articulated3dRotationTargetConstraintParams"
///

/// @var mochi::ConstraintType::JointRotationRange
///
/// @brief Range constraint on joint rotation. Limits joint angles to specified bounds.
///
/// @see @ref mochi::Scene::CreateJointRotationRangeConstraint "Scene::CreateJointRotationRangeConstraint", @ref mochi::JointRotationRangeConstraintParams "JointRotationRangeConstraintParams"
///

/// @var mochi::ConstraintType::JointRotationTracking
///
/// @brief Tracking constraint on joint rotation. Drives joint toward target orientation.
///
/// @see @ref mochi::Scene::CreateJointRotationTrackingConstraint "Scene::CreateJointRotationTrackingConstraint", @ref mochi::JointRotationTrackingConstraintParams "JointRotationTrackingConstraintParams"
///

/// @var mochi::ConstraintType::RigidPivotPosition
///
/// @brief Position constraint on a rigid actor's pivot point. Fixes or tracks a world-space position.
///
/// @see @ref mochi::Scene::CreateRigidPivotPositionConstraint "Scene::CreateRigidPivotPositionConstraint", @ref mochi::RigidPivotPositionConstraintParams "RigidPivotPositionConstraintParams"
///

/// @var mochi::ConstraintType::RigidPivotToRigidTarget
///
/// @brief Position constraint that drives a rigid actor's pivot point toward where that same local point would be if the actor's center-of-mass frame matched a target transform.
///
/// @see @ref mochi::Scene::CreateRigidPivotToRigidTargetConstraint "Scene::CreateRigidPivotToRigidTargetConstraint", @ref mochi::RigidPivotToRigidTargetConstraintParams "RigidPivotToRigidTargetConstraintParams"
///

/// @var mochi::ConstraintType::RigidPivotRotation
///
/// @brief Rotation constraint on a rigid actor's pivot frame. Fixes or tracks a world-space orientation.
///
/// @see @ref mochi::Scene::CreateRigidPivotRotationConstraint "Scene::CreateRigidPivotRotationConstraint", @ref mochi::RigidPivotRotationConstraintParams "RigidPivotRotationConstraintParams"
///

/// @var mochi::ConstraintType::RigidPrismaticJoint
///
/// @brief Translational prismatic joint constraint between two rigid actors. Constrains translation to a single axis. Does not constrain rotation. Pair with @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking" for a full prismatic joint.
///
/// @see @ref mochi::Scene::CreateRigidPrismaticJointConstraint "Scene::CreateRigidPrismaticJointConstraint", @ref mochi::RigidPrismaticJointConstraintParams "RigidPrismaticJointConstraintParams"
///

/// @var mochi::ConstraintType::RigidSphericalJoint
///
/// @brief Spherical joint constraint between two rigid actors. Allows rotation but no translation.
///
/// @see @ref mochi::Scene::CreateRigidSphericalJointConstraint "Scene::CreateRigidSphericalJointConstraint", @ref mochi::RigidSphericalJointConstraintParams "RigidSphericalJointConstraintParams"
///

/// @var mochi::ConstraintType::DeformableNodePosition
///
/// @brief Position constraint on a deformable actor node. Fixes or tracks node position in world space.
///
/// @see @ref mochi::Scene::CreateDeformableNodePositionConstraint "Scene::CreateDeformableNodePositionConstraint", @ref mochi::DeformableNodePositionConstraintParams "DeformableNodePositionConstraintParams"
///

/// @var mochi::ConstraintType::DeformableNodeToRigid
///
/// @brief Constraint connecting a deformable node to a rigid actor. Attaches deformable body to rigid body.
///
/// @see @ref mochi::Scene::CreateDeformableNodeToRigidConstraint "Scene::CreateDeformableNodeToRigidConstraint", @ref mochi::DeformableNodeToRigidConstraintParams "DeformableNodeToRigidConstraintParams"
///

/// @var mochi::ConstraintType::DeformableNodeToDeformableNode
///
/// @brief Constraint connecting two deformable actor nodes.
///
/// @see @ref mochi::Scene::CreateDeformableNodeToDeformableNodeConstraint "Scene::CreateDeformableNodeToDeformableNodeConstraint", @ref mochi::DeformableNodeToDeformableNodeConstraintParams "DeformableNodeToDeformableNodeConstraintParams"
///

/// @var mochi::ConstraintType::RodElementRotationToRigid
///
/// @brief Rotation constraint between a rigid actor and a rod element. Tracks relative rotation.
///
/// @see @ref mochi::Scene::CreateRodElementRotationToRigidConstraint "Scene::CreateRodElementRotationToRigidConstraint", @ref mochi::RodElementRotationToRigidConstraintParams "RodElementRotationToRigidConstraintParams"
///

/// @var mochi::ConstraintType::Count
///
/// @brief Number of constraint type enum values.
///

/// @enum mochi::PoseConstraintType
///
/// @brief Type of constraint in an articulated pose controller.
///
/// @details Defines the functional purpose of a pose constraint, not its internal implementation. Pose controllers use these constraints to track target configurations for articulated actors.
///
/// @see @ref mochi::PoseConstraintInfo "PoseConstraintInfo", @ref mochi::PoseTrackingParams "PoseTrackingParams", @ref mochi::PoseControllerParams "PoseControllerParams"
///

/// @var mochi::PoseConstraintType::Joint
///
/// @brief Joint constraint.
///

/// @var mochi::PoseConstraintType::LinkTranslation
///
/// @brief Link translation constraint. Controls the position of a link.
///

/// @var mochi::PoseConstraintType::LinkRotation
///
/// @brief Link rotation constraint. Controls the orientation of a link.
///

/// @var mochi::PoseConstraintType::Count
///
/// @brief Number of pose constraint type enum values.
///

/// @var mochi::PoseConstraintType::Invalid
///
/// @brief Invalid constraint type.
///

/// @enum mochi::QueryType
///
/// @brief Type of query data to compute for an actor or constraint.
///
/// @details Queries enable on-demand computation of simulation data. Some queries allow immediate retrieval of data; others must be registered beforehand to have the data computed and available for retrieval after the next step. Queries are reference counted, so multiple registrations are acceptable.
///
/// @note Not all query types are supported for all actor/constraint types. Use @ref mochi::Actor::IsQuerySupported "Actor::IsQuerySupported" or @ref mochi::Constraint::IsQuerySupported "Constraint::IsQuerySupported" to check at runtime whether a specific query type is supported for a given actor/constraint.
///
/// @see @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", @ref mochi::Constraint::RegisterQuery "Constraint::RegisterQuery"
///

/// @var mochi::QueryType::NodePositions
///
/// @brief Positions of all mesh nodes. Available via @ref mochi::Actor::GetNodePositionsLocal "Actor::GetNodePositionsLocal".
///
/// @note Only supported for soft, soft-skinned and shell actors.
///

/// @var mochi::QueryType::ElementsDeformationGradient
///
/// @brief Deformation gradients for elements in deformable actors. Available via @ref mochi::Actor::GetElementsDeformationGradient "Actor::GetElementsDeformationGradient".
///
/// @note Only supported for soft and soft-skinned actors (except ROMs).
///

/// @var mochi::QueryType::SurfaceNodePositions
///
/// @brief Positions of surface mesh nodes. Available via @ref mochi::Actor::GetSurfaceMeshNodePositionsLocal "Actor::GetSurfaceMeshNodePositionsLocal".
///
/// @note Not supported for actors without a surface mesh, such as rod actors or rigid actors without a mesh (e.g. with an implicit shape).
///

/// @var mochi::QueryType::SurfaceNodeNormals
///
/// @brief Normals of surface mesh nodes. Available via @ref mochi::Actor::GetSurfaceMeshNodeNormalsLocal "Actor::GetSurfaceMeshNodeNormalsLocal".
///
/// @note Not supported for actors without a surface mesh, such as rod actors or rigid actors without a mesh (e.g. with an implicit shape).
///

/// @var mochi::QueryType::VisualNodePositions
///
/// @brief Positions of visual mesh nodes. Available via @ref mochi::Actor::GetVisualMeshNodePositionsLocal "Actor::GetVisualMeshNodePositionsLocal".
///
/// @note Only supported for actors with a visual mesh. Deformable actors also require a visual mesh embedding.
///

/// @var mochi::QueryType::VisualNodeNormals
///
/// @brief Normals of visual mesh nodes. Available via @ref mochi::Actor::GetVisualMeshNodeNormalsLocal "Actor::GetVisualMeshNodeNormalsLocal".
///
/// @note Only supported for actors with a visual mesh. Deformable actors also require a visual mesh embedding.
///

/// @var mochi::QueryType::ContactPoints
///
/// @brief Contact points between actors. Available via @ref mochi::Actor::GetContactPointsWorld "Actor::GetContactPointsWorld".
///
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
/// @note Not supported for actors without contact sample points or with far SDF evaluation enabled.
///

/// @var mochi::QueryType::ElasticEnergy
///
/// @brief Elastic energy of a deformable actor. Available via @ref mochi::Actor::GetElasticEnergy "Actor::GetElasticEnergy".
///
/// @note Only supported for soft and soft-skinned actors.
///

/// @var mochi::QueryType::NodeContactForces
///
/// @brief Contact forces per node. Available via @ref mochi::Actor::GetNodeContactForcesWorld "Actor::GetNodeContactForcesWorld".
///
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
/// @note Not supported for rod actors, actors without contact sample points or actors with far SDF evaluation enabled.
///

/// @var mochi::QueryType::ConstraintForce
///
/// @brief Force/torque applied by a constraint. Available via @ref mochi::Constraint::GetForce "Constraint::GetForce".
///
/// @note Only applicable to @ref mochi::Constraint "Constraint" objects.
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
///

/// @var mochi::QueryType::ArticulatedControllerForce
///
/// @brief Generalized forces applied by an articulated pose controller. Available via @ref mochi::Actor::GetArticulatedControllerForce "Actor::GetArticulatedControllerForce".
///
/// @note Only applicable to articulated actors with a pose controller.
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
///

/// @var mochi::QueryType::SdfDistances
///
/// @brief Signed distance field values for contact samples. Available via @ref mochi::Actor::GetSdfDistances "Actor::GetSdfDistances".
///
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
///

/// @var mochi::QueryType::TotalContactForce
///
/// @brief Total contact force and torque acting on an actor. Available via @ref mochi::Actor::GetContactForceWorld "Actor::GetContactForceWorld" and @ref mochi::Actor::GetContactTorqueWorld "Actor::GetContactTorqueWorld".
///
/// @note Immediate computation, i.e. @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute", is not supported.
/// @note Not supported for actors without contact sample points or with far SDF evaluation enabled.
///

/// @var mochi::QueryType::Count
///
/// @brief Number of query type enum values.
///

/// @enum mochi::IncludeNestedActors
///
/// @brief Specifies whether actor-contact filtering also applies to nested actors.
///
/// @see @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::IncludeNestedActors::No
///
/// @brief Affect only the exact actor handles passed to the API.
///

/// @var mochi::IncludeNestedActors::Yes
///
/// @brief Affect the exact actor and, for parent actors, its nested actors.
///
/// @note Actors without nested actors are affected as exact actors.
///

/// @var mochi::IncludeNestedActors::Count
///
/// @brief Number of @ref mochi::IncludeNestedActors "IncludeNestedActors" values.
///

/// @struct mochi::SolverParams
///
/// @brief Simulation solver configuration parameters.
///

/// @var mochi::SolverParams::nonLinearSolver
///
/// @brief Nonlinear solver settings.
///

/// @var mochi::SolverParams::linearSolver
///
/// @brief Linear solver settings.
///

/// @var mochi::SolverParams::integrationMethod
///
/// @brief Time integration method.
///

/// @var mochi::SolverParams::experimentalEval
///
/// @brief [Experimental] Evaluation settings common to the full scene.
///
/// @warning This is an experimental feature. It may be changed or removed in the future. Use at your own risk.
///

/// @struct mochi::RecenteringParams
///
/// @brief Parameters controlling recentering behavior for soft actors (not soft-skinned).
///
/// @details Recentering automatically updates the root transform as the actor's "rigid pivot" (typically near the center of mass) moves, with corresponding adjustments to local-space coordinates.
///
/// @note When recentering is disabled, local-space displacement values can become very large if the actor moves far from its starting position. This may be problematic due to finite-precision arithmetic.
/// @note When recentering is enabled, the root transform rotates and translates to follow the actor, and local-space displacements reflect only deformation, not global rotation or translation.
///
/// @see @ref mochi::Actor::GetRecenteringParams "Actor::GetRecenteringParams", @ref mochi::Actor::SetRecenteringParams "Actor::SetRecenteringParams"
///

/// @var mochi::RecenteringParams::useRecentering
///
/// @brief Whether recentering is enabled.
///

/// @var mochi::RecenteringParams::rotationEpsilonDeg
///
/// @brief Minimum rotation threshold [degrees] to apply recentering.
///
/// @note Recentering is applied if either rotation or translation change more than their respective thresholds.
///

/// @var mochi::RecenteringParams::translationEpsilon
///
/// @brief Minimum translation threshold [m] to apply recentering.
///
/// @note Recentering is applied if either rotation or translation change more than their respective thresholds.
///

/// @struct mochi::BoundarySubsamplingParams
///
/// @brief Parameters for subsampling boundary integrals such as contact.
///
/// @details Subsampling reduces the number of boundary sample points used for contact and other boundary integrals, which can improve performance at the cost of accuracy.
///

/// @var mochi::BoundarySubsamplingParams::subsamplingDensity
///
/// @brief Subsampling density in the range [0, 1].
///
/// @note 0 means no sample points are used. 1 means all sample points are used.
///

/// @var mochi::BoundarySubsamplingParams::strategy
///
/// @brief Strategy for determining which sample points to use.
///

/// @struct mochi::ArticulatedShapeInfo
///
/// @brief Information describing an articulated shape's kinematic structure.
///
/// @details Provides read-only access to an articulated shape's links, joints, and hierarchy. This information is immutable once the shape is created and defines the articulation's topology and configuration limits.
///
/// @note Number of joints = number of links + number of cycle joints.
///
/// @see @ref mochi::Actor::GetArticulatedShapeInfo "Actor::GetArticulatedShapeInfo", @ref mochi::Context::GetArticulatedShapeInfo "Context::GetArticulatedShapeInfo"
///

/// @var mochi::ArticulatedShapeInfo::rootFromLinksAtRest
///
/// @brief Rotation and translation of each link in rest configuration relative to the local reference system of the articulated shape. Size must equal the number of links.
///

/// @var mochi::ArticulatedShapeInfo::linkNames
///
/// @brief Name of each link.
///

/// @var mochi::ArticulatedShapeInfo::parents
///
/// @brief Parent link indices defining a tree-like joint structure with no cycles. Size must equal the number of links.
///
/// @note `parent[i] < i` (parent must come before child in the array).
/// @note Use -1 for links with no parent.
///

/// @var mochi::ArticulatedShapeInfo::jointTypes
///
/// @brief Type of each joint. Size must be numLinks + numCycles.
///
/// @see @ref mochi::ArticulatedJointType "ArticulatedJointType"
///

/// @var mochi::ArticulatedShapeInfo::cycles
///
/// @brief Cycle joints creating closed kinematic loops in the articulated body.
///
/// @note Empty if no cycles exist (i.e., the kinematic structure is purely tree-like).
/// @note Cycle entries appear at indices [numLinks, numLinks + numCycles) of the per-joint arrays (@ref mochi::ArticulatedShapeInfo::jointTypes "jointTypes", @ref mochi::ArticulatedShapeInfo::jointAxes "jointAxes", @ref mochi::ArticulatedShapeInfo::jointFromChildLink "jointFromChildLink", @ref mochi::ArticulatedShapeInfo::parentLinkFromJoint "parentLinkFromJoint", @ref mochi::ArticulatedShapeInfo::jointMinLimits "jointMinLimits", @ref mochi::ArticulatedShapeInfo::jointMaxLimits "jointMaxLimits", @ref mochi::ArticulatedShapeInfo::jointNames "jointNames").
///
/// @see @ref mochi::ArticulatedCycleJoint "ArticulatedCycleJoint"
///

/// @var mochi::ArticulatedShapeInfo::jointAxes
///
/// @brief Axis of each joint in the joint's local frame. Size must be numLinks + numCycles.
///

/// @var mochi::ArticulatedShapeInfo::dofInfo
///
/// @brief DoF information of each joint (offset within the full pose, number of translation DoFs, number of rotation DoFs). Size must be numLinks + numCycles.
///

/// @var mochi::ArticulatedShapeInfo::jointFromChildLink
///
/// @brief Transform from each joint's child link to the joint frame (rotation + translation). Size must be numLinks + numCycles.
///
/// @details This is the transform from the child link to the joint. @ref mochi::ArticulatedLinkParams::parentJointFromLink "ArticulatedLinkParams::parentJointFromLink" for tree joints and @ref mochi::ArticulatedCycleJointParams::jointFromChildLink "ArticulatedCycleJointParams::jointFromChildLink" for cycle joints. The joint axis (@ref mochi::ArticulatedShapeInfo::jointAxes "jointAxes") and joint motion are interpreted in this joint frame.
///

/// @var mochi::ArticulatedShapeInfo::parentLinkFromJoint
///
/// @brief Joint frame of each joint expressed in its parent link's local frame (rotation + translation). Size must be numLinks + numCycles.
///
/// @details This is the transform from the joint to the parent link, corresponding to @ref mochi::ArticulatedJointParams::parentLinkFromJoint "ArticulatedJointParams::parentLinkFromJoint".
///

/// @var mochi::ArticulatedShapeInfo::jointMinLimits
///
/// @brief Minimum joint limits for each joint DoF. Size must be numLinks + numCycles, or empty if no joint has limits.
///
/// @details Limits are defined for either all joints or none. Joints without minimum limits are indicated by @ref mochi::ArticulatedShapeInfo::jointMinLimits "jointMinLimits"[i] = -mochi::kInf3. For 1D joints, limits are the scalar minimum limits multiplied by the joint axis. For 3D joints, each component defines the limit along one of the axes of the joint.
///
/// @note The definition of joint limits for spherical joints may be complex, and it may be easier to model them as 3 co-located revolute joints.
/// @note Size of @ref mochi::ArticulatedShapeInfo::jointMinLimits "jointMinLimits" and @ref mochi::ArticulatedShapeInfo::jointMaxLimits "jointMaxLimits" must be the same.
///

/// @var mochi::ArticulatedShapeInfo::jointMaxLimits
///
/// @brief Maximum joint limits for each joint DoF. Size must be numLinks + numCycles, or empty if no joint has limits.
///
/// @details Limits are defined for either all joints or none. Joints without maximum limits are indicated by @ref mochi::ArticulatedShapeInfo::jointMaxLimits "jointMaxLimits"[i] = mochi::kInf3. For 1D joints, limits are the scalar maximum limits multiplied by the joint axis. For 3D joints, each component defines the limit along one of the axes of the joint.
///
/// @note The definition of joint limits for spherical joints may be complex, and it may be easier to model them as 3 co-located revolute joints.
/// @note Size of @ref mochi::ArticulatedShapeInfo::jointMinLimits "jointMinLimits" and @ref mochi::ArticulatedShapeInfo::jointMaxLimits "jointMaxLimits" must be the same.
///

/// @var mochi::ArticulatedShapeInfo::jointNames
///
/// @brief Name of each joint. Size must be numLinks + numCycles.
///

/// @struct mochi::StepInfo
///
/// @brief Information passed to per-step callbacks.
///
/// @see @ref mochi::Scene::RegisterPreStepCallback "Scene::RegisterPreStepCallback", @ref mochi::Scene::RegisterPostStepCallback "Scene::RegisterPostStepCallback"
///

/// @var mochi::StepInfo::scene
///
/// @brief Pointer to the @ref mochi::Scene "Scene" being stepped.
///

/// @var mochi::StepInfo::timeStepSec
///
/// @brief Time step size [s] for this simulation step.
///

/// @struct mochi::RigidActorParams
///
/// @brief Parameters to create a rigid body actor.
///
/// @details Rigid actors behave as rigid bodies with 6 degrees of freedom (3 translational, 3 rotational). They can be static (fixed in space) or dynamic (affected by forces and collisions).
///
/// @note Also used to create links in articulated bodies.
///
/// @see @ref mochi::Scene::CreateRigidActor "Scene::CreateRigidActor", @ref mochi::ArticulatedActorParams "ArticulatedActorParams"
///

/// @var mochi::RigidActorParams::name
///
/// @brief Optional actor name. Uniqueness of names is not enforced.
///

/// @var mochi::RigidActorParams::layer
///
/// @brief Contact layer name for filtering contacts between actors.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::RigidActorParams::shape
///
/// @brief Shape handle defining the actor's geometry and other metadata.
///
/// @note A shape can be shared by multiple actors, even actors in different scenes.
/// @note Dynamic rigid actors require a shape with a surface mesh.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::LoadShapeFromFile "Context::LoadShapeFromFile"
///

/// @var mochi::RigidActorParams::worldFromLocal
///
/// @brief Initial rotation and translation of the actor's local frame with respect to world frame.
///
/// @note The actor's center of mass may be located elsewhere, since it is not necessarily at the origin of the actor's local coordinate frame.
///
/// @see @ref mochi::RigidActorParams::centerOfMass "centerOfMass"
///

/// @var mochi::RigidActorParams::colliderType
///
/// @brief Collision detection geometry.
///
/// @note Determines how OTHER actors detect contact with this actor. It does not affect how this actor detects contact with other actors.
///
/// @see @ref mochi::ColliderType "ColliderType"
///

/// @var mochi::RigidActorParams::isStatic
///
/// @brief If true, actor will be static (fixed in space). If false, actor will be dynamic.
///

/// @var mochi::RigidActorParams::contact
///
/// @brief Contact mechanics parameters.
///
/// @see @ref mochi::ContactParams "ContactParams"
///

/// @var mochi::RigidActorParams::sdf
///
/// @brief Parameters used to construct a grid-based Signed Distance Field (SDF) if the shape doesn't already have one.
///
/// @note Ignored if @ref mochi::RigidActorParams::colliderType "colliderType" is not @ref mochi::ColliderType::Sdf "ColliderType::Sdf".
/// @note Ignored if the shape already has a grid-based SDF.
///

/// @var mochi::RigidActorParams::hasGravity
///
/// @brief If true, actor is affected by gravity.
///
/// @see @ref mochi::Scene::SetGravity "Scene::SetGravity"
///

/// @var mochi::RigidActorParams::density
///
/// @brief Uniform density [kg/m³] of the actor. Must be positive if provided.
///
/// @note Setting both density and mass is not recommended. If both are set, mass takes precedence and density is ignored.
/// @note If only density is set, mass is computed automatically from volume.
/// @note If neither is set, @ref mochi::kDefaultDensity "kDefaultDensity" is used.
///
/// @see @ref mochi::RigidActorParams::mass "mass"
///

/// @var mochi::RigidActorParams::mass
///
/// @brief Total mass [kg] of the actor. Must be positive if provided.
///
/// @note Setting both mass and density is not recommended. If both are set, mass takes precedence and density is ignored.
/// @note If only mass is set, density is computed automatically from volume.
///
/// @see @ref mochi::RigidActorParams::density "density"
///

/// @var mochi::RigidActorParams::centerOfMass
///
/// @brief Position [m] of the center of mass in the actor's local frame.
///
/// @note If not set, computed automatically from geometry.
/// @note Usually combined with explicit momentOfInertia.
///
/// @see @ref mochi::RigidActorParams::momentOfInertia "momentOfInertia"
///

/// @var mochi::RigidActorParams::momentOfInertia
///
/// @brief Moment of inertia tensor [kg·m²] at the center of mass in the actor's local frame.
///
/// @details Stored as [ixx, ixy, ixz, iyy, iyz, izz] using negative tensor notation:
///
/// @code
///      [ixx, ixy, ixz]   [ +∫(y²+z²)dm,  -∫(xy)dm,    -∫(xz)dm    ]
///  I = [ixy, iyy, iyz] = [ -∫(xy)dm,     +∫(x²+z²)dm, -∫(yz)dm    ]
///      [ixz, iyz, izz]   [ -∫(xz)dm,     -∫(yz)dm,    +∫(x²+y²)dm ]
/// @endcode
///
/// @note Uses negative tensor notation consistent with e.g. robotics URDF files.
/// @note Many CAD tools (e.g., Solidworks) use positive tensor notation requiring negation of off-diagonal terms. See https://www.mathworks.com/help/sm/ug/specify-custom-inertia.html.
/// @note Must be finite. A finite but physically invalid tensor (negative principal moments or one violating the triangle inequality) is accepted with a warning, not rejected.
/// @note If not set, computed automatically from geometry and density.
/// @note Usually combined with explicit centerOfMass.
///
/// @see @ref mochi::RigidActorParams::centerOfMass "centerOfMass"
///

/// @var mochi::RigidActorParams::boundaryElementType
///
/// @brief Finite element type for boundary discretization.
///
/// @note Affects accuracy and performance of contact and boundary integrals.
///
/// @see @ref mochi::ActorBoundaryElementType "ActorBoundaryElementType"
///

/// @var mochi::RigidActorParams::boundarySubsampling
///
/// @brief Optional subsampling for boundary integrals such as contact.
///
/// @note Reduces computational cost by using fewer sample points.
/// @note For best performance, combine subsampling with @ref mochi::RigidActorParams::boundaryElementType "boundaryElementType" = @ref mochi::ActorBoundaryElementType::P1Q1 "ActorBoundaryElementType::P1Q1".
///
/// @see @ref mochi::BoundarySubsamplingParams "BoundarySubsamplingParams"
///

/// @var mochi::RigidActorParams::linearVelocity
///
/// @brief Optional initial linear velocity of the center of mass in world frame [m/s], zero otherwise.
///
/// @note Not valid for static rigid actors or articulated links.
///
/// @see @ref mochi::Actor::GetLinearVelocity "Actor::GetLinearVelocity", @ref mochi::Actor::SetVelocity "Actor::SetVelocity"
///

/// @var mochi::RigidActorParams::angularVelocity
///
/// @brief Optional initial angular velocity in world frame [rad/s], zero otherwise.
///
/// @note Not valid for static rigid actors or articulated links.
///
/// @see @ref mochi::Actor::GetAngularVelocity "Actor::GetAngularVelocity", @ref mochi::Actor::SetVelocity "Actor::SetVelocity"
///

/// @struct mochi::SoftActorParams
///
/// @brief Parameters to create a soft deformable actor.
///
/// @details Soft actors are volumetric deformable bodies simulated using the Finite Element Method (FEM).
///
/// @note Soft actors created via @ref mochi::Scene::CreateSoftActor "Scene::CreateSoftActor" act as colliding actors via their own surface sample points but not as colliders. To create a soft actor with a collider, use `experimental::CreateSoftActor` with an explicit `experimental::ExperimentalSoftActorParams::colliderType`.
///
/// @see @ref mochi::Scene::CreateSoftActor "Scene::CreateSoftActor", `experimental::CreateSoftActor`, `experimental::ExperimentalSoftActorParams`
///

/// @var mochi::SoftActorParams::name
///
/// @brief Optional actor name. Uniqueness of names is not enforced.
///
/// @note When used in @ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams", this is interpreted as a nested soft local name. See @ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams" for additional requirements and defaulting behavior.
///

/// @var mochi::SoftActorParams::layer
///
/// @brief Contact layer name for filtering contacts between actors.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::SoftActorParams::worldFromLocal
///
/// @brief Initial rotation and translation of the actor's local frame with respect to world frame.
///
/// @note When this struct is used as an entry of @ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams", this transform must be identity. The soft actor's shape must be defined directly in the reference frame of the articulated actor (see @ref mochi::SoftSkinnedActorParams::skeletonParams "SoftSkinnedActorParams::skeletonParams"). The soft-skinned actor's placement in the scene world is provided by @ref mochi::ArticulatedActorParams::worldFromRoot "ArticulatedActorParams::worldFromRoot" in @ref mochi::SoftSkinnedActorParams::skeletonParams "SoftSkinnedActorParams::skeletonParams".
///

/// @var mochi::SoftActorParams::shape
///
/// @brief Shape handle defining the actor's geometry and other metadata.
///
/// @note Must be a TetrahedralMeshShape for soft actors.
/// @note A shape can be shared by multiple actors, even actors in different scenes.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::LoadShapeFromFile "Context::LoadShapeFromFile"
///

/// @var mochi::SoftActorParams::material
///
/// @brief Uniform material properties.
///
/// @note If the shape contains per-element material data of the same @ref mochi::SoftMaterialType "SoftMaterialType", the per-element values from the shape take precedence over and replace these uniform values. If the shape's per-element material type differs, these uniform values are used instead.
/// @note The actor uses a single PSD strategy for all elements. By default it is the @ref mochi::SoftActorParams::material "material"'s PSD strategy. If the shape supplies per-element material data of a matching @ref mochi::SoftMaterialType "SoftMaterialType" whose @ref mochi::PerElementSoftMaterialData::psdStrategy "PerElementSoftMaterialData::psdStrategy" is specified (i.e. not @ref mochi::MaterialPsdStrategy::MaterialDefault "MaterialPsdStrategy::MaterialDefault"), that value takes precedence. If the @ref mochi::SoftActorParams::material "material"'s PSD strategy is also specified, the two must be equal.
/// @note Non-uniform material properties can also be applied after the actor is created. See experimental::SetSoftMaterialParamsField.
///
/// @see @ref mochi::Actor::SetSoftMaterialParams "Actor::SetSoftMaterialParams", `experimental::SetSoftMaterialParamsField`
///

/// @var mochi::SoftActorParams::contact
///
/// @brief Contact mechanics parameters.
///
/// @see @ref mochi::ContactParams "ContactParams"
///

/// @var mochi::SoftActorParams::hasGravity
///
/// @brief If true, actor is affected by gravity.
///
/// @note Unless the soft actor is part of a soft-skinned actor (@ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams"), at least one of @ref mochi::SoftActorParams::hasGravity "hasGravity", @ref mochi::SoftActorParams::hasInertia "hasInertia" or @ref mochi::SoftActorParams::hasStress "hasStress" must be enabled.
///
/// @see @ref mochi::Scene::SetGravity "Scene::SetGravity"
///

/// @var mochi::SoftActorParams::hasInertia
///
/// @brief If true, actor is affected by inertial forces.
///
/// @note Disable for quasi-static simulations.
/// @note Unless the soft actor is part of a soft-skinned actor (@ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams"), at least one of @ref mochi::SoftActorParams::hasGravity "hasGravity", @ref mochi::SoftActorParams::hasInertia "hasInertia" or @ref mochi::SoftActorParams::hasStress "hasStress" must be enabled.
///

/// @var mochi::SoftActorParams::hasStress
///
/// @brief If true, actor is affected by internal stress/strain forces.
///
/// @note Unless the soft actor is part of a soft-skinned actor (@ref mochi::SoftSkinnedActorParams::softParams "SoftSkinnedActorParams::softParams"), at least one of @ref mochi::SoftActorParams::hasGravity "hasGravity", @ref mochi::SoftActorParams::hasInertia "hasInertia" or @ref mochi::SoftActorParams::hasStress "hasStress" must be enabled.
///

/// @var mochi::SoftActorParams::boundaryElementType
///
/// @brief Finite element type for boundary discretization.
///
/// @note Affects accuracy and performance of contact and boundary integrals.
///
/// @see @ref mochi::ActorBoundaryElementType "ActorBoundaryElementType"
///

/// @struct mochi::ArticulatedJointParams
///
/// @brief Parameters describing a single joint within an articulated actor.
///
/// @details Each joint connects a link to its parent in the kinematic tree. Joints are referenced positionally — the i-th entry of @ref mochi::ArticulatedActorParams::joints "ArticulatedActorParams::joints" corresponds to the joint connecting the i-th link to its parent. Cycle-closing joints are declared separately via @ref mochi::ArticulatedActorParams::cycles "ArticulatedActorParams::cycles".
///
/// @see @ref mochi::ArticulatedActorParams "ArticulatedActorParams", @ref mochi::ArticulatedLinkParams "ArticulatedLinkParams", @ref mochi::ArticulatedJointType "ArticulatedJointType"
///

/// @var mochi::ArticulatedJointParams::name
///
/// @brief Joint name. Must be unique among joints of the same articulated actor.
///
/// @note If left empty, a unique default name (e.g., "joint_0", "joint_1", ...) is assigned automatically.
///

/// @var mochi::ArticulatedJointParams::type
///
/// @brief Joint type.
///
/// @note Default @ref mochi::ArticulatedJointType::Invalid "ArticulatedJointType::Invalid" is a sentinel. The user must overwrite it.
/// @note @ref mochi::ArticulatedJointType::Cycle "ArticulatedJointType::Cycle" is reserved for cycle-closing joints. Use @ref mochi::ArticulatedActorParams::cycles "ArticulatedActorParams::cycles" for cycle joints.
/// @note Static links can be modeled using a @ref mochi::ArticulatedJointType::Hard "ArticulatedJointType::Hard" joint whose parent is either -1 or another static link.
///

/// @var mochi::ArticulatedJointParams::parentLinkFromJoint
///
/// @brief Rotation and translation of the joint with respect to the parent link.
///

/// @var mochi::ArticulatedJointParams::axis
///
/// @brief Local axis of motion for the joint, in the joint's local frame.
///
/// @note Only used for @ref mochi::ArticulatedJointType::Prismatic "ArticulatedJointType::Prismatic" and @ref mochi::ArticulatedJointType::Revolute "ArticulatedJointType::Revolute" joints. Ignored (and reset to zero) for other joint types.
/// @note For Prismatic/Revolute joints, must be non-zero and finite. The vector is automatically normalized to unit length on actor creation.
///

/// @var mochi::ArticulatedJointParams::friction
///
/// @brief Joint friction parameters.
///
/// @note Ignored for @ref mochi::ArticulatedJointType::Free "ArticulatedJointType::Free" and @ref mochi::ArticulatedJointType::Hard "ArticulatedJointType::Hard" joints.
///

/// @var mochi::ArticulatedJointParams::inertia
///
/// @brief Joint inertia coefficient. Units are [kg] for translation DoFs and [kg·m²] for rotation DoFs.
///
/// @note Default is zero joint inertia.
/// @note Ignored for @ref mochi::ArticulatedJointType::Free "ArticulatedJointType::Free" and @ref mochi::ArticulatedJointType::Hard "ArticulatedJointType::Hard" joints.
///

/// @var mochi::ArticulatedJointParams::minLimit
///
/// @brief Minimum joint limits for each DoF. Units are [m] for translation DoFs and [rad] for rotation DoFs.
///
/// @details For 1D joints, limits must be defined by multiplying the scalar min limits by the joint axis. For 3D joints, each component must define the limit along one of the axes of the joint.
///
/// @note The definition of joint limits for spherical joints may be complex, and it may be easier to model them as 3 co-located revolute joints.
///

/// @var mochi::ArticulatedJointParams::maxLimit
///
/// @brief Maximum joint limits for each DoF. Units are [m] for translation DoFs and [rad] for rotation DoFs.
///
/// @details For 1D joints, limits must be defined by multiplying the scalar max limits by the joint axis. For 3D joints, each component must define the limit along one of the axes of the joint.
///
/// @note The definition of joint limits for spherical joints may be complex, and it may be easier to model them as 3 co-located revolute joints.
///

/// @var mochi::ArticulatedJointParams::limitStiffness
///
/// @brief Stiffness coefficient [N/m or N·m/rad] for the joint limit constraints.
///
/// @note Ignored for joints without limits.
///

/// @var mochi::ArticulatedJointParams::limitDamping
///
/// @brief Damping coefficient [N·s/m or N·m·s/rad] for the joint limit constraints.
///
/// @note Ignored for joints without limits.
///

/// @struct mochi::ArticulatedLinkParams
///
/// @brief Parameters describing a single rigid link within an articulated actor.
///
/// @details Each link is a rigid body in the articulation's kinematic tree. Mirrors @ref mochi::RigidActorParams "RigidActorParams" for the per-link rigid-body properties (shape, mass, inertia, contact), and adds tree-structure fields (@ref mochi::ArticulatedLinkParams::parentLink "parentLink", @ref mochi::ArticulatedLinkParams::parentJointFromLink "parentJointFromLink"). Pose and velocity at creation time come from the articulated body, not from per-link fields.
///
/// @see @ref mochi::ArticulatedActorParams "ArticulatedActorParams", @ref mochi::ArticulatedJointParams "ArticulatedJointParams", @ref mochi::RigidActorParams "RigidActorParams"
///

/// @var mochi::ArticulatedLinkParams::name
///
/// @brief Link local name.
///
/// @note Must be unique among links of the same articulated actor. For soft-skinned actors, it must also not collide with nested soft actor local names.
/// @note Must not contain forward slash, backslash, or embedded NUL characters, which are reserved for hierarchy paths or incompatible with actor path formatting.
/// @note If left empty, a unique default name (e.g., "link_0", "link_1", ...) is assigned automatically.
/// @note In the scene the corresponding actor is named "articulatedActorName/linkLocalName". If the articulated actor name is empty, link actors use "unnamed_articulation/linkLocalName".
///

/// @var mochi::ArticulatedLinkParams::parentLink
///
/// @brief Index of the parent link in @ref mochi::ArticulatedActorParams::links "ArticulatedActorParams::links", or -1 for the root.
///
/// @note Links must be listed in parent-first order: `parentLink < i` for the i-th link.
/// @note The root link (index 0) must have `parentLink == -1`.
///

/// @var mochi::ArticulatedLinkParams::parentJointFromLink
///
/// @brief Rotation and translation of the link with respect to the parent joint.
///
/// @warning The rotation must be identity. Non-identity rotations are not supported yet.
///

/// @var mochi::ArticulatedLinkParams::shape
///
/// @brief Shape handle defining the actor's geometry and other metadata.
///
/// @note A shape can be shared by multiple actors, even actors in different scenes.
/// @note Dynamic links require a shape with a surface mesh when link contact is enabled. An articulated actor enables link contact when no skin shape is provided. A soft-skinned actor enables link contact when @ref mochi::SoftSkinnedActorParams::enableCollidingLinks "SoftSkinnedActorParams::enableCollidingLinks" is true.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::LoadShapeFromFile "Context::LoadShapeFromFile"
///

/// @var mochi::ArticulatedLinkParams::layer
///
/// @brief Contact layer name for filtering contacts between actors.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::ArticulatedLinkParams::colliderType
///
/// @brief Collision detection geometry.
///
/// @note Determines how OTHER actors detect contact with this actor. It does not affect how this actor detects contact with other actors.
///

/// @var mochi::ArticulatedLinkParams::contact
///
/// @brief Contact mechanics parameters.
///

/// @var mochi::ArticulatedLinkParams::hasGravity
///
/// @brief If true, the link actor will be affected by gravity.
///
/// @see @ref mochi::Scene::SetGravity "Scene::SetGravity"
///

/// @var mochi::ArticulatedLinkParams::density
///
/// @brief Uniform density [kg/m³] of the actor. Must be positive if provided.
///
/// @note Specify either density or mass, but not both.
/// @note If density is set, mass is computed automatically from volume (and vice versa).
/// @note If neither is set, @ref mochi::kDefaultDensity "kDefaultDensity" is used.
///
/// @see @ref mochi::ArticulatedLinkParams::mass "mass"
///

/// @var mochi::ArticulatedLinkParams::mass
///
/// @brief Total mass [kg] of the actor. Must be positive if provided.
///
/// @note Specify either mass or density, but not both.
/// @note If mass is set, density is computed automatically from volume (and vice versa).
///
/// @see @ref mochi::ArticulatedLinkParams::density "density"
///

/// @var mochi::ArticulatedLinkParams::centerOfMass
///
/// @brief Position [m] of the center of mass in the link actor's local frame.
///
/// @note If not set, computed automatically from geometry.
/// @note Usually combined with explicit momentOfInertia.
///
/// @see @ref mochi::ArticulatedLinkParams::momentOfInertia "momentOfInertia"
///

/// @var mochi::ArticulatedLinkParams::momentOfInertia
///
/// @brief Moment of inertia tensor [kg·m²] at the center of mass in the actor's local frame.
///
/// @details Stored as [ixx, ixy, ixz, iyy, iyz, izz] using negative tensor notation:
///
/// @code
///      [ixx, ixy, ixz]   [ +∫(y²+z²)dm,  -∫(xy)dm,    -∫(xz)dm    ]
///  I = [ixy, iyy, iyz] = [ -∫(xy)dm,     +∫(x²+z²)dm, -∫(yz)dm    ]
///      [ixz, iyz, izz]   [ -∫(xz)dm,     -∫(yz)dm,    +∫(x²+y²)dm ]
/// @endcode
///
/// @note Uses negative tensor notation consistent with e.g. robotics URDF files.
/// @note Many CAD tools (e.g., Solidworks) use positive tensor notation requiring negation of off-diagonal terms. See https://www.mathworks.com/help/sm/ug/specify-custom-inertia.html.
/// @note Must be finite. A finite but physically invalid tensor (negative principal moments or one violating the triangle inequality) is accepted with a warning, not rejected.
/// @note If not set, computed automatically from geometry and density.
/// @note Usually combined with explicit centerOfMass.
///
/// @see @ref mochi::ArticulatedLinkParams::centerOfMass "centerOfMass"
///

/// @var mochi::ArticulatedLinkParams::boundaryElementType
///
/// @brief Finite element type for boundary discretization.
///
/// @note Affects accuracy and performance of contact and boundary integrals.
///

/// @var mochi::ArticulatedLinkParams::boundarySubsampling
///
/// @brief Optional subsampling for boundary integrals such as contact.
///
/// @note Reduces computational cost by using fewer sample points.
/// @note For best performance, combine subsampling with @ref mochi::ArticulatedLinkParams::boundaryElementType "boundaryElementType" = @ref mochi::ActorBoundaryElementType::P1Q1 "ActorBoundaryElementType::P1Q1".
///

/// @struct mochi::ArticulatedSkinParams
///
/// @brief Optional skinned mesh attached to an articulated actor for collision and rendering.
///
/// @details The skin is a triangle mesh deformed by the underlying articulated links. It acts as a colliding actor (its contact sample points are tested against other actors' collider geometry) but not as a collider actor (other actors' contact sample points are not tested against it).
///
/// @see @ref mochi::ArticulatedActorParams::skin "ArticulatedActorParams::skin"
///

/// @var mochi::ArticulatedSkinParams::shape
///
/// @brief Shape handle defining the skinned triangle mesh.
///
/// @note A shape can be shared by multiple actors, even actors in different scenes.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::LoadShapeFromFile "Context::LoadShapeFromFile"
///

/// @var mochi::ArticulatedSkinParams::layer
///
/// @brief Contact layer name for filtering contacts between actors.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::ArticulatedSkinParams::contact
///
/// @brief Contact mechanics parameters.
///

/// @var mochi::ArticulatedSkinParams::boundaryElementType
///
/// @brief Finite element type for boundary discretization.
///
/// @note Affects accuracy and performance of contact and boundary integrals.
///

/// @var mochi::ArticulatedSkinParams::boundarySubsampling
///
/// @brief Optional subsampling for boundary integrals such as contact.
///
/// @note Reduces computational cost by using fewer sample points.
/// @note For best performance, combine subsampling with @ref mochi::ArticulatedSkinParams::boundaryElementType "boundaryElementType" = @ref mochi::ActorBoundaryElementType::P1Q1 "ActorBoundaryElementType::P1Q1".
///

/// @struct mochi::ArticulatedCycleJointParams
///
/// @brief Parameters for a cycle-closing joint within an articulated actor.
///
/// @details Cycle joints close loops in the kinematic chain, enabling topologies beyond simple trees. Implemented as a soft spherical joint constraint (see @ref mochi::ArticulatedCycleJointParams::jointFromChildLink "jointFromChildLink" and @ref mochi::ArticulatedCycleJointParams::stiffness "stiffness").
///
/// @see @ref mochi::ArticulatedActorParams::cycles "ArticulatedActorParams::cycles", @ref mochi::ArticulatedCycleJoint "ArticulatedCycleJoint"
///

/// @var mochi::ArticulatedCycleJointParams::parentLink
///
/// @brief Parent link index.
///

/// @var mochi::ArticulatedCycleJointParams::childLink
///
/// @brief Child link index.
///

/// @var mochi::ArticulatedCycleJointParams::jointFromChildLink
///
/// @brief Position and rotation of the cycle joint constraint in the child link's local frame.
///
/// @note A cycle joint is implemented using a spherical joint constraint. The @ref mochi::ArticulatedCycleJointParams::jointFromChildLink "jointFromChildLink" translation defines the pivot point, in the child link's local frame. Rotation is currently unused, but it could affect joint limits in the future.
///

/// @var mochi::ArticulatedCycleJointParams::stiffness
///
/// @brief Stiffness [N/m] for the cycle joint constraint.
///

/// @struct mochi::ArticulatedActorParams
///
/// @brief Parameters to create an articulated actor.
///
/// @details Articulated actors are composed of rigid links connected by joints, forming a kinematic tree with optional cycle joints. Per-link properties are supplied via @ref mochi::ArticulatedActorParams::links "links", per-joint properties via @ref mochi::ArticulatedActorParams::joints "joints", and cycle-closing joints via @ref mochi::ArticulatedActorParams::cycles "cycles". An optional skinned surface mesh can be attached via @ref mochi::ArticulatedActorParams::skin "skin".
///
/// Contact is automatically disabled between links that are: (a) directly adjacent, (b) reachable via hard joints, or (c) reachable via (dummy) shapeless links. To enable or disable contact for specific pairs of links, see @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric".
///
/// @see @ref mochi::Scene::CreateArticulatedActor "Scene::CreateArticulatedActor"
///

/// @var mochi::ArticulatedActorParams::name
///
/// @brief Name of the articulated actor.
///
/// @note Uniqueness of names is not enforced.
/// @note Link actor names have the form "articulatedActorName/linkLocalName", where `linkLocalName` is the link's local name. If the articulated actor name is empty, link actors use "unnamed_articulation" as the parent name.
///

/// @var mochi::ArticulatedActorParams::worldFromRoot
///
/// @brief Initial rotation and translation of the articulated actor's local frame with respect to world frame.
///

/// @var mochi::ArticulatedActorParams::cycles
///
/// @brief Optional cycle joints creating closed kinematic loops. Empty if no cycles exist.
///

/// @var mochi::ArticulatedActorParams::joints
///
/// @brief Joint parameters (one per joint).
///
/// @note Size must match @ref mochi::ArticulatedActorParams::links "links".
///

/// @var mochi::ArticulatedActorParams::links
///
/// @brief Link actor parameters (one per link). Must contain at least one link.
///
/// @note Size must match @ref mochi::ArticulatedActorParams::joints "joints".
/// @note Links must be listed in parent-first order: the root link is at index 0 with `parentLink == -1`, and any other link's `parentLink` must be smaller than its own index.
///

/// @var mochi::ArticulatedActorParams::skin
///
/// @brief Optional skinned mesh parameters.
///

/// @var mochi::ArticulatedActorParams::jointVelocities
///
/// @brief Optional initial joint velocity per DoF [m/s or rad/s].
///
/// @see @ref mochi::Actor::GetArticulatedJointVelocities "Actor::GetArticulatedJointVelocities", @ref mochi::Actor::SetArticulatedJointVelocities "Actor::SetArticulatedJointVelocities"
///

/// @struct mochi::SoftSkinnedActorParams
///
/// @brief Parameters to create soft-skinned actors with a shared articulated skeleton.
///
/// @details Soft-skinned actors combine deformable soft bodies with an articulated skeleton, allowing realistic tissue simulation that follows skeletal motion.
///
/// @see @ref mochi::Scene::CreateSoftSkinnedActor "Scene::CreateSoftSkinnedActor"
///

/// @var mochi::SoftSkinnedActorParams::skeletonParams
///
/// @brief Parameters for the articulated skeleton.
///
/// @note If a skin shape is provided, the skin mesh acts as the colliding surface, not the individual soft actor surfaces. The skin shape must include blending data to define how the skinned surfaces of the soft actors are blended with the overarching skin. Each soft actor must be linked to its corresponding blending data via its effective nested soft local name after default-name assignment.
///
/// @see @ref mochi::ArticulatedActorParams "ArticulatedActorParams", @ref mochi::ArticulatedSkinParams "ArticulatedSkinParams"
///

/// @var mochi::SoftSkinnedActorParams::softParams
///
/// @brief Parameters for the soft deformable actors.
///
/// @note If a skin shape is provided, the skin mesh acts as the colliding surface, not the individual soft actor surfaces.
/// @note If a skin shape is provided, dynamic hyper-reduction is not allowed on the soft actors.
/// @note If a @ref mochi::SoftActorParams "SoftActorParams" entry has its hasInertia set to true, inertia is applied in the unposed configuration of that actor (prior to skinning) and this struct's hasInertia must be false.
/// @note If a @ref mochi::SoftActorParams "SoftActorParams" entry has its hasStress set to true, elasticity is applied in the unposed configuration of that actor (prior to skinning) and this struct's hasStress must be false.
/// @note Each @ref mochi::SoftActorParams "SoftActorParams" entry must have its hasGravity set to false (use this struct's hasGravity instead).
/// @note Each soft actor must have some DoFs constrained. This can be implemented (a) by constraining nodes in the @ref mochi::SoftActorParams "SoftActorParams" shape for FOM actors, or (b) by constraining the ROM subspace for ROM actors.
/// @note Each soft actor must have at least one energy term enabled: either this struct's @ref mochi::SoftSkinnedActorParams::hasGravity "hasGravity", @ref mochi::SoftSkinnedActorParams::hasInertia "hasInertia" or @ref mochi::SoftSkinnedActorParams::hasStress "hasStress" (applied to every entry), or that entry's own @ref mochi::SoftActorParams::hasInertia "SoftActorParams::hasInertia" or @ref mochi::SoftActorParams::hasStress "SoftActorParams::hasStress".
/// @note Each entry's @ref mochi::SoftActorParams::name "SoftActorParams::name" is a nested soft local name. Explicit non-empty names must be unique across skeleton link local names and other nested soft local names, and must not contain forward slash, backslash, or embedded NUL characters.
/// @note Empty names are assigned deterministically after reserving all skeleton link names and all explicit nested soft names: an empty entry at index `i` uses `soft_i` if available; otherwise it uses the first available `soft_N` found by scanning upward from `N = 0`.
/// @note Each entry's @ref mochi::SoftActorParams::worldFromLocal "SoftActorParams::worldFromLocal" must be identity. Each soft actor's shape must be defined directly in the reference frame of the articulated actor. The soft-skinned actor's placement in scene world is provided by @ref mochi::ArticulatedActorParams::worldFromRoot "ArticulatedActorParams::worldFromRoot" from @ref mochi::SoftSkinnedActorParams::skeletonParams "skeletonParams".
///
/// @see @ref mochi::SoftSkinnedActorParams::hasGravity "hasGravity", @ref mochi::SoftSkinnedActorParams::hasInertia "hasInertia", @ref mochi::SoftSkinnedActorParams::hasStress "hasStress"
///

/// @var mochi::SoftSkinnedActorParams::softAttachLinks
///
/// @brief Optional local names of the rigid links where soft actors are attached.
///
/// @note If empty, soft actor shapes must include skinning data.
/// @note If provided, must be 1-to-1 with @ref mochi::SoftSkinnedActorParams::softParams "softParams". Each entry must be non-empty and must match a skeleton link local name.
/// @note Contact is automatically disabled between soft actors and their attachment links.
///

/// @var mochi::SoftSkinnedActorParams::enableCollidingLinks
///
/// @brief Enable internal skeleton links as colliding actors.
///
/// @note If false, only the soft actors or the skin mesh act as colliding actors.
///

/// @var mochi::SoftSkinnedActorParams::hasGravity
///
/// @brief Enable gravity evaluation of soft actors on posed/skinned positions.
///
/// @note Each @ref mochi::SoftActorParams "SoftActorParams" entry must have its hasGravity set to false.
///
/// @see @ref mochi::Scene::SetGravity "Scene::SetGravity"
///

/// @var mochi::SoftSkinnedActorParams::hasInertia
///
/// @brief Enable inertia evaluation of soft actors on posed/skinned positions.
///
/// @note If true, each @ref mochi::SoftActorParams "SoftActorParams" entry must have its hasInertia set to false.
/// @note If true, inertia is applied in the posed (post-skinning) configuration. This is the physically correct behavior.
/// @note If false, inertia is applied in the unposed configuration for each @ref mochi::SoftActorParams "SoftActorParams" entry that has its hasInertia set to true. This is an approximation but may improve performance.
///

/// @var mochi::SoftSkinnedActorParams::hasStress
///
/// @brief Enable elasticity evaluation of soft actors on posed/skinned positions.
///
/// @note If true, each @ref mochi::SoftActorParams "SoftActorParams" entry must have its hasStress set to false.
/// @note If true, stress forces are applied in the posed (post-skinning) configuration. This is the physically correct behavior.
/// @note If false, stress forces are applied in the unposed configuration for each @ref mochi::SoftActorParams "SoftActorParams" entry that has its hasStress set to true. This is an approximation but may improve performance.
///

/// @struct mochi::ConstraintParams
///
/// @brief Base constraint parameters.
///
/// @details All constraint types inherit from this struct and add their specific parameters. Constraints apply forces and torques using a spring-damper model. Without saturation, the stiffness contribution is proportional to displacement or angular deviation, and the damping contribution is proportional to the corresponding linear or angular velocity. Their respective coefficients are @ref mochi::ConstraintParams::stiffness "stiffness" and @ref mochi::ConstraintParams::damping "damping". @ref mochi::ConstraintParams::saturation "saturation" limits only the stiffness contribution.
///
/// @note SuperDex Physics uses the International System of Units (SI) by default. Other units can be used, but doing so requires overwriting all dimensional default parameters (material, contact, constraints, solver, etc.) to ensure all units remain consistent.
///
/// @see @ref mochi::ConstraintType "ConstraintType"
///

/// @var mochi::ConstraintParams::stiffness
///
/// @brief Constraint stiffness coefficient. [N/m] for translation constraints, [N·m/rad] for rotation constraints. Must be non-negative and finite.
///

/// @var mochi::ConstraintParams::damping
///
/// @brief Constraint damping coefficient. [N·s/m] for translation constraints, [N·m·s/rad] for rotation constraints. Must be non-negative and finite.
///

/// @var mochi::ConstraintParams::saturation
///
/// @brief Saturation distance [m] or angle [rad]. A negative value disables saturation. Must be finite and non-zero.
///
/// @note When enabled, saturation smoothly limits the magnitude of the elastic (stiffness) contribution to @ref mochi::ConstraintParams::stiffness "stiffness" * @ref mochi::ConstraintParams::saturation "saturation". The damping contribution is separate and is not limited by saturation.
///

/// @struct mochi::RigidSphericalJointConstraintParams
///
/// @brief Parameters for creating a spherical joint between two rigid actors.
///
/// @see @ref mochi::Scene::CreateRigidSphericalJointConstraint "Scene::CreateRigidSphericalJointConstraint", @ref mochi::ConstraintType::RigidSphericalJoint "ConstraintType::RigidSphericalJoint"
///

/// @var mochi::RigidSphericalJointConstraintParams::localPosA
///
/// @brief Joint position [m] for rigid actor A in actor A's local frame.
///

/// @var mochi::RigidSphericalJointConstraintParams::localPosB
///
/// @brief Joint position [m] for rigid actor B in actor B's local frame.
///

/// @var mochi::RigidSphericalJointConstraintParams::actorA
///
/// @brief Actor handle identifying rigid actor A.
///

/// @var mochi::RigidSphericalJointConstraintParams::actorB
///
/// @brief Actor handle identifying rigid actor B.
///

/// @struct mochi::RigidPrismaticJointConstraintParams
///
/// @brief Parameters for creating a prismatic joint between two rigid actors.
///
/// @note Constrains translation perpendicular to the free axis (and optionally limits translation along it). Does not constrain rotation.
/// @note It must be complemented with @ref mochi::JointRotationTrackingConstraintParams "JointRotationTrackingConstraintParams" to constrain the rotation and implement a full prismatic joint.
///
/// @see @ref mochi::Scene::CreateRigidPrismaticJointConstraint "Scene::CreateRigidPrismaticJointConstraint", @ref mochi::ConstraintType::RigidPrismaticJoint "ConstraintType::RigidPrismaticJoint", @ref mochi::JointRotationTrackingConstraintParams "JointRotationTrackingConstraintParams"
///

/// @var mochi::RigidPrismaticJointConstraintParams::freeAxis
///
/// @brief Axis of free translation, specified in the world frame at constraint creation time.
///
/// @note The axis is captured at creation and thereafter rigidly attached to actor A: it rotates with actor A rather than remaining fixed in world space.
/// @note Must be non-zero and finite.
/// @note Its magnitude is ignored (normalized internally).
///

/// @var mochi::RigidPrismaticJointConstraintParams::actorA
///
/// @brief Actor handle identifying rigid actor A.
///

/// @var mochi::RigidPrismaticJointConstraintParams::actorB
///
/// @brief Actor handle identifying rigid actor B.
///

/// @var mochi::RigidPrismaticJointConstraintParams::max
///
/// @brief Maximum translation [m] relative to rest position. Empty means unbounded.
///

/// @var mochi::RigidPrismaticJointConstraintParams::min
///
/// @brief Minimum translation [m] relative to rest position. Empty means unbounded.
///

/// @struct mochi::DeformableNodeToDeformableNodeConstraintParams
///
/// @brief Parameters for creating a constraint coupling a node in a deformable actor to a node in another deformable actor.
///
/// @see @ref mochi::Scene::CreateDeformableNodeToDeformableNodeConstraint "Scene::CreateDeformableNodeToDeformableNodeConstraint", @ref mochi::ConstraintType::DeformableNodeToDeformableNode "ConstraintType::DeformableNodeToDeformableNode"
///

/// @var mochi::DeformableNodeToDeformableNodeConstraintParams::nodeIndexA
///
/// @brief Node index in deformable actor A's reference simulation mesh, as returned by @ref mochi::Actor::GetMesh "Actor::GetMesh". Ignored if @ref mochi::DeformableNodeToDeformableNodeConstraintParams::findClosest "findClosest" is true; otherwise it must identify a node in that mesh.
///

/// @var mochi::DeformableNodeToDeformableNodeConstraintParams::nodeIndexB
///
/// @brief Node index in deformable actor B's reference simulation mesh, as returned by @ref mochi::Actor::GetMesh "Actor::GetMesh". Ignored if @ref mochi::DeformableNodeToDeformableNodeConstraintParams::findClosest "findClosest" is true; otherwise it must identify a node in that mesh.
///

/// @var mochi::DeformableNodeToDeformableNodeConstraintParams::actorA
///
/// @brief Actor handle identifying deformable actor A.
///

/// @var mochi::DeformableNodeToDeformableNodeConstraintParams::actorB
///
/// @brief Actor handle identifying deformable actor B.
///

/// @var mochi::DeformableNodeToDeformableNodeConstraintParams::findClosest
///
/// @brief Whether to automatically select a boundary node on each actor.
///
/// @note When true, selection is based on proximity to the world-space midpoint of the actors' root-frame origins and occurs at constraint creation using their undeformed reference simulation meshes. @ref mochi::DeformableNodeToDeformableNodeConstraintParams::nodeIndexA "nodeIndexA" and @ref mochi::DeformableNodeToDeformableNodeConstraintParams::nodeIndexB "nodeIndexB" are ignored.
/// @note When true, both actors must be soft actors (shell and rod actors are not supported).
///

/// @struct mochi::RodElementRotationToRigidConstraintParams
///
/// @brief Parameters for creating a tracking constraint on the relative rotation between a rigid actor and a rod element.
///
/// @details Forces the relative rotation between the rigid actor and a specified rod element to track a target rotation. The target rotation is initialized to the relative rotation observed at constraint creation time, and can be updated at runtime via @ref mochi::Constraint::SetTargetRotation "Constraint::SetTargetRotation".
///
/// @see @ref mochi::Scene::CreateRodElementRotationToRigidConstraint "Scene::CreateRodElementRotationToRigidConstraint", @ref mochi::ConstraintType::RodElementRotationToRigid "ConstraintType::RodElementRotationToRigid", @ref mochi::Constraint::SetTargetRotation "Constraint::SetTargetRotation"
///

/// @var mochi::RodElementRotationToRigidConstraintParams::refFrameRotVec
///
/// @brief Joint reference-frame orientation in world coordinates at constraint creation, expressed as a rotation vector [rad].
///
/// @note After creation, the frame remains fixed relative to the rigid actor.
///

/// @var mochi::RodElementRotationToRigidConstraintParams::rigidActor
///
/// @brief Actor handle identifying rigid actor.
///

/// @var mochi::RodElementRotationToRigidConstraintParams::rodActor
///
/// @brief Actor handle identifying rod actor.
///

/// @var mochi::RodElementRotationToRigidConstraintParams::elementIndex
///
/// @brief Index of the element in the rod actor.
///

/// @struct mochi::DeformableNodeToRigidConstraintParams
///
/// @brief Parameters for creating a constraint coupling a deformable node to a rigid actor.
///
/// @see @ref mochi::Scene::CreateDeformableNodeToRigidConstraint "Scene::CreateDeformableNodeToRigidConstraint", @ref mochi::ConstraintType::DeformableNodeToRigid "ConstraintType::DeformableNodeToRigid"
///

/// @var mochi::DeformableNodeToRigidConstraintParams::rigidLocalPos
///
/// @brief Coupling position [m] in rigid actor's local frame.
///
/// @note When @ref mochi::DeformableNodeToRigidConstraintParams::fixToDeformablePos "fixToDeformablePos" is true, this field is ignored and the coupling position is auto-computed based on the deformable node's initial position in the rigid actor's frame.
/// @note When @ref mochi::DeformableNodeToRigidConstraintParams::findClosest "findClosest" is also true, this field is still used as the search point that selects which deformable node is picked.
///

/// @var mochi::DeformableNodeToRigidConstraintParams::deformableNodeIndex
///
/// @brief Node index in the deformable actor's reference simulation mesh, as returned by @ref mochi::Actor::GetMesh "Actor::GetMesh". Ignored if @ref mochi::DeformableNodeToRigidConstraintParams::findClosest "findClosest" is true; otherwise it must identify a node in that mesh.
///

/// @var mochi::DeformableNodeToRigidConstraintParams::rigidActor
///
/// @brief Actor handle identifying the rigid actor.
///

/// @var mochi::DeformableNodeToRigidConstraintParams::deformableActor
///
/// @brief Actor handle identifying the deformable actor.
///

/// @var mochi::DeformableNodeToRigidConstraintParams::findClosest
///
/// @brief Whether to automatically select a boundary node of the deformable actor.
///
/// @note When true, selection is based on proximity to @ref mochi::DeformableNodeToRigidConstraintParams::rigidLocalPos "rigidLocalPos" transformed to world space by the rigid actor's transform at constraint creation. Selection uses the deformable actor's undeformed reference simulation mesh, and @ref mochi::DeformableNodeToRigidConstraintParams::deformableNodeIndex "deformableNodeIndex" is ignored.
/// @note When true, the deformable actor must be a soft actor (shell and rod actors are not supported).
///

/// @var mochi::DeformableNodeToRigidConstraintParams::fixToDeformablePos
///
/// @brief When true, the coupling position on the rigid actor is auto-computed to match the deformable node's initial position (in the rigid actor's frame), so the constraint starts at zero deviation, and @ref mochi::DeformableNodeToRigidConstraintParams::rigidLocalPos "rigidLocalPos" is ignored.
///
/// @note When @ref mochi::DeformableNodeToRigidConstraintParams::findClosest "findClosest" is also true, @ref mochi::DeformableNodeToRigidConstraintParams::rigidLocalPos "rigidLocalPos" is still used as the search point that selects which deformable node is picked.
///

/// @struct mochi::JointRotationRangeConstraintParams
///
/// @brief Parameters for creating a joint rotation range constraint between two rigid actors.
///
/// @details Constrains the relative rotation between two rigid actors to remain within specified bounds. The relative rotation is expressed in a joint reference frame (captured at constraint creation time and rigidly attached to actor A thereafter), and each component of its rotation-vector (axis-angle) representation is independently constrained to its [min, max] range.
///
/// @see @ref mochi::Scene::CreateJointRotationRangeConstraint "Scene::CreateJointRotationRangeConstraint", @ref mochi::ConstraintType::JointRotationRange "ConstraintType::JointRotationRange"
///

/// @var mochi::JointRotationRangeConstraintParams::refFrameRotVec
///
/// @brief Joint reference frame specified as a rotation vector [rad] with respect to world frame.
///

/// @var mochi::JointRotationRangeConstraintParams::angleRangeX
///
/// @brief Allowed range [min, max] [rad] for the X component of the relative rotation vector (axis-angle), expressed in the joint reference frame.
///

/// @var mochi::JointRotationRangeConstraintParams::angleRangeY
///
/// @brief Allowed range [min, max] [rad] for the Y component of the relative rotation vector (axis-angle), expressed in the joint reference frame.
///

/// @var mochi::JointRotationRangeConstraintParams::angleRangeZ
///
/// @brief Allowed range [min, max] [rad] for the Z component of the relative rotation vector (axis-angle), expressed in the joint reference frame.
///

/// @var mochi::JointRotationRangeConstraintParams::actorA
///
/// @brief Actor handle identifying rigid actor A.
///

/// @var mochi::JointRotationRangeConstraintParams::actorB
///
/// @brief Actor handle identifying rigid actor B.
///

/// @var mochi::JointRotationRangeConstraintParams::rangeAroundRest
///
/// @brief When true, angle limits are relative to the actors' relative rotation at constraint creation time. When false, limits are absolute in the joint reference frame.
///

/// @struct mochi::RigidPivotPositionConstraintParams
///
/// @brief Parameters for creating a position constraint on a rigid actor's pivot point.
///
/// @details Couples a point on a rigid actor (expressed in the actor's local coordinates and referred to as "pivot") to a specific target position in world coordinates.
///
/// @see @ref mochi::Scene::CreateRigidPivotPositionConstraint "Scene::CreateRigidPivotPositionConstraint", @ref mochi::ConstraintType::RigidPivotPosition "ConstraintType::RigidPivotPosition"
///

/// @var mochi::RigidPivotPositionConstraintParams::targetPosition
///
/// @brief Target position in world frame [m].
///

/// @var mochi::RigidPivotPositionConstraintParams::localPosition
///
/// @brief Pivot point in rigid actor's local frame [m].
///

/// @var mochi::RigidPivotPositionConstraintParams::actor
///
/// @brief Actor handle identifying the rigid actor.
///

/// @struct mochi::RigidPivotToRigidTargetConstraintParams
///
/// @brief Parameters for creating a constraint on a rigid actor's pivot point. The target is expressed as the center-of-mass transform of the actor.
///
/// @details Couples a point on a rigid actor (expressed in the actor's local coordinates and referred to as "pivot") to the world position of the pivot under a target center-of-mass transform.
///
/// @see @ref mochi::Scene::CreateRigidPivotToRigidTargetConstraint "Scene::CreateRigidPivotToRigidTargetConstraint", @ref mochi::ConstraintType::RigidPivotToRigidTarget "ConstraintType::RigidPivotToRigidTarget"
///

/// @var mochi::RigidPivotToRigidTargetConstraintParams::targetTransform
///
/// @brief Target center-of-mass transform.
///

/// @var mochi::RigidPivotToRigidTargetConstraintParams::localPosition
///
/// @brief Pivot point in rigid actor's local frame [m].
///

/// @var mochi::RigidPivotToRigidTargetConstraintParams::actor
///
/// @brief Actor handle identifying the rigid actor.
///

/// @struct mochi::RigidPivotRotationConstraintParams
///
/// @brief Parameters for creating a rotation constraint on a rigid actor's pivot frame.
///
/// @details Couples a frame on a rigid actor (expressed in the actor's local coordinates and referred to as "pivot") to a specific target rotation in world coordinates.
///
/// @see @ref mochi::Scene::CreateRigidPivotRotationConstraint "Scene::CreateRigidPivotRotationConstraint", @ref mochi::ConstraintType::RigidPivotRotation "ConstraintType::RigidPivotRotation"
///

/// @var mochi::RigidPivotRotationConstraintParams::targetRotation
///
/// @brief Target rotation in world coordinates, as a rotation vector [rad].
///

/// @var mochi::RigidPivotRotationConstraintParams::localRotation
///
/// @brief Pivot frame in rigid actor's local coordinates, as a rotation vector [rad].
///

/// @var mochi::RigidPivotRotationConstraintParams::actor
///
/// @brief Actor handle identifying the rigid actor.
///

/// @struct mochi::DeformableNodePositionConstraintParams
///
/// @brief Parameters for creating a position constraint on a deformable actor node.
///
/// @see @ref mochi::Scene::CreateDeformableNodePositionConstraint "Scene::CreateDeformableNodePositionConstraint", @ref mochi::ConstraintType::DeformableNodePosition "ConstraintType::DeformableNodePosition"
///

/// @var mochi::DeformableNodePositionConstraintParams::nodeIndex
///
/// @brief Node index in the deformable actor's reference simulation mesh, as returned by @ref mochi::Actor::GetMesh "Actor::GetMesh". Must identify a node in that mesh.
///

/// @var mochi::DeformableNodePositionConstraintParams::position
///
/// @brief Target position for the node in world frame [m].
///

/// @var mochi::DeformableNodePositionConstraintParams::actor
///
/// @brief Actor handle identifying the deformable actor.
///

/// @struct mochi::JointRotationTrackingConstraintParams
///
/// @brief Parameters for creating a joint rotation tracking constraint between two rigid actors.
///
/// @details Forces the relative rotation between two rigid actors to track a target rotation. The target rotation is initialized to the relative rotation observed at constraint creation time, and can be updated at runtime via @ref mochi::Constraint::SetTargetRotation "Constraint::SetTargetRotation". The relative rotation vector is expressed in a reference frame specified by @ref mochi::JointRotationTrackingConstraintParams::refFrameRotVec "refFrameRotVec".
///
/// @note Sometimes used in combination with @ref mochi::RigidPrismaticJointConstraintParams "RigidPrismaticJointConstraintParams" to fully constrain rotation in a prismatic joint.
///
/// @see @ref mochi::Scene::CreateJointRotationTrackingConstraint "Scene::CreateJointRotationTrackingConstraint", @ref mochi::ConstraintType::JointRotationTracking "ConstraintType::JointRotationTracking", @ref mochi::RigidPrismaticJointConstraintParams "RigidPrismaticJointConstraintParams", @ref mochi::Constraint::SetTargetRotation "Constraint::SetTargetRotation"
///

/// @var mochi::JointRotationTrackingConstraintParams::refFrameRotVec
///
/// @brief Joint reference-frame orientation in world coordinates at constraint creation, expressed as a rotation vector [rad].
///
/// @note After creation, the frame remains fixed relative to actor A.
///

/// @var mochi::JointRotationTrackingConstraintParams::actorA
///
/// @brief Actor handle identifying rigid actor A.
///

/// @var mochi::JointRotationTrackingConstraintParams::actorB
///
/// @brief Actor handle identifying rigid actor B.
///

/// @struct mochi::ArticulatedSingleDofTargetConstraintParams
///
/// @brief Parameters for creating a target constraint on a single articulated DoF.
///
/// @details Forces the specified degree of freedom in a joint of an articulated actor to track a given target value. This drives the joint toward a desired configuration.
///
/// @note It applies only to translation DoFs (free or prismatic joints) or single-DoF rotation joints (revolute). For 3D rotation joints (spherical or free), use instead @ref mochi::Articulated3dRotationTargetConstraintParams "Articulated3dRotationTargetConstraintParams".
///
/// @see @ref mochi::Scene::CreateArticulatedSingleDofTargetConstraint "Scene::CreateArticulatedSingleDofTargetConstraint", @ref mochi::ConstraintType::ArticulatedSingleDofTarget "ConstraintType::ArticulatedSingleDofTarget"
///

/// @var mochi::ArticulatedSingleDofTargetConstraintParams::actor
///
/// @brief Actor handle identifying the articulated actor.
///

/// @var mochi::ArticulatedSingleDofTargetConstraintParams::jointIndex
///
/// @brief Index of the joint in the articulated actor.
///

/// @var mochi::ArticulatedSingleDofTargetConstraintParams::dofIndex
///
/// @brief DoF index within the joint (0-based). Translation DoFs come first, then rotation DoFs. For free joints, only translation indices are accepted (use @ref mochi::Articulated3dRotationTargetConstraintParams "Articulated3dRotationTargetConstraintParams" to target the 3D rotation).
///

/// @var mochi::ArticulatedSingleDofTargetConstraintParams::targetValue
///
/// @brief Target value for the joint DoF. Units are [m] for translation DoFs, [rad] for rotation DoFs.
///

/// @struct mochi::Articulated3dRotationTargetConstraintParams
///
/// @brief Parameters for creating a target constraint on 3D rotation DoFs of an articulated actor.
///
/// @details Forces the rotation degrees of freedom of a spherical or free joint in an articulated actor to track a given target orientation. This drives the joint toward a desired rotational configuration.
///
/// @note Applies only to joints with 3D rotation DoFs (spherical joints, or the rotational part of free joints).
///
/// @see @ref mochi::Scene::CreateArticulated3dRotationTargetConstraint "Scene::CreateArticulated3dRotationTargetConstraint", @ref mochi::ConstraintType::Articulated3dRotationTarget "ConstraintType::Articulated3dRotationTarget"
///

/// @var mochi::Articulated3dRotationTargetConstraintParams::actor
///
/// @brief Actor handle identifying the articulated actor.
///

/// @var mochi::Articulated3dRotationTargetConstraintParams::jointIndex
///
/// @brief Index of the joint in the articulated actor.
///

/// @var mochi::Articulated3dRotationTargetConstraintParams::target
///
/// @brief Target rotation relative to the joint's rest orientation, expressed in the joint's local frame as a quaternion [x, y, z, w]. The identity quaternion corresponds to the rest orientation.
///
/// @note Must be finite and non-zero. Normalized before use.
///

/// @struct mochi::ArticulatedSingleDofRangeConstraintParams
///
/// @brief Parameters for creating a range constraint on a single articulated DoF.
///
/// @details Limits a degree of freedom of a joint in an articulated actor to remain within specified [min, max] bounds. This prevents the joint from exceeding its mechanical limits.
///
/// @note It applies only to translation DoFs (free or prismatic joints) or single-DoF rotation joints (revolute). For 3D rotation joints (spherical or free), use instead @ref mochi::Articulated3dRotationRangeConstraintParams "Articulated3dRotationRangeConstraintParams".
///
/// @see @ref mochi::Scene::CreateArticulatedSingleDofRangeConstraint "Scene::CreateArticulatedSingleDofRangeConstraint", @ref mochi::ConstraintType::ArticulatedSingleDofRange "ConstraintType::ArticulatedSingleDofRange"
///

/// @var mochi::ArticulatedSingleDofRangeConstraintParams::actor
///
/// @brief Actor handle identifying the articulated actor.
///

/// @var mochi::ArticulatedSingleDofRangeConstraintParams::jointIndex
///
/// @brief Index of the joint in the articulated actor.
///

/// @var mochi::ArticulatedSingleDofRangeConstraintParams::dofIndex
///
/// @brief DoF index within the joint (0-based). Translation DoFs come first, then rotation DoFs. For free joints, only translation indices are accepted (use @ref mochi::Articulated3dRotationRangeConstraintParams "Articulated3dRotationRangeConstraintParams" to constrain the 3D rotation).
///

/// @var mochi::ArticulatedSingleDofRangeConstraintParams::minValue
///
/// @brief Minimum value for the DoF. [m] for translation DoFs, [rad] for rotation DoFs.
///

/// @var mochi::ArticulatedSingleDofRangeConstraintParams::maxValue
///
/// @brief Maximum value for the DoF. [m] for translation DoFs, [rad] for rotation DoFs.
///

/// @struct mochi::Articulated3dRotationRangeConstraintParams
///
/// @brief Parameters for creating a range constraint on a 3D-rotation articulated joint.
///
/// @details Constrains each component of a spherical or free joint's local rotation vector (rotation axis multiplied by rotation angle) to its corresponding [min, max] range. Use this constraint to model the joint's mechanical rotation limits.
///
/// @see @ref mochi::Scene::CreateArticulated3dRotationRangeConstraint "Scene::CreateArticulated3dRotationRangeConstraint", @ref mochi::ConstraintType::Articulated3dRotationRange "ConstraintType::Articulated3dRotationRange"
///

/// @var mochi::Articulated3dRotationRangeConstraintParams::actor
///
/// @brief Actor handle identifying the articulated actor.
///

/// @var mochi::Articulated3dRotationRangeConstraintParams::jointIndex
///
/// @brief Index of the joint in the articulated actor.
///

/// @var mochi::Articulated3dRotationRangeConstraintParams::minValues
///
/// @brief Minimum allowed value [rad] for each component of the joint-local rotation vector.
///

/// @var mochi::Articulated3dRotationRangeConstraintParams::maxValues
///
/// @brief Maximum allowed value [rad] for each component of the joint-local rotation vector.
///

/// @struct mochi::ContactPoint
///
/// @brief Information about a contact point between two actors.
///
/// @details Describes a single contact or near-contact point between two actors. Contains geometric information (positions, normal, distance), kinematic data (velocities), and dynamic data (force). Also includes finite element discretization information for accurate force interpolation.
///
/// @note Available via @ref mochi::Actor::GetContactPointsWorld "Actor::GetContactPointsWorld" after registering @ref mochi::QueryType::ContactPoints "QueryType::ContactPoints".
///
/// @see @ref mochi::QueryType::ContactPoints "QueryType::ContactPoints", @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::GetContactPointsWorld "Actor::GetContactPointsWorld"
///

/// @var mochi::ContactPoint::actorA
///
/// @brief Handle of the colliding actor.
///
/// @note When calling @ref mochi::Actor::GetContactPointsWorld "Actor::GetContactPointsWorld", the actor being queried may be reported as either @ref mochi::ContactPoint::actorA "actorA" or @ref mochi::ContactPoint::actorB "actorB" in this struct, depending on the direction of the contact test.
/// @note May be the same as @ref mochi::ContactPoint::actorB "actorB" in the case of self-contact.
///

/// @var mochi::ContactPoint::actorB
///
/// @brief Handle of the collider actor.
///
/// @note When calling @ref mochi::Actor::GetContactPointsWorld "Actor::GetContactPointsWorld", the actor being queried may be reported as either @ref mochi::ContactPoint::actorA "actorA" or @ref mochi::ContactPoint::actorB "actorB" in this struct, depending on the direction of the contact test.
/// @note May be the same as @ref mochi::ContactPoint::actorA "actorA" in the case of self-contact.
///

/// @var mochi::ContactPoint::distance
///
/// @brief Signed separation distance [m] between @ref mochi::ContactPoint::posA "posA" (on @ref mochi::ContactPoint::actorA "actorA") and the closest point on the surface of @ref mochi::ContactPoint::actorB "actorB". Negative if the point is inside (i.e. actors overlap).
///

/// @var mochi::ContactPoint::posA
///
/// @brief Contact position [m] on @ref mochi::ContactPoint::actorA "actorA" in world frame.
///

/// @var mochi::ContactPoint::posB
///
/// @brief Approximate contact position [m] on @ref mochi::ContactPoint::actorB "actorB" in world frame.
///
/// @note Equivalent to (posA - normal * distance).
///

/// @var mochi::ContactPoint::normal
///
/// @brief Contact normal in world frame pointing away from @ref mochi::ContactPoint::actorB "actorB". Unit length.
///

/// @var mochi::ContactPoint::force
///
/// @brief Contact force [N] applied to @ref mochi::ContactPoint::actorA "actorA" from @ref mochi::ContactPoint::actorB "actorB" in world frame.
///

/// @var mochi::ContactPoint::pointVelocityA
///
/// @brief Velocity [m/s] of the contact point on @ref mochi::ContactPoint::actorA "actorA" in world frame.
///

/// @var mochi::ContactPoint::pointVelocityB
///
/// @brief Velocity [m/s] of the contact point on @ref mochi::ContactPoint::actorB "actorB" in world frame.
///

/// @var mochi::ContactPoint::sampleIndex
///
/// @brief Sample point index of @ref mochi::ContactPoint::actorA "actorA".
///

/// @var mochi::ContactPoint::intWeight
///
/// @brief Quadrature integration weight of the sample point on the colliding manifold of @ref mochi::ContactPoint::actorA "actorA".
///
/// @note Units depend on the dimensionality of the colliding manifold of @ref mochi::ContactPoint::actorA "actorA": [m²] for surface contact (e.g., rigid, articulated, soft, shell, and rod actors with visual-mesh contact enabled), or [m] for rod actors using centerline contact.
/// @note For surface contact, represents the surface area corresponding to the sample point. For rod centerline contact, represents the arc length.
/// @note Useful for contact area/length estimation and other post-processing.
/// @note @ref mochi::ContactPoint::force "force" is already weighted by this value.
///

/// @var mochi::ContactPoint::elementIndex
///
/// @brief Element index on the surface mesh of @ref mochi::ContactPoint::actorA "actorA".
///
/// @note For rod actors, this field is not populated and is reported as 0. Use @ref mochi::ContactPoint::sampleIndex "sampleIndex" to identify the contact location.
///

/// @var mochi::ContactPoint::parametricCoords
///
/// @brief Parametric coordinates within the surface element of @ref mochi::ContactPoint::actorA "actorA".
///
/// @note Corresponds to finite-element basis function values at the contact sample quadrature point.
/// @note For linear finite elements, these match barycentric coordinates.
/// @note Allows interpolation of functions defined on triangle vertices.
/// @note For rod actors, this field is not populated and is reported as {0, 0, 0}. Use @ref mochi::ContactPoint::sampleIndex "sampleIndex" to identify the contact location.
///

/// @struct mochi::NodeContactForce
///
/// @brief Contact force applied to a specific node.
///
/// @note Available via @ref mochi::Actor::GetNodeContactForcesWorld "Actor::GetNodeContactForcesWorld" after registering @ref mochi::QueryType::NodeContactForces "QueryType::NodeContactForces".
///
/// @see @ref mochi::QueryType::NodeContactForces "QueryType::NodeContactForces", @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::GetNodeContactForcesWorld "Actor::GetNodeContactForcesWorld"
///

/// @var mochi::NodeContactForce::index
///
/// @brief Node index in the volumetric mesh (for actors with a volumetric mesh) or surface mesh (for actors without a volumetric mesh).
///

/// @var mochi::NodeContactForce::force
///
/// @brief Contact force [N] applied to the node.
///

/// @struct mochi::SdfDistances
///
/// @brief SDF distance information for active contact sample points.
///
/// @details Stores signed distance field (SDF) values and gradients for contact sample points. Negative distances indicate penetration into the surface.
///
/// @note Available via @ref mochi::Actor::GetSdfDistances "Actor::GetSdfDistances" after registering @ref mochi::QueryType::SdfDistances "QueryType::SdfDistances".
///
/// @see @ref mochi::QueryType::SdfDistances "QueryType::SdfDistances", @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::GetSdfDistances "Actor::GetSdfDistances"
///

/// @var mochi::SdfDistances::sampleIndices
///
/// @brief Indices into the actor's contact sample points array.
///

/// @var mochi::SdfDistances::worldPositions
///
/// @brief Sample positions [m] in world frame.
///

/// @var mochi::SdfDistances::distances
///
/// @brief Signed distances [m] to the closest surface.
///
/// @note Negative values indicate penetration inside the surface.
///

/// @var mochi::SdfDistances::distanceGrads
///
/// @brief SDF gradients at sample positions, in world frame.
///

/// @var mochi::SdfDistances::maxSdfFarDistanceEvaluation
///
/// @brief Maximum distance [m] at which SDF evaluation was performed.
///
/// @note Non-zero only if the actor has far SDF evaluation enabled.
///

/// @struct mochi::AsyncStepParams
///
/// @brief Parameters controlling the stepping behavior of an @ref mochi::AsyncScene "AsyncScene".
///
/// @details Configures how an @ref mochi::AsyncScene "AsyncScene" determines the time step size. There are three modes for determining the time step size, evaluated in the following priority order:
///
/// 1. If @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" is set and returns a non-negative value, use the callback value.
/// 2. Else if @ref mochi::AsyncStepParams::useFixedTimeStep "useFixedTimeStep" is true, use @ref mochi::AsyncStepParams::fixedTimeStepSeconds "fixedTimeStepSeconds".
/// 3. Else, use elapsed real time since the last step (dynamic mode).
///
/// @see @ref mochi::AsyncScene::GetAsyncStepParams "AsyncScene::GetAsyncStepParams", @ref mochi::AsyncScene::SetAsyncStepParams "AsyncScene::SetAsyncStepParams"
///

/// @var mochi::AsyncStepParams::useFixedTimeStep
///
/// @brief Use fixed time step if true, dynamic (real-time) time step if false.
///
/// @note "Dynamic" means the time step equals elapsed wall-clock time since the last step.
/// @note Ignored if @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" is set and returns a non-negative value.
///
/// @see @ref mochi::AsyncStepParams::fixedTimeStepSeconds "AsyncStepParams::fixedTimeStepSeconds", @ref mochi::AsyncStepParams::timeStepCallback "AsyncStepParams::timeStepCallback"
///

/// @var mochi::AsyncStepParams::fixedTimeStepSeconds
///
/// @brief Fixed time step size [s].
///
/// @note Must be finite and non-negative.
/// @note Used when @ref mochi::AsyncStepParams::useFixedTimeStep "useFixedTimeStep" is true and @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" is not set or returns a negative value.
/// @note Also used by @ref mochi::AsyncScene::RequestStepThenPause "AsyncScene::RequestStepThenPause" when @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" is not set or returns a negative value, even if dynamic-time-step mode is configured.
///
/// @see @ref mochi::AsyncScene::RequestStepThenPause "AsyncScene::RequestStepThenPause", @ref mochi::AsyncStepParams::useFixedTimeStep "AsyncStepParams::useFixedTimeStep", @ref mochi::AsyncStepParams::timeStepCallback "AsyncStepParams::timeStepCallback"
///

/// @var mochi::AsyncStepParams::dynamicTimeStepMinSeconds
///
/// @brief Minimum time step size [s] in dynamic mode.
///
/// @note Dynamic mode is only used when @ref mochi::AsyncStepParams::useFixedTimeStep "useFixedTimeStep" is false and @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" either is not set or returns a negative value.
/// @note Must be finite. Negative values are clamped to zero. Values greater than @ref mochi::AsyncStepParams::dynamicTimeStepMaxSeconds "dynamicTimeStepMaxSeconds" are clamped down to that maximum.
///

/// @var mochi::AsyncStepParams::dynamicTimeStepMaxSeconds
///
/// @brief Maximum time step size [s] in dynamic mode.
///
/// @note Dynamic mode is only used when @ref mochi::AsyncStepParams::useFixedTimeStep "useFixedTimeStep" is false and @ref mochi::AsyncStepParams::timeStepCallback "timeStepCallback" either is not set or returns a negative value.
/// @note Must be finite. Negative values are clamped to zero.
///

/// @var mochi::AsyncStepParams::timeStepCallback
///
/// @brief Optional callback to provide custom time step size [s].
///
/// @note Called on the simulation thread before each step.
/// @note If set and it returns a non-negative value, overrides both fixed and dynamic modes.
/// @note If it returns a negative value, the async scene falls back to the configured fixed or dynamic time-step behavior.
///
/// @see @ref mochi::AsyncStepParams::fixedTimeStepSeconds "AsyncStepParams::fixedTimeStepSeconds", @ref mochi::AsyncStepParams::useFixedTimeStep "AsyncStepParams::useFixedTimeStep"
///

/// @struct mochi::PerformanceStats
///
/// @brief Timing and profiling metrics from the last simulation step.
///
/// @see @ref mochi::Scene::GetPerformanceStats "Scene::GetPerformanceStats"
///

/// @var mochi::PerformanceStats::totalStepDurationSec
///
/// @brief Total wall-clock time [s] spent in the last call to @ref mochi::Scene::Step "Scene::Step".
///
/// @note Includes time spent in user-defined pre-step and post-step callbacks.
///

/// @var mochi::PerformanceStats::solveStepDurationSec
///
/// @brief Wall-clock time [s] spent solving physics in the last call to @ref mochi::Scene::Step "Scene::Step".
///
/// @note Does not include time spent in user-defined pre-step and post-step callbacks.
///

/// @var mochi::PerformanceStats::preStepCallbacksDurationSec
///
/// @brief Wall-clock time [s] spent executing user-defined pre-step callbacks in the last call to @ref mochi::Scene::Step "Scene::Step".
///

/// @var mochi::PerformanceStats::postStepCallbacksDurationSec
///
/// @brief Wall-clock time [s] spent executing user-defined post-step callbacks in the last call to @ref mochi::Scene::Step "Scene::Step".
///

/// @var mochi::PerformanceStats::recordingStepDurationSec
///
/// @brief Wall-clock time [s] spent on recording in the last call to @ref mochi::Scene::Step "Scene::Step".
///

/// @struct mochi::SolverStats
///
/// @brief Solver convergence metrics from the last simulation step.
///
/// @see @ref mochi::Scene::GetSolverStats "Scene::GetSolverStats"
///

/// @var mochi::SolverStats::maxNonLinearIters
///
/// @brief Maximum number of non-linear solver iterations across all islands and integration stages in the last call to @ref mochi::Scene::Step "Scene::Step".
///

/// @var mochi::SolverStats::residualNorm
///
/// @brief Aggregate residual norm across all islands and integration stages in the last call to @ref mochi::Scene::Step "Scene::Step". Computed as the root mean square across integration stages of the L2 norm of per-island residual norms.
///

/// @var mochi::SolverStats::maxLineSearchIters
///
/// @brief Maximum number of line-search iterations per Newton solve across all islands and integration stages in the last call to @ref mochi::Scene::Step "Scene::Step".
///

/// @var mochi::SolverStats::convergenceStatus
///
/// @brief Aggregate convergence status of the scene in the last call to @ref mochi::Scene::Step "Scene::Step".
///
/// @details Returns the worst convergence status across all dynamic actors: @ref mochi::ConvergenceStatus::Diverged "ConvergenceStatus::Diverged" if any actor diverged, @ref mochi::ConvergenceStatus::Stopped "ConvergenceStatus::Stopped" if any actor's solver was stopped, @ref mochi::ConvergenceStatus::Converged "ConvergenceStatus::Converged" if all dynamic actors converged, @ref mochi::ConvergenceStatus::None "ConvergenceStatus::None" if no dynamic actors exist, @ref mochi::Scene::Step "Scene::Step" has not been called yet or the last call to @ref mochi::Scene::Step "Scene::Step" was with zero time step.
///
/// @see @ref mochi::ConvergenceStatus "ConvergenceStatus", @ref mochi::Actor::GetConvergenceStatus "Actor::GetConvergenceStatus"
///

/// @struct mochi::RecordingParams
///
/// @brief Parameters controlling what data gets included in a scene recording.
///
/// @warning The recording system may undergo a substantial refactor to expand its capabilities. Its API and recorded file format may change in future releases.
///
/// @see @ref mochi::Scene::StartRecording "Scene::StartRecording", @ref mochi::Scene::StopRecording "Scene::StopRecording"
///

/// @var mochi::RecordingParams::recordActorMeshes
///
/// @brief Include the meshes (if any) when recording actor creation events.
///

/// @var mochi::RecordingParams::recordActorLocalToGlobalMap
///
/// @brief Include the local-to-global map (if any) when recording actor creation events.
///

/// @var mochi::RecordingParams::recordActorMassMatrix
///
/// @brief Include the mass matrix (if any) when recording actor creation events.
///

/// @var mochi::RecordingParams::recordTargetState
///
/// @brief Record articulated pose controller targets and tracking parameters every step.
///

/// @var mochi::RecordingParams::recordDynamicActorState
///
/// @brief Record the state of dynamic actors every step.
///
/// @details This includes position, rotation, and velocity. For soft actors, it includes the node displacements and velocities.
///

/// @var mochi::RecordingParams::recordStaticActorState
///
/// @brief Record the state of static actors every step. This includes position and rotation.
///

/// @var mochi::RecordingParams::recordContactPoints
///
/// @brief Record results from @ref mochi::QueryType::ContactPoints "QueryType::ContactPoints" for each dynamic actor every step.
///

/// @var mochi::RecordingParams::recordNodeContactForces
///
/// @brief Record results for @ref mochi::QueryType::NodeContactForces "QueryType::NodeContactForces" for each soft actor every step.
///

/// @var mochi::RecordingParams::recordSdfDistances
///
/// @brief Record SDF distances for @ref mochi::QueryType::SdfDistances "QueryType::SdfDistances" for each dynamic actor every step.
///

/// @fn RecordingParams mochi::RecordingParams::All(bool enabled)
///
/// @brief Return @ref mochi::RecordingParams "RecordingParams" with all boolean options set to the given value.
///
/// @param[in] enabled True to enable all options (maximum data), false to disable (minimum data).
/// @return The initialized @ref mochi::RecordingParams "RecordingParams".
///

/// @struct mochi::PoseTrackingParams
///
/// @brief Parameters for pose controller tracking constraints.
///
/// @details Defines spring-damper parameters for individual pose tracking constraints in an articulated actor's pose controller. Each constraint acts on a joint rotation, link translation, or link rotation.
///
/// @see @ref mochi::Actor::GetArticulatedPoseControllerParams "Actor::GetArticulatedPoseControllerParams", @ref mochi::Actor::SetArticulatedPoseControllerParams "Actor::SetArticulatedPoseControllerParams", @ref mochi::PoseControllerParams "PoseControllerParams"
///

/// @var mochi::PoseTrackingParams::stiffness
///
/// @brief Constraint stiffness.
///
/// @note Units depend on the DoF kind: [N/m] for translation DoFs, [N·m/rad] for rotation DoFs.
/// @note Must be non-negative and finite.
///

/// @var mochi::PoseTrackingParams::damping
///
/// @brief Constraint damping.
///
/// @note Units depend on the DoF kind: [N·s/m] for translation DoFs, [N·m·s/rad] for rotation DoFs.
/// @note Must be non-negative and finite.
///

/// @var mochi::PoseTrackingParams::saturation
///
/// @brief Saturation distance [m] or angle [rad]. A negative value disables saturation.
///
/// @note When enabled, saturation smoothly limits the magnitude of the elastic (stiffness) contribution to @ref mochi::PoseTrackingParams::stiffness "stiffness" * @ref mochi::PoseTrackingParams::saturation "saturation". The damping contribution is separate and is not limited by saturation.
/// @note Must be finite and non-zero.
///

/// @struct mochi::PoseControllerParams
///
/// @brief Parameters to create a pose controller for an articulated actor.
///
/// @note Each tracking array must be empty, have size 1, or have size equal to the number of links. Empty arrays use zero-gain defaults. Size-1 arrays are broadcast to all applicable constraints. Full-size arrays are indexed by link.
/// @note Empty controllers are allowed. Constraints are created even when stiffness and damping are both zero, and can be accessed/updated via @ref mochi::Actor::GetArticulatedPoseConstraints "Actor::GetArticulatedPoseConstraints", @ref mochi::Actor::GetArticulatedPoseControllerParams "Actor::GetArticulatedPoseControllerParams" and @ref mochi::Actor::SetArticulatedPoseControllerParams "Actor::SetArticulatedPoseControllerParams".
/// @note Control of cycle joints is not supported.
///
/// @see @ref mochi::Actor::AddArticulatedPoseController "Actor::AddArticulatedPoseController", @ref mochi::PoseTrackingParams "PoseTrackingParams"
///

/// @var mochi::PoseControllerParams::linkPosTracking
///
/// @brief Tracking parameters for link position constraints.
///

