/// @struct mochi::prefab::PrefabReference
///
/// @brief Reference to another prefab file (scene or actor) for prefab nesting.
///

/// @var mochi::prefab::PrefabReference::comment
///
/// @brief Optional serialized comment.
///

/// @var mochi::prefab::PrefabReference::name
///
/// @brief Name of the nested prefab instance. Used to format the names of nested actors in the form "prefabName/actorName".
///
/// @note Name-reference ambiguity is evaluated per nested subtree. A nested prefab's own references (from its constraints, pose controllers, and contact filters) resolve within its own instance first, so a name reused across independent sibling instances is not ambiguous for each instance's internal references. It becomes ambiguous only for a reference written at the enclosing (parent) scope or above.
///

/// @var mochi::prefab::PrefabReference::path
///
/// @brief File path of the nested prefab.
///

/// @var mochi::prefab::PrefabReference::scale
///
/// @brief Uniform scale of the nested prefab, relative to the parent prefab.
///
/// @details The scale applied to this nested prefab is this value multiplied by @ref mochi::prefab::PrefabParams::scale "PrefabParams::scale" and each enclosing @ref mochi::prefab::PrefabReference::scale "PrefabReference::scale". See @ref mochi::prefab::PrefabParams::scale "PrefabParams::scale" for what scaling affects.
///
/// @note Set this value before loading shapes. If changed later, call @ref mochi::prefab::LoadShapes "LoadShapes" on the top-level @ref mochi::prefab::ScenePrefab "ScenePrefab" before adding it to a @ref mochi::Scene "Scene".
/// @note Must be strictly positive and finite. Negative or zero scale is invalid and rejected at @ref mochi::prefab::AddToScene "AddToScene".
///
/// @see @ref mochi::prefab::PrefabParams::scale "PrefabParams::scale"
///

/// @var mochi::prefab::PrefabReference::rotation
///
/// @brief Rotation quaternion [x, y, z, w] of the nested prefab in the parent's local space.
///
/// @note Must be finite and non-zero.
///

/// @var mochi::prefab::PrefabReference::translation
///
/// @brief Translation [x, y, z] of the nested prefab in the parent's local space.
///
/// @note Must be finite.
///

/// @var mochi::prefab::PrefabReference::prefab
///
/// @brief Handle to the loaded nested prefab. Runtime state, populated at load time and never serialized.
///

/// @struct mochi::prefab::ActorContactEntry
///
/// @brief Used by @ref mochi::prefab::ContactFilter "ContactFilter" to enable or disable contact for a pair of actors.
///
/// @see @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::prefab::ActorContactEntry::enable
///
/// @brief Enable (true) or disable (false) contact for the specified pair of actors.
///
/// @note Contact is enabled for all actor pairs by default, except that automatic contact filtering disables adjacent links in articulated and soft-skinned actors. Therefore, you should usually only list additional pairs of actors for which contact should be explicitly disabled.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter"
///

/// @var mochi::prefab::ActorContactEntry::actors
///
/// @brief Identifies two actors by name or hierarchy path.
///
/// @details If the actor is in this prefab, then reference it by name, e.g., "myActor". If the actor is in a nested prefab, then reference it by hierarchy path, e.g., "myPrefab/myActor".
///
/// @note A referenced actor name must identify exactly one existing actor. Actor names need not be unique, but referencing a name shared by more than one actor, or a name that matches no actor, is invalid and rejected at @ref mochi::prefab::AddToScene "AddToScene".
/// @note Parent actor expansion is controlled by @ref mochi::prefab::ActorContactEntry::includeNestedActors "includeNestedActors".
/// @note Order matters when contact settings are applied asymmetrically. In that case, the first actor is the "colliding" actor and the second actor is the "collider". When contact is enabled, the first actor's contact sample points will be tested against the second actor's collider geometry.
/// @note If both actors are the same, then the setting affects self-contact within the actor.
///
/// @warning Must contain exactly 2 elements.
///

/// @var mochi::prefab::ActorContactEntry::includeNestedActors
///
/// @brief Whether expandable parent actor names should include nested actors.
///
/// @details When true, a parent actor name resolves to the parent actor plus nested actors. The contact setting is applied to every ordered pair in the cross-product of the two resolved actor sets; no pairs outside that cross-product are affected. If the resolved sets overlap, pairs in the overlap, including self-pairs, are affected. When false, the contact setting applies only to the exact named actors.
///
/// @note Actors without nested actors are affected as exact actors irrespective of this setting.
/// @note Default contact filtering disables contact between adjacent links in articulated and soft-skinned actors. Actor-contact entries override those defaults for pairs included in the resolved actor sets. If @ref mochi::prefab::ActorContactEntry::includeNestedActors "includeNestedActors" is true and both actor names resolve to the same parent actor, the entry also covers pairs between that parent's nested actors, including adjacent links.
///

/// @struct mochi::prefab::LayerContactEntry
///
/// @brief Used by @ref mochi::prefab::ContactFilter "ContactFilter" to enable or disable contact for a pair of layers.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric"
///

/// @var mochi::prefab::LayerContactEntry::enable
///
/// @brief Enable (true) or disable (false) contact for the specified pair of contact layer names.
///
/// @note Contact is enabled for any pair of layers by default. Therefore, you should usually only list pairs of layers for which contact should be explicitly disabled.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter"
///

/// @var mochi::prefab::LayerContactEntry::layers
///
/// @brief Identifies two contact layer names.
///
/// @note Order matters when contact settings are applied asymmetrically. In that case, the first layer is the "colliding" layer and the second layer is the "collider". When contact is enabled, the contact sample points on an actor in the first layer will be tested against the collider geometry of an actor in the second layer.
/// @note Both layer names can be the same. In that case, the setting applies between actors within the same layer.
///
/// @warning Must contain exactly 2 elements.
///

/// @struct mochi::prefab::ContactFilter
///
/// @brief Contact filtering parameters for a prefab.
///
/// @note By default, all actor pairs can potentially collide with each other, except that automatic contact filtering disables adjacent links in articulated and soft-skinned actors. To prevent additional contact, use this contact filter in one of two ways (or both): 1) Use @ref mochi::prefab::ContactFilter::actorContactAsymmetric "actorContactAsymmetric" or @ref mochi::prefab::ContactFilter::actorContactSymmetric "actorContactSymmetric" to disable contact for a specific pair of actors, or 2) use @ref mochi::prefab::ContactFilter::layerContactAsymmetric "layerContactAsymmetric" or @ref mochi::prefab::ContactFilter::layerContactSymmetric "layerContactSymmetric" to disable contact for a specific pair of contact layer names. This applies to all actors in those layers.
/// @note Contact only occurs if it is allowed by both the actor-vs-actor contact filter and the layer-vs-layer contact filter. Either can prevent contact.
/// @note You can also explicitly enable contact for a pair of actors or layers to override a setting applied earlier. Actor entries can also override automatic adjacent-link exclusions.
/// @note Contact filters are applied after all actors in the prefab have been created. Nested child prefab contact filters are applied before parent prefab contact filters, so parent settings can override child settings in the same actor-vs-actor or layer-vs-layer filter table.
/// @note Settings are applied in this fixed order: @ref mochi::prefab::ContactFilter::layerContactAsymmetric "layerContactAsymmetric", @ref mochi::prefab::ContactFilter::layerContactSymmetric "layerContactSymmetric", @ref mochi::prefab::ContactFilter::actorContactAsymmetric "actorContactAsymmetric", then @ref mochi::prefab::ContactFilter::actorContactSymmetric "actorContactSymmetric". Within each list, entries are applied in array order, so later entries can override earlier entries in the same actor-vs-actor or layer-vs-layer filter table.
/// @note Contact filter settings are not necessarily symmetric.
/// @note Exporting a scene stores disabled pairs from the effective contact-filter state, not the exact JSON representation originally used to author it. Exporting may emit a canonical representation whose contact-filter category differs from the original JSON. For example, self-contact may be emitted as @ref mochi::prefab::ContactFilter::actorContactSymmetric "actorContactSymmetric" because the forward and reverse resolved actor pair are the same.
///
/// @warning Scene export does not record explicit settings that enable contact between actor pairs. If such a setting enables contact between adjacent links of an articulated or soft-skinned actor, adding the exported prefab to a scene applies automatic adjacent-link filtering and disables contact for that pair again. To preserve this behavior, add an equivalent enabling entry to the exported prefab or re-enable the pair after adding the prefab to a scene.
///
/// @see @ref mochi::prefab::ActorContactEntry "ActorContactEntry", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric", @ref mochi::prefab::LayerContactEntry "LayerContactEntry", @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric"
///

/// @var mochi::prefab::ContactFilter::comment
///
/// @brief Optional serialized comment.
///

/// @var mochi::prefab::ContactFilter::actorContactAsymmetric
///
/// @brief Enables or disables contact asymmetrically for each ordered pair of actors.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter", @ref mochi::prefab::ActorContactEntry "ActorContactEntry", @ref mochi::Scene::EnableActorContactAsymmetric "Scene::EnableActorContactAsymmetric"
///

/// @var mochi::prefab::ContactFilter::actorContactSymmetric
///
/// @brief Enables or disables contact symmetrically for each pair of actors.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter", @ref mochi::prefab::ActorContactEntry "ActorContactEntry", @ref mochi::Scene::EnableActorContactSymmetric "Scene::EnableActorContactSymmetric"
///

/// @var mochi::prefab::ContactFilter::layerContactAsymmetric
///
/// @brief Enables or disables contact asymmetrically for each ordered pair of layers.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter", @ref mochi::prefab::LayerContactEntry "LayerContactEntry", @ref mochi::Scene::EnableLayerContactAsymmetric "Scene::EnableLayerContactAsymmetric"
///

/// @var mochi::prefab::ContactFilter::layerContactSymmetric
///
/// @brief Enables or disables contact symmetrically for each pair of layers.
///
/// @see @ref mochi::prefab::ContactFilter "ContactFilter", @ref mochi::prefab::LayerContactEntry "LayerContactEntry", @ref mochi::Scene::EnableLayerContactSymmetric "Scene::EnableLayerContactSymmetric"
///

/// @struct mochi::prefab::ScenePrefab
///
/// @brief Top-level prefab describing a complete or partial physics scene (possibly just one actor).
///

/// @var mochi::prefab::ScenePrefab::comment
///
/// @brief Optional serialized comment.
///

/// @var mochi::prefab::ScenePrefab::actors
///
/// @brief Lists of actors by type.
///

/// @var mochi::prefab::ScenePrefab::constraints
///
/// @brief Lists of constraints by type.
///

/// @var mochi::prefab::ScenePrefab::controllers
///
/// @brief List of pose controllers.
///

/// @var mochi::prefab::ScenePrefab::prefabs
///
/// @brief List of nested prefab references.
///

/// @var mochi::prefab::ScenePrefab::scene
///
/// @brief Global scene parameters (top-level prefab only).
///

/// @var mochi::prefab::ScenePrefab::sourceFilePath
///
/// @brief Path this prefab was loaded from, exactly as passed to the loading function. Used to resolve prefab-relative ("./"-prefixed) nested prefab and shape paths.
///
/// @note Set by the file-based loaders (@ref mochi::prefab::LoadFromFile "LoadFromFile", @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile"). It is not converted to an absolute path: a relative path passed to the loader is stored as-is. The string-based loaders (@ref mochi::prefab::LoadFromJsonString "LoadFromJsonString", @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString") leave it empty. In that case, "./"-prefixed paths fall back to resolution against the root path supplied when the paths are resolved.
/// @note Runtime state, never serialized.
///

/// @var mochi::prefab::ScenePrefab::contactFilter
///
/// @brief Contact filter settings for selective contact filtering.
///

/// @struct mochi::prefab::PrefabParams
///
/// @brief Parameters for instantiating a @ref mochi::prefab::ScenePrefab "ScenePrefab" into a @ref mochi::Scene "Scene".
///

/// @var mochi::prefab::PrefabParams::name
///
/// @brief Optional name prefix for created actors.
///
/// @details Actor names are formatted based on their hierarchy paths. If this string is not empty, it will be used as the first token in the path ("prefabName/actorName", "prefabName/nestedPrefabName/actorName", etc.)
///

/// @var mochi::prefab::PrefabParams::scale
///
/// @brief Uniform scale of the new prefab in world-space.
///
/// @details Composes multiplicatively with any nested @ref mochi::prefab::PrefabReference::scale "PrefabReference::scale" and any per-actor scale (e.g. @ref mochi::prefab::ArticulatedActorPrefab::scale "ArticulatedActorPrefab::scale") to give the cumulative "effective scale" baked into each actor when the prefab is instantiated.
///
/// The effective scale is applied to:
///
/// - Mesh geometry (link / actor shapes are loaded at the cumulative scale)
/// - Joint and link translations, cycle joint anchors
/// - Prismatic joint position limits (Real3, in meters)
/// - Constraint geometric target and limit distances [m], including rigid prismatic joint limits, world-space position targets, rigid actor-local pivot/joint positions in @ref mochi::prefab::RigidPivotPositionConstraintPrefab "RigidPivotPositionConstraintPrefab", @ref mochi::prefab::RigidPivotToRigidTargetConstraintPrefab "RigidPivotToRigidTargetConstraintPrefab", and @ref mochi::prefab::RigidSphericalJointConstraintPrefab "RigidSphericalJointConstraintPrefab"; the rigid-local attachment/search point in @ref mochi::prefab::DeformableNodeToRigidConstraintPrefab "DeformableNodeToRigidConstraintPrefab"; and translational single-DoF target/range values in @ref mochi::prefab::ArticulatedSingleDofTargetConstraintPrefab "ArticulatedSingleDofTargetConstraintPrefab" and @ref mochi::prefab::ArticulatedSingleDofRangeConstraintPrefab "ArticulatedSingleDofRangeConstraintPrefab". Actor-local constraint distances use the referenced actor's prefab metric scale, so standalone rigid/soft shape-bake scale fields are not applied again.
/// - User-supplied inertia overrides on rigid and articulated link actors: center of mass scales componentwise by the signed effective scale, mass scales by the absolute effective volume scale, moment of inertia uses the corresponding diagonal inertia transform. For a purely uniform effective scale s, this reduces to:
/// @code
/// centerOfMass *= s
/// mass *= s^3
/// momentOfInertia *= s^5
/// @endcode
///
/// The mass and moment of inertia formulas preserve the user's authored density.
///
/// The effective scale is NOT applied to:
///
/// - density (intrinsic material property; mass/density are mutually exclusive in the prefab API, so no double-application)
/// - linearVelocity / angularVelocity / jointVelocities
/// - Constraint stiffness/damping coefficients and saturation thresholds inherited from @ref mochi::ConstraintParams "ConstraintParams". These parameters define the constraint's response, not just geometry: different goals (preserving material behavior, damping ratio, actuator limits, or closed-loop response) imply different scale laws, so prefab scaling preserves authored values.
/// - Joint inertia, friction, limit stiffness/damping, cycle joint stiffness (characterized actuator / tuned-penalty parameters; bring your own actuator model when scaling a robot)
/// - Revolute and spherical joint angular limits, rotation-valued targets and ranges in @ref mochi::prefab::Articulated3dRotationTargetConstraintPrefab "Articulated3dRotationTargetConstraintPrefab" and @ref mochi::prefab::Articulated3dRotationRangeConstraintPrefab "Articulated3dRotationRangeConstraintPrefab", and rotational single-DoF target/range values in @ref mochi::prefab::ArticulatedSingleDofTargetConstraintPrefab "ArticulatedSingleDofTargetConstraintPrefab" and @ref mochi::prefab::ArticulatedSingleDofRangeConstraintPrefab "ArticulatedSingleDofRangeConstraintPrefab" (scale invariant)
///
/// @note Must be strictly positive and finite. Negative or zero scale is invalid and rejected at @ref mochi::prefab::AddToScene "AddToScene". The @ref mochi::prefab::ScenePrefab "ScenePrefab" overload additionally requires scale == 1; use the file-path @ref mochi::prefab::AddToScene "AddToScene" overload, nested @ref mochi::prefab::PrefabReference::scale "PrefabReference::scale", or per-actor scale for non-identity scaling.
/// @note Authoring with @ref mochi::RigidActorParams::mass "RigidActorParams::mass" = M is equivalent to authoring with the implied density M / V_unit; under prefab scale the density is preserved and mass scales with the absolute volume scale, so the result is "the same material at a bigger size." For a purely uniform effective scale s, this mass factor is s^3. If you need a fixed mass that does NOT scale with the prefab, set the mass at runtime via @ref mochi::Actor::SetDensity "Actor::SetDensity" after the actor is instantiated.
///

/// @var mochi::prefab::PrefabParams::rotation
///
/// @brief Rotation quaternion [x, y, z, w] of the new prefab in world-space.
///
/// @note Must be finite and non-zero.
///

/// @var mochi::prefab::PrefabParams::translation
///
/// @brief Translation (position) of the new prefab in world-space.
///
/// @note Must be finite.
///

/// @var mochi::prefab::PrefabParams::applySceneSettings
///
/// @brief Whether to apply top-level scene settings.
///
/// @details When true, @ref mochi::prefab::AddToScene "AddToScene" applies gravity and solver overrides from the @ref mochi::prefab::SceneParams "SceneParams" of the top-level prefab. Omitted overrides preserve existing scene values. When false, neither override is applied. Scene settings from nested prefabs are always ignored.
///

/// @struct mochi::prefab::AddToSceneResult
///
/// @brief Struct used to return all created actors and constraints from @ref mochi::prefab::AddToScene "AddToScene".
///
/// @note The returned pointers are non-owning. They remain valid as long as the @ref mochi::Scene "Scene" is alive and the actors/constraints have not been destroyed.
///

/// @var mochi::prefab::AddToSceneResult::actors
///
/// @brief All newly created actors.
///
/// @note Order is not guaranteed except that actors from nested prefabs will be listed before actors from the top-level prefab.
/// @note Contains only top-level actors. Articulated actors' nested link actors and soft-skinned actors' nested link and soft sub-actors are created but not listed here. Reach them via @ref mochi::Actor::GetNestedLinkActors "Actor::GetNestedLinkActors" and @ref mochi::Actor::GetNestedSoftActors "Actor::GetNestedSoftActors".
///
/// @see @ref mochi::prefab::AddToSceneResult::Filter "Filter"
///

/// @var mochi::prefab::AddToSceneResult::constraints
///
/// @brief All newly created constraints.
///
/// @note Order is not guaranteed except that constraints from nested prefabs will be listed before constraints from the top-level prefab.
///
/// @see @ref mochi::prefab::AddToSceneResult::Filter "Filter"
///

/// @fn DynamicArray<Actor*> mochi::prefab::AddToSceneResult::Filter(ActorType type) const
///
/// @brief Return all the newly created actors of a particular type, in order.
///
/// @param[in] type Type of actor to return.
/// @return List of actors of the specified type.
///
/// @note If there were nested prefabs, then actors will be listed in depth-first order.
/// @note For a single prefab (no nested prefabs) whose actors have no nested link or soft sub-actors, the result is 1-to-1 with the prefab's actors of that type (same size, same order). Nested link/soft sub-actors are not listed, and soft-skinned actors are reported under @ref mochi::ActorType::Articulated "ActorType::Articulated".
///

/// @fn DynamicArray<Constraint*> mochi::prefab::AddToSceneResult::Filter(ConstraintType type) const
///
/// @brief Return all the newly created constraints of a particular type, in order.
///
/// @param[in] type Type of constraint to return.
/// @return List of constraints of the specified type.
///
/// @note If there were nested prefabs, then constraints will be listed in depth-first order.
/// @note For a single prefab (no nested prefabs), the result will be 1-to-1 with the constraint list in the prefab (same size, same order).
///

/// @fn ScenePrefab mochi::prefab::LoadFromFile(std::string_view prefabPath, std::string_view rootPath, Context* context, Error& error)
///
/// @brief Fully load a @ref mochi::prefab::ScenePrefab "ScenePrefab" from a file, including all nested prefabs and shapes.
///
/// @param[in] prefabPath File path to the prefab file.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in] context The @ref mochi::Context "Context" that owns the loaded resources.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return The fully loaded @ref mochi::prefab::ScenePrefab "ScenePrefab", or a default-constructed @ref mochi::prefab::ScenePrefab "ScenePrefab" on error.
///
/// @note Prefab files are in JSON format.
/// @note A prefab must not reference itself, directly or indirectly.
///
/// @see @ref mochi::prefab::LoadFromJsonString "LoadFromJsonString", @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile", @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString"
///

/// @fn ScenePrefab mochi::prefab::LoadFromJsonString(std::string_view json, std::string_view rootPath, Context* context, Error& error)
///
/// @brief Fully load a @ref mochi::prefab::ScenePrefab "ScenePrefab" from a JSON string, including all nested prefabs and shapes.
///
/// @param[in] json JSON string containing the serialized prefab.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in] context The @ref mochi::Context "Context" that owns the loaded resources.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return The fully loaded @ref mochi::prefab::ScenePrefab "ScenePrefab", or a default-constructed @ref mochi::prefab::ScenePrefab "ScenePrefab" on error.
///
/// @note The top-level prefab has no source file, so prefab-relative ("./"-prefixed) nested prefab and shape paths written in @p json resolve against @p rootPath, not against a prefab directory. Nested prefabs that are loaded from files resolve their own "./"-prefixed paths relative to the directory containing the nested prefab file. Use @ref mochi::prefab::LoadFromFile "LoadFromFile" if you need prefab-relative resolution at the top level.
/// @note A prefab must not reference itself, directly or indirectly.
///
/// @see @ref mochi::prefab::LoadFromFile "LoadFromFile", @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile", @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString"
///

/// @fn void mochi::prefab::SaveToJsonFile(ScenePrefab const& prefab, std::string_view path, Error& error)
///
/// @brief Serialize a @ref mochi::prefab::ScenePrefab "ScenePrefab" to a JSON file.
///
/// @param[in] prefab The @ref mochi::prefab::ScenePrefab "ScenePrefab" to serialize.
/// @param[in] path Output file path.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Does NOT serialize nested prefabs. Only the top-level prefab data is written.
/// @note Automatically creates the output directory path, as needed.
///
/// @see @ref mochi::prefab::SaveToJsonString "SaveToJsonString"
///

/// @fn DynamicString mochi::prefab::SaveToJsonString(ScenePrefab const& prefab, Error& error)
///
/// @brief Serialize a @ref mochi::prefab::ScenePrefab "ScenePrefab" to a JSON string.
///
/// @param[in] prefab The @ref mochi::prefab::ScenePrefab "ScenePrefab" to serialize.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return The JSON string, or an empty string on error.
///
/// @note Does NOT serialize nested prefabs. Only the top-level prefab data is written.
///
/// @see @ref mochi::prefab::SaveToJsonFile "SaveToJsonFile"
///

/// @fn AddToSceneResult mochi::prefab::AddToScene(ScenePrefab const& prefab, Scene* scene, PrefabParams const& params, Error& error)
///
/// @brief Instantiate a @ref mochi::prefab::ScenePrefab "ScenePrefab" and add it to a @ref mochi::Scene "Scene".
///
/// @details Creates the prefab's actors, constraints, and controllers, applies any scene settings enabled by @ref mochi::prefab::PrefabParams::applySceneSettings "PrefabParams::applySceneSettings", and applies contact filter entries.
///
/// @param[in] prefab The fully loaded @ref mochi::prefab::ScenePrefab "ScenePrefab" to instantiate.
/// @param[in,out] scene The @ref mochi::Scene "Scene" to add things to.
/// @param[in] params Parameters for how and where to instantiate the prefab. Can optionally be omitted in Python.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return An @ref mochi::prefab::AddToSceneResult "AddToSceneResult" containing pointers to all created actors and constraints.
///
/// @note The prefab must be fully loaded (nested prefabs and shapes) before calling this function. If you're not sure, then call @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded".
///
/// @warning This function is not transactional. If it returns an error, the prefab may have been partially instantiated in the scene.
/// @warning Only supported with @ref mochi::prefab::PrefabParams::scale "PrefabParams::scale" = 1. To instantiate at a non-identity scale, use the file-path @ref mochi::prefab::AddToScene "AddToScene" overload or a nested @ref mochi::prefab::PrefabReference::scale "PrefabReference::scale".
///
/// @see @ref mochi::prefab::LoadFromFile "LoadFromFile", @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded", @ref mochi::prefab::PrefabParams "PrefabParams"
///

/// @fn AddToSceneResult mochi::prefab::AddToScene(ScenePrefab const& prefab, Scene* scene, Error& error)
///
/// @brief Overload of @ref mochi::prefab::AddToScene "AddToScene" that instantiates a @ref mochi::prefab::ScenePrefab "ScenePrefab" using default @ref mochi::prefab::PrefabParams "PrefabParams".
///
/// @param[in] prefab The fully loaded @ref mochi::prefab::ScenePrefab "ScenePrefab" to instantiate.
/// @param[in,out] scene The @ref mochi::Scene "Scene" to add things to.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return An @ref mochi::prefab::AddToSceneResult "AddToSceneResult" containing pointers to all created actors and constraints.
///
/// @warning This function is not transactional. If it returns an error, the prefab may have been partially instantiated in the scene.
///
/// @see @ref mochi::prefab::AddToScene "AddToScene"
///

/// @fn AddToSceneResult mochi::prefab::AddToScene(std::string_view prefabPath, std::string_view rootPath, Scene* scene, PrefabParams const& params, Error& error)
///
/// @brief Load a scene prefab from a file and create an instance of it in the @ref mochi::Scene "Scene".
///
/// @details This is a convenience function that loads the prefab, including all nested prefabs and shapes, and immediately adds it to the scene. All loaded shape handles are released automatically afterward.
///
/// @param[in] prefabPath File path to the prefab file.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in,out] scene The @ref mochi::Scene "Scene" to add things to.
/// @param[in] params Parameters for how and where to instantiate the prefab.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return An @ref mochi::prefab::AddToSceneResult "AddToSceneResult" containing pointers to all created actors and constraints.
///
/// @note If you intend to add multiple copies of the prefab to a scene, or to multiple scenes, then consider using @ref mochi::prefab::LoadFromFile "LoadFromFile" to load a @ref mochi::prefab::ScenePrefab "ScenePrefab" object. You can use that @ref mochi::prefab::ScenePrefab "ScenePrefab" multiple times.
/// @note Unlike the @ref mochi::prefab::ScenePrefab "ScenePrefab" overload, this overload supports non-identity @ref mochi::prefab::PrefabParams::scale "PrefabParams::scale" by baking it into actor geometry during load.
///
/// @warning This function is not transactional. If it returns an error, the prefab may have been partially instantiated in the scene.
///
/// @see @ref mochi::prefab::LoadFromFile "LoadFromFile", @ref mochi::prefab::AddToScene "AddToScene", @ref mochi::prefab::PrefabParams "PrefabParams"
///

/// @fn AddToSceneResult mochi::prefab::AddToScene(std::string_view prefabPath, std::string_view rootPath, Scene* scene, Error& error)
///
/// @brief Overload of @ref mochi::prefab::AddToScene "AddToScene" that loads a prefab from a file and instantiates it using default @ref mochi::prefab::PrefabParams "PrefabParams".
///
/// @param[in] prefabPath File path to the prefab file.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in,out] scene The @ref mochi::Scene "Scene" to add things to.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return An @ref mochi::prefab::AddToSceneResult "AddToSceneResult" containing pointers to all created actors and constraints.
///
/// @warning This function is not transactional. If it returns an error, the prefab may have been partially instantiated in the scene.
///
/// @see @ref mochi::prefab::AddToScene "AddToScene"
///

/// @fn DynamicString mochi::prefab::GetPrefabFullPath(std::string_view inputPath, std::string_view rootForRelativePath, std::string_view prefabFilePath)
///
/// @brief Resolve a path referenced inside a prefab to a full path.
///
/// @param[in] inputPath The path to resolve, as stored in the prefab (may be prefixed with "./" to indicate it is relative to the prefab file).
/// @param[in] rootForRelativePath Root directory used to resolve paths that are not prefixed with "./".
/// @param[in] prefabFilePath Path to the prefab file that references inputPath, used to resolve "./"-prefixed paths relative to its location.
/// @return The resolved full path.
///
/// @note Absolute paths are returned unchanged. Paths starting with "./" are resolved relative to the directory containing @p prefabFilePath when provided. Other relative paths are resolved against @p rootForRelativePath.
///

/// @fn ScenePrefab mochi::prefab::ShallowLoadFromFile(std::string_view path, Error& error)
///
/// @brief Deserialize a single @ref mochi::prefab::ScenePrefab "ScenePrefab" from a file, without loading any nested files.
///
/// @param[in] path File path to the prefab file.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return The deserialized @ref mochi::prefab::ScenePrefab "ScenePrefab", or a default-constructed @ref mochi::prefab::ScenePrefab "ScenePrefab" on error.
///
/// @note Use this if you want to modify the @ref mochi::prefab::ScenePrefab "ScenePrefab" data before nested content is loaded, or if you simply want to edit and re-save the prefab file.
/// @note If you intend to add the @ref mochi::prefab::ScenePrefab "ScenePrefab" to a @ref mochi::Scene "Scene", then you will need to load any nested prefabs and shapes first.
///
/// @see @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded", @ref mochi::prefab::LoadNestedPrefabs "LoadNestedPrefabs", @ref mochi::prefab::LoadShapes "LoadShapes", @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString"
///

/// @fn ScenePrefab mochi::prefab::ShallowLoadFromJsonString(std::string_view json, Error& error)
///
/// @brief Deserialize a single @ref mochi::prefab::ScenePrefab "ScenePrefab" from a JSON string, without loading any nested files.
///
/// @param[in] json JSON string containing the serialized prefab.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return The deserialized @ref mochi::prefab::ScenePrefab "ScenePrefab", or a default-constructed @ref mochi::prefab::ScenePrefab "ScenePrefab" on error.
///
/// @note Same as @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile" except that the JSON string is provided in memory.
/// @note Unlike @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile", this function is not given a source file for the top-level prefab. Its "./"-prefixed nested prefab and shape paths therefore resolve against the root path passed to @ref mochi::prefab::LoadNestedPrefabs "LoadNestedPrefabs", @ref mochi::prefab::LoadShapes "LoadShapes", or @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded". Pass the prefab directory as the root path to preserve prefab-relative resolution.
///
/// @see @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile", @ref mochi::prefab::LoadFromJsonString "LoadFromJsonString"
///

/// @fn void mochi::prefab::LoadNestedPrefabs(ScenePrefab& prefab, std::string_view rootPath, Error& error)
///
/// @brief Load nested prefab files recursively.
///
/// @param[in,out] prefab The @ref mochi::prefab::ScenePrefab "ScenePrefab" whose nested prefab references will be loaded.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Use this if the file was loaded via @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile" or @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString" or if the @ref mochi::prefab::ScenePrefab "ScenePrefab" was created procedurally.
/// @note You do not need to call this after @ref mochi::prefab::LoadFromFile "LoadFromFile" or @ref mochi::prefab::LoadFromJsonString "LoadFromJsonString" because they load all nested content for you.
/// @note If called a second time, the nested prefabs will be reloaded. If your intention is to avoid redundant loads, then use @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded" instead.
/// @note A prefab must not reference itself, directly or indirectly.
///
/// @see @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded", @ref mochi::prefab::LoadShapes "LoadShapes"
///

/// @fn void mochi::prefab::LoadShapes(ScenePrefab& prefab, std::string_view rootPath, Context* context, Error& error)
///
/// @brief Load shape files referenced by @p prefab and its loaded nested prefabs.
///
/// @param[in,out] prefab The @ref mochi::prefab::ScenePrefab "ScenePrefab" whose shape references will be loaded.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in] context The @ref mochi::Context "Context" that owns the loaded resources.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Returns an error if the input prefab or any loaded nested prefab references itself, directly or indirectly.
/// @note Use this if the file was loaded via @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile" or @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString" or if the @ref mochi::prefab::ScenePrefab "ScenePrefab" was created procedurally.
/// @note You do not need to call this after @ref mochi::prefab::LoadFromFile "LoadFromFile" or @ref mochi::prefab::LoadFromJsonString "LoadFromJsonString" because they load all nested content for you.
/// @note Calling this function again reloads previously loaded shapes to reflect changes to shape file paths or transforms. Use @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded" to avoid reloading them.
///
/// @warning Shapes are loaded from nested prefabs only if those prefabs are already loaded. Use @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded" if any nested prefabs may be unloaded.
///
/// @see @ref mochi::prefab::EnsureFullyLoaded "EnsureFullyLoaded", @ref mochi::prefab::LoadNestedPrefabs "LoadNestedPrefabs", @ref mochi::prefab::AddToScene "AddToScene"
///

/// @fn void mochi::prefab::EnsureFullyLoaded(ScenePrefab& prefab, std::string_view rootPath, Context* context, Error& error)
///
/// @brief Ensure that all nested prefabs and shape files are loaded, skipping any that are already loaded.
///
/// @param[in,out] prefab The @ref mochi::prefab::ScenePrefab "ScenePrefab" whose nested prefabs and shapes will be loaded.
/// @param[in] rootPath Root directory for resolving relative paths, except those resolved against a prefab file.
/// @param[in] context The @ref mochi::Context "Context" that owns the loaded resources.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Use this if the file was loaded via @ref mochi::prefab::ShallowLoadFromFile "ShallowLoadFromFile" or @ref mochi::prefab::ShallowLoadFromJsonString "ShallowLoadFromJsonString" or if the @ref mochi::prefab::ScenePrefab "ScenePrefab" was created procedurally.
/// @note You do not need to call this after @ref mochi::prefab::LoadFromFile "LoadFromFile" or @ref mochi::prefab::LoadFromJsonString "LoadFromJsonString" because they load all nested content for you.
/// @note A prefab must not reference itself, directly or indirectly.
///
/// @see @ref mochi::prefab::LoadNestedPrefabs "LoadNestedPrefabs", @ref mochi::prefab::LoadShapes "LoadShapes", @ref mochi::prefab::AddToScene "AddToScene"
///

/// @fn void mochi::prefab::ExportScene(Scene const* scene, std::string_view exportName, std::string_view outputDir, Error& error)
///
/// @brief Export a @ref mochi::Scene "Scene" to a folder containing a prefab file and all generated mesh files.
///
/// @param[in] scene The @ref mochi::Scene "Scene" to export.
/// @param[in] exportName Name for the exported prefab. Used both for the export subdirectory and for the prefab filename (`<exportName>.mochi_scene`).
/// @param[in] outputDir Directory where the export folder will be created. The subdirectories `<outputDir>/<exportName>` and `<outputDir>/<exportName>/generated_assets` are created automatically.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Generated mesh files (.mochi.h5) are written under generated_assets/ and referenced from the prefab using "./generated_assets/" paths.
/// @note Exported actor names are made unique: when two actors share a name, later ones receive a numeric suffix (e.g. "box", "box1"), so an exported name may differ from the runtime name.
///
/// @warning Currently exports only rigid, soft, articulated, and soft-skinned actors. Constraints, pose controllers, shell, rod actors, and implicit (non-mesh) shapes are NOT exported.
/// @warning For articulated actors, current joint pose and joint velocities are NOT exported.
/// @warning Scene export does not record explicit settings that enable contact between actor pairs. If such a setting enables contact between adjacent links of an articulated or soft-skinned actor, adding the exported prefab to a scene applies automatic adjacent-link filtering and disables contact for that pair again. To preserve this behavior, add an equivalent enabling entry to the exported prefab or re-enable the pair after adding the prefab to a scene.
///
/// @see @ref mochi::prefab::ExportSceneExcluding "ExportSceneExcluding", @ref mochi::prefab::ExportActor "ExportActor"
///

/// @fn void mochi::prefab::ExportSceneExcluding(Scene const* scene, std::string_view exportName, std::string_view outputDir, Span<ActorHandle const> excludeActors, Error& error)
///
/// @brief Export a @ref mochi::Scene "Scene" to a folder containing a prefab file and all generated mesh files, omitting a caller-provided set of actors.
///
/// @param[in] scene The @ref mochi::Scene "Scene" to export.
/// @param[in] exportName Name for the exported prefab. Used both for the export subdirectory and for the prefab filename (`<exportName>.mochi_scene`).
/// @param[in] outputDir Directory where the export folder will be created. The subdirectories `<outputDir>/<exportName>` and `<outputDir>/<exportName>/generated_assets` are created automatically.
/// @param[in] excludeActors Handles of actors that should not be exported. Excluding an articulated actor also excludes all of its nested link actors. Excluding a soft-skinned actor also excludes all of its nested link and soft sub-actors. Any contact filter entries that reference excluded actors are dropped.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Generated mesh files (.mochi.h5) are written under generated_assets/ and referenced from the prefab using "./generated_assets/" paths.
/// @note Exported actor names are made unique: when two actors share a name, later ones receive a numeric suffix (e.g. "box", "box1"), so an exported name may differ from the runtime name.
///
/// @warning Currently exports only rigid, soft, articulated, and soft-skinned actors. Constraints, pose controllers, shell, rod actors, and implicit (non-mesh) shapes are NOT exported.
/// @warning For articulated actors, current joint pose and joint velocities are NOT exported.
/// @warning Scene export does not record explicit settings that enable contact between actor pairs. If such a setting enables contact between adjacent links of an articulated or soft-skinned actor, adding the exported prefab to a scene applies automatic adjacent-link filtering and disables contact for that pair again. To preserve this behavior, add an equivalent enabling entry to the exported prefab or re-enable the pair after adding the prefab to a scene.
///
/// @see @ref mochi::prefab::ExportScene "ExportScene", @ref mochi::prefab::ExportActor "ExportActor"
///

/// @fn void mochi::prefab::ExportActor(Actor const* actor, std::string_view exportName, std::string_view outputDir, Error& error)
///
/// @brief Export a single actor to a prefab file under `outputDir/exportName/<exportName>.mochi_scene`.
///
/// Extracts creation parameters from the actor and writes the prefab plus any generated mesh assets to disk. Only supported for standalone rigid actors, soft actors and articulated actors.
///
/// @param[in] actor The actor to export. Must not be null.
/// @param[in] exportName Label used for the actor's name, the export subdirectory, and the prefab filename (`<exportName>.mochi_scene`).
/// @param[in] outputDir Parent directory for the export. The subdirectories `<outputDir>/<exportName>` and `<outputDir>/<exportName>/generated_assets` are created automatically.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Uses the same prefab export path as @ref mochi::prefab::ExportScene "ExportScene". In addition to the soft-skinned restriction above, any limitations documented in @ref mochi::prefab::ExportScene "ExportScene" also apply here.
/// @note When exporting an articulated actor, pass the top-level articulated actor (the one returned by @ref mochi::Scene::CreateArticulatedActor "Scene::CreateArticulatedActor" or by @ref mochi::Actor::GetArticulatedActor "Actor::GetArticulatedActor" on a nested link), not a nested actor.
/// @note Generated mesh files (.mochi.h5) are written under generated_assets/ and referenced from the prefab using "./generated_assets/" paths.
///
/// @warning Only supported for standalone rigid, soft, and articulated actors. Soft-skinned actors are not supported here.
/// @warning Contact-filter settings are not exported. Adding an exported articulated actor to a scene applies automatic adjacent-link filtering, even if contact between adjacent links was explicitly enabled before export. To preserve this behavior, add an equivalent enabling entry to the exported prefab or re-enable the pair after adding the prefab to a scene.
///
/// @see @ref mochi::prefab::ExportScene "ExportScene", @ref mochi::prefab::ExportSceneExcluding "ExportSceneExcluding"
///

/// @struct mochi::Handle
///
/// @brief Generic 64-bit handle providing base functionality for strongly-typed handles.
///

/// @var mochi::Handle::value
///
/// @brief Raw 64-bit identifier. Zero indicates an invalid handle.
///

/// @fn mochi::Handle::Handle(ValueType raw)
///
/// @brief Construct a handle from its raw 64-bit identifier.
///
/// @param[in] raw The raw handle identifier.
///

/// @fn bool mochi::Handle::IsValid() const
///
/// @brief Check whether the handle is valid (i.e., its value is non-zero).
///
/// @return True if the handle is valid, false otherwise.
///

/// @fn uint64_t mochi::Handle::GetHash() const
///
/// @brief Compute a hash of the handle for use in unordered containers.
///
/// @return The hash of the handle's raw identifier.
///

/// @typedef mochi::Handle::ValueType
///
/// @brief Raw 64-bit identifier type.
///

/// @struct mochi::SceneHandle
///
/// @brief Unique identifier for a @ref mochi::Scene "Scene" within a @ref mochi::Context "Context".
///

/// @struct mochi::ActorHandle
///
/// @brief Unique identifier for an @ref mochi::Actor "Actor" within a @ref mochi::Scene "Scene".
///
/// @note An @ref mochi::ActorHandle "ActorHandle" can only be used with the @ref mochi::Scene "Scene" that created it.
/// @note Creating and destroying many actors in the same scene may eventually cause an @ref mochi::ActorHandle "ActorHandle" value from a previously destroyed actor to be re-used.
///

/// @struct mochi::ShapeHandle
///
/// @brief Handle to a shape (mesh, sphere, plane, etc.) within a @ref mochi::Context "Context".
///
/// @details The shape remains in memory while referenced by any handle, actor, or file cache entry. In C++ and Python, @ref mochi::ShapeHandle "ShapeHandle" is reference-counted and releases its reference automatically when destroyed. In the C API, you must call @ref mochi::Context::ReleaseShape "Context::ReleaseShape" when done with the handle.
///
/// @see @ref mochi::Context::ReleaseShape "Context::ReleaseShape"
///

/// @struct mochi::CallbackHandle
///
/// @brief Unique identifier for a callback registration within a @ref mochi::Scene "Scene".
///
/// @note A @ref mochi::CallbackHandle "CallbackHandle" can only be used with the @ref mochi::Scene "Scene" that created it.
///

/// @struct mochi::ConstraintHandle
///
/// @brief Unique identifier for a @ref mochi::Constraint "Constraint" within a @ref mochi::Scene "Scene".
///
/// @note A @ref mochi::ConstraintHandle "ConstraintHandle" can only be used with the @ref mochi::Scene "Scene" that created it.
/// @note Creating and destroying many constraints in the same scene may eventually cause a @ref mochi::ConstraintHandle "ConstraintHandle" value from a previously destroyed constraint to be re-used.
///

/// @struct mochi::StateHandle
///
/// @brief Unique identifier for a captured simulation state within a @ref mochi::Scene "Scene".
///
/// @note A @ref mochi::StateHandle "StateHandle" can only be used with the @ref mochi::Scene "Scene" that created it.
///
/// @see @ref mochi::Scene::CaptureState "Scene::CaptureState", @ref mochi::Scene::RestoreState "Scene::RestoreState", @ref mochi::Scene::ReleaseState "Scene::ReleaseState"
///

/// @struct mochi::QueryHandle
///
/// @brief Unique identifier for a query within a @ref mochi::Scene "Scene".
///
/// @note A @ref mochi::QueryHandle "QueryHandle" can only be used with the @ref mochi::Scene "Scene" that created it.
///
/// @see @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::CancelQuery "Actor::CancelQuery", @ref mochi::Constraint::RegisterQuery "Constraint::RegisterQuery", @ref mochi::Constraint::CancelQuery "Constraint::CancelQuery"
///

/// @struct mochi::PrefabHandle
///
/// @brief Runtime handle to a loaded nested prefab (the resolved target of a @ref mochi::prefab::PrefabReference "prefab::PrefabReference").
