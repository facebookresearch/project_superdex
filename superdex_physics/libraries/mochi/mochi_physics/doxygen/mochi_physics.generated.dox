/// @fn Constraint* mochi::Scene::GetConstraint(ConstraintHandle constraint)
///
/// @brief Get the @ref mochi::Constraint "Constraint" pointer associated with a @ref mochi::ConstraintHandle "ConstraintHandle".
///
/// @param[in] constraint Handle of the constraint to retrieve. If valid, it must be owned by this scene.
/// @return Pointer to the @ref mochi::Constraint "Constraint", or nullptr if the handle does not currently identify a constraint in this scene.
///
/// @see @ref mochi::Constraint "Constraint", @ref mochi::ConstraintHandle "ConstraintHandle", @ref mochi::Scene::DestroyConstraint "DestroyConstraint", @ref mochi::Constraint::GetHandle "Constraint::GetHandle"
///

/// @fn Constraint const* mochi::Scene::GetConstraint(ConstraintHandle constraint) const
///
/// @brief Get the const @ref mochi::Constraint "Constraint" pointer associated with a @ref mochi::ConstraintHandle "ConstraintHandle".
///
/// @param[in] constraint Handle of the constraint to retrieve. If valid, it must be owned by this scene.
/// @return Const pointer to the @ref mochi::Constraint "Constraint", or nullptr if the handle does not currently identify a constraint in this scene.
///
/// @see @ref mochi::Constraint "Constraint", @ref mochi::ConstraintHandle "ConstraintHandle", @ref mochi::Scene::DestroyConstraint "DestroyConstraint", @ref mochi::Constraint::GetHandle "Constraint::GetHandle"
///

/// @fn void mochi::Scene::DestroyConstraint(Constraint* constraint)
///
/// @brief Destroy a constraint and remove it from the scene.
///
/// @param[in] constraint Pointer to the constraint to destroy.
///
/// @note If @p constraint is null, this function has no effect.
/// @note After the constraint is destroyed, do not use the pointer or its handle.
///
/// @warning The pointer must be null or point to a live constraint owned by this scene. Passing a pointer to a constraint that has been destroyed is undefined behavior.
///
/// @see @ref mochi::Scene::GetConstraint "GetConstraint", @ref mochi::Constraint::GetHandle "Constraint::GetHandle"
///

/// @fn void mochi::Scene::DestroyConstraint(ConstraintHandle constraint)
///
/// @brief Destroy a constraint and remove it from the scene.
///
/// @param[in] constraint Handle of the constraint to destroy. If valid, it must be owned by this scene.
///
/// @note An invalid handle or one that does not currently identify a constraint in the scene has no effect.
/// @note After the constraint is destroyed, do not use its handle.
///
/// @see @ref mochi::Scene::GetConstraint "GetConstraint", @ref mochi::Constraint::GetHandle "Constraint::GetHandle"
///

/// @fn int mochi::Scene::GetNumConstraints() const
///
/// @brief Get the number of constraints in the scene.
///
/// @return Number of constraints in the scene.
///
/// @note Includes constraints created implicitly by @ref mochi::Scene::CreateArticulatedActor "CreateArticulatedActor" (e.g. articulated joint limits).
///

/// @fn void mochi::Scene::ForEachConstraint(std::function<void(Constraint*)> const& callback)
///
/// @brief Iterate over all the constraints in the scene using a callback.
///
/// @param[in] callback Function called once for each constraint.
///
/// @note Includes constraints created implicitly by @ref mochi::Scene::CreateArticulatedActor "CreateArticulatedActor" (e.g. articulated joint limits).
///
/// @warning Destroying other constraints or actors from within the callback is illegal.
///

/// @fn void mochi::Scene::ForEachConstraint(std::function<void(Constraint const*)> const& callback) const
///
/// @brief Iterate over all the constraints in the scene using a callback (const version).
///
/// @param[in] callback Function called once for each constraint.
///
/// @note Includes constraints created implicitly by @ref mochi::Scene::CreateArticulatedActor "CreateArticulatedActor" (e.g. articulated joint limits).
///
/// @warning Destroying other constraints or actors from within the callback is illegal.
///

/// @fn DebugDraw& mochi::Scene::GetDebugDraw()
///
/// @brief Get the debug draw interface for this scene.
///
/// @return Reference to the @ref mochi::DebugDraw "DebugDraw" interface.
///
/// @see @ref mochi::DebugDraw "DebugDraw"
///

/// @fn DebugDraw const& mochi::Scene::GetDebugDraw() const
///
/// @brief Get a const reference to the debug draw interface for this scene.
///
/// @return Const reference to the @ref mochi::DebugDraw "DebugDraw" interface.
///
/// @see @ref mochi::DebugDraw "DebugDraw"
///

/// @fn void mochi::Scene::UpdateDebugger()
///
/// @brief This gives the debugger a chance to process messages that require reading or writing scene state.
///
/// @details Please call this periodically if you are not actively stepping the scene. If this function is never called and the scene is never stepped, then some debugger features will not work.
///
/// @note Must be called on the scene's owning thread (like other @ref mochi::Scene "Scene" methods).
///

/// @fn bool mochi::Scene::IsRecording() const
///
/// @brief Check if the scene is currently recording.
///
/// @return True if recording is active, false otherwise.
///
/// @note A recording write failure does not end the recording session.
///
/// @see @ref mochi::Scene::StartRecording "StartRecording", @ref mochi::Scene::StopRecording "StopRecording"
///

/// @fn void mochi::Scene::StartRecording(std::string_view filePath, RecordingParams const& params, Error& error)
///
/// @brief Create or replace the specified file and start recording the scene to an HDF5 file.
///
/// @param[in] filePath Path to the output recording file (case sensitive on some filesystems). File will be created or replaced.
/// @param[in] params Parameters controlling what data to record.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Enabling additional recording features will generally increase the recording file size and degrade performance.
/// @note If the scene is already recording, the previous recording is stopped before starting the new one.
///
/// @warning Requires a build with HDF5 support.
/// @warning The recording system may undergo a substantial refactor to expand its capabilities. Its API and recorded file format may change in future releases.
///
/// @see @ref mochi::Scene::StopRecording "StopRecording", @ref mochi::Scene::IsRecording "IsRecording", @ref mochi::RecordingParams "RecordingParams"
///

/// @fn void mochi::Scene::StopRecording()
///
/// @brief Stop recording the scene and close the recording file.
///
/// @see @ref mochi::Scene::StartRecording "StartRecording", @ref mochi::Scene::IsRecording "IsRecording"
///

/// @fn void mochi::Scene::EnableLayerContactAsymmetric(std::string_view layerA, std::string_view layerB, bool enable, Error& error)
///
/// @brief Enable or disable collision detection for an ordered pair of contact layer names. Order matters: controls only the specified direction (actors in layerA checking against actors in layerB).
///
/// @param[in] layerA Name of the layer of the "colliding" actor (the one checking for contact). Must be non-empty.
/// @param[in] layerB Name of the layer of the "collider" actor (the one with a @ref mochi::ColliderType "ColliderType" being tested). Must be non-empty.
/// @param[in] enable True to enable contact, false to disable it.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Contact is enabled by default. You only need to call this method if you wish to disable (or re-enable) contact for a specific layer pair.
/// @note Both layer-to-layer and actor-to-actor contact must be enabled for contact to occur.
/// @note Call twice with swapped arguments or use @ref mochi::Scene::EnableLayerContactSymmetric "EnableLayerContactSymmetric" to affect collision checks in both directions.
/// @note Calling this method with a layer name not previously seen in the scene registers it as a new contact layer, increasing @ref mochi::Scene::GetNumContactLayers "GetNumContactLayers" and adding the name to @ref mochi::Scene::EnumerateContactLayerNames "EnumerateContactLayerNames".
///
/// @see @ref mochi::Scene::EnableLayerContactSymmetric "EnableLayerContactSymmetric", @ref mochi::Scene::EnableActorContactAsymmetric "EnableActorContactAsymmetric", @ref mochi::Scene::IsLayerContactEnabled "IsLayerContactEnabled"
///

/// @fn void mochi::Scene::EnableLayerContactSymmetric(std::string_view layerA, std::string_view layerB, bool enable, Error& error)
///
/// @brief Equivalent to calling @ref mochi::Scene::EnableLayerContactAsymmetric "EnableLayerContactAsymmetric" with @p layerA and @p layerB in both orders.
///
/// @param[in] layerA Name of the first contact layer. Must be non-empty.
/// @param[in] layerB Name of the second contact layer. Must be non-empty.
/// @param[in] enable True to enable contact, false to disable it.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "EnableLayerContactAsymmetric", @ref mochi::Scene::EnableActorContactSymmetric "EnableActorContactSymmetric", @ref mochi::Scene::IsLayerContactEnabled "IsLayerContactEnabled"
///

/// @fn bool mochi::Scene::IsLayerContactEnabled(std::string_view layerA, std::string_view layerB) const
///
/// @brief Check if collision detection is enabled for an ordered pair of contact layer names. Order matters: refers only to the specified direction (actors in layerA checking against actors in layerB).
///
/// @param[in] layerA Name of the layer of the "colliding" actor (the one checking for contact).
/// @param[in] layerB Name of the layer of the "collider" actor (the one with a @ref mochi::ColliderType "ColliderType" being tested).
/// @return True if layer-to-layer contact is enabled, false if layer-to-layer contact is disabled.
///
/// @note Contact is enabled by default, so you will get true for any pair of layers unless overridden via @ref mochi::Scene::EnableLayerContactAsymmetric "EnableLayerContactAsymmetric" or @ref mochi::Scene::EnableLayerContactSymmetric "EnableLayerContactSymmetric".
/// @note This only checks the layer filter. Actor-to-actor contact can still be disabled with @ref mochi::Scene::EnableActorContactAsymmetric "EnableActorContactAsymmetric" or @ref mochi::Scene::EnableActorContactSymmetric "EnableActorContactSymmetric".
///
/// @see @ref mochi::Scene::EnableLayerContactAsymmetric "EnableLayerContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "EnableLayerContactSymmetric"
///

/// @fn int mochi::Scene::GetNumContactLayers() const
///
/// @brief Get the number of unique contact layer names in the scene.
///
/// @return Number of unique layer names in the scene.
///
/// @note The count may include layer names not currently assigned to an actor.
///
/// @see @ref mochi::Scene::EnumerateContactLayerNames "EnumerateContactLayerNames"
///

/// @fn void mochi::Scene::EnumerateContactLayerNames(std::function<void(std::string_view)> const& callback) const
///
/// @brief Enumerate all unique contact layer names in the scene.
///
/// @param[in] callback Function called once for each layer name.
///
/// @note The callback fires @ref mochi::Scene::GetNumContactLayers "GetNumContactLayers" times.
/// @note Enumeration order is unspecified.
///
/// @warning Do not register new contact layers from inside the callback. Doing so may invalidate the enumeration and cause undefined behavior.
///
/// @see @ref mochi::Scene::GetNumContactLayers "GetNumContactLayers"
///

/// @fn void mochi::Scene::EnableActorContactAsymmetric(ActorHandle colliding, ActorHandle collider, bool enable, IncludeNestedActors includeNestedActors, Error& error)
///
/// @brief Enable or disable collision detection between two actors. Order matters: controls only the specified direction (colliding actor checking against collider actor).
///
/// @param[in] colliding Handle of the colliding actor.
/// @param[in] collider Handle of the collider actor.
/// @param[in] enable True to enable contact, false to disable it.
/// @param[in] includeNestedActors Whether nested actors should be affected by this contact setting. With @ref mochi::IncludeNestedActors::No "IncludeNestedActors::No", only the exact handles are affected. With @ref mochi::IncludeNestedActors::Yes "IncludeNestedActors::Yes", parent actors with nested actors resolve to the parent plus nested actors. The setting is applied to every ordered pair in the cross-product of the two resolved handle sets; no pairs outside that cross-product are affected. If the resolved sets overlap, pairs in the overlap, including self-pairs, are affected.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Contact is enabled by default. You only need to call this method if you wish to disable (or re-enable) contact for a specific actor pair.
/// @note Both layer-to-layer and actor-to-actor contact must be enabled for contact to occur.
/// @note Contact between adjacent links is automatically disabled when an articulated or soft-skinned actor is created. A later actor-contact setting can override that automatic disable for any pair included in the resolved actor sets. In particular, enabling contact between a parent actor and itself with @ref mochi::IncludeNestedActors::Yes "IncludeNestedActors::Yes" enables contact between that parent's nested actors, including adjacent links, unless a later actor-contact setting disables those pairs again.
/// @note Call twice with swapped arguments or use @ref mochi::Scene::EnableActorContactSymmetric "EnableActorContactSymmetric" to affect collision checks in both directions.
///
/// @see @ref mochi::Scene::EnableActorContactSymmetric "EnableActorContactSymmetric", @ref mochi::Scene::EnableLayerContactAsymmetric "EnableLayerContactAsymmetric"
///

/// @fn void mochi::Scene::EnableActorContactSymmetric(ActorHandle actorA, ActorHandle actorB, bool enable, IncludeNestedActors includeNestedActors, Error& error)
///
/// @brief Equivalent to calling @ref mochi::Scene::EnableActorContactAsymmetric "EnableActorContactAsymmetric" with @p actorA and @p actorB in both orders using the same @p includeNestedActors.
///
/// @param[in] actorA Handle of the first actor.
/// @param[in] actorB Handle of the second actor.
/// @param[in] enable True to enable contact, false to disable it.
/// @param[in] includeNestedActors Whether nested actors should be affected by this contact setting. See @ref mochi::Scene::EnableActorContactAsymmetric "EnableActorContactAsymmetric" for details.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @see @ref mochi::Scene::EnableActorContactAsymmetric "EnableActorContactAsymmetric", @ref mochi::Scene::EnableLayerContactSymmetric "EnableLayerContactSymmetric"
///

/// @fn CallbackHandle mochi::Scene::RegisterPreStepCallback(std::string_view debugName, std::function<void(StepInfo const&)> callback, int priority)
///
/// @brief Register a callback to execute before each simulation step.
///
/// @param[in] debugName Descriptive name for debugging and profiling.
/// @param[in] callback Callback function receiving @ref mochi::StepInfo "StepInfo".
/// @param[in] priority Execution order. Lower values execute first (higher priority).
/// @return @ref mochi::CallbackHandle "CallbackHandle" for the registered callback.
///
/// @note Callbacks run sequentially on the thread that calls @ref mochi::Scene::Step "Step", in increasing priority order (lower values first).
/// @note The relative order of callbacks registered with equal priority is unspecified. Assign distinct priorities when ordering matters.
/// @note Callbacks must be thread-safe if they access shared state.
/// @note Callbacks should not modify scene structure (add/remove actors/constraints).
///
/// @see @ref mochi::Scene::CancelCallback "CancelCallback", @ref mochi::Scene::RegisterPostStepCallback "RegisterPostStepCallback"
///

/// @fn CallbackHandle mochi::Scene::RegisterPostStepCallback(std::string_view debugName, std::function<void(StepInfo const&)> callback, int priority)
///
/// @brief Register a callback to execute after each simulation step.
///
/// @param[in] debugName Descriptive name for debugging and profiling.
/// @param[in] callback Callback function receiving @ref mochi::StepInfo "StepInfo".
/// @param[in] priority Execution order. Lower values execute first (higher priority).
/// @return @ref mochi::CallbackHandle "CallbackHandle" for the registered callback.
///
/// @note Callbacks run sequentially on the thread that calls @ref mochi::Scene::Step "Step", in increasing priority order (lower values first).
/// @note The relative order of callbacks registered with equal priority is unspecified. Assign distinct priorities when ordering matters.
/// @note Callbacks must be thread-safe if they access shared state.
/// @note Callbacks should not modify scene structure (add/remove actors/constraints).
///
/// @see @ref mochi::Scene::CancelCallback "CancelCallback", @ref mochi::Scene::RegisterPreStepCallback "RegisterPreStepCallback"
///

/// @fn void mochi::Scene::CancelCallback(CallbackHandle handle)
///
/// @brief Cancel a previously registered callback.
///
/// @param[in] handle @ref mochi::CallbackHandle "CallbackHandle" from @ref mochi::Scene::RegisterPreStepCallback "RegisterPreStepCallback" or @ref mochi::Scene::RegisterPostStepCallback "RegisterPostStepCallback". Must be owned by this scene.
///
/// @note Invalid and already-cancelled handles are ignored.
///
/// @see @ref mochi::Scene::RegisterPreStepCallback "RegisterPreStepCallback", @ref mochi::Scene::RegisterPostStepCallback "RegisterPostStepCallback"
///

/// @var mochi::Scene::kDefaultCallbackPriority
///
/// @brief Default priority for callback ordering. Lower values execute earlier (higher priority).
///

/// @var mochi::kDefaultGravity
///
/// @brief Default gravity acceleration in world frame [m/s²].
///

/// @class mochi::AsyncScene
///
/// @brief Manages a simulation scene that steps asynchronously using the SuperDex Physics worker pool.
///
/// @details AsyncScene wraps a synchronous @ref mochi::Scene "Scene" and automatically steps it using a long-lived simulation task executed by the SuperDex Physics worker pool, decoupling physics updates from the main thread. This enables real-time interactive simulations where physics rate is independent of rendering rate.
///
/// @note In general, commands to modify the scene are queued and executed before the next simulation step.
/// @note Thread-safe as long as the synchronous Scene and Actor APIs are only accessed within callbacks.
/// @note Outside of callbacks, store @ref mochi::ActorHandle "ActorHandle" (not Actor*).
/// @note The AsyncScene owns its underlying @ref mochi::Scene "Scene".
///
/// @warning Concurrent access to the underlying @ref mochi::Scene "Scene" outside of callbacks is illegal.
///

/// @fn Context* mochi::AsyncScene::GetContext()
///
/// @brief Get the @ref mochi::Context "Context" that owns this @ref mochi::AsyncScene "AsyncScene".
///
/// @return Pointer to the owning @ref mochi::Context "Context".
///

/// @fn void mochi::AsyncScene::QueueCommand(std::function<void(Scene*)> callback)
///
/// @brief Queue a command to execute on the simulation thread before the next step.
///
/// @param[in] callback Function to execute. Receives Scene* when executed.
///
/// @note Executed before the next simulation step when Scene access is safe.
/// @note When using lambdas, capture by value or use @ref mochi::AsyncScene::WaitForQueuedCommands "WaitForQueuedCommands" to ensure object lifespan.
///
/// @see @ref mochi::AsyncScene::WaitForQueuedCommands "WaitForQueuedCommands", @ref mochi::AsyncScene::QueueActorCommand "QueueActorCommand"
///

/// @fn void mochi::AsyncScene::QueueActorCommand(ActorHandle actor, std::function<void(Actor*)> callback)
///
/// @brief Queue a command to operate on a specific actor on the simulation thread.
///
/// @param[in] actor Handle of the actor to operate on.
/// @param[in] callback Function to execute. Receives Actor* when executed.
///
/// @note Callback only fires if the actor still exists when processed.
/// @note Provides direct access to the synchronous Actor API.
///
/// @see @ref mochi::AsyncScene::QueueCommand "QueueCommand", @ref mochi::AsyncScene::WaitForQueuedCommands "WaitForQueuedCommands"
///

/// @fn void mochi::AsyncScene::WaitForQueuedCommands()
///
/// @brief Block the calling thread until all previously queued commands have executed.
///
/// @warning It is illegal to call from the simulation thread.
///
/// @see @ref mochi::AsyncScene::QueueCommand "QueueCommand", @ref mochi::AsyncScene::QueueActorCommand "QueueActorCommand"
///

/// @fn CallbackHandle mochi::AsyncScene::RegisterPreStepCallback(std::string_view debugName, std::function<void(StepInfo const&)> callback, int priority)
///
/// @brief Register a callback to execute before each simulation step.
///
/// @param[in] debugName Descriptive name for debugging and profiling.
/// @param[in] callback Callback function to execute.
/// @param[in] priority Execution order. Lower values execute first (higher priority).
/// @return @ref mochi::CallbackHandle "CallbackHandle" for the registered callback.
///
/// @note Callbacks run sequentially on the simulation thread, in increasing priority order (lower values first).
/// @note Can be called from any thread.
///
/// @see @ref mochi::AsyncScene::CancelCallback "CancelCallback", @ref mochi::AsyncScene::RegisterPostStepCallback "RegisterPostStepCallback"
///

/// @fn CallbackHandle mochi::AsyncScene::RegisterPostStepCallback(std::string_view debugName, std::function<void(StepInfo const&)> callback, int priority)
///
/// @brief Register a callback to execute after each simulation step.
///
/// @param[in] debugName Descriptive name for debugging and profiling.
/// @param[in] callback Callback function to execute.
/// @param[in] priority Execution order. Lower values execute first (higher priority).
/// @return @ref mochi::CallbackHandle "CallbackHandle" for the registered callback.
///
/// @note Callbacks run sequentially on the simulation thread, in increasing priority order (lower values first).
/// @note Can be called from any thread.
///
/// @see @ref mochi::AsyncScene::CancelCallback "CancelCallback", @ref mochi::AsyncScene::RegisterPreStepCallback "RegisterPreStepCallback"
///

/// @fn void mochi::AsyncScene::CancelCallback(CallbackHandle handle)
///
/// @brief Cancel a previously registered callback.
///
/// @param[in] handle @ref mochi::CallbackHandle "CallbackHandle" from @ref mochi::AsyncScene::RegisterPreStepCallback "RegisterPreStepCallback" or @ref mochi::AsyncScene::RegisterPostStepCallback "RegisterPostStepCallback".
///
/// @note Can be called from any thread.
///
/// @see @ref mochi::AsyncScene::RegisterPreStepCallback "RegisterPreStepCallback", @ref mochi::AsyncScene::RegisterPostStepCallback "RegisterPostStepCallback"
///

/// @fn QueryHandle mochi::AsyncScene::RegisterActorQuery(ActorHandle actor, QueryType type, bool forceCompute)
///
/// @brief Register a query with an actor.
///
/// @param[in] actor Handle of the actor to register the query with.
/// @param[in] type Type of query to register.
/// @param[in] forceCompute If true, compute the query result immediately on the simulation thread upon registration, rather than waiting for the next simulation step. Useful when the actor does not simulate (e.g., a static actor or a paused scene).
/// @return @ref mochi::QueryHandle "QueryHandle" for the registered query, or an invalid handle if @p actor is invalid.
///
/// @note Can be called from any thread.
/// @note May be more convenient than calling @ref mochi::AsyncScene::QueueActorCommand "QueueActorCommand" because it returns the @ref mochi::QueryHandle "QueryHandle" synchronously.
///
/// @see @ref mochi::AsyncScene::CancelActorQuery "CancelActorQuery", @ref mochi::Actor::RegisterQuery "Actor::RegisterQuery", @ref mochi::Actor::RegisterQueryAndCompute "Actor::RegisterQueryAndCompute"
///

/// @fn void mochi::AsyncScene::CancelActorQuery(ActorHandle actor, QueryHandle handle)
///
/// @brief Cancel a query previously registered with an actor.
///
/// @param[in] actor Handle of the actor.
/// @param[in] handle @ref mochi::QueryHandle "QueryHandle" from @ref mochi::AsyncScene::RegisterActorQuery "RegisterActorQuery".
///
/// @see @ref mochi::AsyncScene::RegisterActorQuery "RegisterActorQuery", @ref mochi::Actor::CancelQuery "Actor::CancelQuery"
///

/// @fn AsyncStepParams mochi::AsyncScene::GetAsyncStepParams() const
///
/// @brief Get the parameters controlling async stepping behavior.
///
/// @return Current async step parameters.
///
/// @see @ref mochi::AsyncScene::SetAsyncStepParams "SetAsyncStepParams", @ref mochi::AsyncStepParams "AsyncStepParams"
///

/// @fn void mochi::AsyncScene::SetAsyncStepParams(AsyncStepParams const& params, Error& error)
///
/// @brief Set the parameters controlling async stepping behavior.
///
/// @param[in] params Async step parameters to set.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Changes take effect on the next simulation step.
///
/// @see @ref mochi::AsyncScene::GetAsyncStepParams "GetAsyncStepParams", @ref mochi::AsyncStepParams "AsyncStepParams"
///

/// @fn void mochi::AsyncScene::Pause(bool shouldPause)
///
/// @brief Pause or unpause the simulation.
///
/// @param[in] shouldPause True to pause, false to unpause.
///
/// @note When paused, simulation does not step but queued commands will still execute.
///
/// @see @ref mochi::AsyncScene::IsPaused "IsPaused", @ref mochi::AsyncScene::RequestStepThenPause "RequestStepThenPause"
///

/// @fn bool mochi::AsyncScene::IsPaused() const
///
/// @brief Check if the simulation is currently paused.
///
/// @return True if paused, false if not paused.
///
/// @note When called from the simulation thread, returns the actual pause state. When called from other threads, returns the most recently requested pause state to present a consistent state to the calling thread.
///
/// @see @ref mochi::AsyncScene::Pause "Pause"
///

/// @fn void mochi::AsyncScene::RequestStepThenPause()
///
/// @brief Advance the simulation by exactly one step, then pause.
///
/// @note Works even if the simulation is already paused.
/// @note Uses @ref mochi::AsyncStepParams::fixedTimeStepSeconds "AsyncStepParams::fixedTimeStepSeconds" even when dynamic-time-step mode is configured. If @ref mochi::AsyncStepParams::timeStepCallback "AsyncStepParams::timeStepCallback" is set and returns a non-negative value, the callback's value is used instead.
/// @note Useful for debugging frame-by-frame.
///
/// @see @ref mochi::AsyncScene::Pause "Pause", @ref mochi::AsyncStepParams::fixedTimeStepSeconds "AsyncStepParams::fixedTimeStepSeconds", @ref mochi::AsyncStepParams::timeStepCallback "AsyncStepParams::timeStepCallback"
///

/// @class mochi::DebugDraw
///
/// @brief Manages debug visualization features for a scene.
///
/// @details Provides a feature-based system for visualizing various aspects of the physics simulation. The client application is responsible for rendering the generated primitives using its own graphics API. Features can be individually enabled or disabled, such as visualizing contact points, normals, velocities, or AABBs.
///
/// @note Must be accessed on the same thread as the owning @ref mochi::Scene "Scene".
/// @note Debug draw is disabled by default.
/// @note If consuming the data on a different thread, the client must deep-copy the underlying data into client-owned buffers before the scene thread calls @ref mochi::DebugDraw::GatherData "GatherData" again or modifies the @ref mochi::Scene "Scene". Copying @ref mochi::DebugDrawData "DebugDrawData" itself is a shallow copy of @ref mochi::Span "Span" views into internal buffers and does not transfer ownership.
///
/// @warning Debug drawing has significant performance overhead due to geometry generation and data gathering.
///
/// @see @ref mochi::Scene::GetDebugDraw "Scene::GetDebugDraw", @ref mochi::DebugDrawData "DebugDrawData"
///

/// @fn bool mochi::DebugDraw::IsEnabled() const
///
/// @brief Check if debug drawing is enabled for the scene.
///
/// @return True if debug drawing is enabled, false otherwise.
///
/// @note When disabled, @ref mochi::DebugDraw::GatherData "GatherData" returns empty data regardless of feature settings.
///
/// @see @ref mochi::DebugDraw::Enable "Enable"
///

/// @fn void mochi::DebugDraw::Enable(bool enable)
///
/// @brief Enable or disable debug drawing for the entire scene.
///
/// @param[in] enable True to enable, false to disable.
///
/// @note This is a master switch that overrides all individual feature settings.
///
/// @see @ref mochi::DebugDraw::IsEnabled "IsEnabled"
///

/// @fn int mochi::DebugDraw::GetNumFeatures() const
///
/// @brief Get the number of debug draw features available.
///
/// @return Number of features that can be individually enabled or disabled.
///
/// @see @ref mochi::DebugDraw::FindFeature "FindFeature", @ref mochi::DebugDraw::GetFeatureName "GetFeatureName"
///

/// @fn int mochi::DebugDraw::FindFeature(std::string_view name) const
///
/// @brief Find a feature by name.
///
/// @param[in] name Feature name (case sensitive).
/// @return Feature index if found, or -1 if not found.
///
/// @see @ref mochi::DebugDraw::GetFeatureName "GetFeatureName", @ref mochi::DebugDraw::EnableFeature "EnableFeature"
///

/// @fn std::string_view mochi::DebugDraw::GetFeatureName(int index) const
///
/// @brief Get the name of a feature by index.
///
/// @param[in] index Feature index in the range [0, @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures").
/// @return Name of the feature.
///
/// @see @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures", @ref mochi::DebugDraw::FindFeature "FindFeature"
///

/// @fn std::string_view mochi::DebugDraw::GetFeatureDescription(int index) const
///
/// @brief Get the description of a feature by index.
///
/// @param[in] index Feature index in the range [0, @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures").
/// @return Human-readable description of the feature.
///
/// @see @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures", @ref mochi::DebugDraw::GetFeatureName "GetFeatureName"
///

/// @fn bool mochi::DebugDraw::IsFeatureEnabled(int index) const
///
/// @brief Check if a feature is currently enabled.
///
/// @param[in] index Feature index in the range [0, @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures").
/// @return True if the feature is enabled, false otherwise.
///
/// @see @ref mochi::DebugDraw::EnableFeature "EnableFeature"
///

/// @fn void mochi::DebugDraw::EnableFeature(int index, bool enable)
///
/// @brief Enable or disable a specific feature.
///
/// @param[in] index Feature index in the range [0, @ref mochi::DebugDraw::GetNumFeatures "GetNumFeatures").
/// @param[in] enable True to enable the feature, false to disable.
///
/// @note No debug-draw data is generated while the master switch (@ref mochi::DebugDraw::IsEnabled "IsEnabled") is false, but per-feature settings are remembered and take effect when the master switch is enabled.
///
/// @see @ref mochi::DebugDraw::IsFeatureEnabled "IsFeatureEnabled", @ref mochi::DebugDraw::Enable "Enable"
///

/// @fn DebugDrawData mochi::DebugDraw::GatherData()
///
/// @brief Generate debug draw primitives for all currently enabled features.
///
/// @return Collection of primitives to be rendered by the client application. The returned @ref mochi::DebugDrawData "DebugDrawData" contains Spans that reference internal buffers.
///
/// @note Data is valid only until the next call to @ref mochi::DebugDraw::GatherData "GatherData" or any modification to the @ref mochi::Scene "Scene".
/// @note Returns empty data if @ref mochi::DebugDraw::IsEnabled "IsEnabled" is false.
///
/// @see @ref mochi::DebugDrawData "DebugDrawData"
///

/// @fn void mochi::DebugDraw::EnableActor(ActorHandle actor, bool enable, Error& error)
///
/// @brief Enable or disable debug drawing for a specific actor.
///
/// @param[in] actor Handle of the actor to enable or disable debug drawing for.
/// @param[in] enable True to enable, false to disable.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///
/// @note Enabled by default for all actors, including nested actors (child actors of articulated, soft-skinned and blended actors).
/// @note Debug draw data won't be generated for any actor if the master switch, i.e. @ref mochi::DebugDraw::IsEnabled "IsEnabled", is false.
///

/// @class mochi::DebugServer
///
/// @brief Server API to enable remote debugging and visualization.
///
/// @see @ref mochi::Context::GetDebugServer "Context::GetDebugServer"
///

/// @fn void mochi::DebugServer::Start(uint16_t preferredPort)
///
/// @brief Start accepting client connections on a TCP port.
///
/// @param[in] preferredPort Preferred TCP port to listen on. If the port is already in use, the next available port is chosen automatically.
///
/// @note No-op if the server has already been started.
///
/// @see @ref mochi::DebugServer::Stop "Stop", @ref mochi::DebugServer::HasStarted "HasStarted", @ref mochi::DebugServer::GetPort "GetPort"
///

/// @fn void mochi::DebugServer::Stop()
///
/// @brief Stop the server and disconnect any connected client.
///
/// @note No-op if the server has not started.
///
/// @see @ref mochi::DebugServer::Start "Start", @ref mochi::DebugServer::HasStarted "HasStarted"
///

/// @fn bool mochi::DebugServer::HasStarted() const
///
/// @brief Check whether the server has started.
///
/// @return True if @ref mochi::DebugServer::Start "Start" has been called, even if the server is not actually able to accept connections due to issues with permissions or firewalls.
///
/// @see @ref mochi::DebugServer::Start "Start", @ref mochi::DebugServer::Stop "Stop"
///

/// @fn bool mochi::DebugServer::HasConnection() const
///
/// @brief Check whether a debugger client is currently connected.
///
/// @return True if any debugger client is connected.
///
/// @see @ref mochi::DebugServer::Start "Start", @ref mochi::DebugServer::Stop "Stop"
///

/// @fn uint16_t mochi::DebugServer::GetPort() const
///
/// @brief Get the actual TCP port the server is listening on.
///
/// @details May differ from the port requested in @ref mochi::DebugServer::Start "Start" if that port was already in use.
///
/// @return The TCP port currently in use, or 0 if the server is not listening on a TCP socket.
///
/// @see @ref mochi::DebugServer::Start "Start"
///

/// @fn void mochi::DebugServer::SetCoordinateSpace(CoordinateSpace const& space)
///
/// @brief Declare the coordinate space this application's scene data is expressed in.
///
/// @details Sent to the debugger client so it can render the scene in the correct orientation. This is purely descriptive metadata: it does not affect simulation. The default is X-right, Y-up, Z-backward.
///
/// @param[in] space Coordinate space convention and unit scale of this application's scenes.
///
/// @note Must be called before @ref mochi::DebugServer::Start "Start".
///
/// @see @ref mochi::DebugServer::Start "Start"
///
