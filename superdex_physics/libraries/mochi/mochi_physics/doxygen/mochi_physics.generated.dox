/// @details It encapsulates a smart pointer to @ref mochi::prefab::ScenePrefab "prefab::ScenePrefab".
///
/// @see @ref mochi::prefab::PrefabReference "prefab::PrefabReference", @ref mochi::prefab::LoadNestedPrefabs "prefab::LoadNestedPrefabs", @ref mochi::prefab::EnsureFullyLoaded "prefab::EnsureFullyLoaded", @ref mochi::prefab::ScenePrefab "prefab::ScenePrefab"
///

/// @var mochi::kInvalidHandle
///
