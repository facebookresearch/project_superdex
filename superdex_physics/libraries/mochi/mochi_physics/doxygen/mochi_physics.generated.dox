///
/// @note Only applicable to articulated actors.
///
/// @see @ref mochi::Actor::GetNestedLinkActors "GetNestedLinkActors", @ref mochi::Actor::IsNestedSoftActor "IsNestedSoftActor", @ref mochi::Actor::GetArticulatedActor "GetArticulatedActor"
///

/// @fn ArticulatedShapeInfo mochi::Actor::GetArticulatedShapeInfo(Error& error) const
///
/// @brief Get articulated shape information about the articulated actor.
///
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
