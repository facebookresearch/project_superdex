/// @class mochi::Context
///
/// @brief Main entry point for SuperDex Physics simulation.
///
/// @details A @ref mochi::Context "Context" owns all global state for SuperDex Physics: scenes, shapes, threading, and shared resources. Create exactly one per process with @ref mochi::CreateContext "CreateContext", and destroy it with @ref mochi::DestroyContext "DestroyContext". Shapes are reference-counted and can be shared between actors.
///

/// @fn void mochi::Context::BindThisThread()
///
/// @brief Bind the calling thread to this @ref mochi::Context "Context".
///
/// @details Required before using any @ref mochi::Context "Context", @ref mochi::Scene "Scene", @ref mochi::Actor "Actor", or another part of the SuperDex Physics API from a thread that did not create the @ref mochi::Context "Context". The thread that called @ref mochi::CreateContext "CreateContext" is bound automatically. Each call must be matched by a call to @ref mochi::Context::UnbindThisThread "UnbindThisThread" before the thread exits. The binding is reference-counted, so redundant calls from the same thread are safe as long as they are balanced.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::UnbindThisThread "UnbindThisThread", @ref mochi::CreateContext "CreateContext"
///

/// @fn void mochi::Context::UnbindThisThread()
///
/// @brief Unbind the calling thread from this @ref mochi::Context "Context".
///
/// @details Each call to @ref mochi::Context::BindThisThread "BindThisThread" must be matched by a call to @ref mochi::Context::UnbindThisThread "UnbindThisThread" before the thread exits. The binding is reference-counted, so the thread is only unbound when the number of unbind calls matches the number of bind calls.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::BindThisThread "BindThisThread"
///

/// @fn void mochi::Context::SetIsSingleThreaded(bool isSingleThreaded)
///
/// @brief Enable or disable single-threaded mode.
///
/// @details In single-threaded mode, each new task will be executed on the calling thread, even if other threads are available. This may hurt performance, but it is useful for debugging and batch simulation.
///
/// Enabling single-threaded mode does not, however, terminate tasks that are already running asynchronously. Such tasks will run to completion. For example, if you have an @ref mochi::AsyncScene "AsyncScene", it will continue to step asynchronously, but each step will do its work on that one thread.
///
/// @param[in] isSingleThreaded True to enable single-threaded mode. False to disable.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::IsSingleThreaded "IsSingleThreaded"
///

/// @fn bool mochi::Context::IsSingleThreaded() const
///
/// @brief Return true if running in single-threaded mode.
///
/// @details Returns true when the @ref mochi::Context "Context" was created with zero worker threads (see @ref mochi::CreateContext "CreateContext") or when single-threaded mode has been explicitly enabled via @ref mochi::Context::SetIsSingleThreaded "SetIsSingleThreaded".
///
/// @return True if running in single-threaded mode.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::SetIsSingleThreaded "SetIsSingleThreaded", @ref mochi::CreateContext "CreateContext"
///

/// @fn int mochi::Context::GetNumThreads() const
///
/// @brief Return the number of worker threads available to execute asynchronous tasks.
///
/// @return The configured worker-thread count (see @ref mochi::CreateContext "CreateContext"), or zero if single-threaded mode is enabled (see @ref mochi::Context::SetIsSingleThreaded "SetIsSingleThreaded").
///
/// @note Call on any thread.
///
/// @see @ref mochi::CreateContext "CreateContext", @ref mochi::Context::IsSingleThreaded "IsSingleThreaded"
///

/// @fn void mochi::Context::EnableLogChannel(LogChannel channel, bool enable)
///
/// @brief Enable or disable log messages on the specified channel.
///
/// @details When a channel is disabled, messages on that channel are discarded before reaching the logging callback (see @ref mochi::Context::SetLogCallback "SetLogCallback").
///
/// @param[in] channel The log channel to enable or disable.
/// @param[in] enable True to enable the channel, false to disable it.
///
/// @note By default, all channels are enabled except for @ref mochi::LogChannel::Verbose "LogChannel::Verbose".
/// @note Call on any thread.
///
/// @see @ref mochi::Context::IsLogChannelEnabled "IsLogChannelEnabled", @ref mochi::Context::SetLogCallback "SetLogCallback"
///

/// @fn bool mochi::Context::IsLogChannelEnabled(LogChannel channel)
///
/// @brief Return true if messages on the specified log channel are enabled.
///
/// @param[in] channel The log channel to query.
/// @return True if the channel is enabled, false otherwise.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::EnableLogChannel "EnableLogChannel"
///

/// @fn void mochi::Context::SetLogCallback(LogFn callback)
///
/// @brief Optionally provide a callback function to redirect SuperDex Physics logging. The default function outputs to stdout and to the debugger (if attached).
///
/// @param[in] callback Function to handle logging, or nullptr to restore the default logging function.
///
/// @note Call on any thread.
///
/// @warning Your callback function may be called on any thread.
///
/// @see @ref mochi::Context::GetLogCallback "GetLogCallback"
///

/// @fn LogFn mochi::Context::GetLogCallback()
///
/// @brief Get the function currently being used to output logging.
///
/// @return The current logging callback function.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::SetLogCallback "SetLogCallback"
///

/// @fn void mochi::Context::SetAssertionFailureCallback(OnAssertFn callback)
///
/// @brief Optionally provide a callback function to customize the way in which assertion failures are reported.
///
/// @details An assertion failure indicates a serious problem with the internal code or runtime environment. When this occurs, the default function will log a block of error text, then stop at a breakpoint (fatal if no debugger is attached).
///
/// @param[in] callback Function to call in the event of an assertion failure, or nullptr to restore the default function.
///
/// @note Call on any thread.
///
/// @warning Your callback function may be called on any thread.
///
/// @see @ref mochi::Context::GetAssertionFailureCallback "GetAssertionFailureCallback"
///

/// @fn OnAssertFn mochi::Context::GetAssertionFailureCallback()
///
/// @brief Get the function currently being used to report assertion failures.
///
/// @return The current assertion failure callback function.
///
/// @note Call on any thread.
///
/// @see @ref mochi::Context::SetAssertionFailureCallback "SetAssertionFailureCallback"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromFile(std::string_view filePath, Error& error)
///
/// @brief Load a shape from a file of supported format.
///
/// @details Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off), PLY (.ply), and STL (.stl).
///
/// @param[in] filePath File path to load (case sensitive on some filesystems).
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return A @ref mochi::ShapeHandle "ShapeHandle" that can be used to create actors.
///
/// @note The shape remains in memory while referenced by any handle or actor. In the C API, you must release the shape explicitly by calling @ref mochi::Context::ReleaseShape "Context::ReleaseShape". In C++ and Python, this is optional, since @ref mochi::ShapeHandle "ShapeHandle" cleanup is automatic.
/// @note Call on any thread.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::ReleaseShape "ReleaseShape", @ref mochi::Context::LoadShapeFromBytes "LoadShapeFromBytes"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromFile(std::string_view filePath, Real3 const& bakeScale, Error& error)
///
/// @brief Load a shape from a file of supported format, and bake in some scale.
///
/// @details Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off), PLY (.ply), and STL (.stl).
///
/// @param[in] filePath File path to load (case sensitive on some filesystems).
/// @param[in] bakeScale Scale to bake into the shape or (1, 1, 1) for no change. Negative scale results in mirroring.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return A @ref mochi::ShapeHandle "ShapeHandle" that can be used to create actors.
///
/// @note The shape remains in memory while referenced by any handle or actor. In the C API, you must release the shape explicitly by calling @ref mochi::Context::ReleaseShape "Context::ReleaseShape". In C++ and Python, this is optional, since @ref mochi::ShapeHandle "ShapeHandle" cleanup is automatic.
/// @note Some shape data cannot bake arbitrary non-uniform scale. Unsupported scale values are rejected.
/// @note Precomputed grid SDF data is preserved only when @p bakeScale is uniform by absolute value. Non-uniform scale by absolute value discards the precomputed SDF. If an SDF collider later requires SDF data, SuperDex Physics regenerates it from the transformed mesh at runtime, which may be expensive.
/// @note If the loaded model has @ref mochi::ModelData::elementFrameAxes "ModelData::elementFrameAxes", @p bakeScale transforms those axes as normal directions using the inverse-transpose of the scale transform, then normalize them.
/// @note Call on any thread.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::ReleaseShape "ReleaseShape", @ref mochi::Context::LoadShapeFromBytes "LoadShapeFromBytes"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromFile(std::string_view filePath, TransformRT const& bakeTransform, Error& error)
///
/// @brief Load a shape from a file of supported format, and bake in rotation and translation.
///
/// @details Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off), PLY (.ply), and STL (.stl).
///
/// @param[in] filePath File path to load (case sensitive on some filesystems).
/// @param[in] bakeTransform Transform to bake into the shape, or the identity transform for no change.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return A @ref mochi::ShapeHandle "ShapeHandle" that can be used to create actors.
///
/// @note The shape remains in memory while referenced by any handle or actor. In the C API, you must release the shape explicitly by calling @ref mochi::Context::ReleaseShape "Context::ReleaseShape". In C++ and Python, this is optional, since @ref mochi::ShapeHandle "ShapeHandle" cleanup is automatic.
/// @note If the loaded model has @ref mochi::ModelData::elementFrameAxes "ModelData::elementFrameAxes", @p bakeTransform transforms those axes as normal directions using the inverse-transpose of the rotation transform, then normalize them.
/// @note Call on any thread.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::ReleaseShape "ReleaseShape", @ref mochi::Context::LoadShapeFromBytes "LoadShapeFromBytes"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromFile(std::string_view filePath, Real3 const& bakeScale, TransformRT const& bakeTransform, Error& error)
///
/// @brief Load a shape from a file of supported format, and bake in some scale, rotation, and translation.
///
/// @details Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off), PLY (.ply), and STL (.stl).
///
/// @param[in] filePath File path to load (case sensitive on some filesystems).
/// @param[in] bakeScale Scale to bake into the shape or (1, 1, 1) for no change. Negative scale results in mirroring.
/// @param[in] bakeTransform Transform to bake into the shape, or the identity transform for no change.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return A @ref mochi::ShapeHandle "ShapeHandle" that can be used to create actors.
///
/// @note The shape remains in memory while referenced by any handle or actor. In the C API, you must release the shape explicitly by calling @ref mochi::Context::ReleaseShape "Context::ReleaseShape". In C++ and Python, this is optional, since @ref mochi::ShapeHandle "ShapeHandle" cleanup is automatic.
/// @note Some shape data cannot bake arbitrary non-uniform scale. Unsupported scale values are rejected.
/// @note Precomputed grid SDF data is preserved only when @p bakeScale is uniform by absolute value. Non-uniform scale by absolute value discards the precomputed SDF. If an SDF collider later requires SDF data, SuperDex Physics regenerates it from the transformed mesh at runtime, which may be expensive.
/// @note If the loaded model has @ref mochi::ModelData::elementFrameAxes "ModelData::elementFrameAxes", @p bakeScale and @p bakeTransform transform those axes as normal directions using the inverse-transpose of the scale-rotation transform, then normalize them.
/// @note Call on any thread.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::ReleaseShape "ReleaseShape", @ref mochi::Context::LoadShapeFromBytes "LoadShapeFromBytes"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromBytes(Span<char const> fileData, Error& error)
///
/// @brief Load a shape from a file of supported format, where the file has already been loaded into memory.
///
/// @details Supported formats: JSON (.mochi.json) and HDF5 (.mochi.h5), auto-detected from header bytes. To load a surface mesh format (OBJ, PLY, OFF, STL) from memory, use the overload that takes an explicit @ref mochi::MeshFileType "MeshFileType".
///
/// @param[in] fileData File contents as an in-memory byte array.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return A @ref mochi::ShapeHandle "ShapeHandle" that can be used to create actors.
///
/// @note The shape remains in memory while referenced by any handle or actor. In the C API, you must release the shape explicitly by calling @ref mochi::Context::ReleaseShape "Context::ReleaseShape". In C++ and Python, this is optional, since @ref mochi::ShapeHandle "ShapeHandle" cleanup is automatic.
/// @note Call on any thread.
///
/// @see @ref mochi::ShapeHandle "ShapeHandle", @ref mochi::Context::ReleaseShape "ReleaseShape", @ref mochi::Context::LoadShapeFromFile "LoadShapeFromFile"
///

/// @fn ShapeHandle mochi::Context::LoadShapeFromBytes(Span<char const> fileData, Real3 const& bakeScale, Error& error)
///
/// @brief Load a shape from a file of supported format, where the file has already been loaded into memory, and baking in some scale.
///
