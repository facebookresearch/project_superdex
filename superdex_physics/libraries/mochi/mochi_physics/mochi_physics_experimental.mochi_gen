// @brief Control type for individual control channels when setting articulated actor targets.
//
// @details Specifies how each control channel passed to @ref
// experimental::SetArticulatedForceAndTargetPose is interpreted: whether it controls a single DoF
// or a 3D link quantity (position or rotation), and whether it defines a PD target or applies direct
// force/torque.
//
// @see experimental::SetArticulatedForceAndTargetPose
enum experimental::ControlType [no_reflection] {
  // @brief PD target on a single-DoF joint. Consumes 1 value.
  // dofOrLinkIndices = DoF index.
  SingleDof,
  // @brief PD target on a 3D link position in world frame [m]. Consumes 3 values (x, y, z).
  // dofOrLinkIndices = link index.
  LinkPos,
  // @brief PD target on a 3D link rotation in world frame as a rotation vector [rad].
  // Consumes 3 values. dofOrLinkIndices = link index.
  LinkRot,
  // @brief Force/torque on a single-DoF joint. Consumes 1 value.
  // dofOrLinkIndices = DoF index.
  Force,
  // @brief Number of control type enum values.
  Count,
}

// @brief Set force, target pose, or other control modes for an articulated actor.
//
// @param[in] actor Articulated actor to control.
// @param[in] target The combined control values. Size must match the sum of values consumed by each
// control type (1 for single-DoF modes, 3 for 3D modes).
// @param[in] controlTypes A span indicating the control type for each control channel.
// @param[in] dofOrLinkIndices A span indicating the DoF index (for single-DoF modes) or link index
// (for 3D modes) for each control channel. Must be same size as controlTypes.
//
// @note Only applicable to articulated actors.
// @note Supports 4 control types: @ref experimental::ControlType::SingleDof, @ref
// experimental::ControlType::LinkPos, @ref experimental::ControlType::LinkRot, @ref
// experimental::ControlType::Force.
// @note For 3D rotation mode (@ref experimental::ControlType::LinkRot), values are rotation vectors
// (axis * angle in radians).
// @note @ref experimental::ControlType::SingleDof, @ref experimental::ControlType::LinkPos, and
// @ref experimental::ControlType::LinkRot control types require a pose controller. @ref
// experimental::ControlType::Force does not require a pose controller.
// @note A link-joint pair cannot be controlled by both link-level (@ref
// experimental::ControlType::LinkPos, @ref experimental::ControlType::LinkRot) and DoF-level (@ref
// experimental::ControlType::SingleDof) controls simultaneously.
// @note Control indices must be unique within their control groups. @ref
// experimental::ControlType::SingleDof and @ref experimental::ControlType::Force share DoF indices,
// so a DoF may appear at most once across those modes. @ref experimental::ControlType::LinkPos and
// @ref experimental::ControlType::LinkRot are checked separately, so each link may have at most one
// position target and at most one rotation target.
//
// @see experimental::ControlType, Actor::SetArticulatedTargetPose,
// Actor::SetArticulatedTargetLinkTransforms, Actor::SetExternalForcesOnDofs
fn experimental::SetArticulatedForceAndTargetPose(Actor* actor, Span<real const> target, Span<experimental::ControlType const> controlTypes, Span<int const> dofOrLinkIndices) -> void [mochi_error];

