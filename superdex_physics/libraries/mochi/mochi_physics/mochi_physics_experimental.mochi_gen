}

// @brief Parameters for creating an experimental rod actor.
struct experimental::RodActorParams [no_reflection] {

  // @brief Actor name.
  String name;

  // @brief Contact layer name.
  String layer;

  // @brief World-from-local transform applied to the shape.
  TransformRT worldFromLocal;

  // @brief Shape handle defining the rod geometry. Must be a polyline shape.
  //
  // @note Each element's frame axis is interpreted as one cross-sectional principal axis (the other
  // is the cross product of the segment direction and that axis); the flexural stiffness components
  // are defined with respect to these axes.
  ShapeHandle shape;

  // @brief Contact properties for interactions with volume actors.
  ContactParams contact;

  // @brief Element type controlling the number of contact samples per segment.
  ActorSegmentElementType contactElementType = Default;

  // @brief Rod material properties.
  experimental::RodMaterialParams material;

  // @brief Collider type. Set to PointCloud to enable point-cloud contact.
  ColliderType colliderType = None;

  // @brief Geometric and logical properties of the point-cloud collider.
  experimental::PointCloudColliderParams pointCloudCollider;

  // @brief Enables gravity.
  bool hasGravity = true;

  // @brief Places contact samples on the rod's visual (triangular) mesh instead of the centerline.
  //
  // @note Forces are transmitted to rod degrees of freedom through the skinning Jacobian. Requires
  // the rod shape to have a visual mesh with embedding data.
  bool useVisualMeshContact = false;

  // @brief Element type controlling the number of visual-mesh contact samples per triangle. Only
  // used when visual-mesh contact is enabled.
  ActorBoundaryElementType visualMeshContactElementType = Default;
}

fn experimental::CreateRodActor(Scene* scene, experimental::RodActorParams const& params) -> Actor* [mochi_error, nullable];

fn experimental::GenerateTubularRodModelData(Span<Real3 const> nodes [units(m)], Span<Real3 const> elementFrameAxes, real radius [units(m)], int numCrossSectionSegments, bool isClosedLoop) -> ModelData [mochi_error, no_capi];

struct experimental::ShellMaterialParams [no_reflection] {
  real membraneLambda [units(Pa*m)] = 300;
  real membraneMu [units(Pa*m)] = 400;
  real bendingAlpha [units(Pa*m^3)] = 0.00002;
  real bendingBeta [units(Pa*m^3)] = 0.00007;
  real density [units(kg/m^2)] = 1.0;
  real massDampingCoefficient [units(1/s)] = 0;
  real stiffnessDampingCoefficient [units(s)] = 0;
}

// @brief Parameters for creating an experimental shell actor.
struct experimental::ShellActorParams [no_reflection] {

  // @brief Actor name.
  String name;

  // @brief Contact layer name.
  String layer;

  // @brief World-from-local transform applied to the shape.
  TransformRT worldFromLocal;

  // @brief Shape handle defining the shell geometry.
  ShapeHandle shape;

  // @brief Shell material properties.
  experimental::ShellMaterialParams material;

  // @brief Collider type used to represent the shell for contact.
  //
  // @note Currently, the only supported values are PointCloud (participates in point-cloud
  // contact) and None (no contact).
  ColliderType colliderType = PointCloud;

  // @brief Contact mechanics properties.
  ContactParams contact;

  // @brief Geometric and logical properties of the point-cloud collider.
  experimental::PointCloudColliderParams pointCloudCollider;

  // @brief Enables gravity.
  bool hasGravity = true;

  // @brief Element type controlling the number of contact samples per triangle.
  ActorBoundaryElementType contactElementType = Default;
}

fn experimental::CreateShellActor(Scene* scene, experimental::ShellActorParams const& params) -> Actor* [mochi_error, nullable];
fn experimental::ShellMaterialParamsFrom3dIsotropic(real youngsModulus3d, real poissonsRatio3d, real density3d, real thickness) -> experimental::ShellMaterialParams [mochi_error];

// @brief Calibrate the normal viscous damping coefficient to approximate a target coefficient of
// restitution (CoR).
//
// @details The effective CoR of normal viscous damping is velocity-dependent. For damping
// coefficient c and impact velocity v, let @code alpha = c * v @endcode. The approximate CoR e
// satisfies @code alpha = (1 - e) * (1 + a*e) / (e * (1 + b*e)) @endcode, where
// @code a = 9/2 @endcode and @code b = 8/3 @endcode define a rational fit that matches
// the analytic limits. Evaluating this relation for the requested CoR gives alpha and hence
// @code c = alpha / v @endcode. @ref EffectiveCoefficientOfRestitution is its exact inverse.
// As @code e -> 0 @endcode, @code alpha -> 1/e @endcode, so c diverges for fully inelastic
// collisions.
//
// @param[in] cor Target coefficient of restitution. Must be finite and in (0, 1].
// @param[in] impactVelocity Characteristic impact velocity [m/s]. Must be finite and positive.
//
// @return Normal viscous damping coefficient [s/m]; 0 on error.
//
// @see EffectiveCoefficientOfRestitution, ContactParams::normalViscousDampingCoefficient
fn experimental::CalibrateNormalViscousDampingCoefficient(real cor, real impactVelocity) -> real [mochi_error, units(s/m)];

// @brief Effective coefficient of restitution (CoR) produced by a normal viscous damping
// coefficient at an impact velocity.
//
// @details Exact inverse of @ref CalibrateNormalViscousDampingCoefficient: solves the calibration
// relation for the positive root:
// @code
// e = (-B + sqrt(B^2 + 4A)) / (2A)
// A = a + b*alpha
// B = alpha + 1 - a
// alpha = c * v
// @endcode
// where a = 9/2 and b = 8/3.
//
// @param[in] normalViscousDampingCoefficient Normal viscous damping coefficient [s/m]. Must be
//            finite and non-negative.
// @param[in] impactVelocity Characteristic impact velocity [m/s]. Must be finite and positive.
//
// @return Effective coefficient of restitution; 0 on error.
//
// @see CalibrateNormalViscousDampingCoefficient, ContactParams::normalViscousDampingCoefficient
fn experimental::EffectiveCoefficientOfRestitution(real normalViscousDampingCoefficient, real impactVelocity) -> real [mochi_error];

struct experimental::DebugStats [no_reflection] {
  // @brief Largest relative error of the residual norm across integration stages, simulation
  // islands and Newton iterations, in the last call to @ref Scene::Step. The error is computed by
  // finite-difference consistency check. It is disabled by default due to its computational cost,
  // but it can be activated with @ref ExperimentalEvalParams::consistencyResNorm.
  real maxResidualNormRelativeError;
}

fn experimental::GetDebugStats(Scene const* scene) -> experimental::DebugStats [mochi_error];
