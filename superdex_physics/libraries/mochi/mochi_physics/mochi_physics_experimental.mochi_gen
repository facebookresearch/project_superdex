// @brief Get a transmission's displacement Jacobian at the actor's current pose.
//
// @param[in] actor Articulated actor that owns the transmission.
// @param[in] transmissionIndex Transmission index returned by
// @ref experimental::AddLinearTransmission or @ref experimental::AddSpatialTendon.
// @param[out] outJacobian Scalar-output transmission Jacobian. Its size must equal
// @ref Actor::GetNumDofs, and every entry is overwritten.
//
// @details `outJacobian[j]` is the derivative of transmission displacement with respect to reduced
// DoF `j`, using the articulated solver's reduced tangent/Lie convention and DoF ordering. Each
// entry is the transmission moment arm for that DoF.
//
// @note A joint's entries begin at the offset in the corresponding item returned by
// @ref Actor::GetArticulatedShapeInfo. A revolute joint has one entry at that offset.
fn experimental::GetTransmissionDisplacementJacobian(Actor const* actor, int transmissionIndex, Span<real> outJacobian) -> void [mochi_error];
fn experimental::GetTransmissionActuatorStateVariables(Actor const* actor, int transmissionIndex, Span<real> outStateVariables) -> void [mochi_error];
fn experimental::GetNumTransmissionActuatorStateVariables(Actor const* actor, int transmissionIndex) -> int [mochi_error];

// @brief Parameters controlling IK solver behavior.
//
// @details These parameters configure the Newton solver used for inverse kinematics optimization.
// The solver finds quasistatic (time-invariant) configurations that satisfy position and rotation
// target constraints for articulated bodies.
struct experimental::IKSolverParams [no_reflection] {

  // @brief Maximum Newton solver iterations. Higher values allow convergence over larger distances.
  //
  // @see NonLinearSolverParams::maxIter
  int maxIter = 20;

  // @brief Verbosity level passed to the Newton solver.
  //
  // @see NonLinearSolverParams::verbosity
  VerbosityLevel verbosity = Warning;

  // @brief Absolute residual-norm tolerance for Newton solver convergence.
  //
  // @note IK convergence should be primarily driven by absolute tolerance (not relative tolerance).
  //
  // @see NonLinearSolverParams::absTol
  real absTol = 1e-2;

  // @brief Relative error tolerance for Newton solver convergence.
  //
  // @note IK convergence should be primarily driven by absolute tolerance (not relative tolerance).
  //
  // @see NonLinearSolverParams::relTol
  real relTol = 1e-8;

  // @brief Position error threshold [m] for determining if IK targets are reachable.
  real positionErrorThres [units(m)] = 1e-2;

  // @brief Rotation error threshold [radians] for determining if IK targets are reachable.
  real rotationErrorThres [units(rad)] = 1e-2;

  // @brief Maximum line search iterations per Newton step.
  //
  // @see NonLinearSolverParams::lineSearchMaxIter
  int lineSearchMaxIter = 10;

  // @brief Maximum elapsed wall-clock time [s] before the solver stops.
  //
  // @details When set to a positive value, the solver will stop after this many seconds
  // have elapsed, regardless of convergence. Useful for real-time applications where
  // a time budget must be enforced.
  //
  // @note A value of 0 (default) means no time limit.
  //
  // @see NonLinearSolverParams::maxElapsedTimeSeconds
  double maxElapsedTimeSeconds = 0;
}

// @brief Inverse kinematics solver for articulated bodies.
//
// @details Performs quasistatic optimization to find time-invariant configurations that optimize a
// user-provided energy function. Currently supports soft-constraint energy functions for specifying
// target position and orientation of rigid links in articulated bodies.
//
// @note The IK solver takes ownership of the scene passed at creation. The scene is mutated
// (e.g., gravity zeroed, single-island forced, contact dissipation zeroed, articulated inertia and joint
// friction removed) and is unsuitable for general simulation afterward. Use it only via this
// @ref IKSolver.
// @note Targets must be set before calling @ref IKSolver::SolveIK.
//
// @see experimental::CreateIKSolver, experimental::DestroyIKSolver
class experimental::IKSolver [no_init, no_destruct, no_reflection] {

  // @brief Set the IK solver parameters.
  //
  // @param[in] params IK solver parameters to set.
  //
  // @see IKSolver::GetSolverParams
  fn SetSolverParams(experimental::IKSolverParams const& params) -> void [pure, virtual];

  // @brief Get the current IK solver parameters.
  //
  // @return Current IK solver parameters.
  //
  // @see IKSolver::SetSolverParams
  fn GetSolverParams() -> experimental::IKSolverParams [pure, virtual, const];

  // @brief Create a position target constraint for IK.
  //
  // @param[in] actor Target articulated actor.
  // @param[in] localPosition Position [m] in link's local frame.
  // @param[in] targetPosition Target position [m] in world frame.
  // @param[in] weight Objective function weight (stiffness) [N/m] for the position target. Must
  // be non-negative. The relative magnitude between position and rotation weights determines
  // the tradeoff in mixed problems.
  //
  // @return Constraint pointer to update target dynamically.
  //
  // @warning Only one position target per actor is supported. Calling this method again for the same
  // actor replaces the previous target and invalidates the previously returned @ref Constraint
  // pointer.
  //
  // @note If replacing the previous target fails, the existing target and its pointer remain valid.
  //
  // @see IKSolver::ClearPositionTarget, IKSolver::CreateRotationTarget
  fn CreatePositionTarget(ActorHandle actor, Real3 localPosition, Real3 targetPosition, real weight) -> Constraint* [pure, virtual, mochi_error, nullable];

  // @brief Remove position target constraint for given actor.
  //
  // @param[in] actor Handle of the actor whose target constraint is to be removed.
  //
  // @see IKSolver::CreatePositionTarget
  fn ClearPositionTarget(ActorHandle actor) -> void [pure, virtual, mochi_error];

  // @brief Create a rotation target constraint for IK.
  //
  // @param[in] actor Target articulated actor.
  // @param[in] localRotation Rotation vector [radians] in link's local frame.
  // @param[in] targetRotation Target rotation vector [radians] in world frame.
  // @param[in] weight Objective function weight (stiffness) [N*m/rad] for the rotation target.
  // Must be non-negative. The relative magnitude between position and rotation weights determines
  // the tradeoff in mixed problems.
  //
  // @return Constraint pointer to update target dynamically.
  //
  // @warning Only one rotation target per actor is supported. Calling this method again for the same
  // actor replaces the previous target and invalidates the previously returned @ref Constraint
  // pointer.
  //
  // @note If replacing the previous target fails, the existing target and its pointer remain valid.
  // @note Both rotations are rotation vectors (axis * angle).
  //
  // @see IKSolver::ClearRotationTarget, IKSolver::CreatePositionTarget
  fn CreateRotationTarget(ActorHandle actor, Real3 localRotation, Real3 targetRotation, real weight) -> Constraint* [pure, virtual, mochi_error, nullable];

  // @brief Remove rotation target constraint for given actor.
  //
  // @param[in] actor Handle of the actor whose target constraint is to be removed.
  //
  // @see IKSolver::CreateRotationTarget
  fn ClearRotationTarget(ActorHandle actor) -> void [pure, virtual, mochi_error];

  // @brief Solve the IK problem to find joint configuration satisfying targets.
  //
  // @return True if every target is reached within the per-component error thresholds (the
  // maximum absolute component is no greater than @ref IKSolverParams::positionErrorThres /
  // @ref IKSolverParams::rotationErrorThres), false otherwise.
  //
  // @note At least one target (position or rotation) must be set before calling.
  //
  // @see IKSolverParams::positionErrorThres, IKSolverParams::rotationErrorThres,
  // IKSolver::CreatePositionTarget, IKSolver::CreateRotationTarget
  fn SolveIK() -> bool [pure, virtual, mochi_error];
}

// @brief Create a new inverse kinematics (IK) solver.
//
// @param[in] scene Scene containing the articulated and/or rigid actor(s) to perform IK on.
// @param[in] context @ref Context that owns the @ref Scene.
//
// @return Pointer to the created @ref experimental::IKSolver, or nullptr on error.
//
// @note The @ref experimental::IKSolver assumes exclusive control of the provided scene. The scene
// must not be used directly and will be destroyed by @ref experimental::DestroyIKSolver.
// @note Scene ownership transfers only on success. On error, ownership is unchanged.
// @note The scene must contain only @ref ActorType::Articulated and @ref ActorType::Rigid actors.
// @note The scene's solver parameters, gravity, single-island setting, contact dissipation, and
// articulated inertia/joint-friction terms are reconfigured for IK and cannot be relied upon
// afterwards.
//
// @see experimental::DestroyIKSolver
fn experimental::CreateIKSolver(Scene* scene, Context* context) -> experimental::IKSolver* [mochi_error, nullable];

// @brief Destroy an IK solver and the scene it owns.
//
// @param[in] solver @ref experimental::IKSolver to destroy.
// @param[in] context @ref Context that owns the @ref experimental::IKSolver.
//
// @warning Do not destroy the IK solver's scene directly with @ref Context::DestroyScene while the
// @ref experimental::IKSolver exists. Destroy the IK solver with @ref experimental::DestroyIKSolver
// instead.
// @warning Do not dereference pointers to the IK solver, its owned scene, or the scene's actors and
// constraints after this call.
//
// @note No-op if @ref solver is null or unknown to this @ref Context.
// @note Call on any thread.
// @note Any remaining IK solvers will be cleaned up automatically when the @ref Context is
// destroyed.
//
// @see experimental::CreateIKSolver
fn experimental::DestroyIKSolver(experimental::IKSolver* solver [nullable], Context* context) -> void [mochi_error];

// @brief Check if an IK solver pointer is valid.
//
// @param[in] solver @ref experimental::IKSolver pointer to check.
// @param[in] context @ref Context that owns the @ref experimental::IKSolver.
//
// @return True if the solver is valid (not destroyed) and belongs to this @ref Context, false
// otherwise.
//
// @note Call on any thread.
//
// @see experimental::CreateIKSolver, experimental::DestroyIKSolver
fn experimental::IsValidIKSolver(experimental::IKSolver const* solver [nullable], Context* context) -> bool [mochi_error];

