struct experimental::RodMaterialParams [no_reflection] {
  real linearDensity [units(kg/m)] = 1e-1;
  real linearRotationalInertia [units(kg*m)] = 1e-6;
  real axialStiffness [units(N)] = 1e2;
  real torsionalStiffness [units(N*m^2)] = 5e-4;
  Real2 flexuralStiffness [units(N*m^2)] = {5e-4, 5e-4};
