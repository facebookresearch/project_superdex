    """

@overload
def add_to_scene(
    prefab: ScenePrefab,
    scene: mochi_physics.Scene,
    params: PrefabParams,
) -> AddToSceneResult:
    """Instantiate a :class:`~superdex.physics.prefab.ScenePrefab` and add it to a
    :class:`~superdex.physics.Scene`.

    Creates the prefab's actors, constraints, and controllers, applies any scene
    settings enabled by
    :attr:`~superdex.physics.prefab.PrefabParams.apply_scene_settings`, and applies
    contact filter entries.

    Args:
        prefab (ScenePrefab): The fully loaded
            :class:`~superdex.physics.prefab.ScenePrefab` to instantiate.
        scene (Scene): The :class:`~superdex.physics.Scene` to add things to.
        params (PrefabParams): Parameters for how and where to instantiate the
            prefab. Can optionally be omitted in Python.

    Returns:
        An :class:`~superdex.physics.prefab.AddToSceneResult` containing pointers to
        all created actors and constraints.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        The prefab must be fully loaded (nested prefabs and shapes) before calling
        this function. If you're not sure, then call
        :func:`~superdex.physics.prefab.ensure_fully_loaded`.

    Warning:
        This function is not transactional. If it returns an error, the prefab may
        have been partially instantiated in the scene.

    Warning:
        Only supported with :attr:`~superdex.physics.prefab.PrefabParams.scale` = 1.
        To instantiate at a non-identity scale, use the file-path
        :func:`~superdex.physics.prefab.add_to_scene` overload or a nested
        :attr:`~superdex.physics.prefab.PrefabReference.scale`.

    See Also:
        :func:`~superdex.physics.prefab.load_from_file`,
        :func:`~superdex.physics.prefab.ensure_fully_loaded`,
        :class:`~superdex.physics.prefab.PrefabParams`
    """

