class PrefabParams:
    """Parameters for instantiating a :class:`~superdex.physics.prefab.ScenePrefab`
    into a :class:`~superdex.physics.Scene`.
    """
    name: str
    """Optional name prefix for created actors.

    Actor names are formatted based on their hierarchy paths. If this string is not
    empty, it will be used as the first token in the path ("prefabName/actorName",
    "prefabName/nestedPrefabName/actorName", etc.)
    """
    scale: float
    """Uniform scale of the new prefab in world-space.

    Composes multiplicatively with any nested
    :attr:`~superdex.physics.prefab.PrefabReference.scale` and any per-actor scale
    (e.g. :attr:`~superdex.physics.prefab.ArticulatedActorPrefab.scale`) to give the
    cumulative "effective scale" baked into each actor when the prefab is
    instantiated.

    The effective scale is applied to:

    - Mesh geometry (link / actor shapes are loaded at the cumulative scale)
    - Joint and link translations, cycle joint anchors
    - Prismatic joint position limits (Real3, in meters)
    - Constraint geometric target and limit distances [m], including rigid prismatic
      joint limits, world-space position targets, rigid actor-local pivot/joint
      positions in
      :class:`~superdex.physics.prefab.RigidPivotPositionConstraintPrefab`,
      :class:`~superdex.physics.prefab.RigidPivotToRigidTargetConstraintPrefab`, and
      :class:`~superdex.physics.prefab.RigidSphericalJointConstraintPrefab`; the
      rigid-local attachment/search point in
      :class:`~superdex.physics.prefab.DeformableNodeToRigidConstraintPrefab`; and
      translational single-DoF target/range values in
      :class:`~superdex.physics.prefab.ArticulatedSingleDofTargetConstraintPrefab`
      and
      :class:`~superdex.physics.prefab.ArticulatedSingleDofRangeConstraintPrefab`.
      Actor-local constraint distances use the referenced actor's prefab metric
      scale, so standalone rigid/soft shape-bake scale fields are not applied again.
    - User-supplied inertia overrides on rigid and articulated link actors: center
      of mass scales componentwise by the signed effective scale, mass scales by the
      absolute effective volume scale, moment of inertia uses the corresponding
      diagonal inertia transform. For a purely uniform effective scale s, this
      reduces to:

      ::

          centerOfMass *= s
          mass *= s^3
          momentOfInertia *= s^5

    The mass and moment of inertia formulas preserve the user's authored density.

    The effective scale is NOT applied to:

    - density (intrinsic material property; mass/density are mutually exclusive in
      the prefab API, so no double-application)
    - linearVelocity / angularVelocity / jointVelocities
    - Constraint stiffness/damping coefficients and saturation thresholds inherited
      from :class:`~superdex.physics.ConstraintParams`. These parameters define the
      constraint's response, not just geometry: different goals (preserving material
      behavior, damping ratio, actuator limits, or closed-loop response) imply
      different scale laws, so prefab scaling preserves authored values.
    - Joint inertia, friction, limit stiffness/damping, cycle joint stiffness
      (characterized actuator / tuned-penalty parameters; bring your own actuator
      model when scaling a robot)
    - Revolute and spherical joint angular limits, rotation-valued targets and
      ranges in
      :class:`~superdex.physics.prefab.Articulated3dRotationTargetConstraintPrefab`
      and
      :class:`~superdex.physics.prefab.Articulated3dRotationRangeConstraintPrefab`,
      and rotational single-DoF target/range values in
      :class:`~superdex.physics.prefab.ArticulatedSingleDofTargetConstraintPrefab`
      and
      :class:`~superdex.physics.prefab.ArticulatedSingleDofRangeConstraintPrefab`
      (scale invariant)

    Note:
        Must be strictly positive and finite. Negative or zero scale is invalid and
        rejected at :func:`~superdex.physics.prefab.add_to_scene`. The
        :class:`~superdex.physics.prefab.ScenePrefab` overload additionally requires
        scale == 1; use the file-path :func:`~superdex.physics.prefab.add_to_scene`
        overload, nested :attr:`~superdex.physics.prefab.PrefabReference.scale`, or
        per-actor scale for non-identity scaling.

    Note:
        Authoring with :attr:`~superdex.physics.RigidActorParams.mass` = M is
        equivalent to authoring with the implied density M / V_unit; under prefab
        scale the density is preserved and mass scales with the absolute volume
        scale, so the result is "the same material at a bigger size." For a purely
        uniform effective scale s, this mass factor is s^3. If you need a fixed mass
        that does NOT scale with the prefab, set the mass at runtime via
        :meth:`~superdex.physics.Actor.set_density` after the actor is instantiated.
    """
    @property
    def rotation(self) -> mochi_physics.Quaternion:
        """Rotation quaternion [x, y, z, w] of the new prefab in world-space.

        Note:
            Must be finite and non-zero.
        """
    @rotation.setter
    def rotation(self, value: mochi_physics.QuaternionLike) -> None: ...
    @property
    def translation(self) -> mochi_physics.Real3:
        """Translation (position) of the new prefab in world-space.

        Note:
            Must be finite.
        """
    @translation.setter
    def translation(self, value: mochi_physics.Real3Like) -> None: ...
    apply_scene_settings: bool
    """Whether to apply top-level scene settings.

    When true, :func:`~superdex.physics.prefab.add_to_scene` applies gravity and
    solver overrides from the :class:`~superdex.physics.prefab.SceneParams` of the
    top-level prefab. Omitted overrides preserve existing scene values. When false,
    neither override is applied. Scene settings from nested prefabs are always
    ignored.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        name: str = ...,
        scale: float = ...,
        rotation: mochi_physics.QuaternionLike = ...,
        translation: mochi_physics.Real3Like = ...,
        apply_scene_settings: bool = ...,
    ) -> None: ...

class AddToSceneResult:
    """Struct used to return all created actors and constraints from
    :func:`~superdex.physics.prefab.add_to_scene`.

    Note:
        The returned pointers are non-owning. They remain valid as long as the
        :class:`~superdex.physics.Scene` is alive and the actors/constraints have
        not been destroyed.
    """
    @property
    def actors(self) -> mochi_physics.DynamicArrayActor:
        """All newly created actors.

        Note:
            Order is not guaranteed except that actors from nested prefabs will be
            listed before actors from the top-level prefab.

        Note:
            Contains only top-level actors. Articulated actors' nested link actors and
            soft-skinned actors' nested link actors and nested soft actors are created
            but not listed here. Reach them via
            :meth:`~superdex.physics.Actor.get_nested_link_actors` and
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`.

        See Also:
            :meth:`~superdex.physics.prefab.AddToSceneResult.filter`
        """
    @actors.setter
    def actors(self, value: mochi_physics.ArrayLikeActor) -> None: ...
    @property
    def constraints(self) -> mochi_physics.DynamicArrayConstraint:
        """All newly created constraints.

        Note:
            Order is not guaranteed except that constraints from nested prefabs will be
            listed before constraints from the top-level prefab.

        See Also:
            :meth:`~superdex.physics.prefab.AddToSceneResult.filter`
        """
    @constraints.setter
    def constraints(self, value: mochi_physics.ArrayLikeConstraint) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        actors: mochi_physics.ArrayLikeActor = ...,
        constraints: mochi_physics.ArrayLikeConstraint = ...,
    ) -> None: ...
    @overload
    def filter(
        self,
        type: mochi_physics.ActorType | int,
    ) -> mochi_physics.DynamicArrayActor:
        """Return all the newly created actors of a particular type, in order.

        Args:
            type (ActorType | int): Type of actor to return.

        Returns:
            List of actors of the specified type.

        Note:
            If there were nested prefabs, then actors will be listed in depth-first
            order.

        Note:
            For a single prefab (no nested prefabs) whose actors have no nested link
            actors or nested soft actors, the result is 1-to-1 with the prefab's actors
            of that type (same size, same order). Nested link actors and nested soft
            actors are not listed, and soft-skinned actors are reported under
            :class:`ARTICULATED <superdex.physics.ActorType>`.
        """
    @overload
    def filter(
        self,
        type: mochi_physics.ConstraintType | int,
    ) -> mochi_physics.DynamicArrayConstraint:
        """Return all the newly created constraints of a particular type, in order.

        Args:
            type (ConstraintType | int): Type of constraint to return.

        Returns:
            List of constraints of the specified type.

        Note:
            If there were nested prefabs, then constraints will be listed in depth-first
            order.

        Note:
            For a single prefab (no nested prefabs), the result will be 1-to-1 with the
            constraint list in the prefab (same size, same order).
        """

def load_from_file(prefab_path: str, root_path: str) -> ScenePrefab:
    """Fully load a :class:`~superdex.physics.prefab.ScenePrefab` from a file,
    including all nested prefabs and shapes.

    Args:
        prefab_path (str): File path to the prefab file.
        root_path (str): Root directory for resolving relative paths, except those
            resolved against a prefab file.

    Returns:
        The fully loaded :class:`~superdex.physics.prefab.ScenePrefab`, or a
        default-constructed :class:`~superdex.physics.prefab.ScenePrefab` on error.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        Prefab files are in JSON format.

    Note:
        A prefab must not reference itself, directly or indirectly.

    See Also:
        :func:`~superdex.physics.prefab.load_from_json_string`,
        :func:`~superdex.physics.prefab.shallow_load_from_file`,
        :func:`~superdex.physics.prefab.shallow_load_from_json_string`
    """

def load_from_json_string(json: str, root_path: str) -> ScenePrefab:
    """Fully load a :class:`~superdex.physics.prefab.ScenePrefab` from a JSON string,
    including all nested prefabs and shapes.

    Args:
        json (str): JSON string containing the serialized prefab.
        root_path (str): Root directory for resolving relative paths, except those
            resolved against a prefab file.

    Returns:
        The fully loaded :class:`~superdex.physics.prefab.ScenePrefab`, or a
        default-constructed :class:`~superdex.physics.prefab.ScenePrefab` on error.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        The top-level prefab has no source file, so prefab-relative ("./"-prefixed)
        nested prefab and shape paths written in ``json`` resolve against
        ``root_path``, not against a prefab directory. Nested prefabs that are
        loaded from files resolve their own "./"-prefixed paths relative to the
        directory containing the nested prefab file. Use
        :func:`~superdex.physics.prefab.load_from_file` if you need prefab-relative
        resolution at the top level.

    Note:
        A prefab must not reference itself, directly or indirectly.

    See Also:
        :func:`~superdex.physics.prefab.load_from_file`,
        :func:`~superdex.physics.prefab.shallow_load_from_file`,
        :func:`~superdex.physics.prefab.shallow_load_from_json_string`
    """

def save_to_json_file(prefab: ScenePrefab, path: str) -> None:
    """Serialize a :class:`~superdex.physics.prefab.ScenePrefab` to a JSON file.

    Args:
        prefab (ScenePrefab): The :class:`~superdex.physics.prefab.ScenePrefab` to
            serialize.
        path (str): Output file path.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        Does NOT serialize nested prefabs. Only the top-level prefab data is
        written.

    Note:
        Automatically creates the output directory path, as needed.

    See Also:
        :func:`~superdex.physics.prefab.save_to_json_string`
    """

def save_to_json_string(prefab: ScenePrefab) -> str:
    """Serialize a :class:`~superdex.physics.prefab.ScenePrefab` to a JSON string.

    Args:
        prefab (ScenePrefab): The :class:`~superdex.physics.prefab.ScenePrefab` to
            serialize.

    Returns:
        The JSON string, or an empty string on error.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        Does NOT serialize nested prefabs. Only the top-level prefab data is
