class RoutingElement:
    """One ordered element in a spatial tendon's heterogeneous routing list.

    A :class:`WAYPOINT <superdex.physics.RoutingElementType>` uses :attr:`index` (a
    link index) and :attr:`local_position`; a :class:`LINEAR_JOINT
    <superdex.physics.RoutingElementType>` uses :attr:`index` (a joint index) and
    :attr:`coefficient`. Order matters: a segment forms only between adjacent
    waypoints, so a linear-joint element between two waypoints leaves a gap.
    """
    type: RoutingElementType
    """Selects the interpretation of the remaining fields."""
    index: int
    """Link index for a waypoint, or joint index for a linear-joint element."""
    @property
    def local_position(self) -> Real3:
        """Waypoint position in the link's local frame, the same frame in which the
        link's
        mesh and geometry are authored (the link's root-transform frame) [m]. Only used
        for waypoint elements.
        """
    @local_position.setter
    def local_position(self, value: Real3Like) -> None: ...
    coefficient: float
    """Signed constant moment arm d(displacement)/d(joint DoF) [m / joint DoF]. Only
    used for linear-joint elements. Its sign sets whether the tendon lengthens or
    shortens with the joint DoF.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        type: RoutingElementType | int = ...,
        index: int = ...,
        local_position: Real3Like = ...,
        coefficient: float = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

