def release_shape(shape: ShapeHandle) -> None:
    """Release a shape handle.

    In the C API, this must be called for every
    :class:`~superdex.physics.ShapeHandle` when you are done with it. In C++ and
    Python, this is optional because :class:`~superdex.physics.ShapeHandle` releases
    its reference automatically when destroyed. The shape memory is freed when it is
    no longer referenced by any handle, actor, or file cache entry.

    Args:
        shape (ShapeHandle): Handle to the shape to release.

    Note:
        Call on any thread.

    Note:
        If the shape handle is invalid or already released, then it will be ignored.

    See Also:
        :class:`~superdex.physics.ShapeHandle`,
        :func:`~superdex.physics.is_file_cache_enabled`
    """

def get_num_shapes() -> int:
    """Get the number of shape handles that have been created/loaded and have not yet
    been released.

    Returns:
        The number of active shape handles.

    Note:
        The file cache does not affect this value.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.is_file_cache_enabled`
    """

def enable_file_cache(enable: bool) -> None:
    """Enable or disable the file cache.

    When enabled, shape memory will be preserved even after the
    :class:`~superdex.physics.ShapeHandle` has been released. Subsequent requests
    for the same file (with the same baked-in scale and transform) will be fast
    because the data will already be loaded. This can be an important optimization,
    but beware that it could waste memory if it preserves shapes that are no longer
    needed.

    Args:
        enable (bool): True to enable, false to disable the feature.

    Note:
        Call on any thread.

    Note:
        Disabling the cache (passing false) immediately releases all currently
        cached shapes, equivalent to calling
        :func:`~superdex.physics.clear_file_cache`.

    See Also:
        :func:`~superdex.physics.is_file_cache_enabled`,
        :func:`~superdex.physics.clear_file_cache`,
        :func:`~superdex.physics.clear_file_from_cache`
    """

def is_file_cache_enabled() -> bool:
    """Return true if the file cache feature is enabled.

    Returns:
        True if the file cache is enabled, false otherwise.

    Note:
        Call on any thread.
    """

def clear_file_cache() -> None:
    """Release all shapes that are being preserved by the file cache (if any).

    Use this to free up memory, or to force subsequent file requests to be loaded
    from disk, in case those files had been modified.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.is_file_cache_enabled`,
        :func:`~superdex.physics.clear_file_from_cache`
    """

def clear_file_from_cache(file_path: str) -> None:
    """Release all cached entries for a given shape file.

    Use this to free up memory, or to force the next file request to be loaded from
    disk, in case the file had been modified. All entries for ``file_path`` are
    removed, including every variant produced by different bake scale/transform
    combinations.

    Args:
        file_path (str): Path to a file that may have been loaded. The match is
            case-sensitive and must equal the path used at load time exactly.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.is_file_cache_enabled`,
        :func:`~superdex.physics.clear_file_cache`
    """

def create_scene(name: str) -> Scene:
    """Create a new :class:`~superdex.physics.Scene`.

    A scene is a collection of actors and constraints, which can be stepped to
    advance the simulation. Each scene is independent. Actors from one scene cannot
    affect another scene.

    You can create a new scene on any thread, but that scene must only be accessed
    from one thread at a time. All reads and writes to the scene must be synchronous
    and well ordered. However, if you have multiple scenes, then it is safe to step
    them concurrently.

    Args:
        name (str): Name of the new scene (for debugging).

    Returns:
        Pointer to the new scene. Call :func:`~superdex.physics.destroy_scene` when
        done with it.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.destroy_scene`
    """

def destroy_scene(scene: Optional[Scene]) -> None:
    """Immediately destroy a scene and all its actors and constraints.

    Args:
        scene (Optional[Scene]): Pointer to the scene to destroy.

    Note:
        No-op if ``scene`` is None or unknown to this Mochi context.

    Note:
        Call on any thread.

    Note:
        Any remaining scenes will be cleaned up automatically when the Mochi context
        is destroyed.

    Warning:
        This documentation references the following C++ APIs, which are not
        available in Python: ``mochi::AsyncScene``,
        ``mochi::Context::DestroyAsyncScene``.

    Warning:
        Do not dereference pointers to the scene, actors, constraints, etc. after
        this call.

    Warning:
        If ``scene`` is owned by an ``mochi::AsyncScene``, the call is a no-op (a
        warning is logged). Call ``mochi::Context::DestroyAsyncScene`` instead.

    See Also:
        :func:`~superdex.physics.create_scene`,
        ``mochi::Context::DestroyAsyncScene``
    """

def get_scene(handle: SceneHandle) -> Optional[Scene]:
    """Get a pointer to a scene by its handle.

    Args:
        handle (SceneHandle): Handle to the scene.

    Returns:
        Pointer to the scene, or None if the handle is invalid in this context.

    Note:
        Call on any thread.
    """

def is_valid_scene(scene: Optional[Scene]) -> bool:
    """Check if a scene is valid (not destroyed), and belongs to this Mochi context.

    Args:
        scene (Optional[Scene]): Pointer to the scene to check.

    Returns:
        True if the scene is valid and belongs to this Mochi context.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.create_scene`,
        :func:`~superdex.physics.destroy_scene`
    """

def get_debug_server() -> DebugServer:
    """Get the debug server for this context.

    Returns:
        Reference to the :class:`~superdex.physics.DebugServer`, which accepts
        connections from external debug tools.

    See Also:
        :class:`~superdex.physics.DebugServer`
    """

class Actor:
    """Represents a simulated body (actor) in a scene.

    Note:
        Every body in the simulation is an actor.

    Note:
        Actors always belong to exactly one scene.

    Note:
        Actors can be static or dynamic.

    Warning:
        Concurrent access to the actor or its scene is illegal.
    """
    def get_handle(self) -> ActorHandle:
        """Get the actor's handle.

        Returns:
            Actor's handle.

        Note:
            Handles are safe to store and remain valid throughout the actor lifespan.

        Note:
            Call :meth:`~superdex.physics.Scene.get_actor` to look up the actor's
            pointer from the actor's handle.

        See Also:
            :meth:`~superdex.physics.Scene.get_actor`
        """
    def get_scene(self) -> Scene:
        """Get the :class:`~superdex.physics.Scene` that this actor belongs to.

        Returns:
            Pointer to the scene that this actor belongs to.
        """
    def get_name(self) -> str:
        """Get the name of the actor.

        Returns:
            Name of the actor.

        Note:
            Actor names are not guaranteed to be unique.
        """
    def get_type(self) -> ActorType:
        """Get the type of the actor.

        Returns:
            Type of the actor.
        """
    def get_convergence_status(self) -> ConvergenceStatus:
        """Get the convergence status of the actor in the most recent simulation step.

        Returns:
            Convergence status of the actor in the most recent simulation step.

        Note:
            Static actors do not participate in the solver and may return :class:`NONE
            <superdex.physics.ConvergenceStatus>`.

        See Also:
            :class:`~superdex.physics.ConvergenceStatus`,
            :attr:`~superdex.physics.SolverStats.convergence_status`
        """
    def is_static(self) -> bool:
        """Check whether the actor is static.

        Returns:
            True if the actor is static. False if it's dynamic.
        """
    def get_contact_params(self) -> ContactParams:
        """Get the contact parameters of the actor.

        Returns:
            Contact parameters of the actor.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def set_contact_params(self, params: ContactParams) -> None:
        """Set the contact parameters of the actor.

        Args:
            params (ContactParams): Contact parameters to set.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_collider_type(self) -> ColliderType:
        """Get the collider type of the actor.

        Returns:
            Collider type of the actor.

        Note:
            If :class:`AUTO <superdex.physics.ColliderType>` was specified when creating
            the actor, this method returns the collider type that was automatically
            selected based on the actor's shape, not Auto.
        """
    def has_root_transform(self) -> bool:
        """Check if the actor has a root transform.

        Returns:
            True if the actor has a root transform. False otherwise.

        Note:
            Non-rendered actors may not have a root transform.
        """
    def get_root_transform(self) -> TransformRT:
        """Get the actor's world-from-local transform (root transform).

        Returns:
            The actor's world-from-local transform.

        Note:
            Returns an identity transform when
            :meth:`~superdex.physics.Actor.has_root_transform` returns false.

        Note:
            For a top-level articulated actor, the local frame is the articulation root
            frame, not the root link's frame. For a nested link actor, the local frame
            is that link's frame.
        """
    def set_root_transform(self, world_from_local: TransformRT) -> None:
        """Set the actor's world-from-local transform (root transform).

        Args:
            world_from_local (TransformRT): World-space transform to set.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Not allowed on articulated links.

        Note:
            For a top-level articulated actor, the local frame is the articulation root
            frame, not the root link's frame.

        Note:
            For dynamic actors, it does not change velocity. For static actors, however,
            it changes velocity, because it is implicitly defined by the root transform
            in consecutive time steps. To cancel the velocity of a static actor, use
            :meth:`~superdex.physics.Actor.set_velocity`.

        Note:
            Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler
            in the first time step after this method is called.
        """
    def get_rigid_center_of_mass_local(self) -> Real3:
        """Get the position of the center of mass in the actor's local coordinate frame
        (:meth:`~superdex.physics.Actor.get_root_transform`).

        Returns:
            Position vector of the center of mass in the actor's local coordinate frame.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for dynamic rigid actors (including articulated links) and
            soft actors.

        See Also:
            :meth:`~superdex.physics.Actor.get_root_transform`
        """
    def get_center_of_mass_transform(self) -> TransformRT:
        """Get the world-space transform of the actor expressed at the center of mass.

        The rotation is the same as in
        :meth:`~superdex.physics.Actor.get_root_transform`, but the translation accounts
        for the local position of the center of mass with respect to the root transform.

        Returns:
            Transform of the actor at the center of mass.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for dynamic rigid actors.

        See Also:
            :meth:`~superdex.physics.Actor.set_center_of_mass_transform`,
            :meth:`~superdex.physics.Actor.get_root_transform`
        """
    def set_center_of_mass_transform(self, world_from_com: TransformRT) -> None:
        """Set the world-space transform of the actor expressed at the center of mass.

        Args:
            world_from_com (TransformRT): World-space transform at the center of mass to
                set.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for dynamic rigid actors.

        Note:
            Does not change velocity.

        Note:
            Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler
            in the first time step after this method is called.

        See Also:
            :meth:`~superdex.physics.Actor.get_center_of_mass_transform`,
            :meth:`~superdex.physics.Actor.set_root_transform`
        """
    def get_rigid_moment_of_inertia_local(self) -> Real6:
        """Get the moment of inertia tensor of the actor at the center of mass, aligned
        with the actor's local reference system (root transform), and using *negative*
        tensor notation.

        ::

                 [ixx, ixy, ixz]   [ +∫(y²+z²)dm, -∫(xy)dm,    -∫(xz)dm     ]
             I = [ixy, iyy, iyz] = [ -∫(xy)dm,    +∫(x²+z²)dm, -∫(yz)dm     ]
                 [ixz, iyz, izz]   [ -∫(xz)dm,    -∫(yz)dm,    +∫(x²+y²)dm  ]

        Returns:
            Upper-right triangle in the form [ixx, ixy, ixz, iyy, iyz, izz]. Units:
            kg·m².

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for dynamic rigid actors.
        """
    def set_velocity(self, linear_vel: Real3Like, angular_vel: Real3Like) -> None:
        """Set the world-frame linear and angular velocity of the actor at the center of
        mass.

        Args:
            linear_vel (Real3Like): Linear velocity [m/s] of the center of mass in world
                frame.
            angular_vel (Real3Like): Angular velocity [rad/s] at the center of mass in
                world frame.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid actors (except articulated links) and soft actors
            (except ROMs and soft-skinned actors).

        Note:
            For static actors, it only supports setting zero velocity.

        Note:
            For soft actors, the angular velocity must be zero.

        Note:
            Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler
            in the first time step after this method is called.
        """
    def get_linear_velocity(self) -> Real3:
        """Get the linear velocity of the actor in world frame.

        Returns:
            Linear velocity in world frame [m/s].

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid and soft actors.

        Note:
            For rigid actors, it returns the velocity of the center of mass.

        Note:
            For soft actors, it returns an estimate of the linear velocity of the root
            transform. Requires recentering to be enabled for accurate results.

        Note:
            Not supported for ROM actors.
        """
    def get_angular_velocity(self) -> Real3:
        """Get the angular velocity of the actor in world frame.

        Returns:
            Angular velocity in world frame [rad/s].

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid and soft actors.

        Note:
            For rigid actors, it returns the actual angular velocity.

        Note:
            For soft actors, it returns an estimate of the angular velocity of the root
            transform. Requires recentering to be enabled for accurate results.

        Note:
            Not supported for ROM actors.
        """
    def get_mass(self) -> float:
        """Get the total mass of the actor.

        Returns:
            Mass [kg] of the actor.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Not supported for static actors.
        """
    def get_density(self) -> float:
        """Get the density of the actor in the undeformed configuration.

        Returns:
            Density [kg/m³] of the actor.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid actors (except static rigid actors), articulated
            links and soft actors.

        See Also:
            :meth:`~superdex.physics.Actor.set_density`,
            :meth:`~superdex.physics.Actor.get_soft_material_params`
        """
    def set_density(self, density: float) -> None:
        """Set the density of the actor in the undeformed configuration.

        Args:
            density (float): Density [kg/m³] to set. Must be positive.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid actors (except static rigid actors), articulated
            links and soft actors.

        Note:
            The moment of inertia is updated based on the new density. The center of
            mass is left unchanged.

        See Also:
            :meth:`~superdex.physics.Actor.get_density`,
            :meth:`~superdex.physics.Actor.set_inertia_properties`,
            :meth:`~superdex.physics.Actor.set_soft_material_params`
        """
    def set_inertia_properties(
        self,
        mass: float,
        center_of_mass: Real3Like,
        moment_of_inertia: Real6Like,
    ) -> None:
        """Set the mass properties of the actor.

        Directly sets mass, center of mass position in local coordinates, and moment of
        inertia tensor at the center of mass. This bypasses density-based computation
        and allows specifying exact inertia from CAD data or external measurements.

        Args:
            mass (float): Mass [kg] to set. Must be positive and finite.
            center_of_mass (Real3Like): Position of center of mass [m] in actor's local
                coordinate frame (:meth:`~superdex.physics.Actor.get_root_transform`).
            moment_of_inertia (Real6Like): Moment of inertia tensor at center of mass
                [kg·m²], upper-right triangle [ixx, ixy, ixz, iyy, iyz, izz] using
                negative tensor notation consistent with
                :meth:`~superdex.physics.Actor.get_rigid_moment_of_inertia_local`. Must
                be finite.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for dynamic rigid actors. Not supported for static actors,
            soft actors, shell actors, or articulated links.

        Note:
            A finite but physically invalid moment of inertia tensor (negative principal
            moments or one violating the triangle inequality) is accepted with a
            warning, not rejected.

        Note:
            Re-anchors the density reference state. Subsequent
            :meth:`~superdex.physics.Actor.set_density` calls rescale mass and moment of
            inertia proportionally about the new values; center of mass is unchanged by
            :meth:`~superdex.physics.Actor.set_density`.

        Note:
            After this call, :meth:`~superdex.physics.Actor.get_density` returns bulk
            density mass / volume.

        See Also:
            :meth:`~superdex.physics.Actor.get_mass`,
            :meth:`~superdex.physics.Actor.get_density`,
            :meth:`~superdex.physics.Actor.set_density`,
            :meth:`~superdex.physics.Actor.get_rigid_center_of_mass_local`,
            :meth:`~superdex.physics.Actor.get_rigid_moment_of_inertia_local`
        """
    def get_elastic_energy(self) -> float:
        """Get the elastic energy of the actor, measured as the difference with respect
        to
        the rest state.

        Returns:
            Elastic energy [J] of the actor.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Requires registering :class:`ELASTIC_ENERGY <superdex.physics.QueryType>`
            before the simulation step. Results are available after the simulation step
            completes.

        Note:
            Requires the actor to support :class:`ELASTIC_ENERGY
            <superdex.physics.QueryType>`.

        See Also:
            :meth:`~superdex.physics.Actor.register_query`, :class:`ELASTIC_ENERGY
            <superdex.physics.QueryType>`
        """
    def get_recentering_params(self) -> RecenteringParams:
        """Gets the recentering parameters of the actor.

        Returns:
            Recentering parameters of the actor.

        Note:
            Recentering is only supported for soft actors (not soft-skinned). For other
            actor types, returns default recentering parameters with
            :attr:`~superdex.physics.RecenteringParams.use_recentering` set to false.

        See Also:
            :class:`~superdex.physics.RecenteringParams`,
            :meth:`~superdex.physics.Actor.set_recentering_params`
        """
    def set_recentering_params(self, params: RecenteringParams) -> None:
        """Set the recentering parameters of the actor.

        When enabled for a soft actor, the root transform automatically moves as the
        actor's "rigid pivot" (typically near the center of mass) moves.

        Args:
            params (RecenteringParams): Recentering parameters to set.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft actors (not soft-skinned).

        See Also:
            :class:`~superdex.physics.RecenteringParams`,
            :meth:`~superdex.physics.Actor.get_recentering_params`
        """
    def get_displacements(self) -> SpanConstReal:
        """Get the node displacements of the actor in the actor's local frame, relative
        to
        reference (rest) positions.

        Returns:
            Node displacements in the actor's local frame. Length is 3 × the number of
            nodes for soft, shell, and soft-skinned actors, or 4 × the number of nodes
            for rod actors (3 displacement [m] + 1 twist [rad] per node). The number of
            nodes is available from :meth:`~superdex.physics.Actor.get_mesh`.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft, soft-skinned, shell and rod actors.

        Note:
            For soft-skinned actors, it returns post-skinning displacements, which may
            differ from the pre-skinning elastic deformation component written by
            :meth:`~superdex.physics.Actor.set_displacements`.

        See Also:
            :meth:`~superdex.physics.Actor.set_displacements`,
            :meth:`~superdex.physics.Actor.get_node_positions_local`
        """
    def set_displacements(self, displacements: ArrayLikeReal) -> None:
        """Set the node displacements in the actor's local frame, relative to reference
        (rest) positions.

        Args:
            displacements (ArrayLikeReal): Node displacements [m] to set in the actor's
                local frame. Length must be 3 × the number of nodes. The number of nodes
                is available from :meth:`~superdex.physics.Actor.get_mesh`.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft, soft-skinned and shell actors.

        Note:
            For soft-skinned actors, displacements are the elastic deformation component
            only (before skinning is applied).

        Note:
            Does not change node velocities.

        Note:
            Resets multi-step time integrators, e.g. BDF2 falls back to backward Euler
            in the first time step after this method is called.

        See Also:
            :meth:`~superdex.physics.Actor.get_displacements`,
            :meth:`~superdex.physics.Actor.set_node_positions_local`
        """
    def get_soft_material_params(self) -> SoftMaterialParams:
        """Get the material parameters of a soft actor.

        Returns:
            Material parameters of the actor.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft actors.

        See Also:
            :meth:`~superdex.physics.Actor.set_soft_material_params`,
            :func:`~superdex.physics.experimental.get_soft_material_params_field`,
            :meth:`~superdex.physics.Actor.get_density`
        """
    def set_soft_material_params(self, params: SoftMaterialParams) -> None:
        """Set the material parameters of a soft actor.

        Args:
            params (SoftMaterialParams): Material parameters to set.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft actors.

        Note:
            If the :class:`ELASTIC_ENERGY <superdex.physics.QueryType>` query is active,
            invalidates the elastic energy baseline. One simulation step must complete
            before :meth:`~superdex.physics.Actor.get_elastic_energy` returns valid
            results.

        See Also:
            :meth:`~superdex.physics.Actor.get_soft_material_params`,
            :func:`~superdex.physics.experimental.set_soft_material_params_field`,
            :meth:`~superdex.physics.Actor.set_density`
        """
    def get_mesh(self) -> MeshDataView:
        """Get a view of the actor's reference simulation mesh.

        For soft actors, returns the tetrahedral mesh. For shell actors, returns the
        triangle mesh. For rod actors, returns the polyline mesh. For articulated actors
        with a skin mesh, returns the skin mesh. For articulated actors without a skin
        mesh, returns an empty view. For soft-skinned actors, returns the blended skin
        mesh when one is present and an empty view otherwise. For rigid actors whose
        shape is a tetrahedral or triangular mesh, returns their surface simulation
        mesh. For rigid actors with an implicit shape, such as spheres and planes,
        returns an empty view.

        Returns:
            A non-owning view of the actor's reference simulation mesh, or an empty view
            if the actor has no simulation mesh.

        Note:
            The returned coordinates are reference positions in the actor's local frame.
            They do not include deformation for deformable actors.

        Note:
            For rigid actors with tetrahedral or triangular mesh shapes, returns the
            same compact surface view as
            :meth:`~superdex.physics.Actor.get_surface_mesh`. For tetrahedral meshes
            this is the boundary surface. For triangular meshes, nodes not referenced by
            any surface triangle are omitted and remaining nodes may be reindexed. Use
            :meth:`~superdex.physics.Actor.get_reference_shape` and
            :func:`~superdex.physics.get_shape_mesh` to retrieve the original authored
            shape mesh.

        Note:
            The returned view remains valid until the actor is destroyed.

        See Also:
            :class:`~superdex.physics.MeshDataView`,
            :meth:`~superdex.physics.Actor.get_surface_mesh`,
            :meth:`~superdex.physics.Actor.get_visual_mesh`,
            :func:`~superdex.physics.get_shape_mesh`
        """
    def get_surface_mesh(self) -> MeshDataView:
        """Get a view of the actor's reference surface mesh.

        Returns a compact triangle mesh for the actor's surface. For volumetric
        simulation meshes, the surface is the boundary triangles. For triangular
        simulation meshes, the surface has the same triangle elements as the simulation
        mesh, but nodes not referenced by any surface triangle are omitted and remaining
        nodes may be reindexed. Returns an empty view if the actor does not have a
        surface mesh.

        Returns:
            A non-owning view of the actor's reference surface mesh, or an empty view if
            the actor has no surface mesh.

        Note:
            The returned coordinates are reference surface-mesh positions in the actor's
            local frame. They do not include deformation for deformable actors.

        Note:
            The returned mesh uses compact surface-node ordering. Connectivity indices
            refer to this ordering, which may differ from the node ordering returned by
            :meth:`~superdex.physics.Actor.get_mesh`. Interior nodes and nodes not
            referenced by any surface triangle are excluded. Results from
            :meth:`~superdex.physics.Actor.get_surface_mesh_node_positions_local` and
            :meth:`~superdex.physics.Actor.get_surface_mesh_node_normals_local` use this
            same surface ordering.

        Note:
            The returned view remains valid until the actor is destroyed.

        See Also:
            :class:`~superdex.physics.MeshDataView`,
            :meth:`~superdex.physics.Actor.get_mesh`,
            :meth:`~superdex.physics.Actor.get_visual_mesh`,
            :meth:`~superdex.physics.Actor.get_surface_mesh_node_positions_local`,
            :meth:`~superdex.physics.Actor.get_surface_mesh_node_normals_local`,
            :func:`~superdex.physics.get_shape_surface_mesh`
        """
    def get_visual_mesh(self) -> MeshDataView:
        """Get a view of the actor's reference visual mesh.

        Returns a triangle mesh intended for visual rendering. The mesh may include
        linear visual-mesh skinning data when available. Returns an empty view if the
        actor does not have a visual mesh.

        Returns:
            A non-owning view of the actor's reference visual mesh, or an empty view if
            the actor has no visual mesh.

        Note:
            The returned coordinates are reference visual-mesh positions in the actor's
            local frame. They do not include deformation for deformable actors.

        Note:
            Includes visual mesh nodes not referenced by any visual triangle. Unlike
            surface mesh getters, visual mesh getters do not omit unreferenced nodes.

        Note:
            When linear visual-mesh skinning data is present, skinning indices refer to
            the node ordering returned by :meth:`~superdex.physics.Actor.get_mesh`, not
            to the compact surface-node ordering returned by
            :meth:`~superdex.physics.Actor.get_surface_mesh`. Rod visual mesh embeddings
            are nonlinear and are not exposed through this linear skinning field.

        Note:
            The returned view remains valid until the actor is destroyed.

        See Also:
            :class:`~superdex.physics.MeshDataView`,
            :meth:`~superdex.physics.Actor.get_mesh`,
            :meth:`~superdex.physics.Actor.get_surface_mesh`,
            :meth:`~superdex.physics.Actor.get_visual_mesh_node_positions_local`,
            :meth:`~superdex.physics.Actor.get_visual_mesh_node_normals_local`,
            :func:`~superdex.physics.get_shape_visual_mesh`
