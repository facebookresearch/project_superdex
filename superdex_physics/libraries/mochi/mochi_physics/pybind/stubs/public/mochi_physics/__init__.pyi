class ContactPoint:
    """Information about a contact point between two actors.

    Describes a single contact or near-contact point between two actors. Contains
    geometric information (positions, normal, distance), kinematic data
    (velocities), and dynamic data (force). Also includes finite element
    discretization information for accurate force interpolation.

    Note:
        Available via :meth:`~superdex.physics.Actor.get_contact_points_world` after
        registering :class:`CONTACT_POINTS <superdex.physics.QueryType>`.

    See Also:
        :class:`CONTACT_POINTS <superdex.physics.QueryType>`,
        :meth:`~superdex.physics.Actor.register_query`,
        :meth:`~superdex.physics.Actor.get_contact_points_world`
    """
    actor_a: ActorHandle
    """Handle of the colliding actor.

    Note:
        When calling :meth:`~superdex.physics.Actor.get_contact_points_world`, the
        actor being queried may be reported as either
        :attr:`~superdex.physics.ContactPoint.actor_a` or
        :attr:`~superdex.physics.ContactPoint.actor_b` in this struct, depending on
        the direction of the contact test.

    Note:
        May be the same as :attr:`~superdex.physics.ContactPoint.actor_b` in the
        case of self-contact.
    """
    actor_b: ActorHandle
    """Handle of the collider actor.

    Note:
        When calling :meth:`~superdex.physics.Actor.get_contact_points_world`, the
        actor being queried may be reported as either
        :attr:`~superdex.physics.ContactPoint.actor_a` or
        :attr:`~superdex.physics.ContactPoint.actor_b` in this struct, depending on
        the direction of the contact test.

    Note:
        May be the same as :attr:`~superdex.physics.ContactPoint.actor_a` in the
        case of self-contact.
    """
    distance: float
    """Signed separation distance [m] between
    :attr:`~superdex.physics.ContactPoint.pos_a` (on
    :attr:`~superdex.physics.ContactPoint.actor_a`) and the closest point on the
    surface of :attr:`~superdex.physics.ContactPoint.actor_b`. Negative if the point
    is inside (i.e. actors overlap).
    """
    @property
    def pos_a(self) -> Real3:
        """Contact position [m] on :attr:`~superdex.physics.ContactPoint.actor_a` in
        world
        frame.
        """
    @pos_a.setter
    def pos_a(self, value: Real3Like) -> None: ...
    @property
    def pos_b(self) -> Real3:
        """Approximate contact position [m] on
        :attr:`~superdex.physics.ContactPoint.actor_b` in world frame.

        Note:
            Equivalent to (posA - normal * distance).
        """
    @pos_b.setter
    def pos_b(self, value: Real3Like) -> None: ...
    @property
    def normal(self) -> Real3:
        """Contact normal in world frame pointing away from
        :attr:`~superdex.physics.ContactPoint.actor_b`. Unit length.
        """
    @normal.setter
    def normal(self, value: Real3Like) -> None: ...
    @property
    def force(self) -> Real3:
        """Contact force [N] applied to :attr:`~superdex.physics.ContactPoint.actor_a`
        from
        :attr:`~superdex.physics.ContactPoint.actor_b` in world frame.
        """
    @force.setter
    def force(self, value: Real3Like) -> None: ...
    @property
    def point_velocity_a(self) -> Real3:
        """Velocity [m/s] of the contact point on
        :attr:`~superdex.physics.ContactPoint.actor_a` in world frame.
        """
    @point_velocity_a.setter
    def point_velocity_a(self, value: Real3Like) -> None: ...
    @property
    def point_velocity_b(self) -> Real3:
        """Velocity [m/s] of the contact point on
        :attr:`~superdex.physics.ContactPoint.actor_b` in world frame.
        """
    @point_velocity_b.setter
    def point_velocity_b(self, value: Real3Like) -> None: ...
    sample_index: int
    """Sample point index of :attr:`~superdex.physics.ContactPoint.actor_a`."""
    int_weight: float
    """Quadrature integration weight of the sample point on the colliding manifold of
    :attr:`~superdex.physics.ContactPoint.actor_a`.

    Note:
        Units depend on the dimensionality of the colliding manifold of
        :attr:`~superdex.physics.ContactPoint.actor_a`: [m²] for surface contact
        (e.g., rigid, articulated, soft, shell, and rod actors with visual-mesh
        contact enabled), or [m] for rod actors using centerline contact.

    Note:
        For surface contact, represents the surface area corresponding to the sample
        point. For rod centerline contact, represents the arc length.

    Note:
        Useful for contact area/length estimation and other post-processing.

    Note:
        :attr:`~superdex.physics.ContactPoint.force` is already weighted by this
        value.
    """
    element_index: int
    """Element index on the surface mesh of
    :attr:`~superdex.physics.ContactPoint.actor_a`.

    Note:
        For rod actors, this field is not populated and is reported as 0. Use
        :attr:`~superdex.physics.ContactPoint.sample_index` to identify the contact
        location.
    """
    @property
    def parametric_coords(self) -> Real3:
        """Parametric coordinates within the surface element of
        :attr:`~superdex.physics.ContactPoint.actor_a`.

        Note:
            Corresponds to finite-element basis function values at the contact sample
            quadrature point.

        Note:
            For linear finite elements, these match barycentric coordinates.

        Note:
            Allows interpolation of functions defined on triangle vertices.

        Note:
            For rod actors, this field is not populated and is reported as {0, 0, 0}.
            Use :attr:`~superdex.physics.ContactPoint.sample_index` to identify the
            contact location.
        """
    @parametric_coords.setter
    def parametric_coords(self, value: Real3Like) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        actor_a: ActorHandle = ...,
        actor_b: ActorHandle = ...,
        distance: float = ...,
        pos_a: Real3Like = ...,
        pos_b: Real3Like = ...,
        normal: Real3Like = ...,
        force: Real3Like = ...,
        point_velocity_a: Real3Like = ...,
        point_velocity_b: Real3Like = ...,
        sample_index: int = ...,
        int_weight: float = ...,
        element_index: int = ...,
        parametric_coords: Real3Like = ...,
    ) -> None: ...

