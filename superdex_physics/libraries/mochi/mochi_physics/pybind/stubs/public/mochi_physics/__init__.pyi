class DebugDraw:
    """Manages debug visualization features for a scene.

    Provides a feature-based system for visualizing various aspects of the physics
    simulation. The client application is responsible for rendering the generated
    primitives using its own graphics API. Features can be individually enabled or
    disabled, such as visualizing contact points, normals, velocities, or AABBs.

    Note:
        Must be accessed on the same thread as the owning
        :class:`~superdex.physics.Scene`.

    Note:
        Debug draw is disabled by default.

    Note:
        If consuming the data on a different thread, the client must deep-copy the
        underlying data into client-owned buffers before the scene thread calls
        :meth:`gather_data` again or modifies the :class:`~superdex.physics.Scene`.
        Copying :class:`~superdex.physics.DebugDrawData` itself is a shallow copy of
        ``mochi::Span`` views into internal buffers and does not transfer ownership.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``mochi::Span``.

    Warning:
        Debug drawing has significant performance overhead due to geometry
        generation and data gathering.

    See Also:
        :meth:`~superdex.physics.Scene.get_debug_draw`,
        :class:`~superdex.physics.DebugDrawData`
    """
    def is_enabled(self) -> bool:
        """Check if debug drawing is enabled for the scene.

        Returns:
            True if debug drawing is enabled, false otherwise.

        Note:
            When disabled, :meth:`~superdex.physics.DebugDraw.gather_data` returns empty
            data regardless of feature settings.

        See Also:
            :meth:`~superdex.physics.DebugDraw.enable`
        """
    def enable(self, enable: bool) -> None:
        """Enable or disable debug drawing for the entire scene.

        Args:
            enable (bool): True to enable, false to disable.

        Note:
            This is a master switch that overrides all individual feature settings.

        See Also:
            :meth:`~superdex.physics.DebugDraw.is_enabled`
        """
    def get_num_features(self) -> int:
        """Get the number of debug draw features available.

        Returns:
            Number of features that can be individually enabled or disabled.

        See Also:
            :meth:`~superdex.physics.DebugDraw.find_feature`,
            :meth:`~superdex.physics.DebugDraw.get_feature_name`
        """
    def find_feature(self, name: str) -> int:
        """Find a feature by name.

        Args:
            name (str): Feature name (case sensitive).

        Returns:
            Feature index if found, or -1 if not found.

        See Also:
            :meth:`~superdex.physics.DebugDraw.get_feature_name`,
            :meth:`~superdex.physics.DebugDraw.enable_feature`
        """
    def get_feature_name(self, index: int) -> str:
        """Get the name of a feature by index.

        Args:
            index (int): Feature index in the range [0,
                :meth:`~superdex.physics.DebugDraw.get_num_features`).

        Returns:
            Name of the feature.

        See Also:
            :meth:`~superdex.physics.DebugDraw.get_num_features`,
            :meth:`~superdex.physics.DebugDraw.find_feature`
        """
    def get_feature_description(self, index: int) -> str:
        """Get the description of a feature by index.

        Args:
            index (int): Feature index in the range [0,
                :meth:`~superdex.physics.DebugDraw.get_num_features`).

        Returns:
            Human-readable description of the feature.

        See Also:
            :meth:`~superdex.physics.DebugDraw.get_num_features`,
            :meth:`~superdex.physics.DebugDraw.get_feature_name`
        """
    def is_feature_enabled(self, index: int) -> bool:
        """Check if a feature is currently enabled.

        Args:
            index (int): Feature index in the range [0,
                :meth:`~superdex.physics.DebugDraw.get_num_features`).

        Returns:
            True if the feature is enabled, false otherwise.

        See Also:
            :meth:`~superdex.physics.DebugDraw.enable_feature`
        """
    def enable_feature(self, index: int, enable: bool) -> None:
        """Enable or disable a specific feature.

        Args:
            index (int): Feature index in the range [0,
                :meth:`~superdex.physics.DebugDraw.get_num_features`).
            enable (bool): True to enable the feature, false to disable.

        Note:
            No debug-draw data is generated while the master switch
            (:meth:`~superdex.physics.DebugDraw.is_enabled`) is false, but per-feature
            settings are remembered and take effect when the master switch is enabled.

        See Also:
            :meth:`~superdex.physics.DebugDraw.is_feature_enabled`,
            :meth:`~superdex.physics.DebugDraw.enable`
        """
    def gather_data(self) -> DebugDrawData:
        """Generate debug draw primitives for all currently enabled features.

        Returns:
            Collection of primitives to be rendered by the client application. The
            returned :class:`~superdex.physics.DebugDrawData` contains Spans that
            reference internal buffers.

        Note:
            Data is valid only until the next call to
            :meth:`~superdex.physics.DebugDraw.gather_data` or any modification to the
            :class:`~superdex.physics.Scene`.

        Note:
            Returns empty data if :meth:`~superdex.physics.DebugDraw.is_enabled` is
            false.

        See Also:
            :class:`~superdex.physics.DebugDrawData`
        """
    def enable_actor(self, actor: ActorHandle, enable: bool) -> None:
        """Enable or disable debug drawing for a specific actor.

        Args:
            actor (ActorHandle): Handle of the actor to enable or disable debug drawing
                for.
            enable (bool): True to enable, false to disable.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Enabled by default for all actors, including nested actors (child actors of
            articulated, soft-skinned and blended actors).

        Note:
            Debug draw data won't be generated for any actor if the master switch, i.e.
            :meth:`~superdex.physics.DebugDraw.is_enabled`, is false.
        """

class DebugServer:
    """Server API to enable remote debugging and visualization.

    See Also:
        :func:`~superdex.physics.get_debug_server`
    """
    def start(self, preferred_port: int = ...) -> None:
        """Start accepting client connections on a TCP port.

        Args:
            preferred_port (int): Preferred TCP port to listen on. If the port is
                already in use, the next available port is chosen automatically.

        Note:
            No-op if the server has already been started.

        See Also:
            :meth:`~superdex.physics.DebugServer.stop`,
            :meth:`~superdex.physics.DebugServer.has_started`,
            :meth:`~superdex.physics.DebugServer.get_port`
        """
    def stop(self) -> None:
        """Stop the server and disconnect any connected client.

        Note:
            No-op if the server has not started.

        See Also:
            :meth:`~superdex.physics.DebugServer.start`,
            :meth:`~superdex.physics.DebugServer.has_started`
        """
    def has_started(self) -> bool:
        """Check whether the server has started.

        Returns:
            True if :meth:`~superdex.physics.DebugServer.start` has been called, even if
            the server is not actually able to accept connections due to issues with
            permissions or firewalls.

        See Also:
            :meth:`~superdex.physics.DebugServer.start`,
            :meth:`~superdex.physics.DebugServer.stop`
        """
    def has_connection(self) -> bool:
        """Check whether a debugger client is currently connected.

        Returns:
            True if any debugger client is connected.

        See Also:
            :meth:`~superdex.physics.DebugServer.start`,
            :meth:`~superdex.physics.DebugServer.stop`
        """
    def get_port(self) -> int:
        """Get the actual TCP port the server is listening on.

        May differ from the port requested in
        :meth:`~superdex.physics.DebugServer.start` if that port was already in use.

        Returns:
            The TCP port currently in use, or 0 if the server is not listening on a TCP
            socket.

        See Also:
            :meth:`~superdex.physics.DebugServer.start`
        """
    def set_coordinate_space(self, space: CoordinateSpace) -> None:
        """Declare the coordinate space this application's scene data is expressed in.

        Sent to the debugger client so it can render the scene in the correct
        orientation. This is purely descriptive metadata: it does not affect simulation.
        The default is X-right, Y-up, Z-backward.

        Args:
            space (CoordinateSpace): Coordinate space convention and unit scale of this
                application's scenes.

        Note:
            Must be called before :meth:`~superdex.physics.DebugServer.start`.

        See Also:
            :meth:`~superdex.physics.DebugServer.start`
        """

