    def get_boundary_condition_dof_indices(self) -> SpanConstInt:
        """Get the DoF indices that are constrained by boundary conditions.

        Returns:
            Span of DoF indices with boundary conditions applied.

        Note:
            See :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world` for
            the DoF layout for each actor type.

        Note:
            The returned span contains every boundary-condition entry added through the
            public boundary-condition functions that has not been cleared, in the order
            the entries were added, including repeated DoF indices. Permanent and
            clearable entries are both included and are not distinguishable. Boundary
            conditions applied automatically by the engine are not included.

        Note:
            Adding boundary conditions or calling
            :meth:`~superdex.physics.Actor.clear_boundary_conditions` may invalidate the
            returned span. Do not retain it across either operation. Permanent entries
            are retained when :meth:`~superdex.physics.Actor.clear_boundary_conditions`
            is called, but their positions within subsequently returned spans may
            change. Do not cache those positions across a call to
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`.

        See Also:
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_values_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`
        """
    def get_boundary_condition_dof_values_world(self) -> SpanConstReal:
        """Get the target values of DoFs fixed by boundary conditions.

        Returns:
            Span of DoF target values in the actor-specific representations documented
            by :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`.

        Note:
            1-to-1 correspondence with
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices`.

        Note:
            Adding boundary conditions or calling
            :meth:`~superdex.physics.Actor.clear_boundary_conditions` may invalidate the
            returned span. Do not retain it across either operation. Permanent entries
            are retained when :meth:`~superdex.physics.Actor.clear_boundary_conditions`
            is called, but their positions within subsequently returned spans may
            change. Do not cache those positions across a call to
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`.

        See Also:
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`
        """
    def add_boundary_condition_dofs_world(
        self,
        dof_indices: ArrayLikeInt,
        dof_values_world: ArrayLikeReal,
    ) -> None:
        """Add boundary conditions to specified DoFs.

        Args:
            dof_indices (ArrayLikeInt): DoF indices to constrain.
            dof_values_world (ArrayLikeReal): Target values in the actor-specific
                representations described below. Length must equal ``dof_indices``.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Not supported for nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            For soft and shell actors, each node has 3 consecutive DoFs containing its
            target x, y, and z position [m] in the world frame. All 3 must be specified
            together. Consider
            :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world` as a more
            convenient alternative.

        Note:
            For rigid and articulated actors, the DoF indices within each call must be
            sorted in strictly increasing order (no duplicate indices).

        Note:
            Rigid actors have 6 DoFs: indices 0-2 are the target world-space
            center-of-mass position [m], and indices 3-5 are the target world-from-local
            orientation as a rotation vector (axis multiplied by angle [rad]). Either
            all or none of the 3 rotation DoFs must be specified.

        Note:
            Articulated actors have a number of DoFs that depends on the number of
            joints and the DoFs per joint. When setting boundary conditions on the
            rotation of a free or spherical joint, either all or none of the 3 DoFs must
            be specified.

        Note:
            Rod actors have 4 DoFs per node: the first 3 values are the target node x,
            y, and z position [m] in the world frame, followed by the next element's
            scalar twist angle [rad]. (For open rods, the last DoF, i.e., the final
            node's twist DoF, is included for padding only, does not affect the physics,
            and is automatically constrained to zero. This automatic constraint is not
            reported by
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices`. For
            closed-loop rods, all twist DoFs are physical.) Boundary conditions on a rod
            node's position must specify all 3 consecutive displacement DoFs for that
            node. Only zero values are allowed for the scalar twist angle in this
            function, with the interpretation that the element's cross-section material
            axes rotate by only the minimal amount needed to remain orthogonal to the
            rod's centerline. More elaborate control over rod element rotations should
            use constraints instead of boundary conditions.

        Note:
            Boundary condition APIs add to existing boundary conditions; they do not
            replace existing entries. If a DoF has more than one entry, getter APIs
            return all entries in the order they were added, and the most recently added
            value is the effective value during the step.

        Note:
            Boundary conditions can be cleared with
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`.

        Warning:
            Constrained 3D rotations may exhibit small numerical differences due to
            differences in the internal representation.

        Warning:
            Adding a boundary condition to the same DoF more than once is legal — the
            most recently added value wins — but strongly discouraged. Each call adds an
            entry, so repeatedly re-adding without an intervening
            :meth:`~superdex.physics.Actor.clear_boundary_conditions` grows the per-step
            cost without bound. To update a boundary condition, call
            :meth:`~superdex.physics.Actor.clear_boundary_conditions` and add it again.

        See Also:
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`,
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices`,
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_values_world`
        """
    def add_boundary_condition_dofs_world_permanent(
        self,
        dof_indices: ArrayLikeInt,
        dof_values_world: ArrayLikeReal,
    ) -> None:
        """Add permanent boundary conditions to specified DoFs.

        Args:
            dof_indices (ArrayLikeInt): DoF indices to constrain.
            dof_values_world (ArrayLikeReal): Target values in the actor-specific
                representations documented by
                :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`.
                Length must equal ``dof_indices``.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Not supported for nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            Same as :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`,
            except boundary conditions cannot be cleared.

        Note:
            If a clearable entry is later added for the same DoF, that clearable entry
            is the effective value until
            :meth:`~superdex.physics.Actor.clear_boundary_conditions` removes it. The
            permanent entry is then the effective value again.

        Warning:
            Permanent boundary conditions are retained for the lifetime of the actor and
            cannot be removed by
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`. Adding a
            permanent boundary condition to the same DoF more than once is legal but
            strongly discouraged. The duplicates can never be cleared and irreversibly
            grow the per-step cost. Add each permanent boundary condition only once.

        See Also:
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`
        """
    def add_boundary_condition_nodes_world(
        self,
        node_indices: ArrayLikeInt,
        node_positions_world: ArrayLikeReal,
    ) -> None:
        """Add world-space boundary conditions for specified nodes.

        Args:
            node_indices (ArrayLikeInt): Node indices to constrain.
            node_positions_world (ArrayLikeReal): Target positions [m] in world frame.
                Length must be 3 times the size of ``node_indices``.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft and shell actors, except nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            Boundary conditions can be cleared with
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`.

        Note:
            Equivalent to calling
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world` with DoF
            indices (3*i, 3*i+1, 3*i+2) for each node i.

        Note:
            This API adds to existing boundary conditions. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world` for
            behavior when a DoF has more than one entry.

        Warning:
            Adding boundary conditions to the same nodes repeatedly without clearing
            grows the per-step cost without bound. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`.

        See Also:
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world_permanent`,
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices`,
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_values_world`
        """
    def add_boundary_condition_nodes_world_permanent(
        self,
        node_indices: ArrayLikeInt,
        node_positions_world: ArrayLikeReal,
    ) -> None:
        """Add permanent world-space boundary conditions for specified nodes.

        Args:
            node_indices (ArrayLikeInt): Node indices to constrain.
            node_positions_world (ArrayLikeReal): Target positions [m] in world frame.
                Length must be 3 times the size of ``node_indices``.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft and shell actors, except nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            Same as :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world`,
            except boundary conditions cannot be cleared.

        Note:
            See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`
            for interaction with clearable entries later added to the same DoF.

        Warning:
            Add each permanent boundary condition only once. Duplicates can never be
            cleared and irreversibly grow the per-step cost. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`.

        See Also:
            :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`
        """
    def add_boundary_condition_constrained_nodes_at_rest(self) -> None:
        """Fix the "constrained nodes" at their world-space reference positions.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft and shell actors, except nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            Boundary conditions can be cleared with
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`.

        Note:
            Applies to constrained nodes specified by the actor's mesh. Has no effect if
            none are specified.

        Note:
            Each target position is computed by transforming the node's mesh reference
            coordinate by the actor's root transform.

        Note:
            This API adds to existing boundary conditions. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world` for
            behavior when a DoF has more than one entry.

        Warning:
            If the actor's mesh has constrained nodes, calling this repeatedly without
            clearing re-adds the same boundary conditions and grows the per-step cost
            without bound. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`.

        See Also:
            :meth:`~superdex.physics.Actor.clear_boundary_conditions`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_constrained_nodes_at_rest_permanent`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`
        """
    def add_boundary_condition_constrained_nodes_at_rest_permanent(self) -> None:
        """Permanently fix the "constrained nodes" at their world-space reference
        positions.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for soft and shell actors, except nested soft actors (see
            :meth:`~superdex.physics.Actor.get_nested_soft_actors`).

        Note:
            Not supported in differentiable scenes
            (:func:`~superdex.physics.diffsim.make_scene_differentiable`) or for ROM
            actors.

        Note:
            Same as
            :meth:`~superdex.physics.Actor.add_boundary_condition_constrained_nodes_at_rest`,
            except boundary conditions cannot be cleared.

        Note:
            See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`
            for interaction with clearable entries later added to the same DoF.

        Warning:
            If the actor's mesh has constrained nodes, each call adds a permanent
            boundary condition for every constrained node. Call this at most once.
            Repeated calls create duplicates that cannot be removed and irreversibly
            grow the per-step cost. See
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`.

        See Also:
            :meth:`~superdex.physics.Actor.add_boundary_condition_constrained_nodes_at_rest`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world_permanent`
        """
    def clear_boundary_conditions(self) -> None:
        """Remove all clearable boundary conditions previously added.

        Note:
            To replace existing clearable boundary conditions, call this before adding
            the new boundary-condition set.

        Note:
            May invalidate spans previously returned by
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices` and
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_values_world`. Do
            not retain them across this call.

        Note:
            Permanent entries are retained, but this call may change their positions in
            spans returned by
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_indices` and
            :meth:`~superdex.physics.Actor.get_boundary_condition_dof_values_world`. Do
            not cache those positions across this call.

        See Also:
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_nodes_world`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_constrained_nodes_at_rest`
        """
    def set_external_forces_on_dofs(
        self,
        dof_indices: ArrayLikeInt,
        force_values: ArrayLikeReal,
    ) -> None:
        """Set external forces on specified DoFs.

        Args:
            dof_indices (ArrayLikeInt): DoF indices to apply forces to. Must be unique.
            force_values (ArrayLikeReal): Force values [N] for translation DoFs, torque
                values [N·m] for rotation DoFs. Length must equal the number of DoF
                indices.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Only supported for rigid, articulated, rod, and shell actors.

        Note:
            DoF indices use the same per-actor-type index layout documented by
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`.

        Note:
            External forces can be cleared with
            :meth:`~superdex.physics.Actor.clear_external_forces`.

        Note:
            Replaces all previously set external forces, including external forces on
            DoFs not included in ``dof_indices``. Passing empty ``dof_indices`` and
            ``force_values`` is equivalent to calling
            :meth:`~superdex.physics.Actor.clear_external_forces`.

        Note:
            For rigid and shell actors, values are interpreted in the world frame.

        Note:
            For articulated actors, values are generalized forces in the actor's
            joint-DoF coordinate basis.

        Note:
            For rod actors, forces on displacement DoFs are specified in the world
            frame, while (generalized) forces (scalar torques) on element twist-angle
            DoFs are always oriented along the corresponding element's current
            orientation.

        Note:
            For open (non-closed-loop) rod actors, the last DoF is padding that does not
            participate in physics, so it is invalid to apply a torque to it. For
            closed-loop rods, the last DoF is a physical twist angle.

        See Also:
            :meth:`~superdex.physics.Actor.clear_external_forces`,
            :meth:`~superdex.physics.Actor.get_external_forces`,
            :meth:`~superdex.physics.Actor.add_boundary_condition_dofs_world`
        """
    def clear_external_forces(self) -> None:
        """Remove all the external forces previously added.

        See Also:
            :meth:`~superdex.physics.Actor.set_external_forces_on_dofs`
        """
    def get_external_forces(self, out_forces: ArrayLikeReal) -> None:
        """Get the external forces currently set on this actor as a dense array over all
        DoFs.

        Args:
            out_forces (ArrayLikeReal): Dense output array of force values [N] for
                translation DoFs and torque values [N·m] for rotation DoFs. One entry
                per DoF. Size must equal :meth:`~superdex.physics.Actor.get_num_dofs`.
                DoFs with no external force set are filled with zero.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Returned values use the same frame convention as
            :meth:`~superdex.physics.Actor.set_external_forces_on_dofs`.

        See Also:
            :meth:`~superdex.physics.Actor.set_external_forces_on_dofs`,
            :meth:`~superdex.physics.Actor.clear_external_forces`
        """
    def get_contact_points_world(self) -> SpanConstContactPoint:
