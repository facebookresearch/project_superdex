class QueryType:
    """Type of query data to compute for an actor or constraint.

    Queries enable on-demand computation of simulation data. Some queries allow
    immediate retrieval of data; others must be registered beforehand to have the
    data computed and available for retrieval after the next step. Queries are
    reference counted, so multiple registrations are acceptable.

    Note:
        Not all query types are supported for all actor/constraint types. Use
        :meth:`~superdex.physics.Actor.is_query_supported` or
        :meth:`~superdex.physics.Constraint.is_query_supported` to check at runtime
        whether a specific query type is supported for a given actor/constraint.

    See Also:
        :meth:`~superdex.physics.Actor.register_query`,
        :meth:`~superdex.physics.Actor.register_query_and_compute`,
        :meth:`~superdex.physics.Constraint.register_query`
    """
    NODE_POSITIONS: QueryType
    """Positions of all mesh nodes. Available via
    :meth:`~superdex.physics.Actor.get_node_positions_local`.

    Note:
        Only supported for soft, soft-skinned and shell actors.
    """
    ELEMENTS_DEFORMATION_GRADIENT: QueryType
    """Deformation gradients for elements in deformable actors. Available via
    :meth:`~superdex.physics.Actor.get_elements_deformation_gradient`.

    Note:
        Only supported for soft and soft-skinned actors (except ROMs).
    """
    SURFACE_NODE_POSITIONS: QueryType
    """Positions of surface mesh nodes. Available via
    :meth:`~superdex.physics.Actor.get_surface_mesh_node_positions_local`.

    Note:
        Not supported for actors without a surface mesh, such as rod actors or rigid
        actors without a mesh (e.g. with an implicit shape).
    """
    SURFACE_NODE_NORMALS: QueryType
    """Normals of surface mesh nodes. Available via
    :meth:`~superdex.physics.Actor.get_surface_mesh_node_normals_local`.

    Note:
        Not supported for actors without a surface mesh, such as rod actors or rigid
        actors without a mesh (e.g. with an implicit shape).
    """
    VISUAL_NODE_POSITIONS: QueryType
    """Positions of visual mesh nodes. Available via
    :meth:`~superdex.physics.Actor.get_visual_mesh_node_positions_local`.

    Note:
        Only supported for actors with a visual mesh. Deformable actors also require
        a visual mesh embedding.
    """
    VISUAL_NODE_NORMALS: QueryType
    """Normals of visual mesh nodes. Available via
    :meth:`~superdex.physics.Actor.get_visual_mesh_node_normals_local`.

    Note:
        Only supported for actors with a visual mesh. Deformable actors also require
        a visual mesh embedding.
    """
    CONTACT_POINTS: QueryType
    """Contact points between actors. Available via
    :meth:`~superdex.physics.Actor.get_contact_points_world`.

    Note:
        Immediate computation, i.e.
        :meth:`~superdex.physics.Actor.register_query_and_compute`, is not
        supported.

    Note:
        Not supported for actors without contact sample points or with far SDF
        evaluation enabled.
    """
    ELASTIC_ENERGY: QueryType
    """Elastic energy of a deformable actor. Available via
    :meth:`~superdex.physics.Actor.get_elastic_energy`.

    Note:
        Only supported for soft and soft-skinned actors.
    """
    NODE_CONTACT_FORCES: QueryType
    """Contact forces per node. Available via
    :meth:`~superdex.physics.Actor.get_node_contact_forces_world`.

    Note:
        Immediate computation, i.e.
        :meth:`~superdex.physics.Actor.register_query_and_compute`, is not
        supported.

    Note:
        Not supported for rod actors, actors without contact sample points or actors
        with far SDF evaluation enabled.
    """
    CONSTRAINT_FORCE: QueryType
    """Force/torque applied by a constraint. Available via
    :meth:`~superdex.physics.Constraint.get_force`.

    Note:
        Only applicable to :class:`~superdex.physics.Constraint` objects.

    Note:
