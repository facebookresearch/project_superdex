    psd_proj_mode: PsdProjectionMode
    """Positive Semi-Definite (PSD) projection mode for the dresidual matrix."""
    gradient_descent_fallback: bool
    """Fall back to gradient descent direction if the solver search direction fails."""
    explosion_control: bool
    """Enable heuristic explosion prevention."""
    abs_div_tol: float
    """Absolute divergence tolerance.

    Note:
        Triggers explosion control if residual norm exceeds this value.

    Note:
        Used only if
        :attr:`~superdex.physics.NonLinearSolverParams.explosion_control` is true.
    """
    rel_div_tol: float
    """Relative divergence tolerance, relative to the initial residual.

    Note:
        Triggers explosion control if relative residual norm exceeds this value.

    Note:
        Used only if
        :attr:`~superdex.physics.NonLinearSolverParams.explosion_control` is true.
    """
    line_search_max_iter: int
    """Maximum number of line search iterations.

    Note:
        Must be >= 1 unless
        :attr:`~superdex.physics.NonLinearSolverParams.line_search_type` is
        :class:`NONE <superdex.physics.LineSearchType>`.
    """
    line_search_alpha: float
    """Step length reduction factor for line search.

    Note:
        Must be in (0, 1).
    """
    line_search_wolfe1: float
    """Wolfe condition parameter c1 (sufficient decrease).

    Note:
        Must be in (0, 1).

    Note:
        Used only by :class:`ARMIJO <superdex.physics.LineSearchType>`,
        :class:`WOLFE_WEAK <superdex.physics.LineSearchType>`, :class:`WOLFE_STRONG
        <superdex.physics.LineSearchType>`, and :class:`ARMIJO_OR_RESIDUAL_NORM
        <superdex.physics.LineSearchType>` line search types.
    """
    line_search_wolfe2: float
    """Wolfe condition parameter c2 (curvature).

    Note:
        Must be in
        (:attr:`~superdex.physics.NonLinearSolverParams.line_search_wolfe1`, 1).

    Note:
        Used only by :class:`WOLFE_WEAK <superdex.physics.LineSearchType>` and
        :class:`WOLFE_STRONG <superdex.physics.LineSearchType>` line search types.
    """
    line_search_max_rel_increase: float
    """Maximum relative increase in the objective to accept the step.

    Note:
