    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class ArticulatedShapeInfo:
    """Information describing an articulated shape's kinematic structure.

    Provides read-only access to an articulated shape's links, joints, and
    hierarchy. This information is immutable once the shape is created and defines
    the articulation's topology and configuration limits.

    Note:
        Number of joints = number of links + number of cycle joints.

    See Also:
        :meth:`~superdex.physics.Actor.get_articulated_shape_info`,
        :func:`~superdex.physics.get_articulated_shape_info`
    """
    @property
    def root_from_links_at_rest(self) -> SpanConstTransformRT:
        """Rotation and translation of each link in rest configuration relative to the
        local reference system of the articulated shape. Size must equal the number of
        links.
        """
    @root_from_links_at_rest.setter
    def root_from_links_at_rest(self, value: ArrayLikeTransformRT) -> None: ...
    @property
    def link_names(self) -> SpanConstString:
        """Name of each link."""
    @link_names.setter
    def link_names(self, value: ArrayLikeString) -> None: ...
    @property
    def parents(self) -> SpanConstInt:
        """Parent link indices defining a tree-like joint structure with no cycles. Size
        must equal the number of links.

        Note:
            ``parent[i] < i`` (parent must come before child in the array).

        Note:
            Use -1 for links with no parent.
        """
    @parents.setter
    def parents(self, value: ArrayLikeInt) -> None: ...
    @property
    def joint_types(self) -> SpanConstArticulatedJointType:
        """Type of each joint. Size must be numLinks + numCycles.

        See Also:
            :class:`~superdex.physics.ArticulatedJointType`
        """
    @joint_types.setter
    def joint_types(self, value: ArrayLikeArticulatedJointType) -> None: ...
    @property
    def cycles(self) -> SpanConstArticulatedCycleJoint:
        """Cycle joints creating closed kinematic loops in the articulated body.

        Note:
            Empty if no cycles exist (i.e., the kinematic structure is purely
            tree-like).

        Note:
            Cycle entries appear at indices [numLinks, numLinks + numCycles) of the
            per-joint arrays
            (:attr:`~superdex.physics.ArticulatedShapeInfo.joint_types`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_axes`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_from_child_link`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.parent_link_from_joint`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_min_limits`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_max_limits`,
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_names`).

        See Also:
            :class:`~superdex.physics.ArticulatedCycleJoint`
        """
    @cycles.setter
    def cycles(self, value: ArrayLikeArticulatedCycleJoint) -> None: ...
    @property
    def joint_axes(self) -> SpanConstReal3:
        """Axis of each joint in the joint's local frame. Size must be numLinks +
        numCycles.
        """
    @joint_axes.setter
    def joint_axes(self, value: ArrayLikeReal3) -> None: ...
    @property
    def dof_info(self) -> SpanConstArticulatedDofInfo:
        """DoF information of each joint (offset within the full pose, number of
        translation DoFs, number of rotation DoFs). Size must be numLinks + numCycles.
        """
    @dof_info.setter
    def dof_info(self, value: ArrayLikeArticulatedDofInfo) -> None: ...
    @property
    def joint_from_child_link(self) -> SpanConstTransformRT:
        """Transform from each joint's child link to the joint frame (rotation +
        translation). Size must be numLinks + numCycles.

        This is the transform from the child link to the joint.
        :attr:`~superdex.physics.ArticulatedLinkParams.parent_joint_from_link` for tree
        joints and
        :attr:`~superdex.physics.ArticulatedCycleJointParams.joint_from_child_link` for
        cycle joints. The joint axis
        (:attr:`~superdex.physics.ArticulatedShapeInfo.joint_axes`) and joint motion are
        interpreted in this joint frame.
        """
    @joint_from_child_link.setter
    def joint_from_child_link(self, value: ArrayLikeTransformRT) -> None: ...
    @property
    def parent_link_from_joint(self) -> SpanConstTransformRT:
        """Joint frame of each joint expressed in its parent link's local frame
        (rotation +
        translation). Size must be numLinks + numCycles.

        This is the transform from the joint to the parent link, corresponding to
        :attr:`~superdex.physics.ArticulatedJointParams.parent_link_from_joint`.
        """
    @parent_link_from_joint.setter
    def parent_link_from_joint(self, value: ArrayLikeTransformRT) -> None: ...
    @property
    def joint_min_limits(self) -> SpanConstReal3:
        """Minimum joint limits for each joint DoF. Size must be numLinks + numCycles,
        or
        empty if no joint has limits.

        Limits are defined for either all joints or none. Joints without minimum limits
        are indicated by
        :attr:`~superdex.physics.ArticulatedShapeInfo.joint_min_limits`\\[i] =
        -mochi::kInf3. For 1D joints, limits are the scalar minimum limits multiplied by
        the joint axis. For 3D joints, each component defines the limit along one of the
        axes of the joint.

        Note:
            The definition of joint limits for spherical joints may be complex, and it
            may be easier to model them as 3 co-located revolute joints.

        Note:
            Size of :attr:`~superdex.physics.ArticulatedShapeInfo.joint_min_limits` and
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_max_limits` must be the
            same.
        """
    @joint_min_limits.setter
    def joint_min_limits(self, value: ArrayLikeReal3) -> None: ...
    @property
    def joint_max_limits(self) -> SpanConstReal3:
        """Maximum joint limits for each joint DoF. Size must be numLinks + numCycles,
        or
        empty if no joint has limits.

        Limits are defined for either all joints or none. Joints without maximum limits
        are indicated by
        :attr:`~superdex.physics.ArticulatedShapeInfo.joint_max_limits`\\[i] =
        mochi::kInf3. For 1D joints, limits are the scalar maximum limits multiplied by
        the joint axis. For 3D joints, each component defines the limit along one of the
        axes of the joint.

        Note:
            The definition of joint limits for spherical joints may be complex, and it
            may be easier to model them as 3 co-located revolute joints.

        Note:
            Size of :attr:`~superdex.physics.ArticulatedShapeInfo.joint_min_limits` and
            :attr:`~superdex.physics.ArticulatedShapeInfo.joint_max_limits` must be the
            same.
        """
    @joint_max_limits.setter
    def joint_max_limits(self, value: ArrayLikeReal3) -> None: ...
    @property
    def joint_names(self) -> SpanConstString:
        """Name of each joint. Size must be numLinks + numCycles."""
    @joint_names.setter
    def joint_names(self, value: ArrayLikeString) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        root_from_links_at_rest: ArrayLikeTransformRT = ...,
        link_names: ArrayLikeString = ...,
        parents: ArrayLikeInt = ...,
        joint_types: ArrayLikeArticulatedJointType = ...,
        cycles: ArrayLikeArticulatedCycleJoint = ...,
        joint_axes: ArrayLikeReal3 = ...,
        dof_info: ArrayLikeArticulatedDofInfo = ...,
        joint_from_child_link: ArrayLikeTransformRT = ...,
        parent_link_from_joint: ArrayLikeTransformRT = ...,
        joint_min_limits: ArrayLikeReal3 = ...,
        joint_max_limits: ArrayLikeReal3 = ...,
        joint_names: ArrayLikeString = ...,
    ) -> None: ...

