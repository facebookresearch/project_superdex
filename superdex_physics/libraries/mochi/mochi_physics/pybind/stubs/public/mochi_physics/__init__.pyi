class JointRotationRangeConstraintParams(ConstraintParams):
    """Parameters for creating a joint rotation range constraint between two rigid
    actors.

    Constrains the relative rotation between two rigid actors to remain within
    specified bounds. The relative rotation is expressed in a joint reference frame
    (captured at constraint creation time and rigidly attached to actor A
    thereafter), and each component of its rotation-vector (axis-angle)
    representation is independently constrained to its [min, max] range.

    See Also:
        :meth:`~superdex.physics.Scene.create_joint_rotation_range_constraint`,
        :class:`JOINT_ROTATION_RANGE <superdex.physics.ConstraintType>`
    """
    @property
    def ref_frame_rot_vec(self) -> Real3:
        """Joint reference frame specified as a rotation vector [rad] with respect to
        world
        frame.
        """
    @ref_frame_rot_vec.setter
    def ref_frame_rot_vec(self, value: Real3Like) -> None: ...
    @property
    def angle_range_x(self) -> Real2:
        """Allowed range [min, max] [rad] for the X component of the relative rotation
        vector (axis-angle), expressed in the joint reference frame.
        """
    @angle_range_x.setter
    def angle_range_x(self, value: Real2Like) -> None: ...
    @property
    def angle_range_y(self) -> Real2:
        """Allowed range [min, max] [rad] for the Y component of the relative rotation
        vector (axis-angle), expressed in the joint reference frame.
        """
    @angle_range_y.setter
    def angle_range_y(self, value: Real2Like) -> None: ...
    @property
    def angle_range_z(self) -> Real2:
