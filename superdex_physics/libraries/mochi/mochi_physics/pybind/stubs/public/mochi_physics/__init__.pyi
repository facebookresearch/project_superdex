    Note:
        Must be greater than zero.
    """
    @property
    def shape_target_tensor(self) -> Real6:
        """Shape target tensor (6 values).

        Defines the shape target tensor as a symmetric 3x3 matrix added to the identity:
        S_t = I + [[s0, s1, s2], [s1, s3, s4], [s2, s4, s5]]. The shape target tensor
        specifies the desired local shape of the object. The model then resists
        deformation from this target shape while allowing rigid rotation.
        """
