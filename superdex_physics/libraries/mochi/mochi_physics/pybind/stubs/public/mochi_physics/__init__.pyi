    def __init__(
        self,
        solver_type: NonLinearSolverType | int = ...,
        d_residual_assembly_period: int = ...,
        max_iter: int = ...,
        max_elapsed_time_seconds: float = ...,
        convergence_mode: NonLinearSolverConvergenceMode | int = ...,
        abs_tol: float = ...,
        rel_tol: float = ...,
        rel_step_tol: float = ...,
        stop_if_no_improvement: bool = ...,
        psd_proj_mode: PsdProjectionMode | int = ...,
