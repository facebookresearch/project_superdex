class GridSdfParams:
    """Parameters controlling the resolution of grid-based Signed Distance Fields
    (SDF).

    A GridSdf represents the SDF to a closed surface mesh as a 3D grid where each
    vertex stores the signed distance to the surface mesh. The SDF grid resolution
    and bounds are controlled by these parameters.
    """
    resolution_mode: GridSdfResolutionMode
    """Defines the mesh feature used as reference measurement for computing the voxel
    size.

    See Also:
        :attr:`~superdex.physics.GridSdfParams.resolution_delta`
    """
    @property
    def resolution_delta(self) -> Real3:
        """The maximum voxel size will be
        :attr:`~superdex.physics.GridSdfParams.resolution_delta` times the reference
        measurement computed using
        :attr:`~superdex.physics.GridSdfParams.resolution_mode`.

        Note:
            The actual voxel size may be smaller because the number of grid cells will
            be rounded up to an integer value and clamped to a minimum of
            :attr:`~superdex.physics.GridSdfParams.min_grid_resolution`.

        Note:
            Increasing :attr:`~superdex.physics.GridSdfParams.resolution_delta` will
            result in larger voxels. Doing so will make it harder for the SDF to resolve
            fine details of the mesh, but it will save memory and improve SDF generation
            speed.

        Note:
            Decreasing :attr:`~superdex.physics.GridSdfParams.resolution_delta` will
            improve the SDF's ability to resolve fine details, but it will take more
            memory and more time to generate. This cost scales proportional to N^3. Use
            with care.

        See Also:
            :attr:`~superdex.physics.GridSdfParams.resolution_mode`
        """
    @resolution_delta.setter
    def resolution_delta(self, value: Real3Like) -> None: ...
    boundary_padding_dist: float
    """Additional distance (in meters) to expand the mesh's axis-aligned bounding box
    (AABB) when determining the SDF grid bounds.

    The SDF grid will cover the mesh's AABB expanded by this distance in all
    directions. This ensures the SDF has valid distance values even slightly outside
    the mesh's AABB.

    Note:
        In practice, this value should be greater than the value returned by
        :meth:`~superdex.physics.ContactParams.get_penalty_threshold_dist`. If the
        SDF did not have enough padding, then Mochi would have to use a less
        efficient algorithm for collision detection, but it would still work.

    Note:
        When you load a model and bake a uniform scale value less than 1.0, the
        model's pre-computed SDF will also be scaled, resulting in less absolute
        padding. The default padding value is larger than the default contact
        penalty threshold distance for this reason.

    See Also:
        :const:`~superdex.physics.GRID_SDF_DEFAULT_BOUNDARY_PADDING`
    """
    @property
    def min_grid_resolution(self) -> Int3:
        """The minimum grid resolution measured in number of voxels per axis.

        Note:
            This may override the voxel count (and voxel size) computed using
            :attr:`~superdex.physics.GridSdfParams.resolution_mode` and
            :attr:`~superdex.physics.GridSdfParams.resolution_delta`.
        """
    @min_grid_resolution.setter
    def min_grid_resolution(self, value: Int3Like) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        resolution_mode: GridSdfResolutionMode | int = ...,
        resolution_delta: Real3Like = ...,
        boundary_padding_dist: float = ...,
        min_grid_resolution: Int3Like = ...,
    ) -> None: ...

