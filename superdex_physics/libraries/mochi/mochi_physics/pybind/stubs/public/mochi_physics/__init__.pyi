    def register_query(self, type: QueryType | int) -> QueryHandle:
        """Register a query to compute data for this actor.

        Args:
            type (QueryType | int): Type of query to register.

        Returns:
            :class:`~superdex.physics.QueryHandle` for the registered query, or an
            invalid handle if registration fails.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Queries may add substantial computational overhead. Use only when necessary.

        Note:
            Data is available after the next simulation step, even if its time step is
            zero.

        Note:
            Call :meth:`~superdex.physics.Actor.cancel_query` when the query is not
            needed again in the future.

        Note:
            Queries are reference counted internally, so they will be available as long
            as there is one outstanding :class:`~superdex.physics.QueryHandle`.

        Note:
            Registration is all-or-nothing: if registration fails, no query is
            registered.

        See Also:
            :meth:`~superdex.physics.Actor.cancel_query`,
            :meth:`~superdex.physics.Actor.register_query_and_compute`,
            :meth:`~superdex.physics.Actor.is_query_supported`,
            :meth:`~superdex.physics.Constraint.register_query`
        """
    def register_query_and_compute(self, type: QueryType | int) -> QueryHandle:
        """Register a query for this actor and compute the result immediately.

        Args:
            type (QueryType | int): Type of query to register.

        Returns:
            :class:`~superdex.physics.QueryHandle` for the registered query.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.

        Note:
            Same as :meth:`~superdex.physics.Actor.register_query`, except that the data
            is computed immediately (blocking) rather than at the next simulation step.

        Note:
            Immediate computation is not supported for all query types. For unsupported
            types, the query is still registered successfully, immediate computation is
            skipped, and data becomes available after the next simulation step. See
            :class:`~superdex.physics.QueryType` documentation for which types support
            immediate computation.

        Note:
            Stepping the scene with zero time step is another way to force queries to
            update, without advancing the state of the simulation.

        See Also:
            :meth:`~superdex.physics.Actor.register_query`,
            :meth:`~superdex.physics.Actor.cancel_query`
        """
    def cancel_query(self, handle: QueryHandle) -> None:
        """Cancel a previously registered query.

        Args:
            handle (QueryHandle): :class:`~superdex.physics.QueryHandle` from
                :meth:`~superdex.physics.Actor.register_query` or
                :meth:`~superdex.physics.Actor.register_query_and_compute`.

        Note:
            Cancelling an invalid or already-cancelled handle has no effect.

        Note:
            Cancelling queries may improve memory usage and/or performance if the query
            is no longer needed.

        See Also:
            :meth:`~superdex.physics.Actor.register_query`,
            :meth:`~superdex.physics.Actor.register_query_and_compute`
        """
    def is_query_supported(self, type: QueryType | int) -> bool:
        """Check whether a query type is supported for this actor.

        Args:
            type (QueryType | int): Type of query to check.

        Returns:
            True if :meth:`~superdex.physics.Actor.register_query` would succeed for
            this query type, false otherwise.

        See Also:
            :meth:`~superdex.physics.Actor.register_query`
        """
