class ExperimentalEvalParams:
    """[Experimental] Evaluation settings common to the full scene.

    They tune the evaluation of internal models (contact, constraints, etc).

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    explicit_normals: bool
    """Use explicit normals (from stage-start kinematics) for the evaluation of
    friction.

    Whether to treat the colliding and collider normals explicitly (using
    stage-start kinematics) or implicitly (using current kinematics) for the
    evaluation of alignment and the friction plane.

    Note:
        The SDF gradient for the normal collision force is always implicit.

    Note:
        explicitNormals = true and implicitNormalForceForDissipation = false
        produces contact residuals that are the exact gradients of the contact
        merit. This improves convergence guarantees of the Newton solve, but may be
        less stable due to the explicit treatment.

    Note:
        A differentiable scene requires explicitNormals = true.
    """
    fade_friction: bool
    """Fade friction coefficient based on normal alignment.

    When enabled, friction is scaled by (maxAlignmentNormals - alignment) /
    (maxAlignmentNormals + 1), where "alignment" is defined as the dot product
    between colliding and collider normals.

    Note:
        For co-dimensional colliding actors with ambiguous normals, friction fading
        is disabled regardless of fadeFriction (normal alignment cannot be
        computed).

    Note:
        fadeFriction = true adds a non-integrable term to the residual unless
        :attr:`~superdex.physics.ExperimentalEvalParams.explicit_normals` = true.

    See Also:
        :attr:`~superdex.physics.ContactParams.max_alignment_normals`
    """
    implicit_normal_force_for_dissipation: bool
    """Treat the normal contact force implicitly (if true) or explicitly (if false) for
    dissipative contact terms.

    Note:
        Implicit treatment improves stability (especially with high-order time
        integrators) but the resulting dissipative force is not integrable, hence it
        cannot be derived from an objective function. This (a) may hurt convergence
        with an objective-based line search, and (b) makes the force dresidual
        non-symmetric (a symmetric approximation is used). With
        implicitNormalForceForDissipation = false, the distance used for the
        explicit normal force is approximate when
        :attr:`~superdex.physics.ExperimentalEvalParams.explicit_normals` is false,
        but accurate when it is true.

    Note:
        Dissipative contact terms include Coulomb friction, viscous friction, and
        normal viscous damping. Using an implicit normal force for normal damping
        can improve the accuracy of the effective coefficient of restitution at a
        given time step size.
    """
    fitted_saturation_hessian: SaturationHessianParams
    """Controls whether force-saturation terms use a fitted quadratic Hessian (more
    stable) or the exact analytical Hessian (faster convergence but less stable),
    independently for each saturation pathway.

    Note:
        For any flag set to false, the solver will try first with the true Hessian.
        If it fails, it will retry with the fitted Hessian.
    """
    friction_model: CoulombFrictionModel
    """Selects which Coulomb friction smoothing model to use.

    C1Regularized (default) preserves existing behavior exactly. CinfRegularized is
    an additional model that can be selected at runtime without affecting
    C1Regularized users.
    """
    consistency_res_norm: bool
    """Validate that the residual is the gradient of the objective by a directional
    finite-difference consistency check.

    Note:
        This operation is expensive and should only be used for debugging.
    """
    consistency_res_norm_step: float
    """Step size for finite-difference consistency check."""
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        explicit_normals: bool = ...,
        fade_friction: bool = ...,
        implicit_normal_force_for_dissipation: bool = ...,
        fitted_saturation_hessian: SaturationHessianParams = ...,
        friction_model: CoulombFrictionModel | int = ...,
        consistency_res_norm: bool = ...,
        consistency_res_norm_step: float = ...,
    ) -> None: ...

class NonLinearSolverParams:
    """Parameters for non-linear implicit solves."""
    solver_type: NonLinearSolverType
    """Non-linear solver type."""
    d_residual_assembly_period: int
    """Every how many non-linear iterations to assemble the dresidual matrix.

    Note:
        For Newton's method, set to >1 to reuse the dresidual across iterations.

    Note:
        For quasi-Newton methods (e.g., BFGS, SR1), it must be >1 and indicates
        every how many iterations to restart the algorithm with the actual
        dresidual.
    """
    max_iter: int
    """Maximum number of non-linear iterations."""
    max_elapsed_time_seconds: float
    """Maximum elapsed time [s].

    Note:
        The solve terminates if the elapsed time exceeds this threshold.

    Note:
        0 means no time limit.
    """
    convergence_mode: NonLinearSolverConvergenceMode
    """Convergence monitoring mode.

    Note:
        Applies to :attr:`~superdex.physics.NonLinearSolverParams.abs_tol` and
        :attr:`~superdex.physics.NonLinearSolverParams.rel_tol`.
    """
    abs_tol: float
    """Absolute residual norm tolerance for convergence."""
    rel_tol: float
    """Relative residual norm tolerance for convergence, relative to the initial
    residual.
    """
    rel_step_tol: float
    """Relative tolerance on the L2 norm of the raw linear-solve increment before line
    search scaling.

    Note:
        The solve terminates with :class:`STOPPED
        <superdex.physics.ConvergenceStatus>` status if ``|dx|/|x|`` is below this
        threshold (i.e., the step norm is below this fraction of the current
        solution norm).

    Note:
        0 disables this criterion.

    Note:
        Default is :const:`~superdex.physics.DEFAULT_REL_STEP_TOL`.
    """
    stop_if_no_improvement: bool
    """Stop the solve if the line search figure of merit does not improve from the
    previous iteration.
