        """
    @center_of_mass.setter
    def center_of_mass(self, value: Optional[Real3Like]) -> None: ...
    @property
    def moment_of_inertia(self) -> Optional[Real6]:
        """Moment of inertia tensor [kg·m²] at the center of mass in the actor's local
        frame.

        Stored as [ixx, ixy, ixz, iyy, iyz, izz] using negative tensor notation:

        ::

                 [ixx, ixy, ixz]   [ +∫(y²+z²)dm,  -∫(xy)dm,    -∫(xz)dm    ]
             I = [ixy, iyy, iyz] = [ -∫(xy)dm,     +∫(x²+z²)dm, -∫(yz)dm    ]
                 [ixz, iyz, izz]   [ -∫(xz)dm,     -∫(yz)dm,    +∫(x²+y²)dm ]

        Note:
            Uses negative tensor notation consistent with e.g. robotics URDF files.

        Note:
            Many CAD tools (e.g., Solidworks) use positive tensor notation requiring
            negation of off-diagonal terms. See
            https://www.mathworks.com/help/sm/ug/specify-custom-inertia.html.

        Note:
            Must be finite. A finite but physically invalid tensor (negative principal
            moments or one violating the triangle inequality) is accepted with a
            warning, not rejected.

        Note:
            If not set, computed automatically from geometry and density.

        Note:
            Usually combined with explicit centerOfMass.

        See Also:
            :attr:`~superdex.physics.ArticulatedLinkParams.center_of_mass`
        """
    @moment_of_inertia.setter
    def moment_of_inertia(self, value: Optional[Real6Like]) -> None: ...
    boundary_element_type: ActorBoundaryElementType
    """Finite element type for boundary discretization.

    Note:
        Affects accuracy and performance of contact and boundary integrals.
    """
    boundary_subsampling: Optional[BoundarySubsamplingParams]
    """Optional subsampling for boundary integrals such as contact.

    Note:
        Reduces computational cost by using fewer sample points.

    Note:
        For best performance, combine subsampling with
        :attr:`~superdex.physics.ArticulatedLinkParams.boundary_element_type` =
        :class:`P1Q1 <superdex.physics.ActorBoundaryElementType>`.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        name: str = ...,
        parent_link: int = ...,
        parent_joint_from_link: TransformRT = ...,
        shape: ShapeHandle = ...,
        layer: str = ...,
        collider_type: ColliderType | int = ...,
        contact: ContactParams = ...,
        has_gravity: bool = ...,
        density: Optional[float] = ...,
        mass: Optional[float] = ...,
        center_of_mass: Optional[Real3Like] = ...,
        moment_of_inertia: Optional[Real6Like] = ...,
        boundary_element_type: ActorBoundaryElementType | int = ...,
        boundary_subsampling: Optional[BoundarySubsamplingParams] = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class ArticulatedSkinParams:
    """Optional skinned mesh attached to an articulated actor for collision and
    rendering.

    The skin is a triangle mesh deformed by the underlying articulated links. It
    acts as a colliding actor (its contact sample points are tested against other
    actors' collider geometry) but not as a collider actor (other actors' contact
    sample points are not tested against it).

    See Also:
        :attr:`~superdex.physics.ArticulatedActorParams.skin`
    """
    shape: ShapeHandle
    """Shape handle defining the skinned triangle mesh.

    Note:
        A shape can be shared by multiple actors, even actors in different scenes.

    See Also:
        :class:`~superdex.physics.ShapeHandle`,
        :func:`~superdex.physics.load_shape_from_file`
    """
