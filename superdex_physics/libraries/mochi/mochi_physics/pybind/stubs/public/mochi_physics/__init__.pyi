class ArticulatedActorParams:
    """Parameters to create an articulated actor.

    Articulated actors are composed of rigid links connected by joints, forming a
    kinematic tree with optional cycle joints. Per-link properties are supplied via
    :attr:`links`, per-joint properties via :attr:`joints`, and cycle-closing joints
    via :attr:`cycles`. An optional skinned surface mesh can be attached via
    :attr:`skin`.

    Contact is automatically disabled between links that are: (a) directly adjacent,
    (b) reachable via hard joints, or (c) reachable via (dummy) shapeless links. To
    enable or disable contact for specific pairs of links, see
    :meth:`~superdex.physics.Scene.enable_actor_contact_symmetric`.

    See Also:
        :meth:`~superdex.physics.Scene.create_articulated_actor`
    """
    name: str
    """Name of the articulated actor.

    Note:
        Uniqueness of names is not enforced.

    Note:
        Link actor names have the form "articulatedActorName/linkLocalName", where
        `linkLocalName` is the link's local name. If the articulated actor name is
        empty, link actors use "unnamed_articulation" as the parent name.
    """
    world_from_root: TransformRT
    """Initial rotation and translation of the articulated actor's local frame with
    respect to world frame.
    """
    @property
    def cycles(self) -> DynamicArrayArticulatedCycleJointParams:
        """Optional cycle joints creating closed kinematic loops. Empty if no cycles
        exist.
        """
    @cycles.setter
    def cycles(self, value: ArrayLikeArticulatedCycleJointParams) -> None: ...
    @property
    def joints(self) -> DynamicArrayArticulatedJointParams:
        """Joint parameters (one per joint).

        Note:
            Size must match :attr:`~superdex.physics.ArticulatedActorParams.links`.
        """
    @joints.setter
    def joints(self, value: ArrayLikeArticulatedJointParams) -> None: ...
    @property
    def links(self) -> DynamicArrayArticulatedLinkParams:
        """Link actor parameters (one per link). Must contain at least one link.

        Note:
            Size must match :attr:`~superdex.physics.ArticulatedActorParams.joints`.

        Note:
            Links must be listed in parent-first order: the root link is at index 0 with
            `parentLink == -1`, and any other link's `parentLink` must be smaller than
            its own index.
        """
    @links.setter
    def links(self, value: ArrayLikeArticulatedLinkParams) -> None: ...
    skin: Optional[ArticulatedSkinParams]
    """Optional skinned mesh parameters."""
    @property
    def joint_velocities(self) -> Optional[DynamicArrayReal]:
        """Optional initial joint velocity per DoF [m/s or rad/s].

        See Also:
            :meth:`~superdex.physics.Actor.get_articulated_joint_velocities`,
            :meth:`~superdex.physics.Actor.set_articulated_joint_velocities`
        """
    @joint_velocities.setter
    def joint_velocities(self, value: Optional[ArrayLikeReal]) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        name: str = ...,
        world_from_root: TransformRT = ...,
        cycles: ArrayLikeArticulatedCycleJointParams = ...,
        joints: ArrayLikeArticulatedJointParams = ...,
        links: ArrayLikeArticulatedLinkParams = ...,
        skin: Optional[ArticulatedSkinParams] = ...,
        joint_velocities: Optional[ArrayLikeReal] = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class SoftSkinnedActorParams:
    """Parameters to create soft-skinned actors with a shared articulated skeleton.

    Soft-skinned actors combine deformable soft bodies with an articulated skeleton,
    allowing realistic tissue simulation that follows skeletal motion.

    See Also:
        :meth:`~superdex.physics.Scene.create_soft_skinned_actor`
    """
    skeleton_params: ArticulatedActorParams
    """Parameters for the articulated skeleton.

    Note:
        If a skin shape is provided, the skin mesh acts as the colliding surface,
        not the individual soft actor surfaces. The skin shape must include blending
        data to define how the skinned surfaces of the soft actors are blended with
        the overarching skin. Each soft actor must be linked to its corresponding
        blending data via its effective nested soft local name after default-name
        assignment.

    See Also:
        :class:`~superdex.physics.ArticulatedActorParams`,
        :class:`~superdex.physics.ArticulatedSkinParams`
    """
    @property
    def soft_params(self) -> DynamicArraySoftActorParams:
        """Parameters for the soft deformable actors.

        Note:
            If a skin shape is provided, the skin mesh acts as the colliding surface,
            not the individual soft actor surfaces.

        Note:
            If a skin shape is provided, dynamic hyper-reduction is not allowed on the
            soft actors.

        Note:
            If a :class:`~superdex.physics.SoftActorParams` entry has its hasInertia set
            to true, inertia is applied in the unposed configuration of that actor
            (prior to skinning) and this struct's hasInertia must be false.

        Note:
            If a :class:`~superdex.physics.SoftActorParams` entry has its hasStress set
            to true, elasticity is applied in the unposed configuration of that actor
            (prior to skinning) and this struct's hasStress must be false.

        Note:
            Each :class:`~superdex.physics.SoftActorParams` entry must have its
            hasGravity set to false (use this struct's hasGravity instead).

        Note:
            Each soft actor must have some DoFs constrained. This can be implemented (a)
            by constraining nodes in the :class:`~superdex.physics.SoftActorParams`
            shape for FOM actors, or (b) by constraining the ROM subspace for ROM
            actors.

        Note:
            Each soft actor must have at least one energy term enabled: either this
            struct's :attr:`~superdex.physics.SoftSkinnedActorParams.has_gravity`,
            :attr:`~superdex.physics.SoftSkinnedActorParams.has_inertia` or
            :attr:`~superdex.physics.SoftSkinnedActorParams.has_stress` (applied to
            every entry), or that entry's own
            :attr:`~superdex.physics.SoftActorParams.has_inertia` or
            :attr:`~superdex.physics.SoftActorParams.has_stress`.

        Note:
            Each entry's :attr:`~superdex.physics.SoftActorParams.name` is a nested soft
            local name. Explicit non-empty names must be unique across skeleton link
            local names and other nested soft local names, and must not contain forward
            slash, backslash, or embedded NUL characters.

        Note:
            Empty names are assigned deterministically after reserving all skeleton link
            names and all explicit nested soft names: an empty entry at index `i` uses
            `soft_i` if available; otherwise it uses the first available `soft_N` found
            by scanning upward from `N = 0`.

        Note:
            Each entry's :attr:`~superdex.physics.SoftActorParams.world_from_local` must
            be identity. Each soft actor's shape must be defined directly in the
            reference frame of the articulated actor. The soft-skinned actor's placement
            in scene world is provided by
            :attr:`~superdex.physics.ArticulatedActorParams.world_from_root` from
            :attr:`~superdex.physics.SoftSkinnedActorParams.skeleton_params`.

        See Also:
            :attr:`~superdex.physics.SoftSkinnedActorParams.has_gravity`,
            :attr:`~superdex.physics.SoftSkinnedActorParams.has_inertia`,
            :attr:`~superdex.physics.SoftSkinnedActorParams.has_stress`
        """
    @soft_params.setter
    def soft_params(self, value: ArrayLikeSoftActorParams) -> None: ...
    @property
    def soft_attach_links(self) -> DynamicArrayString:
        """Optional local names of the rigid links where soft actors are attached.

        Note:
            If empty, soft actor shapes must include skinning data.

        Note:
            If provided, must be 1-to-1 with
            :attr:`~superdex.physics.SoftSkinnedActorParams.soft_params`. Each entry
            must be non-empty and must match a skeleton link local name.

        Note:
            Contact is automatically disabled between soft actors and their attachment
            links.
        """
    @soft_attach_links.setter
    def soft_attach_links(self, value: ArrayLikeString) -> None: ...
    enable_colliding_links: bool
    """Enable internal skeleton links as colliding actors.

    Note:
        If false, only the soft actors or the skin mesh act as colliding actors.
    """
    has_gravity: bool
    """Enable gravity evaluation of soft actors on posed/skinned positions.

    Note:
        Each :class:`~superdex.physics.SoftActorParams` entry must have its
        hasGravity set to false.

    See Also:
        :meth:`~superdex.physics.Scene.set_gravity`
    """
    has_inertia: bool
    """Enable inertia evaluation of soft actors on posed/skinned positions.

    Note:
        If true, each :class:`~superdex.physics.SoftActorParams` entry must have its
        hasInertia set to false.

    Note:
        If true, inertia is applied in the posed (post-skinning) configuration. This
        is the physically correct behavior.

    Note:
        If false, inertia is applied in the unposed configuration for each
        :class:`~superdex.physics.SoftActorParams` entry that has its hasInertia set
        to true. This is an approximation but may improve performance.
    """
    has_stress: bool
    """Enable elasticity evaluation of soft actors on posed/skinned positions.

    Note:
        If true, each :class:`~superdex.physics.SoftActorParams` entry must have its
        hasStress set to false.

    Note:
        If true, stress forces are applied in the posed (post-skinning)
        configuration. This is the physically correct behavior.

    Note:
        If false, stress forces are applied in the unposed configuration for each
        :class:`~superdex.physics.SoftActorParams` entry that has its hasStress set
        to true. This is an approximation but may improve performance.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        skeleton_params: ArticulatedActorParams = ...,
        soft_params: ArrayLikeSoftActorParams = ...,
        soft_attach_links: ArrayLikeString = ...,
        enable_colliding_links: bool = ...,
        has_gravity: bool = ...,
        has_inertia: bool = ...,
        has_stress: bool = ...,
    ) -> None: ...

class ConstraintParams:
    """Base constraint parameters.

    All constraint types inherit from this struct and add their specific parameters.
    Constraints apply forces and torques using a spring-damper model. Without
    saturation, the stiffness contribution is proportional to displacement or
    angular deviation, and the damping contribution is proportional to the
    corresponding linear or angular velocity. Their respective coefficients are
    :attr:`stiffness` and :attr:`damping`. :attr:`saturation` limits only the
    stiffness contribution.

    Note:
        SuperDex Physics uses the International System of Units (SI) by default.
        Other units can be used, but doing so requires overwriting all dimensional
        default parameters (material, contact, constraints, solver, etc.) to ensure
        all units remain consistent.

    See Also:
        :class:`~superdex.physics.ConstraintType`
    """
    stiffness: float
    """Constraint stiffness coefficient. [N/m] for translation constraints, [N·m/rad]
    for rotation constraints. Must be non-negative and finite.
    """
    damping: float
    """Constraint damping coefficient. [N·s/m] for translation constraints, [N·m·s/rad]
    for rotation constraints. Must be non-negative and finite.
    """
    saturation: float
    """Saturation distance [m] or angle [rad]. A negative value disables saturation.
    Must be finite and non-zero.

    Note:
        When enabled, saturation smoothly limits the magnitude of the elastic
        (stiffness) contribution to
        :attr:`~superdex.physics.ConstraintParams.stiffness` *
        :attr:`~superdex.physics.ConstraintParams.saturation`. The damping
        contribution is separate and is not limited by saturation.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        stiffness: float = ...,
        damping: float = ...,
        saturation: float = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

