class LinearToleranceStrategy:
    """Strategy for adapting linear solver tolerance inside non-linear iterations."""
    CONSTANT: LinearToleranceStrategy
    """Constant relative tolerance."""
    EISENSTAT_WALKER1: LinearToleranceStrategy
    """Eisenstat-Walker strategy no. 1.

    Note:
        Should be used with :class:`RESIDUAL_L2
        <superdex.physics.LinearSolverConvergenceNorm>`. Other norms may yield
        suboptimal forcing terms.

    Note:
        Not recommended for use with quasi-Newton methods (e.g., :class:`BFGS
        <superdex.physics.NonLinearSolverType>`, :class:`SR1
        <superdex.physics.NonLinearSolverType>`).

        Reference: [Choosing the Forcing Terms in an Inexact Newton Method, Choice 1
        (Eisenstat and Walker,
        1994)](https://softlib.rice.edu/pub/CRPC-TRs/reports/CRPC-TR94463.pdf)
    """
    EISENSTAT_WALKER2: LinearToleranceStrategy
    """Eisenstat-Walker strategy no. 2.

    Note:
        Not recommended for use with quasi-Newton methods (e.g., :class:`BFGS
        <superdex.physics.NonLinearSolverType>`, :class:`SR1
        <superdex.physics.NonLinearSolverType>`).

        Reference: [Choosing the Forcing Terms in an Inexact Newton Method, Choice 2
        (Eisenstat and Walker,
        1994)](https://softlib.rice.edu/pub/CRPC-TRs/reports/CRPC-TR94463.pdf)
    """
    EISENSTAT_WALKER3: LinearToleranceStrategy
    """Custom Eisenstat-Walker strategy: eta = max(min(1/(2+k), sqrt(``|r|``)), eta_0),
    where `k` is the non-linear iteration number, ``|r|`` is the L2-norm of the
    nonlinear residual, and `eta_0` is
    :attr:`~superdex.physics.LinearSolverParams.rel_tol`.

    Note:
        Should be used with :class:`RESIDUAL_L2
        <superdex.physics.LinearSolverConvergenceNorm>`. Other norms may yield
        suboptimal forcing terms.

    Note:
        Not recommended for use with quasi-Newton methods (e.g., :class:`BFGS
        <superdex.physics.NonLinearSolverType>`, :class:`SR1
        <superdex.physics.NonLinearSolverType>`).
    """
    COUNT: LinearToleranceStrategy
    """Number of linear tolerance strategy enum values."""
    DEFAULT: LinearToleranceStrategy
    """Default linear tolerance strategy."""
    def __init__(self, value: int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class LinearSolverType:
    """Linear solver algorithm."""
    CG: LinearSolverType
    """Conjugate Gradient (CG) solver.

    Note:
        Only valid for symmetric positive-definite systems.

    Note:
        Unlike :class:`PARALLEL_CG <superdex.physics.LinearSolverType>`, only
        matrix-vector products are parallelized. CG orthogonalization and
        preconditioner solves are not.
    """
    GMRES: LinearSolverType
    """Generalized Minimal Residual (GMRES) solver."""
    CUDA_CG: LinearSolverType
    """CUDA CG solver.

    Note:
        Only valid for symmetric positive-definite systems.

    Note:
        Requires building with CUDA and a preconditioner with CUDA support.

    See Also:
        :class:`~superdex.physics.PreconditionerType`
    """
    CUDA_GMRES: LinearSolverType
    """CUDA GMRES solver.

    Note:
        Requires building with CUDA and a preconditioner with CUDA support.

    See Also:
        :class:`~superdex.physics.PreconditionerType`
    """
    AUGMENTED_CG: LinearSolverType
    """[Experimental] Augmented CG solver with Krylov subspace recycling.

    Note:
        Only valid for symmetric positive-definite systems.

    Note:
        Requires building with Eigen.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    LDLT: LinearSolverType
    """Direct solver based on the LDLt factorization without pivoting.

    Note:
        Only valid for symmetric systems.

    Note:
        May be unstable for indefinite or ill-conditioned systems.

    Note:
        Uses a dense or a sparse factorization depending on the size and sparsity of
        the system.
    """
    LU: LinearSolverType
    """Direct solver based on the dense LU factorization without pivoting.

    Note:
        May be unstable for ill-conditioned systems.

    Note:
        The cost of the factorization is O(n^3). Will be slow for large systems.

    Note:
        Consider using :class:`LDLT <superdex.physics.LinearSolverType>` if the
        system is symmetric.
    """
    ASYNC_CG: LinearSolverType
    """[Experimental] Asynchronous CG solver.

    Note:
        Only valid for symmetric positive-definite systems.

    Note:
        Async CG is a reformulation of the classical CG algorithm to compute the
        matrix-vector products in parallel to the orthogonalization and convergence
        check.

    Note:
        Equivalent to the classical CG algorithm in exact-precision arithmetic, but
        has inferior stability properties in finite-precision arithmetic.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    PARALLEL_CG: LinearSolverType
    """[Experimental] Parallel CG solver.

    Note:
        Only valid for symmetric positive-definite systems.

    Note:
        Unlike :class:`CG <superdex.physics.LinearSolverType>`, all operations
        (matrix-vector products, preconditioner solves, CG orthogonalization) are
        parallelized.

    Note:
        Requires a preconditioner with a parallel solve.

    Warning:
        Not deterministic.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    MINRES: LinearSolverType
    """Minimal Residual (MINRES) solver.

    Note:
        Only valid for symmetric systems.
    """
    EXPERIMENTAL_CUDA_SPARSE_CHOLESKY: LinearSolverType
    """[Experimental] CUDA sparse Cholesky factorization.

    Note:
        Only valid for sparse or block-sparse symmetric positive-definite systems.

    Note:
        Requires building with CUDA.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    EXPERIMENTAL_CUDA_SPARSE_LDLT: LinearSolverType
    """[Experimental] CUDA sparse LDLt factorization.

    Note:
        Only valid for sparse or block-sparse symmetric systems.

    Note:
        Requires building with CUDA and cuDSS.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    EXPERIMENTAL_CUDA_SPARSE_LU: LinearSolverType
    """[Experimental] CUDA sparse LU factorization.

    Note:
        Only valid for sparse or block-sparse systems.

    Note:
        Requires building with CUDA.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    AUTO: LinearSolverType
    """Let Mochi select the solver type based on the problem."""
    COUNT: LinearSolverType
    """Number of solver type enum values."""
    DEFAULT: LinearSolverType
    """Default solver type."""
    def __init__(self, value: int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class PreconditionerType:
    """Preconditioner types for the linear solver.

    Note:
        Only used for iterative solvers.

    Note:
        CUDA iterative solvers only support :class:`NONE
        <superdex.physics.PreconditionerType>`, :class:`JACOBI
        <superdex.physics.PreconditionerType>` and :class:`BLOCK_JACOBI
        <superdex.physics.PreconditionerType>` preconditioners.
    """
    NONE: PreconditionerType
    """No preconditioner."""
    JACOBI: PreconditionerType
    """Jacobi preconditioner.

    Note:
        Only valid for matrices with non-zero diagonal entries.
    """
    BLOCK_JACOBI: PreconditionerType
    """Block Jacobi preconditioner with block size of 3.

    Note:
        Only valid for matrices whose size is a multiple of 3 and whose 3x3 diagonal
        blocks are non-singular.
    """
    SSOR: PreconditionerType
    """Symmetric successive over-relaxation (SSOR) preconditioner.

    Note:
        Only valid for symmetric positive-definite matrices.
    """
    BLOCK_SSOR: PreconditionerType
    """Block symmetric successive over-relaxation (SSOR) preconditioner with block size
    of 3.

    Note:
        Only valid for symmetric positive-definite matrices whose size is a multiple
        of 3 and whose 3x3 diagonal blocks are non-singular.
    """
    LU: PreconditionerType
    """Dense LU factorization without pivoting.

    Note:
        May be unstable for ill-conditioned matrices.

    Note:
        The iterative solver should converge in 1 iteration.
    """
    AMG: PreconditionerType
    """Algebraic multigrid (AMG).

    Note:
        Only valid for 3x3 block sparse symmetric positive-definite matrices with
        non-singular 3x3 diagonal blocks.
    """
    SYM_INVERSE: PreconditionerType
    """Symmetric inverse preconditioner based on the dense LDLt factorization without
    pivoting.

    Note:
        Only valid for symmetric matrices.

    Note:
        May be unstable for indefinite or ill-conditioned matrices.

    Note:
        The iterative solver should converge in 1 iteration.
    """
    LDLT: PreconditionerType
    """Dense LDLt factorization without pivoting.

    Note:
        Only valid for symmetric matrices.

    Note:
        May be unstable for indefinite or ill-conditioned matrices.

    Note:
        The iterative solver should converge in 1 iteration.
    """
    ILU0: PreconditionerType
    """Incomplete LU factorization with zero fill-in."""
    IC0: PreconditionerType
    """Incomplete Cholesky factorization with zero fill-in.

    Note:
        Only valid for symmetric positive-definite matrices.
    """
    PER_ACTOR: PreconditionerType
    """Domain decomposition preconditioner, where each actor is a subdomain.

    Note:
        The most appropriate preconditioner type is used for each actor.
    """
    COLORED_SSOR: PreconditionerType
    """[Experimental] Colored symmetric successive over-relaxation (SSOR)
    preconditioner.

    Note:
        Only valid for symmetric positive-definite matrices.

    Warning:
        This is an experimental feature. It may be changed or removed in the future.
        Use at your own risk.
    """
    COUNT: PreconditionerType
    """Number of preconditioner type enum values."""
    DEFAULT: PreconditionerType
    """Default preconditioner type."""
    def __init__(self, value: int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class LinearSolverConvergenceNorm:
    """Norm types for the stopping criteria of the linear solver.

    Note:
        This setting only applies to :class:`CG
        <superdex.physics.LinearSolverType>`, :class:`CUDA_CG
        <superdex.physics.LinearSolverType>`, :class:`PARALLEL_CG
        <superdex.physics.LinearSolverType>` and :class:`ASYNC_CG
        <superdex.physics.LinearSolverType>`. :class:`GMRES
        <superdex.physics.LinearSolverType>`, :class:`CUDA_GMRES
        <superdex.physics.LinearSolverType>`, :class:`MINRES
        <superdex.physics.LinearSolverType>`, and :class:`AUGMENTED_CG
        <superdex.physics.LinearSolverType>` always use the L2-norm of the residual
        regardless of this setting. Direct solvers do not have stop criteria.
    """
    RESIDUAL_L2: LinearSolverConvergenceNorm
    """L2-norm of the residual: ``‖r‖₂``."""
    PRECONDITIONED_RESIDUAL_L2: LinearSolverConvergenceNorm
    """L2-norm of the preconditioned residual: ``‖z‖₂`` where ``z = M⁻¹r``."""
    RESIDUAL_PRECONDITIONER_INDUCED: LinearSolverConvergenceNorm
    """Preconditioner-induced norm of the residual: ``√⟨r, z⟩`` where ``z = M⁻¹r``."""
    COUNT: LinearSolverConvergenceNorm
    """Number of linear solver convergence norm enum values."""
    DEFAULT: LinearSolverConvergenceNorm
    """Default linear solver convergence norm."""
    def __init__(self, value: int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

