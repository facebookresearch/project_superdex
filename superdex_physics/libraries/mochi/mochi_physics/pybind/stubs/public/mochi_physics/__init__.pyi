def set_is_single_threaded(is_single_threaded: bool) -> None:
    """Enable or disable single-threaded mode.

    In single-threaded mode, each new task will be executed on the calling thread,
    even if other threads are available. This may hurt performance, but it is useful
    for debugging and batch simulation.

    Enabling single-threaded mode does not, however, terminate tasks that are
    already running asynchronously. Such tasks will run to completion. For example,
    if you have an ``mochi::AsyncScene``, it will continue to step asynchronously,
    but each step will do its work on that one thread.

    Args:
        is_single_threaded (bool): True to enable single-threaded mode. False to
            disable.

    Note:
        Call on any thread.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``mochi::AsyncScene``.

    See Also:
        :func:`~superdex.physics.is_single_threaded`
    """

def is_single_threaded() -> bool:
    """Return true if running in single-threaded mode.

    Returns true when the Mochi context was created with zero worker threads (see
    ``mochi::CreateContext``) or when single-threaded mode has been explicitly
    enabled via :func:`~superdex.physics.set_is_single_threaded`.

    Returns:
        True if running in single-threaded mode.

    Note:
        Call on any thread.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``mochi::CreateContext``.

    See Also:
        :func:`~superdex.physics.set_is_single_threaded`, ``mochi::CreateContext``
    """

def get_num_threads() -> int:
    """Return the number of worker threads available to execute asynchronous tasks.

    Returns:
        The configured worker-thread count (see ``mochi::CreateContext``), or zero
        if single-threaded mode is enabled (see
        :func:`~superdex.physics.set_is_single_threaded`).

    Note:
        Call on any thread.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``mochi::CreateContext``.

    See Also:
        ``mochi::CreateContext``, :func:`~superdex.physics.is_single_threaded`
    """

def enable_log_channel(channel: LogChannel | int, enable: bool) -> None:
    """Enable or disable log messages on the specified channel.

    When a channel is disabled, messages on that channel are discarded before
    reaching the logging callback (see :func:`~superdex.physics.set_log_callback`).

    Args:
        channel (LogChannel | int): The log channel to enable or disable.
        enable (bool): True to enable the channel, false to disable it.

    Note:
        By default, all channels are enabled except for :class:`VERBOSE
        <superdex.physics.LogChannel>`.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.is_log_channel_enabled`,
        :func:`~superdex.physics.set_log_callback`
    """

def is_log_channel_enabled(channel: LogChannel | int) -> bool:
    """Return true if messages on the specified log channel are enabled.

    Args:
        channel (LogChannel | int): The log channel to query.

    Returns:
        True if the channel is enabled, false otherwise.

    Note:
        Call on any thread.

    See Also:
        :func:`~superdex.physics.enable_log_channel`
    """

def set_log_callback(callback: Callable[[LogChannel, str, str, int], None]) -> None:
    """Optionally provide a callback function to redirect SuperDex Physics logging. The
    default function outputs to stdout and to the debugger (if attached).

    Args:
        callback (Callable[[LogChannel, str, str, int], None]): Function to handle
            logging, or None to restore the default logging function.

    Note:
        Call on any thread.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``mochi::Context::GetLogCallback``.

    Warning:
        Your callback function may be called on any thread.

    See Also:
        ``mochi::Context::GetLogCallback``
    """

@overload
def load_shape_from_file(file_path: str) -> ShapeHandle:
    """Load a shape from a file of supported format.

    Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off),
    PLY (.ply), and STL (.stl).

    Args:
        file_path (str): File path to load (case sensitive on some filesystems).

    Returns:
        A :class:`~superdex.physics.ShapeHandle` that can be used to create actors.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        The shape remains in memory while referenced by any handle or actor. In the
        C API, you must release the shape explicitly by calling
        :func:`~superdex.physics.release_shape`. In C++ and Python, this is
        optional, since :class:`~superdex.physics.ShapeHandle` cleanup is automatic.

    Note:
        Call on any thread.

    See Also:
        :class:`~superdex.physics.ShapeHandle`,
        :func:`~superdex.physics.release_shape`,
        :func:`~superdex.physics.load_shape_from_bytes`
    """

@overload
def load_shape_from_file(file_path: str, bake_scale: Real3Like) -> ShapeHandle:
    """Load a shape from a file of supported format, and bake in some scale.

    Supported formats: JSON (.mochi.json), HDF5 (.mochi.h5), OBJ (.obj), OFF (.off),
    PLY (.ply), and STL (.stl).

    Args:
        file_path (str): File path to load (case sensitive on some filesystems).
        bake_scale (Real3Like): Scale to bake into the shape or (1, 1, 1) for no
            change. Negative scale results in mirroring.

    Returns:
        A :class:`~superdex.physics.ShapeHandle` that can be used to create actors.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        The shape remains in memory while referenced by any handle or actor. In the
        C API, you must release the shape explicitly by calling
        :func:`~superdex.physics.release_shape`. In C++ and Python, this is
        optional, since :class:`~superdex.physics.ShapeHandle` cleanup is automatic.

    Note:
        Some shape data cannot bake arbitrary non-uniform scale. Unsupported scale
        values are rejected.

    Note:
        Precomputed grid SDF data is preserved only when ``bake_scale`` is uniform
        by absolute value. Non-uniform scale by absolute value discards the
        precomputed SDF. If an SDF collider later requires SDF data, SuperDex
        Physics regenerates it from the transformed mesh at runtime, which may be
        expensive.

    Note:
        If the loaded model has
        :attr:`~superdex.physics.ModelData.element_frame_axes`, ``bake_scale``
        transforms those axes as normal directions using the inverse-transpose of
        the scale transform, then normalize them.

    Note:
        Call on any thread.

    See Also:
        :class:`~superdex.physics.ShapeHandle`,
        :func:`~superdex.physics.release_shape`,
        :func:`~superdex.physics.load_shape_from_bytes`
    """

