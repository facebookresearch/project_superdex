########################################################################################

// @brief Template for fixed-sized N-dimensional arrays like Int2, Real3,
// Matrix3x3r, etc...
//
// @tparam T Element value type.
// @tparam DIMS Size of each dimension.
template <typename T, int... DIMS> class NdArray;

# Common 1D floating-point arrays types
using Real1 = NdArray<real, 1>;
using Real2 = NdArray<real, 2>;
using Real3 = NdArray<real, 3>;
using Real6 = NdArray<real, 6>;

# Common 1D integral array types
using Int3 = NdArray<int, 3>;

# RGBA color representation using 4 bytes (0-255 per channel) in RGBA order.
using Color = NdArray<uint8, 4>;

########################################################################################

// @brief Wraps a pointer and length. If type T is a const type, then span provides a
// read-only view into the range of elements. The span does not own the memory nor
// guarantee its lifespan.
//
// @tparam T Element value type.
template <typename T> struct Span;

// @brief A dynamically resizable array with syntax and behavior similar to
// std::pmr::vector.
//
// @tparam T Element value type.
template <typename T> struct DynamicArray;

// @brief Dynamically allocated string with polymorphic allocator support.
// Maps to std::basic_string with SuperDex's polymorphic allocator.
class DynamicString [no_reflection];

// @brief Manages an optional contained value, i.e. a value that may or may not be
// present.
//
// @tparam T Type of the value to manage initialization state for.
template <typename T> struct Optional;

########################################################################################

// @brief A 3D affine Transform (rotation & translation, but no scale).
class TransformRT [no_reflection];

// @brief Used for 3D rotations.
class Quaternion [no_reflection];

// @brief Axis-aligned bounding box in 3D space.
class Aabb [no_reflection];

// @brief Oriented bounding box in 3D space.
class Obb [no_reflection];

########################################################################################

// @brief The Error class is used to return success or failure when calling a function.
//   It is usually the last function parameter and is passed by reference. Call @ref IsOK
//   to check for success. Call @ref GetDescription to find out what went wrong.
class Error [no_python, no_reflection] {
  // @brief Returns true if the error is OK (no error).
  // @return True if the error is OK (no error).
  fn IsOK() -> bool [const];

  // @brief Returns a description of the error.
  // @return A description of the error.
  fn GetDescription() -> char const* [const];

  // @brief Returns the file where the error occurred.
  // @return The file where the error occurred.
  fn GetFile() -> char const* [const];

  // @brief Returns the line where the error occurred.
  // @return The line where the error occurred.
  fn GetLine() -> int [const];
};

########################################################################################

// @brief Generic callable wrapper, templatized by return type and argument types.
// Models @code std::function<Ret(Args...)> @endcode from C++.
//
// @tparam Ret Return type.
// @tparam Args Argument types.
template <typename Ret, typename... Args> struct Function;

// @brief Signature of an assertion failure callback.
// Returns true if execution should break at the current file and line.
using OnAssertFn = Function<bool, char const*, char const*, char const*, int>;

########################################################################################

// @brief The zero vector (0, 0, 0).
constant Real3 kReal3Zeros = {0.0, 0.0, 0.0};

// @brief The ones vector (1, 1, 1).
constant Real3 kReal3Ones = {1.0, 1.0, 1.0};

// @brief Unit vector along the X axis (1, 0, 0).
constant Real3 kReal3XAxis = {1.0, 0.0, 0.0};

// @brief Unit vector along the Y axis (0, 1, 0).
constant Real3 kReal3YAxis = {0.0, 1.0, 0.0};

// @brief Unit vector along the Z axis (0, 0, 1).
constant Real3 kReal3ZAxis = {0.0, 0.0, 1.0};

// @brief The range [-2π, 2π].
constant Real2 kMinus2PiPlus2Pi; # Fwd. declared because the C++ value is computed (-2*kPI).

// @brief The unit interval [0, 1].
constant Real2 kUnitInterval = {0.0, 1.0};

// @brief Spatial dimensionality of mesh data.
constant int kMeshDataSpaceDim = 3;

// @brief Default boundary padding distance [m] for grid-based SDF construction.
constant real kGridSdfDefaultBoundaryPadding; # Fwd. declared because the C++ value is computed.

// @brief Default material density [kg/m³].
constant real kDefaultDensity = 1000.0;

// @brief Default tolerance for the L2 norm of the non-linear solver's raw linear-solve
// increment. Avoids attempting to solve beyond the floating-point noise floor.
//
// @see NonLinearSolverParams::relStepTol
constant real kDefaultRelStepTol; # Fwd. declared because value depends on real type.

// @brief Sentinel value to automatically select the maximum number of linear solver
// iterations.
constant int kAutoLinearSolverMaxIter = -1;
