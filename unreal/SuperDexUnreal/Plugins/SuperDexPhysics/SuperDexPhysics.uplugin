	"EnabledByDefault": false,
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "SuperDexPhysics",
			"Type": "Runtime",
			"LoadingPhase": "PreDefault",
