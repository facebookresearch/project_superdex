{
  "metadata": {
    "name": "G1 feet (test)",
    "description": "g1_stand with g1_stand_stiff's 30x actuators (the statue; a base names no base), a fixed twist command, foot_contact on the 14-sphere feet and the foot, posture and body terms, recording the command, the joints and the torso's rotation"
  },
  "base": "g1_stand.superdex_lab",
  "commands": [
    {
      "name": "twist",
      "kind": "twist_command",
      "params": {
        "base": "pelvis",
        "linVelX": [
          0.5,
          0.5
        ],
        "linVelY": [
          0.0,
          0.0
        ],
        "angVelZ": [
          0.2,
          0.2
        ],
        "heading": [
          -3.141592653589793,
          3.141592653589793
        ],
        "standingShare": 0.0,
        "headingShare": 1.0,
        "headingCommand": false,
        "headingStiffness": 1.0,
        "minNorm": 0.1,
        "phasePeriodS": 0.6,
        "resamplingS": [
          100.0,
          100.0
        ]
      }
    },
    {
      "name": "feet",
      "kind": "foot_contact",
      "params": {
        "links": [
          "links:left_foot?_s?",
          "links:right_foot?_s?"
        ],
        "sites": [
          "left_foot",
          "right_foot"
        ],
        "ground": "StaticPlane",
        "base": "pelvis",
        "forceThreshold": 1.0
      }
    }
  ],
  "rewards": [
    {
      "name": "feet_gait",
      "kind": "feet_gait",
      "weight": 1.0,
      "params": {
        "command": "twist",
