/// @fn Span<real const> superdex::robotics::ControllerBasicOscPd::ComputeOutput(ControllerBasicOscPdObsv const& obsv, ControllerBasicOscPdTarget const& target, superdex::Error& error)
///
/// @brief Compute control efforts from observation state and target setpoint.
///
/// @param[in] obsv Current robot state (positions, velocities, transforms).
/// @param[in] target Target setpoint.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
