/// @struct superdex::robotics::ControllerMochiArticulatedPoseParams
///
/// @brief ControllerMochiArticulatedPose parameters.
///

/// @struct superdex::robotics::ControllerMochiArticulatedPoseObsv
///
/// @brief Observation state (empty — this controller is target-driven).
///

/// @struct superdex::robotics::ControllerMochiArticulatedPoseTarget
///
/// @brief Target to drive the ArticulatedPoseController toward. Provide exactly one of @ref superdex::robotics::ControllerMochiArticulatedPoseTarget::localToParentTransforms "bots::ControllerMochiArticulatedPoseTarget::localToParentTransforms" or @ref superdex::robotics::ControllerMochiArticulatedPoseTarget::poseDofs "bots::ControllerMochiArticulatedPoseTarget::poseDofs".
///

/// @var superdex::robotics::ControllerMochiArticulatedPoseTarget::worldFromRoot
///
/// @brief Root link pose in world frame
///

/// @var superdex::robotics::ControllerMochiArticulatedPoseTarget::localToParentTransforms
///
/// @brief Per-link LocalToParent transforms
///

/// @var superdex::robotics::ControllerMochiArticulatedPoseTarget::poseDofs
///
/// @brief Non-root joint DOFs; root DOFs are derived from worldFromRoot
///

/// @class superdex::robotics::ControllerMochiArticulatedPose
///
/// @brief ControllerMochiArticulatedPose -- drives a mochi ArticulatedPoseController via either per-link LocalToParent transforms (converted to world-space targets) or non-root pose DOFs combined with a world-space root transform.
///

/// @fn std::string_view superdex::robotics::ControllerMochiArticulatedPose::TypeName()
///
/// @brief Registration type name for this controller (see RoboticsContext::RegisterControllerType).
///
/// @return This controller's registration type name.
///

/// @fn void superdex::robotics::ControllerMochiArticulatedPose::Initialize(bool removeExisting, superdex::Error& error)
///
/// @brief Add a mochi ArticulatedPoseController to the actor using the default/current params. Mochi ArticulatedPoseController is a singleton per articulation so only one controller can be active at a time. Calling commands on multiple controllers at the same time will result in overwriting commands. Must be called after SetParams and before ComputeOutput.
///
/// @param[in] removeExisting If true, removes any existing ArticulatedPoseController on the actor before adding a new one. If false, an existing controller causes an error.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///

/// @fn ControllerMochiArticulatedPoseParams const& superdex::robotics::ControllerMochiArticulatedPose::GetParams() const
///
/// @brief Get controller parameters.
///
/// @return The params.
///

/// @fn void superdex::robotics::ControllerMochiArticulatedPose::SetParams(ControllerMochiArticulatedPoseParams const& params, superdex::Error& error)
///
/// @brief Set controller parameters.
///
/// @param[in] params Params.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
///

/// @fn Span<real const> superdex::robotics::ControllerMochiArticulatedPose::ComputeOutput(ControllerMochiArticulatedPoseObsv const& obsv, ControllerMochiArticulatedPoseTarget const& target, superdex::Error& error)
///
/// @brief Forward targets to the internal pose controller.
///
/// @param[in] obsv Unused (empty).
/// @param[in] target Target poses: either worldFromRoot + @ref superdex::robotics::ControllerMochiArticulatedPoseTarget::localToParentTransforms "bots::ControllerMochiArticulatedPoseTarget::localToParentTransforms" (link-transform path), or worldFromRoot + @ref superdex::robotics::ControllerMochiArticulatedPoseTarget::poseDofs "bots::ControllerMochiArticulatedPoseTarget::poseDofs" (pose-DOF path). Exactly one must be provided.
/// @param[in,out] error Error status. Check @ref mochi::Error::IsOK "Error::IsOK" for success.
/// @return Empty span — control is applied internally via the pose controller.
///

/// @struct superdex::robotics::ControllerBasicJscPdParams
///
/// @brief Joint-space PD controller parameters.
///

/// @var superdex::robotics::ControllerBasicJscPdParams::Kp
///
/// @brief The position gain [Nm/rad]
///

/// @var superdex::robotics::ControllerBasicJscPdParams::Kd
///
/// @brief The position damping gain [Nms/rad]
///

/// @var superdex::robotics::ControllerBasicJscPdParams::saturation
///
/// @brief The saturation magnitude of the controller output for each joint. Values < 0 are interpreted as infinitiy [N or Nm]
///

/// @var superdex::robotics::ControllerBasicJscPdParams::deadband
///
/// @brief The deadband is removed from error towards 0 (limited to 0) before multiplying by Kp. Damping is always applied regardless of the deadband. The deadband results in a force profile about the target like this \___/ rather than \/
///

/// @struct superdex::robotics::ControllerBasicJscPdObsv
///
/// @brief Observation state — robot state variables read each control step. Fill it with GetCurrentObservationsFromMochi to read the live simulation, or populate it directly from an external state source (e.g., a real robot).
///

/// @var superdex::robotics::ControllerBasicJscPdObsv::dofPositions
///
/// @brief All DOF positions [rad or m]
///

/// @var superdex::robotics::ControllerBasicJscPdObsv::dofVelocities
///
/// @brief All DOF velocities [rad/s or m/s]
///

/// @var superdex::robotics::ControllerBasicJscPdObsv::dt
///
/// @brief Time since the last ComputeOutput call [s]
///

/// @struct superdex::robotics::ControllerBasicJscPdTarget
///
/// @brief Target setpoint for the controller.
///

/// @var superdex::robotics::ControllerBasicJscPdTarget::targetPose
///
/// @brief Target joint positions [m or rad]
///

/// @struct superdex::robotics::CameraSensorParams
///
/// @brief Parameters for a camera sensor (fixed or wrist-mounted). Loaded from a .superdex_sensor JSON file via SReflect. Fields with value 0 mean "use engine default".
///

/// @var superdex::robotics::CameraSensorParams::name
///
/// @brief Camera name carried in the params, distinct from the sensor's instance name.
///

/// @var superdex::robotics::CameraSensorParams::imageWidth
///
/// @brief Rendered image width [px].
///

/// @var superdex::robotics::CameraSensorParams::imageHeight
///
/// @brief Rendered image height [px].
///

/// @var superdex::robotics::CameraSensorParams::fovVerticalDeg
///
/// @brief Vertical field of view [deg].
///

/// @var superdex::robotics::CameraSensorParams::nearClip
///
/// @brief Distance to the near clip plane [m].
///

/// @var superdex::robotics::CameraSensorParams::farClip
///
/// @brief Distance to the far clip plane [m].
///

/// @var superdex::robotics::CameraSensorParams::lookAt
///
/// @brief Look-at target in world space (fixed cameras only).
///

/// @var superdex::robotics::CameraSensorParams::offsetLocal
///
/// @brief Offset from EE frame origin in local coordinates (wrist cameras only).
///

/// @var superdex::robotics::CameraSensorParams::forwardAxis
///
/// @brief Forward direction in EE-local frame (wrist cameras only).
///

/// @var superdex::robotics::CameraSensorParams::upAxisLocal
///
/// @brief Up direction in EE-local frame (wrist cameras only).
///

/// @var superdex::robotics::CameraSensorParams::lookDistance
///
/// @brief Distance ahead of offset point to place look-at target (wrist cameras only).
///

