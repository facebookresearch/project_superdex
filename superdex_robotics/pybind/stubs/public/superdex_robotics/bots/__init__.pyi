class ControllerBasicOscPd(ControllerBase):
    """Basic operational-space PD (impedance) controller for robotic arms.

    Computes joint torques via the Jacobian transpose method: tau = J^T * F, where F
    = Kp * pose_error + Kd * velocity_error combines position/rotation tracking
    errors with PD gains. This is the minimal, robot-agnostic core of
    operational-space control:

    - No nullspace or posture bias. Redundant (extra-DOF) arms are free to drift in
      the nullspace; only the end-effector pose is regulated.
    - Per-DOF effort clamping (direction-preserving vector scaling), enabled by
      default; the per-joint effort limits are harvested from the controller's
      BotPrefab (see Initialize).
    - No joint/velocity-limit avoidance, friction/gravity compensation, or inertia
      decoupling; those belong to richer controllers (see the internal OSC
      variants).

    Intended as a clean, open-sourceable baseline that works on any articulated arm
    without robot-specific tuning tables.
    """
    @staticmethod
    def type_name() -> str:
        """Registration type name for this controller (see
        RoboticsContext::RegisterControllerType).

        Returns:
            This controller's registration type name.
        """
    def initialize(self, base_link_name: str, ee_link_name: str) -> None:
        """Two-phase initialization: resolve base and end-effector links by name. Must
        be
        called after creation and before
        :meth:`~superdex.robotics.ControllerBasicOscPd.compute_output`.

        Args:
            base_link_name (str): Name of the base link (root of control chain).
            ee_link_name (str): Name of the end-effector link.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_params(self) -> ControllerBasicOscPdParams:
        """Get controller parameters.

        Returns:
            The params.
        """
    def set_params(self, params: ControllerBasicOscPdParams) -> None:
        """Set controller parameters.

        Args:
            params (ControllerBasicOscPdParams): Params.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_controlled_dofs(self) -> mochi_physics.SpanConstInt:
        """Get the controlled DOF indices (between base and end-effector links).

        Returns:
            The controlled dofs.
        """
    def get_controlled_links(self) -> mochi_physics.SpanConstInt:
        """Get the controlled link indices (between base and end-effector links).

        Returns:
            The controlled links.
        """
    def get_ee_link_index(self) -> int:
        """Get the end-effector link index.

        Returns:
            The eelink index.
        """
    def get_current_observations_from_mochi(self) -> ControllerBasicOscPdObsv:
        """Read current robot state from the Mochi actor.

        Returns:
            Observation struct populated from the actor's current state.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def compute_output(
        self,
        obsv: ControllerBasicOscPdObsv,
        target: ControllerBasicOscPdTarget,
    ) -> mochi_physics.SpanConstReal:
        """Compute control efforts from observation state and target setpoint.

        Args:
            obsv (ControllerBasicOscPdObsv): Current robot state (positions, velocities,
                transforms).
            target (ControllerBasicOscPdTarget): Target setpoint.

        Returns:
            Efforts for all DOFs [Nm]. Uncontrolled DOFs are set to 0. Empty span on
            error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """

