def load_bot_prefab_from_file(path: str) -> BotPrefab:
    """Load bot parameters from a .superdex_bot file using the default file-based
    loader. Automatically resolves ModBotPrefab files by building the final
    :class:`~superdex.robotics.BotPrefab`.

    If path is a .superdex_bot_archive file (see ArchiveBot), the archive is
    transparently extracted and cached into a temp directory and the embedded target
    bot is loaded.

    Args:
        path (str): File path to the .superdex_bot or .superdex_bot_archive file.

    Returns:
        Loaded or built :class:`~superdex.robotics.BotPrefab`, or
        default-constructed on failure.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.
    """

def load_bot_prefab_from_urdf_file(path: str) -> BotPrefab:
    """Load bot parameters from a URDF file.

    Parses the URDF and resolves each link's visual and collision mesh references
    relative to the URDF location (ROS `package://` URIs are supported), storing the
    resolved on-disk paths in the returned prefab. Collision meshes may be any
    format the shape loader accepts (e.g. .stl, .obj, .ply, .off, .mochi.h5); when a
    collision mesh carries no baked SDF, one is generated on demand at bot creation.
    A free `world_joint` is injected at index 0.

    Args:
        path (str): Path to the .urdf file.

    Returns:
        The loaded or built :class:`~superdex.robotics.BotPrefab`.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Note:
        Only ``<mesh>`` geometry is imported. Primitive URDF shapes (``<box>``,
        ``<cylinder>``, ``<sphere>``) in ``<visual>`` / ``<collision>`` elements are
        not supported and are silently skipped; the importer uses the first
        mesh-bearing visual/collision on each link.
    """

def build_articulated_pose_from_bot_pose(
    bot_prefab: BotPrefab,
    src_pose: mochi_physics.ArrayLikeReal,
    num_actor_dofs: int,
) -> mochi_physics.DynamicArrayReal:
    """Convert a bot-space pose to an articulated-actor pose.

    Bot DOFs never include the root joint's, whether or not the articulation has
    any: a Free root contributes 6 actor DOFs that bot space excludes, and a Hard
    root contributes none. The two spaces therefore share an order and differ only
    by that leading offset, so this copies srcPose to pose[i + numBaseDofs] and
    zero-fills the base DOFs, producing the actor-DOF layout
    :meth:`~superdex.physics.Actor.set_articulated_pose_from_joints` expects. It
    never permutes.

    Args:
        bot_prefab (BotPrefab): Bot describing the articulation.
        src_pose (ArrayLikeReal): Bot-space pose (must have
            ``superdex::robotics::BotPrefab::_numDofs`` entries).
        num_actor_dofs (int): The actor's DOF count
            (:meth:`~superdex.physics.Actor.get_num_dofs`).

    Returns:
        Pose in actor-DOF layout, sized to numActorDofs.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.

    Warning:
        This documentation references the following C++ API, which is not available
        in Python: ``superdex::robotics::BotPrefab::_numDofs``.
    """

def create_bot(
    scene: mochi_physics.Scene,
    bot_prefab: BotPrefab,
    bots_context: RoboticsContext,
) -> Optional[Bot]:
    """Create a :class:`~superdex.robotics.Bot` runtime object from a
    :class:`~superdex.robotics.BotPrefab`. Builds the underlying articulated actor
    in scene and seeds its default pose. The returned
    :class:`~superdex.robotics.Bot` owns no scene resources beyond the actor —
    destroy it with :func:`~superdex.robotics.destroy_bot`. This must be in the
    scene thread (i.e. in an async callback if using async scenes.)

    Args:
        scene (Scene): Target scene in which to create the bot and its components.
        bot_prefab (BotPrefab): Bot parameters describing the articulation.
        bots_context (RoboticsContext): Bots context used for components created on
            the bot. Must outlive the returned :class:`~superdex.robotics.Bot`.

    Returns:
        Pointer to the created :class:`~superdex.robotics.Bot`.

    Raises:
        :class:`~superdex.physics.Error`: If an error occurs.
    """

def destroy_bot(scene: mochi_physics.Scene, bot: Optional[Bot]) -> None:
    """Destroy a :class:`~superdex.robotics.Bot` previously created by
    :func:`~superdex.robotics.create_bot`. Destroys the underlying articulated actor
    in its owning scene and any controllers, sensors, and actuators the bot created.
    This must be in the scene thread (i.e. in an async callback if using async
    scenes.)

    Args:
        scene (Scene): Scene to remove the bot from. Must be the same scene used to
            create the bot.
        bot (Optional[Bot]): Pointer to the bot to be destroyed.
    """

