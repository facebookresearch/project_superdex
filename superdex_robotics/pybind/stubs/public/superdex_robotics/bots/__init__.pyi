    @joint_coefficients.setter
    def joint_coefficients(self, value: mochi_physics.ArrayLikeReal) -> None: ...
    @property
    def joint_axis_disps(self) -> mochi_physics.DynamicArrayReal:
        """Displacement along the joint axis [m] for the transmission attachment point
        at
        each joint. This allows the transmission to be offset from the joint origin
        along the axis.
        """
    @joint_axis_disps.setter
    def joint_axis_disps(self, value: mochi_physics.ArrayLikeReal) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        *,
        target_displacement: float = ...,
        stiffness: float = ...,
        damping: float = ...,
        allow_compressive_force: bool = ...,
        name: str = ...,
        joint_indices: mochi_physics.ArrayLikeInt = ...,
        joint_coefficients: mochi_physics.ArrayLikeReal = ...,
        joint_axis_disps: mochi_physics.ArrayLikeReal = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

