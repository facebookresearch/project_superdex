        local_to_parent_transforms: mochi_physics.ArrayLikeTransformRT = ...,
        pose_dofs: mochi_physics.ArrayLikeReal = ...,
    ) -> None: ...

class ControllerMochiArticulatedPose(ControllerBase):
    """ControllerMochiArticulatedPose -- drives a mochi ArticulatedPoseController via
    either per-link LocalToParent transforms (converted to world-space targets) or
    non-root pose DOFs combined with a world-space root transform.
    """
    @staticmethod
    def type_name() -> str:
        """Registration type name for this controller (see
        RoboticsContext::RegisterControllerType).

        Returns:
            This controller's registration type name.
        """
    def initialize(self, remove_existing: bool) -> None:
        """Add a mochi ArticulatedPoseController to the actor using the default/current
        params. Mochi ArticulatedPoseController is a singleton per articulation so only
        one controller can be active at a time. Calling commands on multiple controllers
        at the same time will result in overwriting commands. Must be called after
        SetParams and before ComputeOutput.

        Args:
            remove_existing (bool): If true, removes any existing
                ArticulatedPoseController on the actor before adding a new one. If
                false, an existing controller causes an error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_params(self) -> ControllerMochiArticulatedPoseParams:
        """Get controller parameters.

        Returns:
            The params.
        """
    def set_params(self, params: ControllerMochiArticulatedPoseParams) -> None:
        """Set controller parameters.

        Args:
            params (ControllerMochiArticulatedPoseParams): Params.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def compute_output(
        self,
        obsv: ControllerMochiArticulatedPoseObsv,
        target: ControllerMochiArticulatedPoseTarget,
    ) -> mochi_physics.SpanConstReal:
        """Forward targets to the internal pose controller.

        Args:
            obsv (ControllerMochiArticulatedPoseObsv): Unused (empty).
            target (ControllerMochiArticulatedPoseTarget): Target poses: either
                worldFromRoot +
                :attr:`~superdex.robotics.ControllerMochiArticulatedPoseTarget.local_to_parent_transforms`
                (link-transform path), or worldFromRoot +
                :attr:`~superdex.robotics.ControllerMochiArticulatedPoseTarget.pose_dofs`
                (pose-DOF path). Exactly one must be provided.

        Returns:
            Empty span — control is applied internally via the pose controller.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """

class Bot:
    """Runtime interface to a bot instance in a :class:`~superdex.physics.Scene`.

    A :class:`~superdex.robotics.Bot` wraps a single articulated
    :class:`~superdex.physics.Actor` with the controllers, sensors, and actuators
    created for it. Bots are created via :func:`~superdex.robotics.create_bot` and
    destroyed via :func:`~superdex.robotics.destroy_bot`. The
    :class:`~superdex.robotics.RoboticsContext` owns the bot memory allocated and
    deallocated by these functions, respectively. The raw
    :class:`~superdex.robotics.Bot`\\* returned by
    :func:`~superdex.robotics.create_bot` remains valid until
    :func:`~superdex.robotics.destroy_bot` is called or the
    :class:`~superdex.robotics.RoboticsContext` is destroyed.

    Note:
        Not thread-safe -- like the underlying :class:`~superdex.physics.Scene`, a
        :class:`~superdex.robotics.Bot` must only be accessed from the thread that
        owns its scene (usually in an async callback if using async scenes.)
    """
    def get_handle(self) -> BotHandle:
        """Handle identifying this bot in its owning
        :class:`~superdex.robotics.RoboticsContext`.

        Returns:
            Handle identifying this bot.
        """
    def get_scene(self) -> Optional[mochi_physics.Scene]:
        """The :class:`~superdex.physics.Scene` in which this bot was created.

        Returns:
            Owning scene, or None if it no longer exists.
        """
    def get_name(self) -> str:
        """Bot name (forwarded from :attr:`~superdex.robotics.BotPrefab.name`).

        Returns:
            Null-terminated bot name.
        """
    def get_bot_prefab(self) -> BotPrefab:
        """The :class:`~superdex.robotics.BotPrefab` from which this bot was created.

        Returns:
            Prefab used to create this bot.
        """
    def get_articulated_actor(self) -> Optional[mochi_physics.Actor]:
        """The underlying articulated :class:`~superdex.physics.Actor` that backs this
        bot
        in the scene.

        Returns:
            Underlying articulated actor, or None if it no longer exists.
        """
    def create_controller(
        self,
        type_name: str,
        name: str = ...,
    ) -> Optional[ControllerBase]:
        """Create a controller of the given type and attach it to this bot.

        Args:
            type_name (str): Registered controller type (e.g., "BASIC_OSC_PD",
                "BASIC_JSC_PD").
            name (str): Instance name for the controller, used by
                :meth:`~superdex.robotics.Bot.find_controllers_by_name`. Names need not
                be unique.

        Returns:
            Pointer to the new controller, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_controller_handles(self) -> DynamicArrayControllerHandle:
        """Get the handles of every controller this bot owns.

        Covers controllers created through
        :meth:`~superdex.robotics.Bot.create_controller` and those created on one of
        this bot's actors with
        :meth:`~superdex.robotics.RoboticsContext.create_controller` — the owning bot is
        inferred from the actor (see
        :meth:`~superdex.robotics.RoboticsContext.get_bot_containing_actor`), so how a
        controller was created makes no difference to whether it appears here. Mirrors
        :meth:`~superdex.robotics.Bot.get_sensor_handles`: the same set the bot-scoped
        finders draw from, and the same set :func:`~superdex.robotics.destroy_bot` tears
        down. Resolve each handle with
        :meth:`~superdex.robotics.RoboticsContext.get_controller`.

        Returns:
            A snapshot of the bot's controller handles, in creation order.
        """
    def get_controller(
        self,
        controller_handle: ControllerHandle,
    ) -> Optional[ControllerBase]:
        """Resolve a controller handle to its underlying
        :class:`~superdex.robotics.ControllerBase`.

        Unlike :meth:`~superdex.robotics.RoboticsContext.get_controller`, which resolves
        any handle in the context, this checks the controller belongs to this bot first
        — so a handle from another bot, or from a standalone actor, is reported as an
        error rather than silently resolved.

        Args:
            controller_handle (ControllerHandle): Handle returned by
                :meth:`~superdex.robotics.Bot.get_controller_handles`.

        Returns:
            Pointer to the controller, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def create_sensor(
        self,
        type_name: str,
        link_name: str,
        name: str = ...,
        param_args: str = ...,
    ) -> Optional[SensorBase]:
        """Create a sensor of the given type on one of this bot's links.

        The bot-level counterpart to declaring a
        :class:`~superdex.robotics.BotSensorPrefab` in the
        :class:`~superdex.robotics.BotPrefab`, for sensors that are only known at
        runtime. The sensor joins :meth:`~superdex.robotics.Bot.get_sensor_handles` and
        is destroyed with the bot, exactly like an auto-instantiated one.

        Args:
            type_name (str): Registered sensor type (e.g. "SENSOR_CAMERA").
            link_name (str): Name of the link (from
                :attr:`~superdex.robotics.BotPrefab.links`) to attach the sensor to.
            name (str): Instance name, used by
                :meth:`~superdex.robotics.Bot.find_sensors_by_name`. Names need not be
                unique.
            param_args (str): Optional params file path or inline JSON; empty uses
                defaults.

        Returns:
            Pointer to the new sensor, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_sensor_handles(self) -> DynamicArraySensorHandle:
        """Get the handles of every sensor this bot owns.

        Covers sensors declared per link in the :class:`~superdex.robotics.BotPrefab`
        via :class:`~superdex.robotics.BotSensorPrefab` and instantiated by
        :func:`~superdex.robotics.create_bot`, those added afterwards via
        :meth:`~superdex.robotics.Bot.create_sensor`, and those created straight off one
        of this bot's actors with
        :meth:`~superdex.robotics.RoboticsContext.create_sensor` — the owning bot is
        inferred from the actor (see
        :meth:`~superdex.robotics.RoboticsContext.get_bot_containing_actor`), so how a
        sensor was created makes no difference to whether it appears here. This is the
        same set the bot-scoped finders draw from, and the same set
        :func:`~superdex.robotics.destroy_bot` tears down. Use
        :meth:`~superdex.robotics.RoboticsContext.get_sensor` on each handle to obtain
        the underlying :class:`~superdex.robotics.SensorBase` pointer.

        Returns:
            A snapshot of the bot's sensor handles in creation order: the
            :attr:`~superdex.robotics.BotPrefab.links` entries first (by link, then by
            per-link sensor index), followed by any later additions.
        """
    def get_sensor(self, sensor_handle: SensorHandle) -> Optional[SensorBase]:
        """Resolve a sensor handle to its underlying
        :class:`~superdex.robotics.SensorBase`.

        Args:
            sensor_handle (SensorHandle): Handle returned by
                :meth:`~superdex.robotics.Bot.get_sensor_handles`.

        Returns:
            Pointer to the sensor, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_sensor_link_name(self, sensor_handle: SensorHandle) -> Optional[str]:
        """Get the name of the link to which the sensor is attached.

        Args:
            sensor_handle (SensorHandle): Handle returned by
                :meth:`~superdex.robotics.Bot.get_sensor_handles`.

        Returns:
            Link name, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def create_actuator(
        self,
        type_name: str,
        link_name: str,
        name: str = ...,
        param_args: str = ...,
    ) -> Optional[ActuatorBase]:
        """Create an actuator of the given type on one of this bot's links. The actuator
        counterpart to :meth:`~superdex.robotics.Bot.create_sensor`, for actuators only
        known at runtime rather than declared as a
        :class:`~superdex.robotics.BotActuatorPrefab`. It joins
        :meth:`~superdex.robotics.Bot.get_actuator_handles` and is destroyed with the
        bot.

        Args:
            type_name (str): Registered actuator type.
            link_name (str): Name of the link (from
                :attr:`~superdex.robotics.BotPrefab.links`) to attach the actuator to.
            name (str): Instance name, used by
                :meth:`~superdex.robotics.Bot.find_actuators_by_name`. Names need not be
                unique.
            param_args (str): Optional params file path or inline JSON; empty uses
                defaults.

        Returns:
            Pointer to the new actuator, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_actuator_handles(self) -> DynamicArrayActuatorHandle:
        """Get the handles of every actuator this bot owns — its
        :class:`~superdex.robotics.BotPrefab` link
        :class:`~superdex.robotics.BotActuatorPrefab` entries, any added afterwards via
        :meth:`~superdex.robotics.Bot.create_actuator`, and any created on one of this
        bot's actors through :meth:`~superdex.robotics.RoboticsContext.create_actuator`.
        Destroyed with the bot. Mirrors
        :meth:`~superdex.robotics.Bot.get_sensor_handles` exactly, ordering included.

        Returns:
            A snapshot of the bot's actuator handles in creation order.
        """
    def get_actuator(self, actuator_handle: ActuatorHandle) -> Optional[ActuatorBase]:
        """Resolve an actuator handle to its underlying
        :class:`~superdex.robotics.ActuatorBase`.

        Args:
            actuator_handle (ActuatorHandle): Handle returned by
                :meth:`~superdex.robotics.Bot.get_actuator_handles`.

        Returns:
            Pointer to the actuator, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_actuator_link_name(self, actuator_handle: ActuatorHandle) -> Optional[str]:
        """Get the name of the link to which the actuator is attached.

        Args:
            actuator_handle (ActuatorHandle): Handle returned by
                :meth:`~superdex.robotics.Bot.get_actuator_handles`.

        Returns:
            Link name, or None on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def find_controllers_by_name(self, name: str) -> DynamicArrayControllerHandle:
        """Find controllers owned by this bot whose instance name equals name. Instance
        names are not unique.

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_controllers_by_type(self, type_name: str) -> DynamicArrayControllerHandle:
        """Find controllers owned by this bot whose registered type name equals
        typeName.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_sensors_by_name(self, name: str) -> DynamicArraySensorHandle:
        """Find sensors owned by this bot whose instance name equals name. Instance
        names
        are not unique.

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_sensors_by_type(self, type_name: str) -> DynamicArraySensorHandle:
        """Find sensors owned by this bot whose registered type name equals typeName.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_actuators_by_name(self, name: str) -> DynamicArrayActuatorHandle:
        """Find actuators owned by this bot whose instance name equals name. Instance
        names
        are not unique.

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_actuators_by_type(self, type_name: str) -> DynamicArrayActuatorHandle:
        """Find actuators owned by this bot whose registered type name equals typeName.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """

