class BotLinearTransmissionPrefab(BotTransmissionPrefab):
    """Parameters describing a single linear transmission attached to a bot.

    Mirrors mochi::experimental::LinearTransmissionParams with an added display
    :attr:`~superdex.robotics.BotTransmissionPrefab.name` field and SReflect markup
    so it can live inside :class:`~superdex.robotics.BotPrefab` and round-trip
    through the bot's JSON serialization. The three joint arrays
    (:attr:`joint_indices`, :attr:`joint_coefficients`, :attr:`joint_axis_disps`)
    must always be the same length, with one entry per joint the transmission
    traverses. The remaining fields are inherited from
    :class:`~superdex.robotics.BotTransmissionPrefab` which inherits
    mochi::experimental::DisplacementControlActuatorParams so that one
    displacement-control actuator can be configured alongside each transmission.
    """
    @property
    def joint_indices(self) -> mochi_physics.DynamicArrayInt:
        """Indices into :attr:`~superdex.robotics.BotPrefab.joints` identifying which
        joints the transmission traverses.
        """
    @joint_indices.setter
    def joint_indices(self, value: mochi_physics.ArrayLikeInt) -> None: ...
    @property
    def joint_coefficients(self) -> mochi_physics.DynamicArrayReal:
        """Transmission Jacobian entry at each joint [m / joint-DoF units for a tendon,
        dimensionless for a gearbox]. Sign encodes direction: positive if the
        transmission displacement increases with the joint DoF, negative if it
        decreases.
