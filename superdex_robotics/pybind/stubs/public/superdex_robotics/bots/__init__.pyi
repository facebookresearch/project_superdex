        self,
        value: mochi_physics.ArrayLikeTransformRT,
    ) -> None: ...
    @property
    def pose_dofs(self) -> mochi_physics.DynamicArrayReal:
        """Non-root joint DOFs; root DOFs are derived from worldFromRoot"""
    @pose_dofs.setter
