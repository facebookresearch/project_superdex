    ) -> None: ...
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        name: str = ...,
        joints: ArrayLikeBotJointPrefab = ...,
        links: ArrayLikeBotLinkPrefab = ...,
        world_from_root: mochi_physics.TransformRT = ...,
        default_pose: mochi_physics.ArrayLikeReal = ...,
        linear_transmissions: ArrayLikeBotLinearTransmissionPrefab = ...,
        spatial_tendons: ArrayLikeBotSpatialTendonPrefab = ...,
        contact_overrides: ArrayLikeBotContactOverride = ...,
        cycles: mochi_physics.ArrayLikeArticulatedCycleJointParams = ...,
    ) -> None: ...

class RoboticsContext:
    """Resource owner for bots, controllers, sensors, and actuators.

    Owns the memory for bots, controllers, sensors, and actuators created through
    it.
    """
    def create_controller(
        self,
        type_name: str,
        prefab: Optional[BotPrefab],
        robot: Optional[mochi_physics.Actor],
        name: str = ...,
    ) -> ControllerHandle:
        """Create a controller of the given type for robot. Harvests model-derived
        configuration (e.g. per-joint effort limits) from the optional borrowed prefab:
        pass None to create on a raw articulated actor with no model (the prefab must
        outlive the controller otherwise).

        robot may also be None, to drive a real robot with observations pushed in from
        outside instead of read off a Mochi articulation. Anything that needs the
        articulation (e.g. reading a Jacobian) then has to be supplied externally, and
        the controller reports an error if asked for it. A controller that cannot work
        at all without a simulation rejects the None actor itself — see
        :class:`~superdex.robotics.ControllerMochiArticulatedPose`, which drives Mochi's
        built-in implicit PD controller.

        The owning bot is inferred from robot (see
        :meth:`~superdex.robotics.RoboticsContext.get_bot_containing_actor`): if that
        actor is a bot's articulation or one of its link actors, the controller is
        recorded against that bot, found by the bot-scoped finders, and destroyed with
        it; otherwise it has no owning bot.
        :meth:`~superdex.robotics.Bot.create_controller` is the more direct way to
        create one on a bot you already hold, and also carries an instance name.

        Args:
            type_name (str): Registered controller type name.
            prefab (Optional[BotPrefab]): Optional borrowed robot-model description; may
                be None and must outlive the created controller.
            robot (Optional[Actor]): Articulated actor to control, or None for
                externally supplied observations.
            name (str): Instance name used by the name-based finders; need not be
                unique.

        Returns:
            Handle to the created controller, or an invalid handle on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_controller(self, handle: ControllerHandle) -> Optional[ControllerBase]:
        """Get the controller associated with the given handle.

        Args:
            handle (ControllerHandle): Controller handle to resolve.

        Returns:
            Context-owned controller, or None if the handle is invalid or stale.
        """
    def destroy_controller(self, handle: ControllerHandle) -> None:
        """Destroy the controller associated with the given handle.

        Args:
            handle (ControllerHandle): Controller handle to destroy; invalid or stale
                handles are ignored.
        """
    def is_valid_controller(self, handle: ControllerHandle) -> bool:
        """Check whether a handle refers to a live controller.

        Args:
            handle (ControllerHandle): Controller handle to check.

        Returns:
            True if the handle resolves to a live controller.
        """
    def create_sensor(
        self,
        type_name: str,
        link_actor: Optional[mochi_physics.Actor],
        name: str = ...,
        param_args: str = ...,
    ) -> SensorHandle:
        """Create a sensor of the given type on the given link actor. paramArgs is an
        optional params file path or inline JSON string consumed by the factory; pass an
        empty view to use default-constructed parameters. name is the instance name used
        by :meth:`~superdex.robotics.RoboticsContext.find_sensors_by_name` and need not
        be unique. The owning bot is inferred from linkActor. Returns a handle. For
        bot-owned sensors, prefer declaring them in the
        :class:`~superdex.robotics.BotPrefab` so they are auto-instantiated and
        destroyed with the bot.

        Args:
            type_name (str): Registered sensor type name.
            link_actor (Optional[Actor]): Actor to attach the sensor to, or None for an
                actor-less sensor.
            name (str): Instance name used by the name-based finders; need not be
                unique.
            param_args (str): Params file path or inline JSON; empty uses defaults.

        Returns:
            Handle to the created sensor, or an invalid handle on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_sensor(self, handle: SensorHandle) -> Optional[SensorBase]:
        """Get the sensor associated with the given handle. Returns None if invalid.
        Downcast to the concrete sensor type as needed (e.g.
        ``static_cast<CameraSensor*>(GetSensor(handle))``).

        Args:
            handle (SensorHandle): Sensor handle to resolve.

        Returns:
            Context-owned sensor, or None if the handle is invalid or stale.
        """
    def destroy_sensor(self, handle: SensorHandle) -> None:
        """Destroy the sensor associated with the given handle.

        Args:
            handle (SensorHandle): Sensor handle to destroy; invalid or stale handles
                are ignored.
        """
    def is_valid_sensor(self, handle: SensorHandle) -> bool:
        """Check whether a handle refers to a live sensor.

        Args:
            handle (SensorHandle): Sensor handle to check.

        Returns:
            True if the handle resolves to a live sensor.
        """
    def create_actuator(
        self,
        type_name: str,
        link_actor: mochi_physics.Actor,
        name: str = ...,
        param_args: str = ...,
    ) -> ActuatorHandle:
        """Create an actuator of the given type on the given link actor. Unlike a
        sensor,
        an actuator always drives a body, so linkActor is required: passing None sets an
        error and returns an invalid handle. paramArgs is an optional params file path
        or inline JSON string; empty uses default-constructed parameters. name is the
        instance name used by
        :meth:`~superdex.robotics.RoboticsContext.find_actuators_by_name` and need not
        be unique. The owning bot is inferred from linkActor. Returns a handle. For
        bot-owned actuators, prefer declaring them in the
        :class:`~superdex.robotics.BotPrefab` so they are auto-instantiated and
        destroyed with the bot.

        Args:
            type_name (str): Registered actuator type name.
            link_actor (Actor): Actor the actuator drives; must not be None.
            name (str): Instance name used by the name-based finders; need not be
                unique.
            param_args (str): Params file path or inline JSON; empty uses defaults.

        Returns:
            Handle to the created actuator, or an invalid handle on error.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def get_actuator(self, handle: ActuatorHandle) -> Optional[ActuatorBase]:
        """Get the actuator associated with the given handle. Returns None if invalid.
        Downcast to the concrete actuator type as needed.

        Args:
            handle (ActuatorHandle): Actuator handle to resolve.

        Returns:
            Context-owned actuator, or None if the handle is invalid or stale.
        """
    def destroy_actuator(self, handle: ActuatorHandle) -> None:
        """Destroy the actuator associated with the given handle.

        Args:
            handle (ActuatorHandle): Actuator handle to destroy; invalid or stale
                handles are ignored.
        """
    def is_valid_actuator(self, handle: ActuatorHandle) -> bool:
        """Check whether a handle refers to a live actuator.

        Args:
            handle (ActuatorHandle): Actuator handle to check.

        Returns:
            True if the handle resolves to a live actuator.
        """
    def get_bot(self, handle: BotHandle) -> Optional[Bot]:
        """Get the bot associated with the given handle.

        Args:
            handle (BotHandle): Bot handle to resolve.

        Returns:
            Context-owned bot, or None if the handle is invalid or the bot was
            destroyed.
        """
    def is_valid_bot(self, handle: BotHandle) -> bool:
        """Check whether a handle refers to a live bot.

        Args:
            handle (BotHandle): Bot handle to check.

        Returns:
            True if the handle resolves to a live bot.
        """
    def get_bot_containing_actor(
        self,
        actor: Optional[mochi_physics.Actor],
    ) -> Optional[Bot]:
        """Find the bot containing actor. Accepts either a bot's articulation actor or
        any
        of its link actors. Returns None when the actor is contained by no bot, which is
        a valid result: a scene may hold standalone actors and articulations from plain
        mochi prefabs alongside its bots. A None actor also returns None.

        Args:
            actor (Optional[Actor]): Actor to locate; may be None.

        Returns:
            Context-owned bot containing the actor, or None if none.
        """
    def is_controller_type_registered(self, type_name: str) -> bool:
        """Check whether a controller type name is registered (creatable via
        CreateController). Lets the scene loader skip unknown types gracefully (e.g.
        internal-only types in a public build).

        Args:
            type_name (str): Registered type name to check.

        Returns:
            True if a controller factory is registered for the type name.
        """
    def is_sensor_type_registered(self, type_name: str) -> bool:
        """Check whether a sensor type name is registered (creatable via CreateSensor).
        Mirrors :meth:`~superdex.robotics.RoboticsContext.is_controller_type_registered`
        / :meth:`~superdex.robotics.RoboticsContext.is_actuator_type_registered`.

        Args:
            type_name (str): Registered type name to check.

        Returns:
            True if a sensor factory is registered for the type name.
        """
    def is_actuator_type_registered(self, type_name: str) -> bool:
        """Check whether an actuator type name is registered (creatable via
        CreateActuator).

        Args:
            type_name (str): Registered type name to check.

        Returns:
            True if an actuator factory is registered for the type name.
        """
    def find_controllers_by_name(self, name: str) -> DynamicArrayControllerHandle:
        """Find all controllers whose instance name equals name, across every controller
        in
        this context. Instance names are not unique, so any number of handles may be
        returned (empty if none match).

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_controllers_by_type(self, type_name: str) -> DynamicArrayControllerHandle:
        """Find all controllers of the given registered typeName. Returns every match;
        empty if none.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_sensors_by_name(self, name: str) -> DynamicArraySensorHandle:
        """Find all sensors whose instance name equals name, across every sensor in this
        context (including scene-level sensors that have no owning bot). Returns every
        match; empty if none.

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_sensors_by_type(self, type_name: str) -> DynamicArraySensorHandle:
        """Find all sensors of the given registered typeName. Returns every match; empty
        if
        none.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_actuators_by_name(self, name: str) -> DynamicArrayActuatorHandle:
        """Find all actuators whose instance name equals name, across every actuator in
        this context. Returns every match; empty if none.

        Args:
            name (str): Exact instance name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_actuators_by_type(self, type_name: str) -> DynamicArrayActuatorHandle:
        """Find all actuators of the given registered typeName. Returns every match;
        empty
        if none.

        Args:
            type_name (str): Exact registered type name to match.

        Returns:
            Handles of every match in creation order; empty if none.
        """
    def find_bots_by_name(self, name: str) -> DynamicArrayBotHandle:
        """Find all bots whose name (from :attr:`~superdex.robotics.BotPrefab.name`)
        equals
        name. Bot names are not unique (multiple bots may share a prefab name), so any
        number of handles may be returned (empty if none). There is no FindBotsByType: a
        bot has no registered type.

        Args:
            name (str): Exact bot name to match.

        Returns:
            Handles of every matching live bot; empty if none.
        """

class ComponentBase:
    """Base class for all bots components (controllers, sensors, actuators). Provides
    common state: the associated actor's stale-safe identity, a validity flag, and
    the Destroy pattern. The validity flag is set to false by RoboticsContext before
    deletion, allowing dangling-pointer detection alongside generational handles.

    The associated actor is NOT cached as a raw pointer. Its stale-safe identity
    (:class:`~superdex.physics.ActorHandle` / :class:`~superdex.physics.SceneHandle`
    / owning Mochi context) is retained and :meth:`get_actor` resolves the live
    :class:`~superdex.physics.Actor`\\* on demand, yielding None once the owning
    scene (or the actor) has been destroyed. A component that outlives its mochi
    Scene (e.g. the Scene was destroyed before the RoboticsContext) therefore never
    dereferences a dangling Actor* — callers check :meth:`get_actor` for None. This
    assumes the mochi Mochi context outlives the RoboticsContext — the outermost
    lifetime in the mochi ownership graph.
    """
    def is_valid(self) -> bool:
        """Whether this component remains usable. Returns false after its owning
        :class:`~superdex.robotics.RoboticsContext` destroys it.

        Returns:
            True while the component is live.
        """
    def get_actor(self) -> Optional[mochi_physics.Actor]:
        """Resolve the live :class:`~superdex.physics.Actor`\\* this component is bound
        to,
        or None if it was constructed without an actor or its owning scene/actor has
        since been destroyed. Resolved on demand from the stale-safe handle each call
        (an O(1) scene lookup), so it is always current and never returns a dangling
        pointer — dereference only after a None check.

        Returns:
            Live associated actor, or None if none is available.
        """
    def get_owning_bot(self) -> Optional[Bot]:
        """The bot this component was created on, or None if it was created directly on
        an
        actor (not via a bot) — e.g. a scene-level sensor or a controller built on a raw
        articulation. Used to scope FindByName / FindByType to a single bot and to drive
        DestroyBot's component cascade. Borrowed: the owning bot is owned by the
        RoboticsContext, which destroys a bot's components before the bot itself, so
        this never dangles. Held as a raw pointer (not a handle) because a bot is not
        scene-owned, so the stale-safety the actor handles provide is unnecessary here.

        Returns:
            Owning bot, or None if this component has no owning bot.
        """
    def get_name(self) -> str:
        """This component's instance name, or empty if it was created without one. Names
        are NOT required to be unique, so name-based lookups (FindByName) may return
        multiple matches.

        Returns:
            Instance name; empty if unnamed.
        """
    def get_type_name(self) -> str:
        """This component's registered type name (e.g. "BASIC_OSC_PD", "SENSOR_CAMERA"),
        reported polymorphically. Declared here so controllers, sensors, and actuators
        can be searched by type uniformly (FindByType); each component kind implements
        it.

        Returns:
            Registered component type name.
        """
    def reset(self) -> None:
        """Reset internal state without destroying the component. Parameters are
        preserved.
        Use between episodes to clear stale state (e.g., derivative tracking, timing
        diagnostics).
        """

class ControllerBase(ComponentBase):
    """Base class for all controllers. Inherits common lifecycle from ComponentBase.
    Controllers are identified by string names via RoboticsContext registration, not
    enums.
    """
    def configure_from_scene_entry(self, param_args: str, init_args: str) -> None:
        """Configure this controller from serialized parameter and initialization
        arguments. paramArgs is either a params file path or inline JSON; empty uses
        defaults. initArgs is a controller-specific file path or inline JSON, for
        example carrying baseLinkName/eeLinkName for link-resolved controllers.
        Implementations typically deserialize it into a small reflected init-args struct
        and ignore unrecognized framework keys.

        Pure virtual: every controller must implement this uniform configuration entry
        point. A controller that cannot support serialized configuration should set an
        error with a clear message rather than silently succeeding.

        Args:
            param_args (str): Params file path or inline JSON; empty uses defaults.
            init_args (str): Controller-specific init-argument file path or inline JSON.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """

class ControllerBasicOscPdParams:
    """Basic operational-space PD controller parameters.

    Minimal parameter set for a robot-agnostic task-space impedance controller. See
    ControllerBasicOscPd for details.
    """
    kp_p: float
    """Position gain [N/m]"""
    kd_p: float
    """Position damping gain [Ns/m]"""
    kp_r: float
    """Rotation gain [Nm/rad]"""
    kd_r: float
    """Rotation damping gain [Nms/rad]"""
    b_apply_max_error_magnitude_normalization: bool
    """If true, renormalize the task-space error so translation and rotation errors
    stay below their configured maximums, keeping the force direction consistent.
    Requires positive maxTranslationError and maxRotationError.
    """
    max_translation_error: float
    """Max translation error for normalization in control space [m]. Must be positive
    when enabled.
    """
    max_rotation_error: float
    """Max rotation error for normalization in control space [rad]. Must be positive
    when enabled.
    """
    ee_link_from_ee: mochi_physics.TransformRT
    """The transform of the actual end-effector in the end-effector link space"""
    b_apply_max_osc_torque_normalization: bool
    """If true, scale the output efforts down uniformly so that no controlled DOF
    exceeds the per-joint effort limit harvested from the controller's BotPrefab
    (see Initialize), preserving the task-space force direction. Requires the
    controller to have been constructed with a BotPrefab; only joints with a finite
    (positive) effortLimit constrain the scaling — unbounded (negative) and
    non-actuated (zero) joints are ignored.
    """
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        kp_p: float = ...,
        kd_p: float = ...,
        kp_r: float = ...,
        kd_r: float = ...,
        b_apply_max_error_magnitude_normalization: bool = ...,
        max_translation_error: float = ...,
        max_rotation_error: float = ...,
        ee_link_from_ee: mochi_physics.TransformRT = ...,
        b_apply_max_osc_torque_normalization: bool = ...,
    ) -> None: ...
    @staticmethod
    def load_from_file(path: str) -> ControllerBasicOscPdParams:
        """Load controller parameters from a JSON file.

        Args:
            path (str): Path to a .superdex_controller JSON file.

        Returns:
            Loaded parameters, or default-constructed on failure.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """
    def save_to_file(self, path: str) -> None:
        """Save controller parameters to a JSON file.

        Args:
            path (str): Destination file path.

        Raises:
            :class:`~superdex.physics.Error`: If an error occurs.
        """

